  .section-{{ section.id }} .lfqb-ingredients-modal .product-ingredients__media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-ingredients__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-ingredients__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-ingredients__tag {
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-ingredients__title {
    margin: 0 0 6px;
    font-family: var(--font-heading-family);
    font-size: 17px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-ingredients__text {
    font-size: 14px;
    line-height: 1.4;
  }

  /* Right column: full ingredient list */
  .section-{{ section.id }} .lfqb-ingredients-modal__sidebar h3 {
    margin: 14px 0 4px;
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #1f1f1f;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal__sidebar h3:first-child {
    margin-top: 0;
    padding-right: 36px;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal__sidebar div:has(> svg) {
