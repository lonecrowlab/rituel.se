    text-transform: uppercase;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal__sidebar div > svg {
    flex-shrink: 0;
  }

  /* Footer: badges */
  .section-{{ section.id }} .lfqb-ingredients-modal__footer {
    flex-shrink: 0;
    padding: 11px 16px;
    background: linear-gradient(92deg, rgba(223, 177, 66, 0.3) 10%, rgba(233, 128, 68, 0.3) 49.5%, rgba(175, 137, 152, 0.3) 100%);
  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-content__tags-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 12px;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-content__tags-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-content__tags-item svg {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-content__tags-item p {
    margin: 0;
    font-size: 11px;
