{% liquid
  assign product = section.settings.product
  assign selected_variant = product.selected_or_first_available_variant
%}

<section class="ltl-fry-quick-buy section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lf-wrap">
    <div class="lfqb-grid">
      <div class="lfqb-content">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'heading' %}
              {% if block.settings.text != blank %}
                <h2 class="lfqb-heading lfqb-block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
              {% endif %}
            {% when 'text' %}
              {% if block.settings.text != blank %}
                <div class="lfqb-text rte lfqb-block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {% endif %}
            {% when 'badge' %}
              {% if block.settings.text != blank %}
                <span class="lfqb-badge lfqb-block-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>

      <div class="lfqb-buy">
        {% if product != blank %}
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'lfqb-product__image', alt: product.title }}
          {% endif %}
          <p class="lfqb-product__title">{{ product.title }}</p>
          <p class="lfqb-product__price">{{ selected_variant.price | money }}</p>

          {% liquid
            assign lfqb_form_id = 'lfqb-form-' | append: section.id
          %}
          {% form 'product', product, class: 'lfqb-form', id: lfqb_form_id %}
            {% if product.has_only_default_variant %}
              <input type="hidden" name="id" value="{{ selected_variant.id }}">
            {% else %}
              <select name="id" class="lfqb-variant-select" aria-label="Variant">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% if variant.id == selected_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }} — {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>
            {% endif %}
            <button type="submit" class="lfqb-btn" {% unless selected_variant.available %}disabled{% endunless %}>
              {% assign button_label = section.settings.button_label %}
              {% if button_label == blank %}
                {% if selected_variant.available %}
                  {% assign button_label = 'Add to cart' %}
                {% else %}
                  {% assign button_label = 'Sold out' %}
                {% endif %}
              {% endif %}
              {{ button_label }}
            </button>
          {% endform %}
        {% else %}
          <p class="lfqb-empty">Select a product in section settings.</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% render 'ltl-fry-section-base', section: section %}

<style>
  .section-{{ section.id }} .lfqb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
  }

  .section-{{ section.id }} .lfqb-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: {{ section.settings.text_align }};
  }

  .section-{{ section.id }} .lfqb-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.25;
  }

  .section-{{ section.id }} .lfqb-text {
    font-size: {{ section.settings.body_font_size_mobile }}px;
    color: {{ section.settings.body_color }};
    line-height: 1.55;
  }

  .section-{{ section.id }} .lfqb-badge {
    display: inline-block;
    background: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_text_color }};
    font-size: {{ section.settings.badge_font_size_mobile }}px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
  }

  .section-{{ section.id }} .lfqb-buy {
    background: {{ section.settings.buy_box_bg_color }};
    border: {{ section.settings.buy_box_border_width }}px solid {{ section.settings.buy_box_border_color }};
    border-radius: {{ section.settings.buy_box_border_radius }}px;
    padding: 20px;
    text-align: center;
  }

  .section-{{ section.id }} .lfqb-product__image {
    width: 100%;
    max-width: 280px;
    height: auto;
    margin: 0 auto 12px;
    display: block;
    border-radius: 8px;
  }

  .section-{{ section.id }} .lfqb-product__title {
    font-size: {{ section.settings.product_title_size_mobile }}px;
    font-weight: 600;
    margin: 0 0 4px;
    color: {{ section.settings.product_title_color }};
  }

  .section-{{ section.id }} .lfqb-product__price {
    font-size: {{ section.settings.product_price_size_mobile }}px;
    margin: 0 0 16px;
    color: {{ section.settings.product_price_color }};
  }

  .section-{{ section.id }} .lfqb-variant-select {
    width: 100%;
    margin-bottom: 12px;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: {{ section.settings.body_font_size_mobile }}px;
  }

  .section-{{ section.id }} .lfqb-btn {
    width: 100%;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_font_size_mobile }}px;
    font-weight: {{ section.settings.button_font_weight }};
    cursor: pointer;
  }

  .section-{{ section.id }} .lfqb-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .section-{{ section.id }} .lfqb-empty {
    font-size: {{ section.settings.body_font_size_mobile }}px;
    color: {{ section.settings.body_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .lfqb-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .section-{{ section.id }} .lfqb-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfqb-text {
      font-size: {{ section.settings.body_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfqb-badge {
      font-size: {{ section.settings.badge_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfqb-product__title {
      font-size: {{ section.settings.product_title_size_desktop }}px;
    }

    .section-{{ section.id }} .lfqb-product__price {
      font-size: {{ section.settings.product_price_size_desktop }}px;
    }

    .section-{{ section.id }} .lfqb-btn {
      font-size: {{ section.settings.button_font_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "ltl-fry-quick-buy",
  "tag": "section",
  "class": "section-ltl-fry-quick-buy",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "select", "id": "text_align", "label": "Content alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "header", "content": "Buy box" },
    { "type": "color", "id": "buy_box_bg_color", "label": "Buy box background", "default": "#ffffff" },
    { "type": "range", "id": "buy_box_border_width", "min": 0, "max": 4, "step": 1, "unit": "px", "label": "Buy box border width", "default": 1 },
    { "type": "color", "id": "buy_box_border_color", "label": "Buy box border color", "default": "#e5e7eb" },
    { "type": "range", "id": "buy_box_border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Buy box radius", "default": 12 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size_mobile", "min": 20, "max": 48, "step": 2, "unit": "px", "label": "Heading size (mobile)", "default": 28 },
    { "type": "range", "id": "heading_font_size_desktop", "min": 24, "max": 56, "step": 2, "unit": "px", "label": "Heading size (desktop)", "default": 40 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" },
      { "value": "700", "label": "Bold" }
    ], "default": "600" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1f2937" },
    { "type": "range", "id": "body_font_size_mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Body size (mobile)", "default": 15 },
    { "type": "range", "id": "body_font_size_desktop", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Body size (desktop)", "default": 16 },
    { "type": "color", "id": "body_color", "label": "Body color", "default": "#374151" },
    { "type": "range", "id": "badge_font_size_mobile", "min": 10, "max": 16, "step": 1, "unit": "px", "label": "Badge size (mobile)", "default": 12 },
    { "type": "range", "id": "badge_font_size_desktop", "min": 10, "max": 16, "step": 1, "unit": "px", "label": "Badge size (desktop)", "default": 13 },
    { "type": "color", "id": "badge_bg_color", "label": "Badge background", "default": "#cc667c" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#ffffff" },
    { "type": "range", "id": "product_title_size_mobile", "min": 14, "max": 24, "step": 1, "unit": "px", "label": "Product title size (mobile)", "default": 18 },
    { "type": "range", "id": "product_title_size_desktop", "min": 16, "max": 28, "step": 1, "unit": "px", "label": "Product title size (desktop)", "default": 20 },
    { "type": "color", "id": "product_title_color", "label": "Product title color", "default": "#111827" },
    { "type": "range", "id": "product_price_size_mobile", "min": 14, "max": 24, "step": 1, "unit": "px", "label": "Price size (mobile)", "default": 16 },
    { "type": "range", "id": "product_price_size_desktop", "min": 16, "max": 28, "step": 1, "unit": "px", "label": "Price size (desktop)", "default": 18 },
    { "type": "color", "id": "product_price_color", "label": "Price color", "default": "#111827" },
    { "type": "header", "content": "Button" },
    { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "button_font_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Button size (mobile)", "default": 14 },
    { "type": "range", "id": "button_font_size_desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Button size (desktop)", "default": 16 },
    { "type": "select", "id": "button_font_weight", "label": "Button weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" },
      { "value": "700", "label": "Bold" }
    ], "default": "600" },
    { "type": "range", "id": "button_border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Button radius", "default": 8 },
    { "type": "range", "id": "button_padding_vertical", "min": 8, "max": 24, "step": 1, "unit": "px", "label": "Button padding vertical", "default": 14 },
    { "type": "range", "id": "button_padding_horizontal", "min": 16, "max": 60, "step": 2, "unit": "px", "label": "Button padding horizontal", "default": 24 },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf8f6" },
    { "type": "checkbox", "id": "gradient_enabled", "label": "Use gradient background", "default": false },
    { "type": "color_background", "id": "gradient_background", "label": "Gradient", "default": "linear-gradient(180deg, rgba(250,248,246,1), rgba(255,255,255,1) 100%)" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "range", "id": "container_max_width", "min": 600, "max": 1200, "step": 10, "unit": "px", "label": "Container max width", "default": 1000 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (mobile)", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (mobile)", "default": 32 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (desktop)", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (desktop)", "default": 48 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Heading", "default": "Ready to try it?" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add to cart and start your ritual today.</p>" }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Badge text", "default": "60-day guarantee" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ltl-fry-quick-buy",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "badge" }
      ]
    }
  ]
}
{% endschema %}
