  }

  .section-{{ section.id }} .lfqb-ingredients-modal .product-ingredients__item {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: start;
    gap: 16px;
    margin: 0;
    padding: 0;
