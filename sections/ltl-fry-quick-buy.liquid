{%- liquid
  assign quick_buy_product = section.settings.product
  if quick_buy_product == blank
    assign quick_buy_product = product
  endif

  assign selected_variant = quick_buy_product.selected_or_first_available_variant
  assign lfqb_form_id = 'lfqb-form-' | append: section.id
  assign selling_plans_available = false
  assign first_selling_plan_id = blank
  assign selling_plan_count = 0

  if quick_buy_product != blank
    assign product = quick_buy_product
    for group in quick_buy_product.selling_plan_groups
      for plan in group.selling_plans
        assign selling_plan_count = selling_plan_count | plus: 1
        if first_selling_plan_id == blank
          assign first_selling_plan_id = plan.id
          assign selling_plans_available = true
        endif
      endfor
    endfor
  endif

  assign gallery_media = quick_buy_product.media | where: 'media_type', 'image'
  if gallery_media.size == 0
    assign gallery_media = quick_buy_product.media
  endif
-%}

<section
  class="ltl-fry-quick-buy section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-lfqb-section
>
  <div class="lf-wrap">
    {% if quick_buy_product == blank %}
      <p class="lfqb-empty">Select a product in section settings.</p>
    {% else %}
      <div class="lfqb-grid">
        <div class="lfqb-media">
          <div class="lfqb-gallery" data-lfqb-gallery>
            <div class="lfqb-gallery__stage">
              {% if section.settings.show_save_badge and section.settings.save_badge_text != blank %}
                <span class="lfqb-gallery__save-badge">{{ section.settings.save_badge_text }}</span>
              {% endif %}

              {% if gallery_media.size > 0 %}
                {% for media in gallery_media %}
                  {%- liquid
                    assign slide_alt = media.alt
                    if slide_alt == blank
                      assign slide_alt = quick_buy_product.title
                    endif
                  -%}
                  <div
                    class="lfqb-gallery__slide{% if forloop.first %} is-active{% endif %}"
                    data-lfqb-slide
                    data-index="{{ forloop.index0 }}"
                  >
                    {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'lfqb-gallery__image', alt: slide_alt }}
                  </div>
                {% endfor %}
              {% else %}
                <div class="lfqb-gallery__slide is-active" data-lfqb-slide data-index="0">
                  {{ 'product-1' | placeholder_svg_tag: 'lfqb-gallery__placeholder' }}
                </div>
              {% endif %}

              {% if gallery_media.size > 1 %}
                <button type="button" class="lfqb-gallery__nav lfqb-gallery__nav--prev" data-lfqb-prev aria-label="Previous image">&lsaquo;</button>
                <button type="button" class="lfqb-gallery__nav lfqb-gallery__nav--next" data-lfqb-next aria-label="Next image">&rsaquo;</button>
              {% endif %}

              {% if section.settings.show_quote_overlay %}
                <div class="lfqb-gallery__quote">
                  {% if section.settings.quote_image != blank %}
                    {{ section.settings.quote_image | image_url: width: 80 | image_tag: loading: 'lazy', class: 'lfqb-gallery__quote-image', alt: section.settings.quote_name }}
                  {% endif %}
                  <div class="lfqb-gallery__quote-body">
                    {% if section.settings.quote_name != blank %}
                      <p class="lfqb-gallery__quote-name">{{ section.settings.quote_name }}</p>
                    {% endif %}
                    {% if section.settings.quote_text != blank %}
                      <p class="lfqb-gallery__quote-text">{{ section.settings.quote_text }}</p>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            </div>

            {% if gallery_media.size > 1 %}
              <div class="lfqb-gallery__thumbs" data-lfqb-thumbs>
                {% for media in gallery_media %}
                  {%- liquid
                    assign thumb_alt = media.alt
                    if thumb_alt == blank
                      assign thumb_alt = quick_buy_product.title
                    endif
                  -%}
                  <button
                    type="button"
                    class="lfqb-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                    data-lfqb-thumb
                    data-index="{{ forloop.index0 }}"
                    aria-label="Show image {{ forloop.index }}"
                  >
                    {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: thumb_alt }}
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          </div>

          {% assign ingredients_label = section.settings.ingredients_button_text | default: 'View ingredients' %}
          <button
            type="button"
            class="lfqb-ingredients-btn"
            data-lfqb-open-ingredients
            aria-controls="lfqb-ingredients-{{ section.id }}"
          >
            {{ ingredients_label }}
          </button>
        </div>

        <div class="lfqb-offer">
          {% form 'product', quick_buy_product, class: 'lfqb-form', id: lfqb_form_id %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-lfqb-variant-input>

            {% if quick_buy_product.has_only_default_variant == false %}
              <label class="lfqb-variant-label visually-hidden" for="lfqb-variant-{{ section.id }}">Variant</label>
              <select id="lfqb-variant-{{ section.id }}" class="lfqb-variant-select" data-lfqb-variant-select aria-label="Variant">
                {% for variant in quick_buy_product.variants %}
                  <option
                    value="{{ variant.id }}"
                    {% if variant.id == selected_variant.id %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }} — {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>
            {% endif %}

            <div class="lfqb-blocks">
              {% for block in section.blocks %}
                {%- liquid
                  assign visibility = block.settings.visibility | default: 'all'
                  assign device_class = 'lfqb-device-' | append: visibility
                -%}

                {% case block.type %}
                  {% when 'reviews' %}
                    <div class="lfqb-block lfqb-block-reviews lfqb-block-{{ block.id }} {{ device_class }}" {{ block.shopify_attributes }}>
                      {% render 'rating-stars-block', block: block, product: quick_buy_product, block_attributes: '', margins: true %}
                    </div>

                  {% when 'text' %}
                    {% if block.settings.text != blank %}
                      <div class="lfqb-text lfqb-text--{{ block.settings.style }} lfqb-block lfqb-block-{{ block.id }} {{ device_class }}" {{ block.shopify_attributes }}>
                        {{ block.settings.text }}
                      </div>
                    {% endif %}

                  {% when 'price' %}
                    {%- liquid
                      assign compare_at = selected_variant.compare_at_price
                      assign current_price = selected_variant.price
                      assign on_sale = false
                      if compare_at > current_price
                        assign on_sale = true
                      endif
                      assign price_second = false
                      if block.settings.layout == 'price_second'
                        assign price_second = true
                      endif
                    -%}
                    <div
                      class="lfqb-price lfqb-block lfqb-block-{{ block.id }} {{ device_class }}{% if on_sale %} lfqb-price--on-sale{% endif %}{% if price_second %} lfqb-price--compare-first{% endif %}"
                      id="lfqb-price-{{ block.id }}"
                      data-lfqb-price-block
                      {{ block.shopify_attributes }}
                    >
                      <div class="lfqb-price__row">
                        <span class="lfqb-price__current" data-lfqb-price-current>{{ current_price | money_with_currency }}</span>
                        {% if on_sale %}
                          <s class="lfqb-price__compare" data-lfqb-price-compare>{{ compare_at | money_with_currency }}</s>
                        {% else %}
                          <s class="lfqb-price__compare" data-lfqb-price-compare hidden></s>
                        {% endif %}
                      </div>
                    </div>

                  {% when 'feature' %}
                    <div
                      class="lfqb-feature lfqb-block lfqb-block-{{ block.id }} {{ device_class }}"
                      data-lfqb-feature
                      data-default-enabled="{{ block.settings.default_enabled }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="lfqb-feature__head">
                        <label class="lfqb-feature__toggle-wrap">
                          <input
                            type="checkbox"
                            class="lfqb-feature__toggle"
                            data-lfqb-plan-toggle
                            {% if block.settings.default_enabled and selling_plans_available %}checked{% endif %}
                            {% unless selling_plans_available %}disabled{% endunless %}
                          >
                          <span class="lfqb-feature__toggle-ui" aria-hidden="true"></span>
                        </label>
                        <div class="lfqb-feature__copy">
                          {% if block.settings.title != blank %}
                            <p class="lfqb-feature__title">{{ block.settings.title }}</p>
                          {% endif %}
                          {% if block.settings.description != blank %}
                            <p class="lfqb-feature__description">{{ block.settings.description }}</p>
                          {% endif %}
                        </div>
                      </div>
                      {% if block.settings.features != blank %}
                        <div class="lfqb-feature__features rte">{{ block.settings.features }}</div>
                      {% endif %}
                      {% if block.settings.show_savings_message %}
                        {%- liquid
                          assign savings_token = '{' | append: '{' | append: ' savings ' | append: '}' | append: '}'
                          assign savings_preview = block.settings.savings_message | replace: '[savings]', '' | replace: '[ savings ]', '' | replace: savings_token, ''
                        -%}
                        <p
                          class="lfqb-feature__savings"
                          data-lfqb-savings
                          data-template="{{ block.settings.savings_message | escape }}"
                          {% unless block.settings.default_enabled and selling_plans_available %}hidden{% endunless %}
                        >
                          {{ savings_preview }}
                        </p>
                      {% endif %}
                      {% unless selling_plans_available %}
                        <p class="lfqb-feature__no-plans">No subscription plans found on this product.</p>
                      {% endunless %}
                      {% if selling_plan_count > 1 %}
                        <label class="lfqb-feature__plan-label visually-hidden" for="lfqb-plan-{{ block.id }}">Subscription plan</label>
                        <select id="lfqb-plan-{{ block.id }}" class="lfqb-feature__plan-select" data-lfqb-plan-select>
                          {% for group in quick_buy_product.selling_plan_groups %}
                            {% for plan in group.selling_plans %}
                              <option value="{{ plan.id }}" {% if plan.id == first_selling_plan_id %}selected{% endif %}>{{ plan.name }}</option>
                            {% endfor %}
                          {% endfor %}
                        </select>
                      {% endif %}
                    </div>

                  {% when 'custom_html' %}
                    {% if block.settings.custom_html != blank %}
                      <div class="lfqb-custom-html lfqb-block lfqb-block-{{ block.id }} {{ device_class }}" {{ block.shopify_attributes }}>
                        {{ block.settings.custom_html }}
                      </div>
                    {% endif %}

                  {% when 'buy_buttons' %}
                    {%- liquid
                      assign atc_label = block.settings.button_label
                      if atc_label == blank
                        if selected_variant.available
                          assign atc_label = 'Add to cart'
                        else
                          assign atc_label = 'Sold out'
                        endif
                      endif
                    -%}
                    <div class="lfqb-atc-wrap lfqb-block lfqb-block-{{ block.id }} {{ device_class }}" {{ block.shopify_attributes }}>
                      <button
                        type="submit"
                        name="add"
                        class="lfqb-atc"
                        data-lfqb-atc
                        {% unless selected_variant.available %}disabled{% endunless %}
                      >
                        <span
                          data-lfqb-atc-label
                          data-available-label="{{ atc_label | escape }}"
                          data-sold-out-label="{{ block.settings.sold_out_label | default: 'Sold out' | escape }}"
                        >{{ atc_label }}</span>
                      </button>
                    </div>

                  {% when 'image_with_text' %}
                    {%- liquid
                      assign iwt_alt = block.settings.image_alt
                      if block.settings.image != blank and block.settings.image.alt != blank
                        assign iwt_alt = block.settings.image.alt
                      endif
                      assign iwt_text_position = block.settings.text_position
                      if iwt_text_position == blank
                        if block.settings.image_position == 'right'
                          assign iwt_text_position = 'left'
                        elsif block.settings.image_position == 'left'
                          assign iwt_text_position = 'right'
                        else
                          assign iwt_text_position = 'right'
                        endif
                      endif
                      assign iwt_width = block.settings.block_width | default: 'auto'
                      assign iwt_align = block.settings.content_align | default: 'center'
                    -%}
                    <div class="lfqb-iwt lfqb-iwt--text-{{ iwt_text_position }} lfqb-iwt--{{ iwt_width }} lfqb-iwt--align-{{ iwt_align }} lfqb-block lfqb-block-{{ block.id }} {{ device_class }}" {{ block.shopify_attributes }}>
                      {% if block.settings.image != blank %}
                        <div class="lfqb-iwt__media">
                          {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'lfqb-iwt__image', alt: iwt_alt }}
                        </div>
                      {% endif %}
                      {% if block.settings.text != blank %}
                        <div class="lfqb-iwt__text rte">{{ block.settings.text }}</div>
                      {% endif %}
                    </div>

                  {% when 'images_with_text' %}
                    {%- liquid
                      assign iwtm_columns = block.settings.columns | default: 2
                      assign iwtm_align = block.settings.content_align | default: 'center'
                    -%}
                    <div
                      class="lfqb-iwtm lfqb-block lfqb-block-{{ block.id }} {{ device_class }}"
                      style="--lfqb-iwtm-cols: {{ iwtm_columns }};"
                      {{ block.shopify_attributes }}
                    >
                      {% for i in (1..4) %}
                        {%- liquid
                          assign image_key = 'image_' | append: i
                          assign text_key = 'text_' | append: i
                          assign alt_key = 'image_alt_' | append: i
                          assign item_image = block.settings[image_key]
                          assign item_text = block.settings[text_key]
                          assign item_alt = block.settings[alt_key]
                          if item_image != blank and item_image.alt != blank
                            assign item_alt = item_image.alt
                          endif
                        -%}
                        {% if item_image != blank or item_text != blank %}
                          <div class="lfqb-iwtm__item lfqb-iwtm__item--align-{{ iwtm_align }}">
                            {% if item_image != blank %}
                              <div class="lfqb-iwtm__media">
                                {{ item_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'lfqb-iwtm__image', alt: item_alt }}
                              </div>
                            {% endif %}
                            {% if item_text != blank %}
                              <div class="lfqb-iwtm__text rte">{{ item_text }}</div>
                            {% endif %}
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>

                  {% when 'low_stock' %}
                    <div class="lfqb-low-stock lfqb-block lfqb-block-{{ block.id }} {{ device_class }}" {{ block.shopify_attributes }}>
                      {% if block.settings.show_icon %}
                        <span class="lfqb-low-stock__icon" aria-hidden="true">{{ block.settings.icon_text | default: '🔥' }}</span>
                      {% endif %}
                      {% render 'product-scarcity',
                        scarcity_id: block.id,
                        block_attributes: '',
                        stock_min: block.settings.stock_min,
                        stock_max: block.settings.stock_max,
                        reduction_minutes: block.settings.reduction_minutes,
                        reduction_amount: block.settings.reduction_amount,
                        text_prefix: block.settings.text_prefix,
                        text_suffix: block.settings.text_suffix,
                        dot_color: block.settings.dot_color,
                        min_dot_color: block.settings.min_dot_color,
                        match_text_to_dot_color: block.settings.match_text_to_dot_color,
                        text_color: block.settings.text_color,
                        stock_color: block.settings.stock_color,
                        text_font_size: block.settings.text_font_size,
                        text_font_weight: block.settings.text_font_weight,
                        count_font_weight: block.settings.count_font_weight
                      %}
                    </div>
                {% endcase %}
              {% endfor %}
            </div>
          {% endform %}
        </div>
      </div>

      <script type="application/json" data-lfqb-product-data>
        {
          "moneyFormat": {{ shop.money_with_currency_format | json }},
          "currency": {{ cart.currency.iso_code | json }},
          "selectedVariantId": {{ selected_variant.id | json }},
          "sellingPlansAvailable": {{ selling_plans_available | json }},
          "defaultPlanId": {{ first_selling_plan_id | json }},
          "variants": [
            {%- for variant in quick_buy_product.variants -%}
              {
                "id": {{ variant.id | json }},
                "price": {{ variant.price }},
                "compareAtPrice": {{ variant.compare_at_price | default: 0 }},
                "available": {{ variant.available | json }},
                "allocations": [
                  {%- for allocation in variant.selling_plan_allocations -%}
                    {
                      "planId": {{ allocation.selling_plan.id | json }},
                      "price": {{ allocation.price }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      </script>
    {% endif %}
  </div>

  <dialog class="lfqb-ingredients-modal" id="lfqb-ingredients-{{ section.id }}" data-lfqb-ingredients-modal>
    <div class="lfqb-ingredients-modal__inner">
      <button type="button" class="lfqb-ingredients-modal__close" data-lfqb-close-ingredients aria-label="Close">&times;</button>
      <div class="lfqb-ingredients-modal__layout">
        <div class="lfqb-ingredients-modal__content">
          {% if section.settings.ingredients_modal_content != blank %}
            {{ section.settings.ingredients_modal_content }}
          {% else %}
            {% render 'ltl-fry-ingredients-modal-fallback' %}
          {% endif %}
        </div>
        <div class="lfqb-ingredients-modal__sidebar">
          {% if section.settings.ingredients_modal_sidebar != blank %}
            {{ section.settings.ingredients_modal_sidebar }}
          {% else %}
            {% render 'ltl-fry-ingredients-modal-sidebar-fallback' %}
          {% endif %}
        </div>
      </div>
      <div class="lfqb-ingredients-modal__footer">
        {% if section.settings.ingredients_modal_footer != blank %}
          {{ section.settings.ingredients_modal_footer }}
        {% else %}
          {% render 'ltl-fry-ingredients-modal-footer-fallback' %}
        {% endif %}
      </div>
    </div>
  </dialog>
</section>

{% render 'ltl-fry-section-base', section: section %}

<style>
  .section-{{ section.id }} .lfqb-empty {
    margin: 0;
    font-size: 15px;
    color: #6b7280;
  }

  .section-{{ section.id }} .lfqb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.column_gap_mobile }}px;
    align-items: start;
  }

  .section-{{ section.id }} .lfqb-gallery__stage {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.gallery_radius }}px;
    background: {{ section.settings.gallery_bg_color }};
    {% if section.settings.gallery_aspect_ratio == 'auto' %}
      min-height: 420px;
    {% else %}
      aspect-ratio: {{ section.settings.gallery_aspect_ratio }};
    {% endif %}
  }

  .section-{{ section.id }} .lfqb-gallery__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .section-{{ section.id }} .lfqb-gallery__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .section-{{ section.id }} .lfqb-gallery__image,
  .section-{{ section.id }} .lfqb-gallery__placeholder {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.gallery_image_fit }};
    display: block;
  }

  .section-{{ section.id }} .lfqb-gallery__save-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    background: {{ section.settings.save_badge_bg_color }};
    color: {{ section.settings.save_badge_text_color }};
    font-size: {{ section.settings.save_badge_font_size }}px;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-{{ section.id }} .lfqb-gallery__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #111;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .section-{{ section.id }} .lfqb-gallery__nav--prev { left: 12px; }
  .section-{{ section.id }} .lfqb-gallery__nav--next { right: 12px; }

  .section-{{ section.id }} .lfqb-gallery__quote {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: flex;
    gap: 10px;
    align-items: center;
    background: rgba(255, 255, 255, 0.94);
    border-radius: 12px;
    padding: 10px 12px;
  }

  .section-{{ section.id }} .lfqb-gallery__quote-image {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .section-{{ section.id }} .lfqb-gallery__quote-name {
    margin: 0 0 2px;
    font-size: 12px;
    font-weight: 700;
  }

  .section-{{ section.id }} .lfqb-gallery__quote-text {
    margin: 0;
    font-size: 12px;
    line-height: 1.4;
  }

  .section-{{ section.id }} .lfqb-gallery__thumbs {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .section-{{ section.id }} .lfqb-gallery__thumb {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    cursor: pointer;
  }

  .section-{{ section.id }} .lfqb-gallery__thumb.is-active {
    border-color: #111;
  }

  .section-{{ section.id }} .lfqb-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .section-{{ section.id }} .lfqb-ingredients-btn {
    width: 100%;
    margin-top: 12px;
    border: none;
    border-radius: {{ section.settings.ingredients_button_radius }}px;
    padding: 14px 18px;
    background: {{ section.settings.ingredients_button_bg }};
    color: {{ section.settings.ingredients_button_color }};
    font-size: {{ section.settings.ingredients_button_font_size_mobile }}px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .section-{{ section.id }} .lfqb-offer {
    display: flex;
    flex-direction: column;
  }

  .section-{{ section.id }} .lfqb-form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .section-{{ section.id }} .lfqb-blocks {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: {{ section.settings.block_gap_mobile }}px;
  }

  .section-{{ section.id }} .lfqb-blocks > .lfqb-block:not(.lfqb-iwt--auto) {
    flex: 0 0 100%;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .section-{{ section.id }} .lfqb-blocks > .lfqb-iwt--auto {
    flex: 0 0 auto;
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    align-self: flex-start;
  }

  .section-{{ section.id }} .lfqb-variant-select {
    width: 100%;
    margin-bottom: 12px;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .lfqb-device-desktop { display: none !important; }
  }

  .section-{{ section.id }} .lfqb-block-reviews .rating-stars {
    justify-content: flex-start;
  }

  {% for block in section.blocks %}
    {% if block.type == 'text' %}
      {% if block.settings.font_source == 'custom' %}
        {% if block.settings.font_regular != blank %}
          {{ block.settings.font_regular | font_face: font_display: 'swap' }}
        {% endif %}
        {% if block.settings.font_bold != blank %}
          {{ block.settings.font_bold | font_face: font_display: 'swap' }}
