</style>
<script>
  (function () {
    const section = document.querySelector('[data-section-id="{{ section.id }}"][data-lfqb-section]');
    if (!section) return;

    const dataEl = section.querySelector('[data-lfqb-product-data]');
    const form = section.querySelector('.lfqb-form');
    if (!dataEl || !form) return;

    let productData = {};
    try {
      productData = JSON.parse(dataEl.textContent);
    } catch (e) {
      return;
    }

    const variantInput = form.querySelector('[data-lfqb-variant-input]');
    const variantSelect = form.querySelector('[data-lfqb-variant-select]');
    const priceBlocks = section.querySelectorAll('[data-lfqb-price-block]');
    const featureBlocks = section.querySelectorAll('[data-lfqb-feature]');
    const atcButton = form.querySelector('[data-lfqb-atc]');
    const atcLabel = form.querySelector('[data-lfqb-atc-label]');
    let sellingPlanInput = form.querySelector('input[name="selling_plan"]');

    function formatMoney(cents) {
      const value = Math.round(Number(cents) || 0);
      const format = productData.moneyFormat || '{{amount}}';
      const amount = (value / 100).toFixed(2);
      const amountParts = amount.split('.');
      const intPart = amountParts[0];
      const decPart = amountParts[1] || '00';
      const amountNoDecimals = String(Math.round(value / 100));

      const withThousands = function (numStr, sep) {
        return numStr.replace(/\B(?=(\d{3})+(?!\d))/g, sep);
      };

      const placeholders = {
        amount_with_comma_separator: withThousands(intPart, '.') + ',' + decPart,
        amount_no_decimals_with_comma_separator: withThousands(amountNoDecimals, '.'),
        amount_with_apostrophe_separator: withThousands(intPart, "'") + '.' + decPart,
        amount_no_decimals_with_apostrophe_separator: withThousands(amountNoDecimals, "'"),
        amount_with_space_separator: withThousands(intPart, ' ') + ',' + decPart,
        amount_no_decimals_with_space_separator: withThousands(amountNoDecimals, ' '),
        amount_no_decimals: withThousands(amountNoDecimals, ','),
        amount: withThousands(intPart, ',') + '.' + decPart
      };

      let output = String(format);
      Object.keys(placeholders).forEach(function (key) {
        output = output.replace(new RegExp('\\{\\{\\s*' + key + '\\s*\\}\\}', 'g'), placeholders[key]);
      });

      if (/\{\{\s*amount/.test(output) && typeof Shopify !== 'undefined' && typeof Shopify.formatMoney === 'function') {
        try {
          return Shopify.formatMoney(value, format);
        } catch (e) {}
      }
      return output;
    }

    function getVariant() {
      const id = Number(variantInput ? variantInput.value : productData.selectedVariantId);
      return (productData.variants || []).find(function (variant) {
        return Number(variant.id) === id;
      });
    }

    function getActivePlanId(featureEl) {
      const toggle = featureEl.querySelector('[data-lfqb-plan-toggle]');
      if (!toggle || !toggle.checked || !productData.sellingPlansAvailable) return null;
      const select = featureEl.querySelector('[data-lfqb-plan-select]');
      if (select) return Number(select.value);
      return Number(productData.defaultPlanId) || null;
    }

    function getPrices() {
      const variant = getVariant();
      if (!variant) return null;

      let planId = null;
      featureBlocks.forEach(function (featureEl) {
        const active = getActivePlanId(featureEl);
        if (active) planId = active;
      });

      let current = variant.price;
      let compare = variant.compareAtPrice || 0;

      if (planId) {
        const allocation = (variant.allocations || []).find(function (item) {
          return Number(item.planId) === Number(planId);
        });
        if (allocation) {
          compare = variant.price;
          current = allocation.price;
        }
      }

      return {
        current: current,
        compare: compare,
        savings: Math.max(0, compare - current),
        available: !!variant.available
      };
    }

    function syncSellingPlanInput() {
      let planId = null;
      featureBlocks.forEach(function (featureEl) {
        const active = getActivePlanId(featureEl);
        if (active) planId = active;
      });

      if (!sellingPlanInput) {
        sellingPlanInput = document.createElement('input');
        sellingPlanInput.type = 'hidden';
        sellingPlanInput.name = 'selling_plan';
        form.appendChild(sellingPlanInput);
      }

      if (planId) {
        sellingPlanInput.value = planId;
        sellingPlanInput.disabled = false;
      } else {
        sellingPlanInput.value = '';
        sellingPlanInput.disabled = true;
      }
    }

    function updatePrices() {
      const prices = getPrices();
      if (!prices) return;

      priceBlocks.forEach(function (block) {
        const currentEl = block.querySelector('[data-lfqb-price-current]');
        const compareEl = block.querySelector('[data-lfqb-price-compare]');
        if (currentEl) currentEl.textContent = formatMoney(prices.current);
        if (compareEl) {
          if (prices.compare > prices.current) {
            compareEl.textContent = formatMoney(prices.compare);
            compareEl.hidden = false;
            block.classList.add('lfqb-price--on-sale');
          } else {
            compareEl.hidden = true;
            block.classList.remove('lfqb-price--on-sale');
          }
        }
      });

      featureBlocks.forEach(function (featureEl) {
        const savingsEl = featureEl.querySelector('[data-lfqb-savings]');
        if (!savingsEl) return;
        const template = savingsEl.dataset.template || savingsEl.textContent.trim();
        if (!template) return;
        const message = template
          .replace(/\[\s*savings\s*\]/gi, formatMoney(prices.savings))
          .replace(/\{\{\s*savings\s*\}\}/gi, formatMoney(prices.savings));
        savingsEl.textContent = message;
        savingsEl.hidden = !(getActivePlanId(featureEl) && prices.savings > 0);
      });

      if (atcButton) {
        atcButton.disabled = !prices.available;
        if (atcLabel) {
          atcLabel.textContent = prices.available
            ? (atcLabel.dataset.availableLabel || atcLabel.textContent)
            : (atcLabel.dataset.soldOutLabel || 'Sold out');
        }
      }
    }

    function bindFeatureBlocks() {
      featureBlocks.forEach(function (featureEl) {
        const toggle = featureEl.querySelector('[data-lfqb-plan-toggle]');
        const select = featureEl.querySelector('[data-lfqb-plan-select]');
        const savingsEl = featureEl.querySelector('[data-lfqb-savings]');
        if (savingsEl && !savingsEl.dataset.template) {
          savingsEl.dataset.template = savingsEl.textContent.trim();
        }
        if (toggle) {
          toggle.addEventListener('change', function () {
            syncSellingPlanInput();
            updatePrices();
          });
        }
        if (select) {
          select.addEventListener('change', function () {
            syncSellingPlanInput();
            updatePrices();
          });
        }
      });
    }

    if (variantSelect && variantInput) {
      variantSelect.addEventListener('change', function () {
        variantInput.value = variantSelect.value;
        syncSellingPlanInput();
        updatePrices();
      });
    }

    bindFeatureBlocks();
    syncSellingPlanInput();
    updatePrices();

    const gallery = section.querySelector('[data-lfqb-gallery]');
    if (gallery) {
      const slides = Array.from(gallery.querySelectorAll('[data-lfqb-slide]'));
      const thumbs = Array.from(gallery.querySelectorAll('[data-lfqb-thumb]'));
      let activeIndex = slides.findIndex(function (slide) {
        return slide.classList.contains('is-active');
      });
      if (activeIndex < 0) activeIndex = 0;

      function showSlide(index) {
        if (!slides.length) return;
        activeIndex = (index + slides.length) % slides.length;
        slides.forEach(function (slide, i) {
          slide.classList.toggle('is-active', i === activeIndex);
        });
        thumbs.forEach(function (thumb, i) {
          thumb.classList.toggle('is-active', i === activeIndex);
        });
      }

      const prev = gallery.querySelector('[data-lfqb-prev]');
      const next = gallery.querySelector('[data-lfqb-next]');
      if (prev) prev.addEventListener('click', function () { showSlide(activeIndex - 1); });
      if (next) next.addEventListener('click', function () { showSlide(activeIndex + 1); });
      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          showSlide(Number(thumb.dataset.index || 0));
        });
      });
    }

    const modal = section.querySelector('[data-lfqb-ingredients-modal]');
    const openBtn = section.querySelector('[data-lfqb-open-ingredients]');
    const closeBtn = section.querySelector('[data-lfqb-close-ingredients]');
    if (modal && openBtn) {
      openBtn.addEventListener('click', function () {
        if (typeof modal.showModal === 'function') modal.showModal();
      });
    }
    if (modal && closeBtn) {
      closeBtn.addEventListener('click', function () {
        modal.close();
      });
    }
    if (modal) {
      modal.addEventListener('click', function (event) {
        if (event.target === modal) modal.close();
      });
    }
  })();
</script>

