{% comment %}
  Header menu drawer settings + panel markup.
  The hamburger trigger lives in Header; this section injects drawer content into it.
{% endcomment %}

{% style %}
  .header-menu-section {
    display: none !important;
  }
{% endstyle %}

<div id="header-menu-drawer-source" hidden>
  {% render 'header-drawer', menu_section: section, part: 'panel' %}
</div>

<script>
  (function () {
    function forceCloseDrawer() {
      var headerDrawer = document.querySelector('header-drawer');
      var details = document.getElementById('Details-menu-drawer-container');
      if (!details) return;

      var summary = details.querySelector('summary');
      var header = document.querySelector('.section-header');

      details.classList.remove('menu-opening');
      details.removeAttribute('open');

      if (summary) {
        summary.setAttribute('aria-expanded', 'false');
      }

      if (header) header.classList.remove('menu-open');
      document.body.classList.remove('overflow-hidden-desktop', 'overflow-hidden-tablet');

      if (headerDrawer && typeof removeTrapFocus === 'function') {
        removeTrapFocus(summary);
      }
    }

    function forceOpenState() {
      var details = document.getElementById('Details-menu-drawer-container');
      if (!details || !details.hasAttribute('open')) return;

      var summary = details.querySelector('summary');
      var header = document.querySelector('.section-header');

      details.classList.add('menu-opening');
      if (summary) summary.setAttribute('aria-expanded', 'true');
      if (header) header.classList.add('menu-open');
    }

    function bindDrawerInteractions() {
      var headerDrawer = document.querySelector('header-drawer');
      var details = document.getElementById('Details-menu-drawer-container');
      if (!headerDrawer || !details) return;

      var summary = details.querySelector('summary');

      headerDrawer.querySelectorAll('.menu-drawer__close-menu-btn').forEach(function (button) {
        if (button.dataset.drawerCloseBound === 'true') return;
        button.dataset.drawerCloseBound = 'true';

        button.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          forceCloseDrawer();
        });
      });

      if (details.dataset.drawerToggleBound === 'true') return;
      details.dataset.drawerToggleBound = 'true';

      // Theme close via overlay/summary leaves aria-expanded=true; force full cleanup.
      if (!headerDrawer.dataset.closePatched) {
        headerDrawer.dataset.closePatched = 'true';
        var originalClose = headerDrawer.closeMenuDrawer.bind(headerDrawer);
        headerDrawer.closeMenuDrawer = function (event, element) {
          if (event !== undefined) {
            originalClose(event, element);
          }
          forceCloseDrawer();
        };
      }

      // Overlay clicks can re-open <details> after theme JS removes open/menu-opening.
      // Capture phase + stopImmediatePropagation matches the close-button path.
      if (summary && summary.dataset.drawerOverlayBound !== 'true') {
        summary.dataset.drawerOverlayBound = 'true';
        summary.addEventListener(
          'click',
          function (event) {
            if (!details.hasAttribute('open')) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            forceCloseDrawer();
          },
          true
        );
      }

      details.addEventListener('toggle', function () {
        if (details.hasAttribute('open')) {
          forceOpenState();
        } else {
          forceCloseDrawer();
        }
      });
    }

    function mountHeaderMenuDrawerPanel() {
      var details = document.getElementById('Details-menu-drawer-container');
      var source = document.getElementById('header-menu-drawer-source');
      if (!details || !source) return;

      var existingPanel = details.querySelector('#menu-drawer');
      if (existingPanel) existingPanel.remove();

      var panel = source.querySelector('#menu-drawer');
      if (!panel) return;

      details.appendChild(panel);

      var logoLink = details.dataset.logoLink;
      var logo = panel.querySelector('[data-drawer-logo-link]');
      if (logoLink && logo) logo.href = logoLink;

      bindDrawerInteractions();

      if (!details.hasAttribute('open')) {
        forceCloseDrawer();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mountHeaderMenuDrawerPanel);
    } else {
      mountHeaderMenuDrawerPanel();
    }

    document.addEventListener('shopify:section:load', mountHeaderMenuDrawerPanel);
  })();
</script>

