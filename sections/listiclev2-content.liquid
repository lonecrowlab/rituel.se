<section
  class="listiclev2-content section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  {% if section.settings.section_id != blank %}id="{{ section.settings.section_id }}"{% endif %}
>
  <div class="page-width lv2co-wrap">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'heading' %}
          {% if block.settings.title != blank %}
            <div
              class="lv2co-heading{% if block.settings.heading_style == 'bar' or block.settings.heading_style == 'bar_left' %} lv2co-heading--bar-left{% endif %}{% if block.settings.heading_style == 'bar' or block.settings.heading_style == 'underline' %} lv2co-heading--bar-underline{% endif %} lv2co-block-{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <div class="lv2co-heading__text rte">{{ block.settings.title }}</div>
            </div>
          {% endif %}

        {% when 'text' %}
          {% if block.settings.content != blank %}
            <div class="lv2co-text rte lv2co-block-{{ block.id }}" {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </div>
          {% endif %}

        {% when 'image' %}
          {% if block.settings.image != blank %}
            <div class="lv2co-image lv2co-block-{{ block.id }} lv2co-image--{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
              {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'lv2co-image__img', alt: block.settings.image.alt }}
            </div>
          {% endif %}

        {% when 'icon_text' %}
          {% if block.settings.text != blank %}
            <div class="lv2co-icon-row lv2co-block-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="lv2co-icon-row__icon">
                {% if block.settings.icon_image != blank %}
                  {{ block.settings.icon_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'lv2co-icon-row__img', alt: '' }}
                {% elsif block.settings.icon_name != blank %}
                  <span class="lv2co-icon-row__svg">
                    {% render 'icons', icon: block.settings.icon_name %}
                  </span>
                {% endif %}
              </div>
              <div class="lv2co-icon-row__text rte">{{ block.settings.text }}</div>
            </div>
          {% endif %}
      {% endcase %}
    {% endfor %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .section-{{ section.id }} .lv2co-wrap {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    width: 100%;
    text-align: {{ section.settings.text_align }};
  }

  .section-{{ section.id }} .lv2co-heading {
    position: relative;
    display: inline-block;

    margin: {{ section.settings.heading_margin_bottom_mobile }}px 0;
    text-align: {{ section.settings.text_align }};
  }

  .section-{{ section.id }} .lv2co-heading__text {
    padding-left: {{ section.settings.heading_padding_left }}px;
    padding-bottom: {{ section.settings.heading_padding_bottom }}px;
    position: relative;
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    color: {{ section.settings.heading_color }};
    line-height: 1.3;
    font-weight: {{ section.settings.heading_font_weight }};
  }

  .section-{{ section.id }} .lv2co-heading__text p {
    margin: 0;
  }

  .section-{{ section.id }} .lv2co-heading--bar-left .lv2co-heading__text::before {
    content: "";
    position: absolute;
    width: {{ section.settings.border_left_width }}px;
    height: {{ section.settings.border_left_height }}px;
    background: {{ section.settings.border_color }};
    top: {{ section.settings.border_left_top }}px;
    left: 0;
  }

  .section-{{ section.id }} .lv2co-heading--bar-underline .lv2co-heading__text::after {
    content: "";
    position: absolute;
    border-bottom: {{ section.settings.border_bottom_width }}px solid {{ section.settings.border_color }};
    width: {{ section.settings.border_bottom_width_pct }}%;
    left: 0;
    bottom: 0;
  }

  .section-{{ section.id }} .lv2co-text {
    font-size: {{ section.settings.text_font_size_mobile }}px;
    color: {{ section.settings.text_color }};
    line-height: {{ section.settings.text_line_height }};
    font-weight: {{ section.settings.text_font_weight }};
    margin-bottom: {{ section.settings.block_gap_mobile }}px;
  }

  .section-{{ section.id }} .lv2co-text p {
    margin: 0 0 1em;
  }

  .section-{{ section.id }} .lv2co-text p:last-child {
    margin-bottom: 0;
  }

  .section-{{ section.id }} .lv2co-text ol,
  .section-{{ section.id }} .lv2co-text ul {
    margin: 0 0 1em;
    padding-left: 1.25em;
  }

  {% for block in section.blocks %}
    .section-{{ section.id }} .lv2co-block-{{ block.id }} {
      box-sizing: border-box;
      padding-top: {{ block.settings.block_padding_top }}px;
      padding-bottom: {{ block.settings.block_padding_bottom }}px;
      padding-left: {{ block.settings.block_padding_left }}px;
      padding-right: {{ block.settings.block_padding_right }}px;
      border-top: {{ block.settings.block_border_top | default: 0 }}px {{ block.settings.block_border_style | default: 'solid' }} {{ block.settings.block_border_color | default: '#000000' }};
      border-right: {{ block.settings.block_border_right | default: 0 }}px {{ block.settings.block_border_style | default: 'solid' }} {{ block.settings.block_border_color | default: '#000000' }};
      border-bottom: {{ block.settings.block_border_bottom | default: 0 }}px {{ block.settings.block_border_style | default: 'solid' }} {{ block.settings.block_border_color | default: '#000000' }};
      border-left: {{ block.settings.block_border_left | default: 0 }}px {{ block.settings.block_border_style | default: 'solid' }} {{ block.settings.block_border_color | default: '#000000' }};
    }

    {% if block.settings.custom_css != blank %}
      .section-{{ section.id }} .lv2co-block-{{ block.id }} {
        {{ block.settings.custom_css }}
      }
    {% endif %}

    {% if block.type == 'image' %}
      .section-{{ section.id }} .lv2co-block-{{ block.id }} {
        margin-top: {{ block.settings.margin_top }}px;
        margin-bottom: {{ block.settings.margin_bottom }}px;
      }
      .section-{{ section.id }} .lv2co-block-{{ block.id }} .lv2co-image__img {
        max-width: {{ block.settings.image_max_width }}px;
        width: 100%;
        height: auto;
        border-radius: {{ block.settings.border_radius }}px;
        display: inline-block;
      }
      .section-{{ section.id }} .lv2co-image--left.lv2co-block-{{ block.id }} {
        text-align: left;
      }
      .section-{{ section.id }} .lv2co-image--center.lv2co-block-{{ block.id }} {
        text-align: center;
      }
      .section-{{ section.id }} .lv2co-image--right.lv2co-block-{{ block.id }} {
        text-align: right;
      }
    {% endif %}

    {% if block.type == 'icon_text' %}
      .section-{{ section.id }} .lv2co-block-{{ block.id }} {
        display: flex;
        align-items: flex-start;
        gap: {{ block.settings.gap }}px;
        padding-top: {{ block.settings.block_padding_top | plus: block.settings.padding_vertical }}px;
        padding-bottom: {{ block.settings.block_padding_bottom | plus: block.settings.padding_vertical }}px;
        padding-left: {{ block.settings.block_padding_left | plus: block.settings.padding_horizontal }}px;
        padding-right: {{ block.settings.block_padding_right | plus: block.settings.padding_horizontal }}px;
        margin-bottom: {{ block.settings.margin_bottom }}px;
      }
      .section-{{ section.id }} .lv2co-block-{{ block.id }} .lv2co-icon-row__icon {
        flex-shrink: 0;
        width: {{ block.settings.icon_size_mobile }}px;
        height: {{ block.settings.icon_size_mobile }}px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: {{ block.settings.icon_bg_color }};
        border-radius: {{ block.settings.icon_radius }}px;
        color: {{ block.settings.icon_color }};
        padding: {{ block.settings.icon_padding }}px;
      }
      .section-{{ section.id }} .lv2co-block-{{ block.id }} .lv2co-icon-row__svg {
        width: 100%;
        height: 100%;
        display: block;
      }
      .section-{{ section.id }} .lv2co-block-{{ block.id }} .lv2co-icon-row__svg svg {
        width: 100%;
        height: 100%;
        display: block;
        fill: currentColor;
        stroke: currentColor;
      }
      .section-{{ section.id }} .lv2co-block-{{ block.id }} .lv2co-icon-row__img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }
      .section-{{ section.id }} .lv2co-block-{{ block.id }} .lv2co-icon-row__text {
        font-size: {{ block.settings.text_font_size_mobile }}px;
        color: {{ block.settings.text_color }};
        line-height: 1.5;
        flex: 1;
        text-align: left;
      }
      .section-{{ section.id }} .lv2co-block-{{ block.id }} .lv2co-icon-row__text p {
        margin: 0;
      }
    {% endif %}
  {% endfor %}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .section-{{ section.id }} .lv2co-heading {
      margin-bottom: {{ section.settings.heading_margin_bottom_desktop }}px;
    }

    .section-{{ section.id }} .lv2co-heading__text {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2co-text {
      font-size: {{ section.settings.text_font_size_desktop }}px;
      margin-bottom: {{ section.settings.block_gap_desktop }}px;
    }

    {% for block in section.blocks %}
      {% if block.type == 'icon_text' %}
        .section-{{ section.id }} .lv2co-block-{{ block.id }} .lv2co-icon-row__icon {
          width: {{ block.settings.icon_size_desktop }}px;
          height: {{ block.settings.icon_size_desktop }}px;
        }
        .section-{{ section.id }} .lv2co-block-{{ block.id }} .lv2co-icon-row__text {
          font-size: {{ block.settings.text_font_size_desktop }}px;
        }
      {% endif %}
    {% endfor %}
  }
</style>

{% schema %}
{
  "name": "Listiclev2 Content",
  "tag": "section",
  "class": "section-listiclev2-content",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section anchor ID"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Heading defaults"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 22
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "heading_padding_left",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading left padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_padding_bottom",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading margin bottom (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_desktop",
