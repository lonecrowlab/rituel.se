      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_left_width",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "Left bar width",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_left_height",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Left bar height",
      "default": 22
    },
    {
      "type": "range",
      "id": "border_left_top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Left bar top offset",
      "default": 0
    },
    {
      "type": "range",
