<section class="listiclev2-compare section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width lv2p-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="lv2p-heading{% if section.settings.heading_style == 'bar' %} lv2p-heading--bar{% endif %}">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.intro != blank %}
      <div class="lv2p-intro rte">{{ section.settings.intro }}</div>
    {% endif %}

    {% assign compare_rows = section.blocks | where: 'type', 'compare_row' %}
    {% if compare_rows.size > 0 %}
      <div class="lv2p-table">
        <div class="lv2p-table__head">
          <div class="lv2p-table__cell lv2p-table__cell--label"></div>
          <div class="lv2p-table__cell lv2p-table__cell--featured">{{ section.settings.us_label }}</div>
          <div class="lv2p-table__cell lv2p-table__cell--them">{{ section.settings.them_label }}</div>
        </div>
        {% for block in compare_rows %}
          {% assign row_stripe = forloop.index0 | modulo: 2 %}
          <div class="lv2p-table__row lv2p-row-{{ block.id }}{% if row_stripe == 0 %} lv2p-table__row--stripe{% endif %}" {{ block.shopify_attributes }}>
            <div class="lv2p-table__cell lv2p-table__cell--label">{{ block.settings.feature_label }}</div>
            <div class="lv2p-table__cell lv2p-table__cell--featured">
              {% if block.settings.us_icon_name != blank and block.settings.us_icon_name != 'none' %}
                <span class="lv2p-table__icon-badge lv2p-table__icon-badge--us">
                  {% render 'icons', icon: block.settings.us_icon_name %}
                </span>
              {% endif %}
              {% if block.settings.us_value != blank %}
                <span class="lv2p-table__value">{{ block.settings.us_value }}</span>
              {% endif %}
            </div>
            <div class="lv2p-table__cell lv2p-table__cell--them">
              {% if block.settings.them_icon_name == 'dash' %}
                <span class="lv2p-table__dash">—</span>
              {% elsif block.settings.them_icon_name != blank and block.settings.them_icon_name != 'none' %}
                <span class="lv2p-table__icon-badge lv2p-table__icon-badge--them">
                  {% render 'icons', icon: block.settings.them_icon_name %}
                </span>
              {% endif %}
              {% if block.settings.them_value != blank %}
                <span class="lv2p-table__value">{{ block.settings.them_value }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% assign bullets = section.blocks | where: 'type', 'bullet' %}
    {% if bullets.size > 0 %}
      <ul class="lv2p-bullets">
        {% for block in bullets %}
          <li class="lv2p-bullet" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .section-{{ section.id }} .lv2p-wrap {
    max-width: {{ section.settings.container_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .section-{{ section.id }} .lv2p-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  .section-{{ section.id }} .lv2p-heading--bar {
    position: relative;
    display: inline-block;
    padding-left: 14px;
  }

  .section-{{ section.id }} .lv2p-heading--bar:before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.15em;
    width: 4px;
    height: 1em;
    background: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .lv2p-intro {
    font-size: {{ section.settings.intro_font_size_mobile }}px;
    color: {{ section.settings.intro_color }};
    text-align: {{ section.settings.text_align }};
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .section-{{ section.id }} .lv2p-table {
    margin-bottom: 20px;
  }

  .section-{{ section.id }} .lv2p-table__head,
  .section-{{ section.id }} .lv2p-table__row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    align-items: center;
  }

  .section-{{ section.id }} .lv2p-table__row--stripe {
    background: {{ section.settings.row_stripe_bg }};
    border-radius: {{ section.settings.row_stripe_radius }}px;
  }

  .section-{{ section.id }} .lv2p-table__cell {
    padding: {{ section.settings.row_padding_vertical }}px {{ section.settings.row_padding_horizontal }}px;
    font-size: {{ section.settings.cell_font_size_mobile }}px;
    line-height: 1.45;
    min-height: {{ section.settings.row_min_height }}px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-{{ section.id }} .lv2p-table__cell--label {
    justify-content: flex-start;
    text-align: left;
    font-weight: {{ section.settings.feature_font_weight }};
    color: {{ section.settings.feature_color }};
  }

  .section-{{ section.id }} .lv2p-table__cell--featured,
  .section-{{ section.id }} .lv2p-table__cell--them {
    justify-content: center;
    text-align: center;
  }

  .section-{{ section.id }} .lv2p-table__cell--featured {
    border-left: {{ section.settings.featured_column_border_width }}px solid {{ section.settings.featured_column_border_color }};
    border-right: {{ section.settings.featured_column_border_width }}px solid {{ section.settings.featured_column_border_color }};
  }

  .section-{{ section.id }} .lv2p-table__head .lv2p-table__cell {
    font-weight: 600;
    font-size: {{ section.settings.header_font_size_mobile }}px;
    color: {{ section.settings.header_color }};
    padding-bottom: {{ section.settings.header_padding_bottom }}px;
  }

  .section-{{ section.id }} .lv2p-table__head .lv2p-table__cell--featured {
    font-weight: 700;
  }

  .section-{{ section.id }} .lv2p-table__head .lv2p-table__cell--them {
    font-weight: 400;
    color: {{ section.settings.them_header_color }};
  }

  .section-{{ section.id }} .lv2p-table__icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: {{ section.settings.icon_badge_size }}px;
    height: {{ section.settings.icon_badge_size }}px;
    border-radius: 50%;
  }

  .section-{{ section.id }} .lv2p-table__icon-badge svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: block;
    fill: currentColor;
    stroke: currentColor;
  }

  .section-{{ section.id }} .lv2p-table__icon-badge--us {
    background: {{ section.settings.us_icon_bg_color }};
    color: {{ section.settings.us_icon_color }};
  }

  .section-{{ section.id }} .lv2p-table__icon-badge--them {
    background: {{ section.settings.them_icon_bg_color }};
    color: {{ section.settings.them_icon_color }};
  }

  {% for block in section.blocks %}
    {% if block.type == 'compare_row' %}
      .section-{{ section.id }} .lv2p-row-{{ block.id }} .lv2p-table__icon-badge--us {
        {% if block.settings.us_icon_bg_color != blank %}background: {{ block.settings.us_icon_bg_color }};{% endif %}
        {% if block.settings.us_icon_color != blank %}color: {{ block.settings.us_icon_color }};{% endif %}
      }
      .section-{{ section.id }} .lv2p-row-{{ block.id }} .lv2p-table__icon-badge--them {
        {% if block.settings.them_icon_bg_color != blank %}background: {{ block.settings.them_icon_bg_color }};{% endif %}
        {% if block.settings.them_icon_color != blank %}color: {{ block.settings.them_icon_color }};{% endif %}
      }
    {% endif %}
  {% endfor %}

  .section-{{ section.id }} .lv2p-table__dash {
    display: inline-block;
    font-size: {{ section.settings.dash_font_size }}px;
    line-height: 1;
    color: {{ section.settings.dash_color }};
    font-weight: 300;
  }

  .section-{{ section.id }} .lv2p-table__value {
    font-size: 0.92em;
  }

  .section-{{ section.id }} .lv2p-bullets {
    margin: 0;
    padding-left: 1.25em;
    font-size: {{ section.settings.bullet_font_size_mobile }}px;
    line-height: 1.6;
    color: {{ section.settings.bullet_color }};
  }

  .section-{{ section.id }} .lv2p-bullet {
    margin-bottom: 8px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .section-{{ section.id }} .lv2p-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2p-intro {
      font-size: {{ section.settings.intro_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2p-table__cell {
      font-size: {{ section.settings.cell_font_size_desktop }}px;
      padding: {{ section.settings.row_padding_vertical_desktop }}px {{ section.settings.row_padding_horizontal_desktop }}px;
    }

    .section-{{ section.id }} .lv2p-table__head .lv2p-table__cell {
      font-size: {{ section.settings.header_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2p-bullets {
      font-size: {{ section.settings.bullet_font_size_desktop }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .lv2p-table__cell {
      gap: 4px;
    }

    .section-{{ section.id }} .lv2p-table__cell--label {
      padding-right: 4px;
    }

    .section-{{ section.id }} .lv2p-table__value {
      font-size: 0.85em;
    }
  }
</style>

{% schema %}
{
  "name": "Listiclev2 Compare",
  "tag": "section",
  "class": "section-listiclev2-compare",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "bar", "label": "Left bar" }
      ],
      "default": "plain"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "us_label",
      "label": "Featured column label",
      "default": "RITÚEL"
    },
    {
      "type": "text",
      "id": "them_label",
      "label": "Comparison column label",
      "default": "Most brands"
    },
    {
      "type": "header",
      "content": "Table style"
    },
    {
      "type": "color",
      "id": "featured_column_border_color",
      "label": "Featured column border color",
      "default": "#e6e6e6"
    },
    {
      "type": "range",
      "id": "featured_column_border_width",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "label": "Featured column border width",
      "default": 1
    },
    {
      "type": "color",
      "id": "row_stripe_bg",
      "label": "Alternating row background",
      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "row_stripe_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Row border radius",
      "default": 50,
      "info": "Pill shape on alternating rows"
    },
    {
      "type": "range",
      "id": "row_min_height",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Row min height",
      "default": 52
    },
    {
      "type": "range",
      "id": "row_padding_vertical",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Row padding vertical (mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "row_padding_horizontal",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Row padding horizontal (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "row_padding_vertical_desktop",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Row padding vertical (desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "row_padding_horizontal_desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Row padding horizontal (desktop)",
      "default": 20
    },
    {
      "type": "header",
      "content": "Icon badges (defaults)"
    },
    {
      "type": "range",
      "id": "icon_badge_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Badge size",
      "default": 28
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Icon size inside badge",
      "default": 14
    },
    {
      "type": "color",
      "id": "us_icon_bg_color",
      "label": "Featured icon background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "us_icon_color",
      "label": "Featured icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "them_icon_bg_color",
      "label": "Comparison icon background",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "them_icon_color",
      "label": "Comparison icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dash_color",
      "label": "Dash color",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "dash_font_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Dash size",
      "default": 22
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading (mobile)",
      "default": 22
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading (desktop)",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "intro_font_size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Intro (mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "intro_font_size_desktop",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Intro (desktop)",
      "default": 16
    },
    {
      "type": "color",
      "id": "intro_color",
      "label": "Intro color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "header_font_size_mobile",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Table header (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "header_font_size_desktop",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Table header (desktop)",
      "default": 15
    },
    {
      "type": "color",
      "id": "header_color",
      "label": "Featured header color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "them_header_color",
      "label": "Comparison header color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "header_padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Header padding bottom",
      "default": 16
    },
    {
      "type": "select",
      "id": "feature_font_weight",
      "label": "Feature label weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "feature_color",
      "label": "Feature label color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "cell_font_size_mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Cell text (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "cell_font_size_desktop",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Cell text (desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "bullet_font_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Bullet (mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "bullet_font_size_desktop",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Bullet (desktop)",
      "default": 15
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Bullet color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Container max width",
      "default": 750,
      "info": "Content container width. Section background stays full width."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "compare_row",
      "name": "Compare row",
      "settings": [
        {
          "type": "text",
          "id": "feature_label",
          "label": "Feature label",
          "default": "Deep penetration"
        },
        {
          "type": "header",
          "content": "Featured column"
        },
        {
          "type": "select",
          "id": "us_icon_name",
          "label": "Icon",
          "options": [
            { "value": "checkmark_icon", "label": "Checkmark" },
            { "value": "guarantee_icon", "label": "Guarantee" },
            { "value": "star__icon", "label": "Star" },
            { "value": "shield_icon", "label": "Shield" },
            { "value": "lightning_icon", "label": "Lightning" },
            { "value": "heart_icon", "label": "Heart" },
            { "value": "side_wreath", "label": "Side wreath" },
            { "value": "custom_hero_rating", "label": "Rating star" },
            { "value": "none", "label": "None" }
          ],
          "default": "checkmark_icon"
        },
        {
          "type": "color",
          "id": "us_icon_bg_color",
          "label": "Icon background override"
        },
        {
          "type": "color",
          "id": "us_icon_color",
          "label": "Icon color override"
        },
        {
          "type": "text",
          "id": "us_value",
          "label": "Optional text value"
        },
        {
          "type": "header",
          "content": "Comparison column"
        },
        {
          "type": "select",
          "id": "them_icon_name",
          "label": "Icon",
          "options": [
            { "value": "dash", "label": "Dash (—)" },
            { "value": "none", "label": "None" },
            { "value": "checkmark_icon", "label": "Checkmark" },
            { "value": "guarantee_icon", "label": "Guarantee" },
            { "value": "star__icon", "label": "Star" },
            { "value": "shield_icon", "label": "Shield" },
            { "value": "lightning_icon", "label": "Lightning" },
            { "value": "heart_icon", "label": "Heart" },
            { "value": "side_wreath", "label": "Side wreath" },
            { "value": "custom_hero_rating", "label": "Rating star" }
          ],
          "default": "dash"
        },
        {
          "type": "color",
          "id": "them_icon_bg_color",
          "label": "Icon background override"
        },
        {
          "type": "color",
          "id": "them_icon_color",
          "label": "Icon color override"
        },
        {
          "type": "text",
          "id": "them_value",
          "label": "Optional text value"
        }
      ]
    },
    {
      "type": "bullet",
      "name": "Bullet point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Deep penetration into the skin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Listiclev2 Compare"
    }
  ]
}
{% endschema %}
