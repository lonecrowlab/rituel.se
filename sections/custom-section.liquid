{%- liquid
  assign bg_desktop = section.settings.background_desktop
  assign bg_mobile = section.settings.background_mobile
  if bg_mobile == blank
    assign bg_mobile = bg_desktop
  endif
-%}

<section
  class="custom-section section-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="cs__bg" aria-hidden="true">
    {%- if bg_desktop != blank -%}
      {{ bg_desktop | image_url: width: 2400 | image_tag: class: 'cs__bg-img cs__bg-img--desktop', loading: 'lazy', widths: '800,1200,1600,2000,2400', sizes: '100vw', alt: '' }}
    {%- endif -%}
    {%- if bg_mobile != blank -%}
      {{ bg_mobile | image_url: width: 1200 | image_tag: class: 'cs__bg-img cs__bg-img--mobile', loading: 'lazy', widths: '400,600,800,1000,1200', sizes: '100vw', alt: '' }}
    {%- endif -%}
  </div>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="cs__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="cs__inner">
    <div class="cs__wrap">
      <div class="cs__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign visibility = block.settings.visibility | default: 'all'
            assign device_class = 'cs-device-' | append: visibility
            assign block_alignment = block.settings.alignment | default: 'center'
            assign align_class = 'cs-align-' | append: block_alignment
            assign width_desktop = block.settings.width_desktop | default: 'full'
            assign width_mobile = block.settings.width_mobile | default: 'full'
          -%}

          {%- case block.type -%}
            {%- when 'heading' -%}
              <div
                id="shopify-block-{{ block.id }}"
                class="cs__item cs__item--heading cs__item--width-{{ width_desktop }} cs__item--width-mobile-{{ width_mobile }} cs-block-{{ block.id }} {{ device_class }} {{ align_class }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.text != blank -%}
                  <{{ block.settings.heading_tag | default: 'h2' }} class="cs__heading">
                    <span class="cs__heading-text rte">{{ block.settings.text }}</span>
                  </{{ block.settings.heading_tag | default: 'h2' }}>
                {%- endif -%}
              </div>

            {%- when 'text' -%}
              <div
                id="shopify-block-{{ block.id }}"
                class="cs__item cs__item--text cs__item--width-{{ width_desktop }} cs__item--width-mobile-{{ width_mobile }} cs-block-{{ block.id }} {{ device_class }} {{ align_class }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.title != blank -%}
                  <div class="cs__text-title">{{ block.settings.title }}</div>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="cs__text-description rte">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>

            {%- when 'image_with_text' -%}
              {%- liquid
                assign iwt_layout = block.settings.layout | default: 'image_top'
                assign iwt_alt = block.settings.image_alt
                if block.settings.image != blank and block.settings.image.alt != blank
                  assign iwt_alt = block.settings.image.alt
                endif
              -%}
              <div
                id="shopify-block-{{ block.id }}"
                class="cs__item cs__item--iwt cs__item--width-{{ width_desktop }} cs__item--width-mobile-{{ width_mobile }} cs-iwt cs-iwt--{{ iwt_layout }} cs-block-{{ block.id }} {{ device_class }} {{ align_class }}"
                {{ block.shopify_attributes }}
              >
                <div class="cs-iwt__inner">
                  <div class="cs-iwt__media{% if block.settings.image_circle %} cs-iwt__media--circle{% endif %}">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'cs-iwt__image', alt: iwt_alt }}
                    {%- else -%}
                      <div class="cs-iwt__placeholder">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="cs-iwt__content">
                    {%- if block.settings.title != blank -%}
                      <div class="cs-iwt__title">{{ block.settings.title }}</div>
                    {%- endif -%}
                    {%- if block.settings.description != blank -%}
                      <div class="cs-iwt__description rte">{{ block.settings.description }}</div>
                    {%- endif -%}
                  </div>
                </div>
              </div>

            {%- when 'image' -%}
              <div
                id="shopify-block-{{ block.id }}"
                class="cs__item cs__item--image cs__item--width-{{ width_desktop }} cs__item--width-mobile-{{ width_mobile }} cs-block-{{ block.id }} {{ device_class }} {{ align_class }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign img_alt = block.settings.image_alt
                    if block.settings.image.alt != blank
                      assign img_alt = block.settings.image.alt
                    endif
                  -%}
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="cs__image-link">
                      {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'cs__image', alt: img_alt }}
                    </a>
                  {%- else -%}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'cs__image', alt: img_alt }}
                  {%- endif -%}
                {%- else -%}
                  <div class="cs__image-placeholder">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  {% if section.settings.heading_font != blank %}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.body_font != blank %}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {% endif %}

  {% for block in section.blocks %}
    {% if block.type == 'heading' and block.settings.font != blank %}
      {{ block.settings.font | font_face: font_display: 'swap' }}
    {% endif %}
    {% if block.type == 'text' %}
      {% if block.settings.title_font != blank %}
        {{ block.settings.title_font | font_face: font_display: 'swap' }}
      {% endif %}
      {% if block.settings.description_font != blank %}
        {{ block.settings.description_font | font_face: font_display: 'swap' }}
      {% endif %}
    {% endif %}
    {% if block.type == 'image_with_text' %}
      {% if block.settings.title_font != blank %}
        {{ block.settings.title_font | font_face: font_display: 'swap' }}
      {% endif %}
      {% if block.settings.description_font != blank %}
        {{ block.settings.description_font | font_face: font_display: 'swap' }}
      {% endif %}
    {% endif %}
  {% endfor %}

  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
  }

  .section-{{ section.id }} {
    position: relative;
    overflow: hidden;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .cs__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    {% if section.settings.gradient_enabled %}
      background: {{ section.settings.gradient_background }};
    {% else %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  .section-{{ section.id }} .cs__bg-img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.background_fit }};
    object-position: {{ section.settings.background_position }};
    display: block;
  }

  .section-{{ section.id }} .cs__bg-img--desktop {
    display: none;
  }

  .section-{{ section.id }} .cs__bg-img--mobile {
    display: block;
  }

  .section-{{ section.id }} .cs__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .section-{{ section.id }} .cs__inner {
    position: relative;
    z-index: 2;
    padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_right_mobile }}px {{ section.settings.padding_bottom_mobile }}px {{ section.settings.padding_left_mobile }}px;
  }

  .section-{{ section.id }} .cs__wrap {
    max-width: {{ section.settings.content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .section-{{ section.id }} .cs__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: {{ section.settings.row_alignment }};
    gap: {{ section.settings.block_gap_mobile }}px;
    --cs-gap: {{ section.settings.block_gap_mobile }}px;
  }

  .section-{{ section.id }} .cs__item {
    min-width: 0;
    box-sizing: border-box;
  }

  .section-{{ section.id }} .cs__item--width-mobile-full { flex: 0 0 100%; width: 100%; }
  .section-{{ section.id }} .cs__item--width-mobile-half { flex: 0 0 calc((100% - var(--cs-gap) * 1) / 2); width: calc((100% - var(--cs-gap) * 1) / 2); }
  .section-{{ section.id }} .cs__item--width-mobile-third { flex: 0 0 calc((100% - var(--cs-gap) * 2) / 3); width: calc((100% - var(--cs-gap) * 2) / 3); }
  .section-{{ section.id }} .cs__item--width-mobile-quarter { flex: 0 0 calc((100% - var(--cs-gap) * 3) / 4); width: calc((100% - var(--cs-gap) * 3) / 4); }
  .section-{{ section.id }} .cs__item--width-mobile-fifth { flex: 0 0 calc((100% - var(--cs-gap) * 4) / 5); width: calc((100% - var(--cs-gap) * 4) / 5); }
  .section-{{ section.id }} .cs__item--width-mobile-sixth { flex: 0 0 calc((100% - var(--cs-gap) * 5) / 6); width: calc((100% - var(--cs-gap) * 5) / 6); }
  .section-{{ section.id }} .cs__item--width-mobile-seventh { flex: 0 0 calc((100% - var(--cs-gap) * 6) / 7); width: calc((100% - var(--cs-gap) * 6) / 7); }
  .section-{{ section.id }} .cs__item--width-mobile-auto { flex: 1 1 auto; width: auto; min-width: 0; }

  .section-{{ section.id }} .cs-align-left { text-align: left; }
  .section-{{ section.id }} .cs-align-center { text-align: center; }
  .section-{{ section.id }} .cs-align-right { text-align: right; }

  .section-{{ section.id }} .cs__item--image {
    display: flex;
  }

  .section-{{ section.id }} .cs-align-left.cs__item--image { justify-content: flex-start; }
  .section-{{ section.id }} .cs-align-center.cs__item--image { justify-content: center; }
  .section-{{ section.id }} .cs-align-right.cs__item--image { justify-content: flex-end; }

  .section-{{ section.id }} .cs-align-left .cs-iwt__inner { align-items: flex-start; }
  .section-{{ section.id }} .cs-align-center .cs-iwt__inner { align-items: center; }
  .section-{{ section.id }} .cs-align-right .cs-iwt__inner { align-items: flex-end; }

  .section-{{ section.id }} .cs-device-desktop { display: none; }
  .section-{{ section.id }} .cs-device-mobile { display: block; }
  .section-{{ section.id }} .cs-device-all { display: block; }
  .section-{{ section.id }} .cs-device-all.cs__item--iwt,
  .section-{{ section.id }} .cs-device-mobile.cs__item--iwt { display: flex; }

  .section-{{ section.id }} .cs__heading {
    margin: 0;
    line-height: 1.2;
    {% if section.settings.heading_font != blank %}
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    {% endif %}
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .cs__heading-text p {
    margin: 0;
  }

  .section-{{ section.id }} .cs-iwt__inner {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .section-{{ section.id }} .cs-iwt--image_left .cs-iwt__inner { flex-direction: row; }
  .section-{{ section.id }} .cs-iwt--image_right .cs-iwt__inner { flex-direction: row-reverse; }
  .section-{{ section.id }} .cs-iwt--image_top .cs-iwt__inner { flex-direction: column; }
  .section-{{ section.id }} .cs-iwt--image_bottom .cs-iwt__inner { flex-direction: column-reverse; }

  .section-{{ section.id }} .cs-iwt__media {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .section-{{ section.id }} .cs-iwt__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .section-{{ section.id }} .cs-iwt__image {
    display: block;
    width: 100%;
    height: 100%;
    padding:15px;
    object-fit: contain;
  }

  .section-{{ section.id }} .cs-iwt__placeholder,
  .section-{{ section.id }} .cs__image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.04);
    width: 100%;
    height: 100%;
    min-height: 80px;
  }

  .section-{{ section.id }} .cs-iwt__placeholder svg,
  .section-{{ section.id }} .cs__image-placeholder svg {
    width: 50%;
    opacity: 0.35;
  }

  .section-{{ section.id }} .cs-iwt__description p,
  .section-{{ section.id }} .cs__text-description p {
    margin: 0;
  }

  .section-{{ section.id }} .cs-iwt__description p + p,
  .section-{{ section.id }} .cs__text-description p + p {
    margin-top: 0.5em;
  }

  .section-{{ section.id }} .cs__image-link {
    display: inline-block;
    line-height: 0;
  }

  .section-{{ section.id }} .cs__image {
    display: block;
    max-width: 100%;
    height: auto;
  }

  {% for block in section.blocks %}
    .section-{{ section.id }} .cs-block-{{ block.id }} {
      {% if block.settings.margin_top_mobile > 0 %}
        margin-top: {{ block.settings.margin_top_mobile }}px;
      {% endif %}
      {% if block.settings.margin_bottom_mobile > 0 %}
        margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
      {% endif %}
    }

    {% if block.type == 'heading' %}
      .section-{{ section.id }} .cs-block-{{ block.id }} .cs__heading {
        {% if block.settings.font != blank %}
          font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
        {% endif %}
        font-weight: {{ block.settings.font_weight }};
        font-size: {{ block.settings.font_size_mobile }}px;
        color: {{ block.settings.color }};
        letter-spacing: {{ block.settings.letter_spacing | times: 0.01 }}em;
        text-transform: {{ block.settings.text_transform }};
        {% if block.settings.max_width > 0 %}
          max-width: {{ block.settings.max_width }}px;
          {% if block.settings.alignment == 'center' %}
            margin-left: auto;
            margin-right: auto;
          {% elsif block.settings.alignment == 'right' %}
            margin-left: auto;
          {% endif %}
        {% endif %}
      }
    {% endif %}

    {% if block.type == 'text' %}
      .section-{{ section.id }} .cs-block-{{ block.id }} .cs__text-title {
        {% if block.settings.title_font != blank %}
          font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
        {% elsif section.settings.body_font != blank %}
          font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
        {% endif %}
        font-weight: {{ block.settings.title_font_weight }};
        font-size: {{ block.settings.title_size_mobile }}px;
        color: {{ block.settings.title_color }};
        letter-spacing: {{ block.settings.title_letter_spacing | times: 0.01 }}em;
        text-transform: {{ block.settings.title_text_transform }};
        line-height: 1.35;
        margin: 0 0 8px;
        {% if block.settings.max_width > 0 %}
          max-width: {{ block.settings.max_width }}px;
          {% if block.settings.alignment == 'center' %}
            margin-left: auto;
            margin-right: auto;
          {% elsif block.settings.alignment == 'right' %}
            margin-left: auto;
          {% endif %}
        {% endif %}
      }

      .section-{{ section.id }} .cs-block-{{ block.id }} .cs__text-description {
        {% if block.settings.description_font != blank %}
          font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
        {% elsif section.settings.body_font != blank %}
          font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
        {% endif %}
        font-weight: {{ block.settings.description_font_weight }};
        font-size: {{ block.settings.description_size_mobile }}px;
        color: {{ block.settings.description_color }};
        line-height: 1.55;
        {% if block.settings.max_width > 0 %}
          max-width: {{ block.settings.max_width }}px;
          {% if block.settings.alignment == 'center' %}
            margin-left: auto;
            margin-right: auto;
          {% elsif block.settings.alignment == 'right' %}
            margin-left: auto;
          {% endif %}
        {% endif %}
      }
    {% endif %}

    {% if block.type == 'image_with_text' %}
      .section-{{ section.id }} .cs-block-{{ block.id }} .cs-iwt__inner {
        gap: {{ block.settings.gap_mobile }}px;
        align-items: {{ block.settings.vertical_align }};
      }

      .section-{{ section.id }} .cs-block-{{ block.id }} .cs-iwt__content {
        text-align: {{ block.settings.text_align }};
      }

      .section-{{ section.id }} .cs-block-{{ block.id }} .cs-iwt__media {
        width: {{ block.settings.image_size_mobile }}px;
        height: {{ block.settings.image_size_mobile }}px;
        border-radius: {% if block.settings.image_circle %}50%{% else %}{{ block.settings.image_radius }}px{% endif %};
        {% if block.settings.image_bg_color != blank %}
          background: {{ block.settings.image_bg_color }};
        {% endif %}
        {% if block.settings.image_circle == false and block.settings.image_radius > 0 %}
          overflow: hidden;
        {% endif %}
      }

      .section-{{ section.id }} .cs-block-{{ block.id }}.cs-iwt--image_left .cs-iwt__media,
      .section-{{ section.id }} .cs-block-{{ block.id }}.cs-iwt--image_right .cs-iwt__media {
        width: {{ block.settings.image_size_mobile }}px;
        height: {{ block.settings.image_size_mobile }}px;
      }

      .section-{{ section.id }} .cs-block-{{ block.id }}.cs-iwt--image_top .cs-iwt__media,
      .section-{{ section.id }} .cs-block-{{ block.id }}.cs-iwt--image_bottom .cs-iwt__media {
        width: {{ block.settings.image_size_mobile }}px;
        height: {{ block.settings.image_size_mobile }}px;
        margin-left: auto;
        margin-right: auto;
      }

      .section-{{ section.id }} .cs-block-{{ block.id }} .cs-iwt__title {
        {% if block.settings.title_font != blank %}
          font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
        {% elsif section.settings.body_font != blank %}
          font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
        {% endif %}
        font-weight: {{ block.settings.title_font_weight }};
        font-size: {{ block.settings.title_size_mobile }}px;
        color: {{ block.settings.title_color }};
        letter-spacing: {{ block.settings.title_letter_spacing | times: 0.01 }}em;
        text-transform: {{ block.settings.title_text_transform }};
        line-height: 1.3;
        margin: 0 0 6px;
      }

      .section-{{ section.id }} .cs-block-{{ block.id }} .cs-iwt__description {
        {% if block.settings.description_font != blank %}
          font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
        {% elsif section.settings.body_font != blank %}
          font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
        {% endif %}
        font-weight: {{ block.settings.description_font_weight }};
        font-size: {{ block.settings.description_size_mobile }}px;
        color: {{ block.settings.description_color }};
        line-height: 1.5;
      }
    {% endif %}

    {% if block.type == 'image' %}
      .section-{{ section.id }} .cs-block-{{ block.id }} .cs__image,
      .section-{{ section.id }} .cs-block-{{ block.id }} .cs__image-placeholder {
        width: {{ block.settings.image_width_mobile }}px;
        max-width: 100%;
        border-radius: {{ block.settings.image_radius }}px;
        object-fit: {{ block.settings.image_fit }};
      }

      .section-{{ section.id }} .cs-block-{{ block.id }} .cs__image-placeholder {
        height: {{ block.settings.image_width_mobile }}px;
      }
    {% endif %}
  {% endfor %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    }

    .section-{{ section.id }} .cs__bg-img--desktop {
      display: block;
    }

    .section-{{ section.id }} .cs__bg-img--mobile {
      display: none;
    }

    .section-{{ section.id }} .cs__inner {
      padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_right_desktop }}px {{ section.settings.padding_bottom_desktop }}px {{ section.settings.padding_left_desktop }}px;
    }

    .section-{{ section.id }} .cs__grid {
      gap: {{ section.settings.block_gap_desktop }}px;
      --cs-gap: {{ section.settings.block_gap_desktop }}px;
    }

    .section-{{ section.id }} [class*="cs__item--width-mobile-"] {
      flex: unset;
      width: unset;
    }

    .section-{{ section.id }} .cs__item--width-full { flex: 0 0 100%; width: 100%; }
    .section-{{ section.id }} .cs__item--width-half { flex: 0 0 calc((100% - var(--cs-gap) * 1) / 2); width: calc((100% - var(--cs-gap) * 1) / 2); }
    .section-{{ section.id }} .cs__item--width-third { flex: 0 0 calc((100% - var(--cs-gap) * 2) / 3); width: calc((100% - var(--cs-gap) * 2) / 3); }
    .section-{{ section.id }} .cs__item--width-quarter { flex: 0 0 calc((100% - var(--cs-gap) * 3) / 4); width: calc((100% - var(--cs-gap) * 3) / 4); }
    .section-{{ section.id }} .cs__item--width-fifth { flex: 0 0 calc((100% - var(--cs-gap) * 4) / 5); width: calc((100% - var(--cs-gap) * 4) / 5); }
    .section-{{ section.id }} .cs__item--width-sixth { flex: 0 0 calc((100% - var(--cs-gap) * 5) / 6); width: calc((100% - var(--cs-gap) * 5) / 6); }
    .section-{{ section.id }} .cs__item--width-seventh { flex: 0 0 calc((100% - var(--cs-gap) * 6) / 7); width: calc((100% - var(--cs-gap) * 6) / 7); }
    .section-{{ section.id }} .cs__item--width-auto { flex: 1 1 auto; width: auto; min-width: 0; }

    .section-{{ section.id }} .cs-device-desktop { display: block; }
    .section-{{ section.id }} .cs-device-mobile { display: none; }
    .section-{{ section.id }} .cs-device-all { display: block; }
    .section-{{ section.id }} .cs-device-all.cs__item--iwt,
    .section-{{ section.id }} .cs-device-desktop.cs__item--iwt { display: flex; }

    .section-{{ section.id }} .cs__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    {% for block in section.blocks %}
      .section-{{ section.id }} .cs-block-{{ block.id }} {
        {% if block.settings.margin_top_desktop > 0 %}
          margin-top: {{ block.settings.margin_top_desktop }}px;
        {% endif %}
        {% if block.settings.margin_bottom_desktop > 0 %}
          margin-bottom: {{ block.settings.margin_bottom_desktop }}px;
        {% endif %}
      }

      {% if block.type == 'heading' %}
        .section-{{ section.id }} .cs-block-{{ block.id }} .cs__heading {
          font-size: {{ block.settings.font_size_desktop }}px;
        }
      {% endif %}

      {% if block.type == 'text' %}
        .section-{{ section.id }} .cs-block-{{ block.id }} .cs__text-title {
          font-size: {{ block.settings.title_size_desktop }}px;
        }

        .section-{{ section.id }} .cs-block-{{ block.id }} .cs__text-description {
          font-size: {{ block.settings.description_size_desktop }}px;
        }
      {% endif %}

      {% if block.type == 'image_with_text' %}
        .section-{{ section.id }} .cs-block-{{ block.id }} .cs-iwt__inner {
          gap: {{ block.settings.gap_desktop }}px;
        }

        .section-{{ section.id }} .cs-block-{{ block.id }} .cs-iwt__media {
          width: {{ block.settings.image_size_desktop }}px;
          height: {{ block.settings.image_size_desktop }}px;
        }

        .section-{{ section.id }} .cs-block-{{ block.id }}.cs-iwt--image_left .cs-iwt__media,
        .section-{{ section.id }} .cs-block-{{ block.id }}.cs-iwt--image_right .cs-iwt__media {
          width: {{ block.settings.image_size_desktop }}px;
          height: {{ block.settings.image_size_desktop }}px;
        }

        .section-{{ section.id }} .cs-block-{{ block.id }}.cs-iwt--image_top .cs-iwt__media,
        .section-{{ section.id }} .cs-block-{{ block.id }}.cs-iwt--image_bottom .cs-iwt__media {
          width: {{ block.settings.image_size_desktop }}px;
          height: {{ block.settings.image_size_desktop }}px;
        }

        .section-{{ section.id }} .cs-block-{{ block.id }} .cs-iwt__title {
          font-size: {{ block.settings.title_size_desktop }}px;
        }

        .section-{{ section.id }} .cs-block-{{ block.id }} .cs-iwt__description {
          font-size: {{ block.settings.description_size_desktop }}px;
        }
      {% endif %}

      {% if block.type == 'image' %}
        .section-{{ section.id }} .cs-block-{{ block.id }} .cs__image,
        .section-{{ section.id }} .cs-block-{{ block.id }} .cs__image-placeholder {
          width: {{ block.settings.image_width_desktop }}px;
        }

        .section-{{ section.id }} .cs-block-{{ block.id }} .cs__image-placeholder {
          height: {{ block.settings.image_width_desktop }}px;
        }
      {% endif %}
    {% endfor %}
