{% endcomment %}


{%- style -%}
  .vd-l { display: none !important; }
  #shopify-section-{{ section.id }} {
    --section-horizontal-padding: var(--page-margin, 16px);
    --section-border-radius: {{ section.settings.section_border_radius_mobile }}px;
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    border-radius: var(--section-border-radius);
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      {% if section.settings.section_bg_type == 'gradient' %}
        background: {{ section.settings.section_bg_gradient }};
      {% else %}
        background-color: {{ section.settings.section_bg_color }};
      {% endif %}
    }
  }

  {% if section.settings.enable_advanced_settings %}
    #shopify-section-{{ section.id }} {
      --section-horizontal-padding: {{ section.settings.padding_horizontal_mobile }}px;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --section-horizontal-padding: 0px;
      --section-border-radius: {{ section.settings.section_border_radius }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      {% if section.settings.full_width_desktop %}
        {% if section.settings.section_bg_type == 'gradient' %}
          background: {{ section.settings.section_bg_gradient }};
        {% else %}
          background-color: {{ section.settings.section_bg_color }};
        {% endif %}
      {% else %}
        background: transparent;
      {% endif %}
    }
  }

  {% if section.settings.enable_advanced_settings == false and section.settings.full_width_desktop %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-container-max-width: var(--page-content-width, var(--page-width, 1440px));
        --section-outer-gutter: max(0px, calc((100vw - var(--section-container-max-width)) / 2));
        --section-horizontal-padding: max(0px, calc(var(--page-margin, 40px) - var(--section-outer-gutter)));
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings == false and section.settings.full_width_desktop == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: 40px;
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: {{ section.settings.padding_horizontal }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} > .vso-hero-32__container {
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--section-horizontal-padding);
    padding-right: var(--section-horizontal-padding);
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    max-width: var(--page-content-width, var(--page-width, 1440px));
    {% if section.settings.enable_advanced_settings %}
      max-width: {{ section.settings.section_max_width }}rem;
    {% endif %}
    border-radius: var(--section-border-radius);
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} > .vso-hero-32__container {
      background: transparent;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} > .vso-hero-32__container {
      {% if section.settings.full_width_desktop %}
        background: transparent;
      {% else %}
        {% if section.settings.section_bg_type == 'gradient' %}
          background: {{ section.settings.section_bg_gradient }};
        {% else %}
          background-color: {{ section.settings.section_bg_color }};
        {% endif %}
        width: calc(100% - (2 * var(--page-margin, 40px)));
      {% endif %}
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} > .vso-hero-32__container {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'heading' -%}
      #shopify-section-{{ section.id }} .vso-hero-32__heading {
        margin: {{ block.settings.heading_margin_top_mobile }}px 0 {{ block.settings.heading_margin_bottom_mobile }}px 0;
        text-align: {{ block.settings.heading_alignment_mobile }};
        color: {{ block.settings.heading_color }};
      }

      {% if block.settings.heading_custom_font %}
        #shopify-section-{{ section.id }} .vso-hero-32__heading {
          font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
          font-weight: {{ block.settings.heading_font.weight }};
          font-style: {{ block.settings.heading_font.style }};
          font-size: {{ block.settings.heading_size_mobile }}px;
          line-height: {{ block.settings.heading_line_height }};
          color: {{ block.settings.heading_color }};
        }

        @media screen and (min-width: 750px) {
          #shopify-section-{{ section.id }} .vso-hero-32__heading {
            font-size: {{ block.settings.heading_size_desktop }}px;
          }
        }
      {% endif %}

      #shopify-section-{{ section.id }} .vso-hero-32__heading .vso-hero-32__heading-highlight-{{ section.id }} {
        background: {{ block.settings.heading_highlight_color }} !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
        background-clip: text !important;
        color: transparent !important;
      }

      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} .vso-hero-32__heading {
          margin: {{ block.settings.heading_margin_top_desktop }}px 0 {{ block.settings.heading_margin_bottom_desktop }}px 0;
          text-align: {{ block.settings.heading_alignment_desktop }};
          max-width: {{ block.settings.heading_max_width_desktop }}px;
        }
      }
    {%- endif -%}

    {%- if block.type == 'description' -%}
      #shopify-section-{{ section.id }} .vso-hero-32__description {
        margin: {{ block.settings.description_margin_top_mobile }}px 0 {{ block.settings.description_margin_bottom_mobile }}px 0;
        text-align: {{ block.settings.description_alignment_mobile }};
        color: {{ block.settings.description_color }};
      }

      {% if block.settings.description_custom_font %}
        #shopify-section-{{ section.id }} .vso-hero-32__description {
          font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
          font-style: {{ block.settings.description_font.style }};
          font-size: {{ block.settings.description_size_mobile }}px;
          font-weight: {{ block.settings.description_weight }};
          line-height: {{ block.settings.description_line_height }};
          color: {{ block.settings.description_color }};
        }

        @media screen and (min-width: 750px) {
          #shopify-section-{{ section.id }} .vso-hero-32__description {
            font-size: {{ block.settings.description_size_desktop }}px;
          }
        }
      {% endif %}

      #shopify-section-{{ section.id }} .vso-hero-32__description p {
        margin: 0;
      }

      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} .vso-hero-32__description {
          margin: {{ block.settings.description_margin_top_desktop }}px 0 {{ block.settings.description_margin_bottom_desktop }}px 0;
          text-align: {{ block.settings.description_alignment_desktop }};
          max-width: {{ block.settings.description_max_width_desktop }}px;
        }
      }
    {%- endif -%}
  {%- endfor -%}

  #shopify-section-{{ section.id }} .vso-hero-32__cards:not(.swiper) {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.cards_gap_mobile }}px;
    {% if section.settings.cards_equal_height %}
    align-items: stretch;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-32__cards:not(.swiper) {
      grid-template-columns: repeat({{ section.settings.cards_per_view_desktop }}, 1fr);
      gap: {{ section.settings.cards_gap_desktop }}px;
      {% if section.settings.cards_equal_height %}
      align-items: stretch;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .vso-node { display: none; }
  #shopify-section-{{ section.id }} .vso-node--v2 { display: block; }

  /* Concept theme compatibility: prevent global reveal/animation styles from hiding content */
  #shopify-section-{{ section.id }} .vso-hero-32__content,
  #shopify-section-{{ section.id }} .vso-hero-32__heading,
  #shopify-section-{{ section.id }} .vso-hero-32__description,
  #shopify-section-{{ section.id }} .vso-hero-32__card-tag,
  #shopify-section-{{ section.id }} .vso-hero-32__card-heading,
  #shopify-section-{{ section.id }} .vso-hero-32__card-description,
  #shopify-section-{{ section.id }} .vso-hero-32__card-description {
    opacity: 1 !important;
    visibility: visible !important;
  }

  #shopify-section-{{ section.id }} .vso-hero-32__heading,
  #shopify-section-{{ section.id }} .vso-hero-32__description {
    display: block !important;
    position: relative !important;
    z-index: 2 !important;
  }

  #shopify-section-{{ section.id }} .vso-hero-32__cards.swiper {
    width: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .swiper,
  #shopify-section-{{ section.id }} .swiper-wrapper,
  #shopify-section-{{ section.id }} .swiper-slide {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .swiper-wrapper {
    display: flex;
    {% if section.settings.cards_equal_height %}
    align-items: stretch;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .swiper-slide {
    {% if section.settings.cards_equal_height %}
      height: auto;
    {% else %}
      height: auto;
    {% endif %}
    display: flex;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .vso-hero-32__carousel-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    height: 44px;
    padding: 0 2px;
  }

  #shopify-section-{{ section.id }} .swiper-pagination {
    position: static !important;
    width: auto !important;
    margin: 0 !important;
    text-align: left !important;
  }

  #shopify-section-{{ section.id }} .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    background: {{ section.settings.pagination_dot_color_inactive }};
    border-radius: 50%;
    transition: all 0.3s ease;
    margin: 0 4px 0 0;
    display: inline-block;
  }

  #shopify-section-{{ section.id }} .swiper-pagination-bullet:not(:last-child) {
    margin-right: 8px;
  }

  #shopify-section-{{ section.id }} .swiper-pagination-bullet-active {
    background: {{ section.settings.pagination_dot_color_active }};
    transform: scale(1.2);
  }

  #shopify-section-{{ section.id }} .vso-hero-32__carousel-arrows {
    display: flex;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .swiper-button-next,
  #shopify-section-{{ section.id }} .swiper-button-prev {
    position: static !important;
    width: 44px;
    height: 44px;
    background: {{ section.settings.navigation_arrows_bg_color }};
    border-radius: 50%;
    border: {{ section.settings.navigation_arrows_border_width }}px solid {{ section.settings.navigation_arrows_icon_color }};
    transition: all 0.3s ease;
    margin: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    z-index: 2;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-32__cards.swiper.swiper-lock ~ .vso-hero-32__carousel-nav .vso-hero-32__carousel-arrows {
      display: none !important;
    }
    #shopify-section-{{ section.id }} .vso-hero-32__carousel-nav .swiper-pagination.swiper-pagination-lock + .vso-hero-32__carousel-arrows {
      display: none !important;
    }
  }

  #shopify-section-{{ section.id }} .swiper-button-next:hover,
  #shopify-section-{{ section.id }} .swiper-button-prev:hover {
    border-color: {{ section.settings.navigation_arrows_icon_color }};
  }

  #shopify-section-{{ section.id }} .swiper-button-next::after,
  #shopify-section-{{ section.id }} .swiper-button-prev::after {
    content: '';
    width: 20px;
    height: 20px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  #shopify-section-{{ section.id }} .swiper-button-next::after {
    background-image: url("data:image/svg+xml,<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path fill-rule='evenodd' clip-rule='evenodd' d='M12.2929 4.29289C12.6834 3.90237 13.3166 3.90237 13.7071 4.29289L20.7071 11.2929C21.0976 11.6834 21.0976 12.3166 20.7071 12.7071L13.7071 19.7071C13.3166 20.0976 12.6834 20.0976 12.2929 19.7071C11.9024 19.3166 11.9024 18.6834 12.2929 18.2929L17.5858 13H4C3.44772 13 3 12.5523 3 12C3 11.4477 3.44772 11 4 11H17.5858L12.2929 5.70711C11.9024 5.31658 11.9024 4.68342 12.2929 4.29289Z' fill='%23{{ section.settings.navigation_arrows_icon_color | remove: '#' }}'/></svg>");
  }

  #shopify-section-{{ section.id }} .swiper-button-prev::after {
    background-image: url("data:image/svg+xml,<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path fill-rule='evenodd' clip-rule='evenodd' d='M11.7071 4.29289C12.0976 4.68342 12.0976 5.31658 11.7071 5.70711L6.41421 11H20C20.5523 11 21 11.4477 21 12C21 12.5523 20.5523 13 20 13H6.41421L11.7071 18.2929C12.0976 18.6834 12.0976 19.3166 11.7071 19.7071C11.3166 20.0976 10.6834 20.0976 10.2929 19.7071L3.29289 12.7071C3.10536 12.5196 3 12.2652 3 12C3 11.7348 3.10536 11.4804 3.29289 11.2929L10.2929 4.29289C10.6834 3.90237 11.3166 3.90237 11.7071 4.29289Z' fill='%23{{ section.settings.navigation_arrows_icon_color | remove: '#' }}'/></svg>");
  }

  #shopify-section-{{ section.id }} .swiper-button-next.swiper-button-disabled::after {
    background-image: url("data:image/svg+xml,<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path fill-rule='evenodd' clip-rule='evenodd' d='M12.2929 4.29289C12.6834 3.90237 13.3166 3.90237 13.7071 4.29289L20.7071 11.2929C21.0976 11.6834 21.0976 12.3166 20.7071 12.7071L13.7071 19.7071C13.3166 20.0976 12.6834 20.0976 12.2929 19.7071C11.9024 19.3166 11.9024 18.6834 12.2929 18.2929L17.5858 13H4C3.44772 13 3 12.5523 3 12C3 11.4477 3.44772 11 4 11H17.5858L12.2929 5.70711C11.9024 5.31658 11.9024 4.68342 12.2929 4.29289Z' fill='%23{{ section.settings.navigation_arrows_icon_color_disabled | remove: '#' }}'/></svg>");
  }

  #shopify-section-{{ section.id }} .swiper-button-prev.swiper-button-disabled::after {
    background-image: url("data:image/svg+xml,<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path fill-rule='evenodd' clip-rule='evenodd' d='M11.7071 4.29289C12.0976 4.68342 12.0976 5.31658 11.7071 5.70711L6.41421 11H20C20.5523 11 21 11.4477 21 12C21 12.5523 20.5523 13 20 13H6.41421L11.7071 18.2929C12.0976 18.6834 12.0976 19.3166 11.7071 19.7071C11.3166 20.0976 10.6834 20.0976 10.2929 19.7071L3.29289 12.7071C3.10536 12.5196 3 12.2652 3 12C3 11.7348 3.10536 11.4804 3.29289 11.2929L10.2929 4.29289C10.6834 3.90237 11.3166 3.90237 11.7071 4.29289Z' fill='%23{{ section.settings.navigation_arrows_icon_color_disabled | remove: '#' }}'/></svg>");
  }

  #shopify-section-{{ section.id }} .swiper-button-next.swiper-button-disabled,
  #shopify-section-{{ section.id }} .swiper-button-prev.swiper-button-disabled {
    border-color: {{ section.settings.navigation_arrows_icon_color_disabled }};
  }

  #shopify-section-{{ section.id }} .vso-hero-32__card {
    display: flex;
    flex-direction: column;
    background: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    padding: {{ section.settings.card_padding_vertical }}px {{ section.settings.card_padding_horizontal }}px;
    text-align: {{ section.settings.card_text_alignment }};
    {% if section.settings.cards_equal_height %}
      height: 100%;
    {% else %}
      height: auto;
    {% endif %}
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .vso-hero-32__card-image-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: {{ section.settings.card_image_margin_bottom }}px;
    border-radius: {{ section.settings.card_image_border_radius }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .vso-hero-32__card-image {
    width: 100%;
    height: {{ section.settings.card_image_height_mobile }}px;
    object-fit: cover;
    display: block;
    {% if section.settings.enable_image_zoom %}
    transition: transform 0.4s ease-out;
    {% endif %}
  }

  {% if section.settings.enable_image_zoom %}
  #shopify-section-{{ section.id }} .vso-hero-32__card:hover .vso-hero-32__card-image {
    transform: scale(1.08);
  }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-32__card-image {
      height: {{ section.settings.card_image_height_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-32__card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .vso-hero-32__card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.tag_gap }}px;
    margin-bottom: {{ section.settings.tags_margin_bottom }}px;
    align-items: center;
    {% if section.settings.card_text_alignment == 'center' %}
      justify-content: center;
    {% elsif section.settings.card_text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .vso-hero-32__card-tag {
    padding: {{ section.settings.tag_padding_vertical }}px {{ section.settings.tag_padding_horizontal }}px;
    background: {{ section.settings.tag_bg_color }};
    border-radius: {{ section.settings.tag_border_radius }}px;
    border: {{ section.settings.tag_border_width }}px solid {{ section.settings.tag_border_color }};
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    margin: 0;
    color: {{ section.settings.tag_color }};
  }

  {% if section.settings.tag_custom_font %}
    #shopify-section-{{ section.id }} .vso-hero-32__card-tag {
      font-family: {{ section.settings.tag_font.family }}, {{ section.settings.tag_font.fallback_families }};
      font-style: {{ section.settings.tag_font.style }};
      font-size: {{ section.settings.tag_size_mobile }}px;
      font-weight: {{ section.settings.tag_weight }};
      line-height: {{ section.settings.tag_line_height }};
      color: {{ section.settings.tag_color }};
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-32__card-tag {
        font-size: {{ section.settings.tag_size_desktop }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-hero-32__card-heading {
    margin: 0 0 {{ section.settings.card_heading_margin_bottom }}px 0;
    color: {{ section.settings.card_heading_color }};
  }

  {% if section.settings.card_heading_custom_font %}
    #shopify-section-{{ section.id }} .vso-hero-32__card-heading {
      font-family: {{ section.settings.card_heading_font.family }}, {{ section.settings.card_heading_font.fallback_families }};
      font-style: {{ section.settings.card_heading_font.style }};
      font-size: {{ section.settings.card_heading_size_mobile }}px;
      font-weight: {{ section.settings.card_heading_weight }};
      line-height: {{ section.settings.card_heading_line_height }};
      color: {{ section.settings.card_heading_color }};
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-32__card-heading {
        font-size: {{ section.settings.card_heading_size_desktop }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-hero-32__card-description {
    margin: 0;
    color: {{ section.settings.card_description_color }};
  }

  {% if section.settings.card_description_custom_font %}
    #shopify-section-{{ section.id }} .vso-hero-32__card-description {
      font-family: {{ section.settings.card_description_font.family }}, {{ section.settings.card_description_font.fallback_families }};
      font-style: {{ section.settings.card_description_font.style }};
      font-size: {{ section.settings.card_description_size_mobile }}px;
      font-weight: {{ section.settings.card_description_weight }};
      line-height: {{ section.settings.card_description_line_height }};
      color: {{ section.settings.card_description_color }};
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-32__card-description {
        font-size: {{ section.settings.card_description_size_desktop }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-hero-32__card-description p {
    margin: 0;
    color: inherit;
  }

{%- endstyle -%}

{%- for block in section.blocks -%}
  {%- if block.type == 'heading' and block.settings.heading_highlight_custom_font -%}
<style>
  #shopify-section-{{ section.id }} .vso-hero-32__heading .vso-hero-32__heading-highlight-{{ section.id }} {
    font-family: {{ block.settings.heading_highlight_font.family }}, {{ block.settings.heading_highlight_font.fallback_families }} !important;
    font-weight: {{ block.settings.heading_highlight_weight }} !important;
    font-style: {{ block.settings.heading_highlight_font.style }} !important;
    font-size: {{ block.settings.heading_highlight_size_mobile }}px !important;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-32__heading .vso-hero-32__heading-highlight-{{ section.id }} {
      font-size: {{ block.settings.heading_highlight_size_desktop }}px !important;
    }
  }
</style>
  {%- endif -%}
{%- endfor -%}

{%- if request.design_mode -%}
  <div class="vso-require-script">
    <div class="vso-warning">
      <div class="vso-warning__left">
        <div class="vso-warning__badge">
