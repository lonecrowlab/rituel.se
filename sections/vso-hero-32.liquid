  </style>
{%- endif -%}


<div id="shopify-section-{{ section.id }}" class="vso-node vd-l vso-node--v2 vso-hero-32 vso-hidden">
  <div class="vso-hero-32__container vso-node">

    <div class="vso-hero-32__content">
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          {%- if block.settings.heading != blank -%}
            {%- liquid
              assign title_parts = block.settings.heading | split: '_'
              assign processed_title = ''
              assign is_highlighted = false
              for part in title_parts
                if is_highlighted
                  capture highlighted_part
                    echo '<span class="vso-hero-32__heading-highlight-' | append: section.id | append: '">' | append: part | append: '</span>'
                  endcapture
                  assign processed_title = processed_title | append: highlighted_part
                  assign is_highlighted = false
                else
                  assign processed_title = processed_title | append: part
                  assign is_highlighted = true
                endif
              endfor
            -%}
            {% if block.settings.heading_custom_font %}
              <h2 class="vso-hero-32__heading">{{ processed_title }}</h2>
            {% else %}
              {%- assign heading_tag = block.settings.heading_as | default: 'h2' -%}
              <{{ heading_tag }} class="vso-hero-32__heading">{{ processed_title }}</{{ heading_tag }}>
            {% endif %}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'description' -%}
          {%- if block.settings.description != blank -%}
            {% if block.settings.description_custom_font %}
              <div class="vso-hero-32__description">{{ block.settings.description }}</div>
            {% else %}
              {%- assign description_tag = block.settings.description_as | default: 'p' -%}
              {%- if description_tag == 'p' -%}
                <div class="vso-hero-32__description">{{ block.settings.description }}</div>
              {%- else -%}
                <{{ description_tag }} class="vso-hero-32__description">{{ block.settings.description | strip_html }}</{{ description_tag }}>
              {%- endif -%}
            {% endif %}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="vso-hero-32__cards{% if section.settings.enable_carousel %} swiper{% endif %}"{% if section.settings.enable_carousel %} data-carousel="true"{% endif %}>
      {% if section.settings.enable_carousel %}<div class="swiper-wrapper">{% endif %}
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div class="{% if section.settings.enable_carousel %}swiper-slide{% endif %} vso-hero-32__card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="vso-hero-32__card-image-wrapper">
                <img class="vso-hero-32__card-image"
                     src="{{ block.settings.image | image_url: width: 400 }}"
                     alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                     loading="lazy"
                     width="400"
                     height="{{ 400 | divided_by: block.settings.image.aspect_ratio | round }}">
              </div>
            {%- endif -%}

            <div class="vso-hero-32__card-content">
              <div>
                {%- assign has_tags = false -%}
                {%- if block.settings.tag_1 != blank or block.settings.tag_2 != blank or block.settings.tag_3 != blank or block.settings.tag_4 != blank or block.settings.tag_5 != blank -%}
                  {%- assign has_tags = true -%}
                {%- endif -%}

                {%- if has_tags -%}
                  <div class="vso-hero-32__card-tags">
                    {%- if block.settings.tag_1 != blank -%}
                      {% if section.settings.tag_custom_font %}
                        <span class="vso-hero-32__card-tag">{{ block.settings.tag_1 }}</span>
                      {% else %}
                        {%- assign tag_tag = section.settings.tag_as | default: 'p' -%}
                        <{{ tag_tag }} class="vso-hero-32__card-tag">{{ block.settings.tag_1 }}</{{ tag_tag }}>
                      {% endif %}
                    {%- endif -%}
                    {%- if block.settings.tag_2 != blank -%}
                      {% if section.settings.tag_custom_font %}
                        <span class="vso-hero-32__card-tag">{{ block.settings.tag_2 }}</span>
                      {% else %}
                        {%- assign tag_tag = section.settings.tag_as | default: 'p' -%}
                        <{{ tag_tag }} class="vso-hero-32__card-tag">{{ block.settings.tag_2 }}</{{ tag_tag }}>
                      {% endif %}
                    {%- endif -%}
                    {%- if block.settings.tag_3 != blank -%}
                      {% if section.settings.tag_custom_font %}
                        <span class="vso-hero-32__card-tag">{{ block.settings.tag_3 }}</span>
                      {% else %}
                        {%- assign tag_tag = section.settings.tag_as | default: 'p' -%}
                        <{{ tag_tag }} class="vso-hero-32__card-tag">{{ block.settings.tag_3 }}</{{ tag_tag }}>
                      {% endif %}
                    {%- endif -%}
                    {%- if block.settings.tag_4 != blank -%}
                      {% if section.settings.tag_custom_font %}
                        <span class="vso-hero-32__card-tag">{{ block.settings.tag_4 }}</span>
                      {% else %}
                        {%- assign tag_tag = section.settings.tag_as | default: 'p' -%}
                        <{{ tag_tag }} class="vso-hero-32__card-tag">{{ block.settings.tag_4 }}</{{ tag_tag }}>
                      {% endif %}
                    {%- endif -%}
                    {%- if block.settings.tag_5 != blank -%}
                      {% if section.settings.tag_custom_font %}
                        <span class="vso-hero-32__card-tag">{{ block.settings.tag_5 }}</span>
                      {% else %}
                        {%- assign tag_tag = section.settings.tag_as | default: 'p' -%}
                        <{{ tag_tag }} class="vso-hero-32__card-tag">{{ block.settings.tag_5 }}</{{ tag_tag }}>
                      {% endif %}
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  {% if section.settings.card_heading_custom_font %}
                    <div class="vso-hero-32__card-heading">{{ block.settings.heading }}</div>
                  {% else %}
                    {%- assign card_heading_tag = section.settings.card_heading_as | default: 'h3' -%}
                    <{{ card_heading_tag }} class="vso-hero-32__card-heading">{{ block.settings.heading }}</{{ card_heading_tag }}>
                  {% endif %}
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  {% if section.settings.card_description_custom_font %}
                    <div class="vso-hero-32__card-description">{{ block.settings.description }}</div>
                  {% else %}
                    {%- assign card_desc_tag = section.settings.card_description_as | default: 'p' -%}
                    {%- if card_desc_tag == 'p' -%}
                      <div class="vso-hero-32__card-description">{{ block.settings.description }}</div>
                    {%- else -%}
                      <{{ card_desc_tag }} class="vso-hero-32__card-description">{{ block.settings.description | strip_html }}</{{ card_desc_tag }}>
                    {%- endif -%}
                  {% endif %}
                {%- endif -%}
              </div>

            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {% if section.settings.enable_carousel %}</div>{% endif %}

      {% if section.settings.enable_carousel %}
        {% assign show_nav = false %}
        {% if section.settings.show_navigation_arrows or section.settings.show_pagination_dots %}
          {% assign show_nav = true %}
        {% endif %}
        {% if show_nav %}
        <div class="vso-hero-32__carousel-nav">
          {% if section.settings.show_pagination_dots %}
            <div class="swiper-pagination"></div>
          {% else %}
            <div></div>
          {% endif %}

          {% if section.settings.show_navigation_arrows %}
            <div class="vso-hero-32__carousel-arrows">
              <div class="swiper-button-prev"></div>
              <div class="swiper-button-next"></div>
            </div>
          {% endif %}
        </div>
        {% endif %}
      {% endif %}
    </div>

  </div>
</div>

{% if section.settings.enable_carousel %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<script>
(function() {
  const sectionId = 'shopify-section-{{ section.id }}';
  let swiperInstance = null;

  function initSwiper() {
    const sectionRoot = document.getElementById(sectionId);
    const swiperContainer = sectionRoot ? sectionRoot.querySelector('.vso-hero-32__cards.swiper') : null;

    if (swiperInstance && swiperInstance.destroy) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }

    if (!swiperContainer || typeof Swiper === 'undefined') {
      if (!swiperContainer) return;
      setTimeout(initSwiper, 100);
      return;
    }

    swiperInstance = new Swiper(swiperContainer, {
      slidesPerView: 1,
      spaceBetween: {{ section.settings.cards_gap_mobile }},
      loop: false,
      {% unless section.settings.cards_equal_height %}
      autoHeight: true,
      {% endunless %}
      {% if section.settings.cards_equal_height %}
      watchSlidesProgress: true,
      {% endif %}
      observeParents: true,
      observeSlideChildren: true,
      observer: true,
      watchOverflow: true,
      breakpoints: {
        750: {
          slidesPerView: {{ section.settings.cards_per_view_desktop }},
          spaceBetween: {{ section.settings.cards_gap_desktop }},
        }
      },
      {% if section.settings.show_navigation_arrows %}
      navigation: {
        nextEl: '#' + sectionId + ' .vso-hero-32__carousel-arrows .swiper-button-next',
        prevEl: '#' + sectionId + ' .vso-hero-32__carousel-arrows .swiper-button-prev',
      },
      {% endif %}
      {% if section.settings.show_pagination_dots %}
      pagination: {
        el: '#' + sectionId + ' .vso-hero-32__carousel-nav .swiper-pagination',
        clickable: true,
      },
      {% endif %}
    });

    {% if section.settings.cards_equal_height %}
    function setEqualHeights() {
      const cards = swiperContainer.querySelectorAll('.vso-hero-32__card');
      if (cards.length === 0) return;

      let maxHeight = 0;

      cards.forEach(card => {
        card.style.height = 'auto';
      });

      swiperContainer.offsetHeight;

      cards.forEach(card => {
        const height = card.offsetHeight;
        if (height > maxHeight) {
          maxHeight = height;
        }
      });

      cards.forEach(card => {
        card.style.height = maxHeight + 'px';
      });
    }

    setEqualHeights();

    swiperInstance.on('init', function() {
      setEqualHeights();
      setTimeout(setEqualHeights, 50);
    });

    swiperInstance.on('slideChange', function() {
      setEqualHeights();
    });

    window.addEventListener('resize', function() {
      setTimeout(setEqualHeights, 100);
    });

    setTimeout(setEqualHeights, 100);
    {% endif %}

    const visibilityFix = () => {
      if (swiperInstance && typeof swiperInstance.update === 'function') {
        swiperInstance.update();
      }
      var arrows = sectionRoot && sectionRoot.querySelector('.vso-hero-32__carousel-arrows');
      var paginationEl = sectionRoot && sectionRoot.querySelector('.swiper-pagination');
      var isLocked = swiperInstance && swiperInstance.isLocked;
      var paginationLocked = paginationEl && paginationEl.classList.contains('swiper-pagination-lock');
      if (arrows) {
        if (isLocked || paginationLocked) {
          arrows.style.display = 'none';
        } else {
          arrows.style.display = '';
        }
      }
    };
    window.addEventListener('resize', visibilityFix);
    if ('requestAnimationFrame' in window) {
      requestAnimationFrame(visibilityFix);
      setTimeout(visibilityFix, 200);
      setTimeout(visibilityFix, 500);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSwiper);
  } else {
    initSwiper();
  }

  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      setTimeout(initSwiper, 100);
    }
  });

  document.addEventListener('shopify:section:reorder', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      setTimeout(initSwiper, 100);
    }
  });

  document.addEventListener('shopify:section:unload', function(event) {
    if (event.detail.sectionId === '{{ section.id }}' && swiperInstance && swiperInstance.destroy) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
  });
})();
</script>
{% endif %}

{% schema %}
{
  "name": "VSO - Hero 32",
  "tag": "section",
  "class": "section vso-node vso-node--v2 vso-hero-32",
  "settings": [
    { "type": "header", "content": "Section Settings" },
    {
      "type": "checkbox",
      "id": "enable_advanced_settings",
      "label": "Enable advanced settings",
      "default": false,
      "info": "Shows additional settings for spacing, layout, and typography."
    },

    { "type": "header", "content": "Layout Settings", "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    { "type": "range", "id": "section_max_width", "label": "Content max width", "min": 30, "max": 200, "step": 2, "unit": "rem", "default": 120, "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    { "type": "range", "id": "padding_horizontal", "label": "Desktop side spacing", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "info": "Adds spacing on the left and right sides of this section on desktop.", "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    { "type": "range", "id": "padding_horizontal_mobile", "label": "Mobile side spacing", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "info": "Adds spacing on the left and right sides of this section on mobile.", "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },

    { "type": "header", "content": "Section Background" },
    {
      "type": "select",
      "id": "section_bg_type",
      "label": "Section background type",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "solid"
    },
    { "type": "color", "id": "section_bg_color", "label": "Section background color", "default": "#FFFFFF", "visible_if": "{{ section.settings.section_bg_type == 'solid' }}" },
    { "type": "color_background", "id": "section_bg_gradient", "label": "Section background gradient", "default": "linear-gradient(180deg, #FFFFFF 0%, #F3F4F6 100%)", "visible_if": "{{ section.settings.section_bg_type == 'gradient' }}" },
{ "type": "checkbox", "id": "full_width_desktop", "label": "Full width on desktop", "default": true, "info": "Make section background full width on desktop" },
    { "type": "range", "id": "section_border_radius", "label": "Desktop border radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "section_border_radius_mobile", "label": "Mobile border radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "Section Padding" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 },

    { "type": "header", "content": "Section Margin" },
    { "type": "range", "id": "margin_top", "label": "Desktop margin top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "margin_bottom", "label": "Desktop margin bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "margin_top_mobile", "label": "Mobile margin top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "margin_bottom_mobile", "label": "Mobile margin bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 },

    { "type": "header", "content": "Cards Layout" },
    { "type": "checkbox", "id": "enable_carousel", "label": "Enable carousel", "default": true, "info": "Turn on to enable swipe/scroll through cards" },
    { "type": "checkbox", "id": "cards_equal_height", "label": "Equal height cards", "default": true, "info": "Make all cards the same height as the tallest card" },
    { "type": "range", "id": "cards_per_view_desktop", "label": "Desktop cards per view", "min": 2, "max": 5, "step": 1, "default": 3, "info": "Number of cards visible at once" },
    { "type": "range", "id": "cards_gap_desktop", "label": "Desktop gap", "min": 1, "max": 60, "step": 1, "unit": "px", "default": 16, "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    { "type": "range", "id": "cards_gap_mobile", "label": "Mobile gap", "min": 1, "max": 40, "step": 1, "unit": "px", "default": 16, "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },

    { "type": "header", "content": "Carousel Navigation Arrows" },
    { "type": "checkbox", "id": "show_navigation_arrows", "label": "Show navigation arrows", "default": true, "info": "Display left/right arrow buttons" },
    { "type": "range", "id": "navigation_arrows_border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1, "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    { "type": "color", "id": "navigation_arrows_bg_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "color", "id": "navigation_arrows_icon_color", "label": "Arrow color", "default": "#000000" },
    { "type": "color", "id": "navigation_arrows_icon_color_disabled", "label": "Disabled arrow color", "default": "#BDBDBD" },

    { "type": "header", "content": "Carousel Pagination Dots" },
    { "type": "checkbox", "id": "show_pagination_dots", "label": "Show pagination dots", "default": true, "info": "Display progress dots below cards" },
