<section
  id="ProductFeatured-{{ section.id }}"
  class="product-featured section-{{ section.id }} pf-image-{{ section.settings.image_position }}"
  data-section-id="{{ section.id }}"
  data-discount-code="{{ offer_code | escape }}"
>
  <div class="pf-wrap">
    <div class="pf-grid">
      <div class="pf-media">
        <div class="pf-media__image-wrap">
          {%- if media_image != blank -%}
            {{ media_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'pf-media__image', alt: media_alt }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'pf-media__placeholder' }}
          {%- endif -%}
        </div>

        {%- if section.settings.show_ingredients -%}
          <button
            type="button"
            class="pf-ingredients-btn"
            data-pf-ingredients-open
            aria-haspopup="dialog"
            aria-controls="ProductFeaturedIngredients-{{ section.id }}"
          >
            {{ section.settings.ingredients_button_label | default: 'View ingredients' }}
          </button>
        {%- endif -%}
      </div>

      <div class="pf-content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'rating' -%}
              <div
                class="pf-block pf-rating pf-block-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.profile_image_1 != blank or block.settings.profile_image_2 != blank or block.settings.profile_image_3 != blank -%}
                  <div class="pf-rating__faces">
                    {%- if block.settings.profile_image_1 != blank -%}
                      {{ block.settings.profile_image_1 | image_url: width: 48, height: 48 | image_tag: class: 'pf-rating__face', loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    {%- if block.settings.profile_image_2 != blank -%}
                      {{ block.settings.profile_image_2 | image_url: width: 48, height: 48 | image_tag: class: 'pf-rating__face', loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    {%- if block.settings.profile_image_3 != blank -%}
                      {{ block.settings.profile_image_3 | image_url: width: 48, height: 48 | image_tag: class: 'pf-rating__face', loading: 'lazy', alt: '' }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.show_stars -%}
                  <span class="pf-rating__stars" aria-hidden="true">
                    {%- for i in (1..block.settings.star_rating) -%}
                      {% render 'icons', icon: 'custom_hero_rating' %}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.rating_text != blank -%}
                  <div class="pf-rating__text">{{ block.settings.rating_text }}</div>
                {%- endif -%}
              </div>

            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                <{{ block.settings.heading_tag | default: 'h2' }}
                  class="pf-block pf-heading pf-block-{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.heading }}
                </{{ block.settings.heading_tag | default: 'h2' }}>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="pf-block pf-text rte pf-block-{{ block.id }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

            {%- when 'special_offer' -%}
              <div class="pf-block pf-offer pf-block-{{ block.id }}" {{ block.shopify_attributes }}>
                <div class="pf-offer__top">
                  {%- if block.settings.title != blank -%}
                    <p class="pf-offer__title">{{ block.settings.title }}</p>
                  {%- endif -%}
                  {%- if block.settings.offer_percent > 0 -%}
                    <span class="pf-offer__badge">−{{ block.settings.offer_percent }}%</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.description != blank -%}
                  <div class="pf-offer__desc">{{ block.settings.description }}</div>
                {%- endif -%}
                {%- if featured_product != blank -%}
                  <div class="pf-offer__prices">
                    {%- if offer_percent > 0 and offer_price < original_price -%}
                      <s class="pf-offer__compare">{{ original_price | money }}</s>
                      <span class="pf-offer__price">{{ offer_price | money }}</span>
                    {%- else -%}
                      <span class="pf-offer__price">{{ selected_variant.price | money }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.show_code and block.settings.discount_code != blank -%}
                  <button type="button" class="pf-offer__code" data-pf-copy-code="{{ block.settings.discount_code | escape }}">
                    <span>Code:</span>
                    <strong>{{ block.settings.discount_code }}</strong>
                  </button>
                {%- endif -%}
              </div>

            {%- when 'features' -%}
              {%- if block.settings.features != blank -%}
                <div class="pf-block pf-features pf-block-{{ block.id }}" {{ block.shopify_attributes }}>
                  {{ block.settings.features }}
                </div>
              {%- endif -%}

            {%- when 'low_stock' -%}
              {%- liquid
                assign stock_count = block.settings.fallback_count | plus: 0
                assign show_stock = true
                if block.settings.use_product_inventory and selected_variant
                  if selected_variant.inventory_management == blank
                    assign show_stock = false
                  else
                    assign stock_count = selected_variant.inventory_quantity
                    if selected_variant.inventory_quantity > block.settings.threshold
                      assign show_stock = false
                    endif
                    unless selected_variant.available
                      assign show_stock = true
                    endunless
                  endif
                endif
                assign stock_label = block.settings.text | default: 'Only {count} left'
                assign stock_label = stock_label | replace: '{count}', stock_count
              -%}
              {%- if show_stock -%}
                <p class="pf-block pf-stock pf-block-{{ block.id }}" {{ block.shopify_attributes }}>
                  <span class="pf-stock__dot" aria-hidden="true"></span>
                  <span class="pf-stock__text">{{ stock_label }}</span>
                </p>
              {%- endif -%}

            {%- when 'button' -%}
              {%- liquid
                assign button_label = block.settings.button_label | default: 'Add to cart'
                if featured_product != blank and selected_variant.available == false
                  assign button_label = block.settings.sold_out_label | default: 'Sold out'
                endif
              -%}
              <div class="pf-block pf-cta pf-block-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if featured_product != blank -%}
                  {%- assign pf_form_id = 'pf-form-' | append: section.id | append: '-' | append: block.id -%}
                  {% form 'product', featured_product, id: pf_form_id, class: 'pf-form' %}
                    <input type="hidden" name="id" value="{{ selected_variant.id }}">
                    {%- if featured_product.has_only_default_variant == false -%}
                      <select name="id" class="pf-variant" aria-label="{{ featured_product.options | join: ' / ' }}">
                        {%- for variant in featured_product.variants -%}
                          <option
                            value="{{ variant.id }}"
                            {% if variant.id == selected_variant.id %}selected{% endif %}
                            {% unless variant.available %}disabled{% endunless %}
                          >
                            {{ variant.title }} — {{ variant.price | money }}
                          </option>
                        {%- endfor -%}
                      </select>
                    {%- endif -%}
                    <button
                      type="submit"
                      class="pf-btn"
                      {% unless selected_variant.available %}disabled{% endunless %}
                    >
                      {{ button_label }}
                    </button>
                  {% endform %}
                {%- elsif block.settings.button_link != blank -%}
                  <a class="pf-btn" href="{{ block.settings.button_link }}">{{ button_label }}</a>
                {%- else -%}
                  <p class="pf-empty">Select a product in section settings.</p>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_ingredients -%}
    <dialog
      id="ProductFeaturedIngredients-{{ section.id }}"
      class="pf-ing-dialog"
      aria-labelledby="ProductFeaturedIngredientsTitle-{{ section.id }}"
    >
      <div class="pf-ing-panel">
        <button type="button" class="pf-ing-close" data-pf-ingredients-close aria-label="Close">
          <span aria-hidden="true">×</span>
        </button>
        <div id="ProductFeaturedIngredientsTitle-{{ section.id }}" class="pf-ing-area pf-ing-area--title">
          {{ ingredients_title }}
        </div>
        <div class="pf-ing-split">
          <div class="pf-ing-area pf-ing-area--cards">
            {{ ingredients_cards }}
          </div>
          <aside class="pf-ing-area pf-ing-area--sidebar">
            {{ ingredients_sidebar }}
          </aside>
        </div>
        <div class="pf-ing-area pf-ing-area--footer">
          {{ ingredients_footer }}
        </div>
      </div>
    </dialog>
  {%- endif -%}
</section>

{% style %}
  .section-{{ section.id }} {
    --pf-bg: {{ section.settings.background_color }};
    --pf-text: {{ section.settings.text_color }};
    --pf-muted: {{ section.settings.muted_color }};
    --pf-accent: {{ section.settings.accent_color }};
    --pf-radius: {{ section.settings.image_radius }}px;
    background: var(--pf-bg);
    color: var(--pf-text);
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: {{ section.settings.padding_x_mobile }}px;
    padding-right: {{ section.settings.padding_x_mobile }}px;
  }

  .section-{{ section.id }} .pf-wrap {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  .section-{{ section.id }} .pf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.column_gap_mobile }}px;
    align-items: {{ section.settings.vertical_alignment }};
  }

  .section-{{ section.id }} .pf-media,
  .section-{{ section.id }} .pf-content {
    min-width: 0;
  }

  .section-{{ section.id }} .pf-media__image,
  .section-{{ section.id }} .pf-media__placeholder {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--pf-radius);
  }

  .section-{{ section.id }} .pf-ingredients-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: {{ section.settings.ingredients_btn_margin_top }}px;
    padding: {{ section.settings.ingredients_btn_pad_y_mobile }}px {{ section.settings.ingredients_btn_pad_x_mobile }}px;
    border: 1px solid {{ section.settings.ingredients_btn_border }};
    border-radius: {{ section.settings.ingredients_btn_radius }}px;
    background: {{ section.settings.ingredients_btn_bg }};
    color: {{ section.settings.ingredients_btn_color }};
    font-size: {{ section.settings.ingredients_btn_size_mobile }}px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .section-{{ section.id }} .pf-content {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.block_gap_mobile }}px;
  }

  .section-{{ section.id }} .pf-rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .section-{{ section.id }} .pf-rating__faces {
    display: flex;
    align-items: center;
  }

  .section-{{ section.id }} .pf-rating__face {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
    margin-left: -8px;
  }

  .section-{{ section.id }} .pf-rating__face:first-child {
    margin-left: 0;
  }

  .section-{{ section.id }} .pf-rating__stars {
    display: inline-flex;
    gap: 2px;
    color: {{ section.settings.star_color }};
  }

  .section-{{ section.id }} .pf-rating__stars svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .section-{{ section.id }} .pf-rating__text,
  .section-{{ section.id }} .pf-rating__text p {
    margin: 0;
    font-size: inherit;
  }

  .section-{{ section.id }} .pf-heading {
    margin: 0;
    line-height: 1.2;
  }

  .section-{{ section.id }} .pf-text p {
    margin: 0 0 0.7em;
  }

  .section-{{ section.id }} .pf-text p:last-child {
    margin-bottom: 0;
  }

  .section-{{ section.id }} .pf-offer {
    border: 1px solid {{ section.settings.offer_border }};
    background: {{ section.settings.offer_bg }};
    border-radius: 12px;
  }

  .section-{{ section.id }} .pf-offer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .section-{{ section.id }} .pf-offer__title {
    margin: 0;
    font-weight: 700;
    line-height: 1.25;
  }

  .section-{{ section.id }} .pf-offer__badge {
    flex-shrink: 0;
    background: var(--pf-accent);
    color: #fff;
    border-radius: 999px;
    padding: 4px 10px;
    font-weight: 700;
    line-height: 1;
  }

  .section-{{ section.id }} .pf-offer__desc,
  .section-{{ section.id }} .pf-offer__desc p {
    margin: 8px 0 0;
    color: var(--pf-muted);
  }

  .section-{{ section.id }} .pf-offer__prices {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 12px;
  }

  .section-{{ section.id }} .pf-offer__compare {
    color: var(--pf-muted);
    text-decoration: line-through;
  }

  .section-{{ section.id }} .pf-offer__price {
    font-weight: 700;
    color: var(--pf-accent);
  }

  .section-{{ section.id }} .pf-offer__code {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--pf-text);
    cursor: pointer;
    font: inherit;
  }

  .section-{{ section.id }} .pf-offer__code.is-copied::after {
    content: 'Copied';
    font-size: 12px;
    font-weight: 600;
    color: var(--pf-accent);
  }

  .section-{{ section.id }} .pf-features ul,
  .section-{{ section.id }} .pf-features ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .section-{{ section.id }} .pf-features li {
    position: relative;
    padding-left: 28px;
    margin: 0;
    line-height: 1.4;
  }

  .section-{{ section.id }} .pf-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15em;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--pf-accent);
    box-shadow: inset 0 0 0 18px var(--pf-accent);
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='12' r='12' fill='black'/><path d='M7.2 12.2L10.3 15.3L16.8 8.7' stroke='white' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' fill='none'/></svg>") center / contain no-repeat;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><circle cx='12' cy='12' r='12' fill='black'/><path d='M7.2 12.2L10.3 15.3L16.8 8.7' stroke='white' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' fill='none'/></svg>") center / contain no-repeat;
  }

  .section-{{ section.id }} .pf-features p {
    margin: 0 0 8px;
  }

  .section-{{ section.id }} .pf-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: {{ section.settings.stock_color }};
    font-weight: 600;
  }

  .section-{{ section.id }} .pf-stock__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: {{ section.settings.stock_color }};
    box-shadow: 0 0 0 4px {{ section.settings.stock_color | color_modify: 'alpha', 0.16 }};
  }

  .section-{{ section.id }} .pf-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .section-{{ section.id }} .pf-variant {
    width: 100%;
    padding: 10px 12px;
