{%- liquid
  assign featured_product = section.settings.product
  if featured_product == blank and product != blank
    assign featured_product = product
  endif

  assign selected_variant = featured_product.selected_or_first_available_variant
  assign media_image = section.settings.image
  if media_image == blank and featured_product != blank and featured_product.featured_image
    assign media_image = featured_product.featured_image
  endif
  assign media_alt = ''
  if media_image != blank
    assign media_alt = media_image.alt
  endif
  if media_alt == blank and featured_product != blank
    assign media_alt = featured_product.title
  endif

  assign offer_percent = 0
  assign offer_code = ''
  for block in section.blocks
    if block.type == 'special_offer'
      assign offer_percent = block.settings.offer_percent | plus: 0
      assign offer_code = block.settings.discount_code | strip
    endif
  endfor

  assign original_price = 0
  assign offer_price = 0
  if selected_variant
    assign original_price = selected_variant.compare_at_price | default: selected_variant.price
    if original_price == blank or original_price < selected_variant.price
      assign original_price = selected_variant.price
    endif
    if offer_percent > 0
      assign offer_multiplier = 100 | minus: offer_percent
      assign offer_price = original_price | times: offer_multiplier | divided_by: 100
    else
      assign offer_price = selected_variant.price
    endif
  endif

  assign ingredients_title = section.settings.ingredients_html_title
  assign ingredients_cards = section.settings.ingredients_html_cards
  assign ingredients_sidebar = section.settings.ingredients_html_sidebar
  assign ingredients_footer = section.settings.ingredients_html_footer
-%}

