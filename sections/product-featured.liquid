<script>
  (function () {
    var root = document.getElementById('ProductFeatured-{{ section.id }}');
    if (!root) return;

    var dialog = document.getElementById('ProductFeaturedIngredients-{{ section.id }}');
    var openBtn = root.querySelector('[data-pf-ingredients-open]');
    var closeBtn = root.querySelector('[data-pf-ingredients-close]');
    var discountCode = (root.getAttribute('data-discount-code') || '').trim();

    function openIngredients() {
      if (!dialog) return;
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
    }

    function closeIngredients() {
      if (!dialog) return;
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
    }

    if (openBtn) openBtn.addEventListener('click', openIngredients);
    if (closeBtn) closeBtn.addEventListener('click', closeIngredients);
    if (dialog) {
      dialog.addEventListener('click', function (event) {
        if (event.target === dialog) closeIngredients();
      });
    }

    root.querySelectorAll('[data-pf-copy-code]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var code = btn.getAttribute('data-pf-copy-code') || '';
        if (!code || !navigator.clipboard) return;
        navigator.clipboard.writeText(code).then(function () {
          btn.classList.add('is-copied');
          setTimeout(function () { btn.classList.remove('is-copied'); }, 1600);
        });
      });
    });

    async function applyDiscount(code) {
      if (!code) return;
      try {
        await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ discount: code })
        });
      } catch (e) {}
    }

    async function refreshCart() {
      if (window.CartManager && typeof window.CartManager.clearCache === 'function') {
        window.CartManager.clearCache();
      }
      document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
      var drawer = document.querySelector('cart-drawer');
      if (drawer && typeof drawer.open === 'function') {
        drawer.open();
      } else if (drawer) {
        drawer.classList.add('active', 'animate');
        drawer.setAttribute('open', '');
      }
    }

    root.querySelectorAll('form.pf-form').forEach(function (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var idInput = form.querySelector('[name="id"]');
        var variantId = idInput ? idInput.value : null;
        var button = form.querySelector('.pf-btn');
        if (!variantId) return;
        if (button) button.disabled = true;

        applyDiscount(discountCode)
          .then(function () {
            if (window.CartManager && typeof window.CartManager.addToCart === 'function') {
              return window.CartManager.addToCart([{ id: Number(variantId), quantity: 1 }]);
            }
            return fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
            }).then(function (res) {
              if (!res.ok) throw new Error('Add to cart failed');
              return res.json();
            });
          })
          .then(refreshCart)
          .catch(function () {
            form.submit();
          })
          .finally(function () {
            if (button) button.disabled = false;
          });
      });
    });
  })();
</script>

