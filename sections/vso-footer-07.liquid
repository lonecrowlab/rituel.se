  All modifications are logged.

  If you require assistance or have questions regarding this code, please contact support@versio.studio.
{%- endcomment -%}

{%- assign benefits_block = section.blocks | where: 'type', 'benefits' | first -%}
{%- style -%}
  .vd-l { display: none !important; }
  #shopify-section-{{ section.id }} {
    --section-border-radius: {{ section.settings.section_border_radius_mobile }}px;
    --section-horizontal-padding: var(--page-margin, 16px);
    --inner-padding-top: {{ section.settings.inner_padding_top }}px;
    --inner-padding-bottom: {{ section.settings.inner_padding_bottom }}px;
    --inner-padding-top-mobile: {{ section.settings.inner_padding_top_mobile }}px;
    --inner-padding-bottom-mobile: {{ section.settings.inner_padding_bottom_mobile }}px;
    --inner-padding-horizontal: {{ section.settings.inner_padding_horizontal }}px;
    --inner-padding-horizontal-mobile: {{ section.settings.inner_padding_horizontal_mobile }}px;
    --columns-gap: {{ section.settings.columns_gap }}px;
    --menu-heading-size-desktop: {{ section.settings.menu_heading_size_desktop }}px;
    --menu-heading-size-mobile: {{ section.settings.menu_heading_size_mobile }}px;
    --menu-item-size-desktop: {{ section.settings.menu_item_size_desktop }}px;
    --menu-item-size-mobile: {{ section.settings.menu_item_size_mobile }}px;
    {% if benefits_block %}
      --benefits-overlap-mobile: {{ benefits_block.settings.overlap_mobile | default: benefits_block.settings.overlap_desktop | default: 60 }}px;
      --benefits-overlap-desktop: {{ benefits_block.settings.overlap_desktop | default: 60 }}px;
    {% else %}
      --benefits-overlap-mobile: 0px;
      --benefits-overlap-desktop: 0px;
    {% endif %}
    border-radius: var(--section-border-radius);
    overflow-x: clip;
    overflow-y: visible;
    padding: 0;
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
  }

  {% if section.settings.enable_advanced_settings %}
    #shopify-section-{{ section.id }} {
      --section-horizontal-padding: {{ section.settings.inner_padding_horizontal_mobile }}px;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg_color }};
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --section-border-radius: {% if section.settings.bg_full_width %}0px{% else %}{{ section.settings.section_border_radius }}px{% endif %};
      --section-horizontal-padding: 0px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      background: transparent;
    }
  }

  {% if section.settings.enable_advanced_settings == false and section.settings.bg_full_width == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: 40px;
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings == false and section.settings.bg_full_width %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-container-max-width: var(--page-content-width, var(--page-width, 1440px));
        --section-outer-gutter: max(0px, calc((100vw - var(--section-container-max-width)) / 2));
        --section-horizontal-padding: max(0px, calc(var(--page-margin, 40px) - var(--section-outer-gutter)));
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: {{ section.settings.inner_padding_horizontal }}px;
      }
    }
  {% endif %}

  .vso-node { display: none; }
  .vso-node--v2 { display: block; }

  #shopify-section-{{ section.id }} > .vso-footer-07__background {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    max-width: var(--page-content-width, var(--page-width, 1440px));
    {% if section.settings.enable_advanced_settings %}
      {% if section.settings.section_full_width %}max-width: 100%;{% else %}max-width: {{ section.settings.section_max_width }}rem;{% endif %}
    {% endif %}
    border-radius: var(--section-border-radius);
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: var(--section-horizontal-padding);
    padding-right: var(--section-horizontal-padding);
    position: relative;
  }

  {% if section.settings.bg_full_width == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} > .vso-footer-07__background {
        width: calc(100% - (2 * var(--page-margin, 40px)));
      }
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} > .vso-footer-07__background {
      background: transparent;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} > .vso-footer-07__background {
      background-color: {{ section.settings.section_bg_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if section.settings.bg_full_width %}
        overflow: visible;
      {% endif %}
    }
  }

  {% if section.settings.bg_full_width %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} > .vso-footer-07__background::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100vw;
        background-color: {{ section.settings.section_bg_color }};
        z-index: -1;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-footer-07__background > .vso-footer-07__container {
    width: 100%;
    padding-top: var(--inner-padding-top-mobile);
    padding-bottom: var(--inner-padding-bottom-mobile);
    position: relative;
    display: flex;
    flex-direction: column;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-footer-07__background > .vso-footer-07__container {
      padding-top: var(--inner-padding-top);
      padding-bottom: var(--inner-padding-bottom);
    }
  }

  {% if benefits_block %}
    #shopify-section-{{ section.id }} .vso-footer-07__benefits-wrapper {
      position: relative;
      z-index: 20;
      display: flex;
      justify-content: center;
      align-items: stretch;
      width: 100vw;
      margin-left: calc(-50vw + 50%);
      margin-right: 0;
      padding-left: {{ benefits_block.settings.wrapper_padding_mobile | default: 0 }}px;
      padding-right: {{ benefits_block.settings.wrapper_padding_mobile | default: 0 }}px;
      padding-top: {{ benefits_block.settings.wrapper_padding_mobile | default: 0 }}px;
      padding-bottom: {{ benefits_block.settings.wrapper_padding_mobile | default: 0 }}px;
      margin-bottom: calc(-1 * {{ benefits_block.settings.overlap_mobile | default: benefits_block.settings.overlap_desktop | default: 60 }}px);
      background-color: {{ benefits_block.settings.benefits_wrapper_bg_mobile | default: benefits_block.settings.bg_color | default: '#ffffff' }};
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-footer-07__benefits-wrapper {
        display: flex;
        justify-content: center;
        align-items: stretch;
        {% if section.settings.bg_full_width %}
          width: 100vw;
          margin-left: calc(-50vw + 50%);
          margin-right: 0;
        {% else %}
          width: 100%;
          margin-left: auto;
          margin-right: auto;
          {% if section.settings.enable_advanced_settings %}
            {% if section.settings.section_full_width %}max-width: 100%;{% else %}max-width: {{ section.settings.section_max_width }}rem;{% endif %}
          {% endif %}
        {% endif %}
        padding-left: var(--inner-padding-horizontal);
        padding-right: var(--inner-padding-horizontal);
        padding-top: 0;
        padding-bottom: 0;
        margin-bottom: calc(-1 * {{ benefits_block.settings.overlap_desktop | default: 60 }}px);
        background-color: transparent;
      }
    }

    #shopify-section-{{ section.id }} .vso-footer-07__benefits {
      display: grid;
      grid-template-columns: 1fr;
      gap: {{ benefits_block.settings.gap_mobile | default: 16 }}px;
      background-color: {{ benefits_block.settings.bg_color | default: '#ffffff' }};
      border-radius: 0;
      padding: {{ benefits_block.settings.padding_mobile | default: 24 }}px;
      margin-left: auto;
      margin-right: auto;
      position: relative;
      border: none;
      width: 100%;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-footer-07__benefits {
        width: fit-content;
        max-width: 100%;
        grid-template-columns: repeat(3, 1fr);
        gap: {{ benefits_block.settings.gap_desktop | default: 24 }}px;
        border-radius: {{ benefits_block.settings.border_radius_desktop | default: 16 }}px;
        padding: {{ benefits_block.settings.padding_desktop | default: 32 }}px {{ benefits_block.settings.padding_horizontal_desktop | default: 48 }}px;
        margin-left: {{ benefits_block.settings.margin_horizontal_desktop | default: 0 }}px;
        margin-right: {{ benefits_block.settings.margin_horizontal_desktop | default: 0 }}px;
        border: {{ benefits_block.settings.border_width | default: 0 }}px solid {{ benefits_block.settings.border_color | default: 'transparent' }};
      }
    }

    #shopify-section-{{ section.id }} .vso-footer-07__benefit {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: {{ benefits_block.settings.benefit_gap | default: 12 }}px;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-footer-07__benefit {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
    }

    #shopify-section-{{ section.id }} .vso-footer-07__benefit-content {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-footer-07__benefit-content {
        align-items: center;
      }
    }

    #shopify-section-{{ section.id }} .vso-footer-07__benefit-icon {
      width: {{ benefits_block.settings.icon_size_mobile | default: 32 }}px;
      height: {{ benefits_block.settings.icon_size_mobile | default: 32 }}px;
      object-fit: contain;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-footer-07__benefit-icon {
        width: {{ benefits_block.settings.icon_size_desktop | default: 40 }}px;
        height: {{ benefits_block.settings.icon_size_desktop | default: 40 }}px;
      }
    }

    #shopify-section-{{ section.id }} .vso-footer-07__benefit-heading {
      margin: 0;
      font-weight: 600;
      color: {{ benefits_block.settings.heading_color | default: '#111111' }};
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    {% if benefits_block.settings.heading_custom_font %}
      #shopify-section-{{ section.id }} .vso-footer-07__benefit-heading {
        font-size: {{ benefits_block.settings.heading_size_mobile | default: 12 }}px;
        font-family: {{ benefits_block.settings.heading_font.family }}, {{ benefits_block.settings.heading_font.fallback_families }};
        font-style: {{ benefits_block.settings.heading_font.style }};
        line-height: {{ benefits_block.settings.heading_line_height }}%;
      }
      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} .vso-footer-07__benefit-heading {
          font-size: {{ benefits_block.settings.heading_size_desktop | default: 13 }}px;
        }
      }
    {% endif %}
    {% if benefits_block.settings.heading_custom_font and section.settings.enable_advanced_settings %}
      #shopify-section-{{ section.id }} .vso-footer-07__benefit-heading {
        font-weight: {{ benefits_block.settings.heading_font_weight | default: 600 }};
        letter-spacing: {{ benefits_block.settings.heading_letter_spacing | default: 2 }}px;
      }
    {% endif %}

    #shopify-section-{{ section.id }} .vso-footer-07__benefit-text {
      margin: 0;
      color: {{ benefits_block.settings.text_color | default: '#666666' }};
      line-height: 1.5;
    }
    {% if benefits_block.settings.text_custom_font %}
      #shopify-section-{{ section.id }} .vso-footer-07__benefit-text {
        font-size: {{ benefits_block.settings.text_size_mobile | default: 12 }}px;
        font-family: {{ benefits_block.settings.text_font.family }}, {{ benefits_block.settings.text_font.fallback_families }};
        font-style: {{ benefits_block.settings.text_font.style }};
        line-height: {{ benefits_block.settings.text_line_height }}%;
      }
      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} .vso-footer-07__benefit-text {
          font-size: {{ benefits_block.settings.text_size_desktop | default: 14 }}px;
        }
      }
    {% endif %}
    {% if benefits_block.settings.text_custom_font and section.settings.enable_advanced_settings %}
      #shopify-section-{{ section.id }} .vso-footer-07__benefit-text {
        font-weight: {{ benefits_block.settings.text_font_weight | default: 400 }};
        letter-spacing: {{ benefits_block.settings.text_letter_spacing | default: 0 }}px;
      }
    {% endif %}
  {% endif %}

  #shopify-section-{{ section.id }} .vso-footer-07__nav-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    order: 2;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__nav-grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.nav_columns_desktop | default: 4 }}, 1fr);
      gap: var(--columns-gap);
      order: unset;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__menu {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__menu {
      border-bottom: none;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__menu-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 16px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__menu-toggle {
      display: none;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__menu-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .vso-footer-07__menu-icon::before,
  #shopify-section-{{ section.id }} .vso-footer-07__menu-icon::after {
    content: '';
    position: absolute;
    background-color: {{ section.settings.text_color }};
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  #shopify-section-{{ section.id }} .vso-footer-07__menu-icon::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }
  #shopify-section-{{ section.id }} .vso-footer-07__menu-icon::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }
  #shopify-section-{{ section.id }} .vso-footer-07__menu.is-open .vso-footer-07__menu-icon::after {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .vso-footer-07__menu-heading {
    margin: 0;
    font-weight: 600;
    color: {{ section.settings.menu_heading_text_color }};
    letter-spacing: 1px;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__menu-heading {
      margin: 0 0 16px 0;
    }
  }
  {% if section.settings.menu_heading_custom_font %}
    #shopify-section-{{ section.id }} .vso-footer-07__menu-heading {
      font-size: var(--menu-heading-size-mobile);
      font-family: {{ section.settings.menu_heading_font.family }}, {{ section.settings.menu_heading_font.fallback_families }};
      font-style: {{ section.settings.menu_heading_font.style }};
      line-height: {{ section.settings.menu_heading_line_height }}%;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-footer-07__menu-heading {
        font-size: var(--menu-heading-size-desktop);
      }
    }
  {% endif %}
  {% if section.settings.menu_heading_custom_font and section.settings.enable_advanced_settings %}
    #shopify-section-{{ section.id }} .vso-footer-07__menu-heading {
      font-weight: {{ section.settings.menu_heading_font_weight }};
      letter-spacing: {{ section.settings.menu_heading_letter_spacing }}px;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-footer-07__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: none;
    flex-direction: column;
    gap: {{ section.settings.menu_items_gap | default: 10 }}px;
    padding-bottom: 16px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .vso-footer-07__menu.is-open .vso-footer-07__menu-list {
    display: flex;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__menu-list {
      display: flex;
      padding-bottom: 0;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__menu-heading-desktop {
    display: none;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__menu-heading-desktop {
      display: block;
      margin: 0 0 16px 0;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__menu-link {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    font-size: var(--menu-item-size-mobile);
    transition: opacity 0.2s ease;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-footer-07__menu-link {
      font-size: var(--menu-item-size-desktop);
    }
  }
  #shopify-section-{{ section.id }} .vso-footer-07__menu-link:hover {
    opacity: 0.7;
  }

  {%- assign logo_block = section.blocks | where: 'type', 'logo' | first -%}
  #shopify-section-{{ section.id }} .vso-footer-07__logo-wrapper {
    display: flex;
    justify-content: {{ logo_block.settings.alignment | default: 'center' }};
    margin-top: {{ logo_block.settings.margin_top_mobile | default: 40 }}px;
    margin-bottom: {{ logo_block.settings.margin_bottom_mobile | default: 40 }}px;
    order: 1;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__logo-wrapper {
      margin-top: {{ logo_block.settings.margin_top_desktop | default: 60 }}px;
      margin-bottom: {{ logo_block.settings.margin_bottom_desktop | default: 60 }}px;
      order: unset;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__logo {
    width: 100%;
    {% if logo_block.settings.logo_full_width %}
      max-width: 100%;
    {% else %}
      max-width: {{ logo_block.settings.max_width_mobile | default: 300 }}px;
    {% endif %}
    height: auto;
    object-fit: contain;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-footer-07__logo {
      {% if logo_block.settings.logo_full_width %}
        max-width: 100%;
      {% else %}
        max-width: {{ logo_block.settings.max_width_desktop | default: 800 }}px;
      {% endif %}
    }
  }

  {%- assign links_block = section.blocks | where: 'type', 'links' | first -%}
  #shopify-section-{{ section.id }} .vso-footer-07__links-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ links_block.settings.gap_mobile | default: 16 }}px;
    margin-top: {{ links_block.settings.margin_top_mobile | default: 24 }}px;
    margin-bottom: {{ links_block.settings.margin_bottom_mobile | default: 24 }}px;
    order: 3;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__links-wrapper {
      order: unset;
    }
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-footer-07__links-wrapper {
      gap: {{ links_block.settings.gap_desktop | default: 24 }}px;
      margin-top: {{ links_block.settings.margin_top_desktop | default: 32 }}px;
      margin-bottom: {{ links_block.settings.margin_bottom_desktop | default: 32 }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__link {
    color: {{ links_block.settings.link_color | default: section.settings.link_color }};
    text-decoration: none;
    font-size: {{ links_block.settings.font_size_mobile | default: 12 }}px;
    font-weight: {{ links_block.settings.font_weight | default: 400 }};
    transition: opacity 0.2s ease;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-footer-07__link {
      font-size: {{ links_block.settings.font_size_desktop | default: 14 }}px;
    }
  }
  #shopify-section-{{ section.id }} .vso-footer-07__link:hover {
    opacity: 0.7;
  }

  {%- assign bottom_block = section.blocks | where: 'type', 'bottom_bar' | first -%}
  #shopify-section-{{ section.id }} .vso-footer-07__bottom-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ bottom_block.settings.gap_mobile | default: 20 }}px;
    padding: {{ bottom_block.settings.padding_vertical_mobile | default: 24 }}px {{ bottom_block.settings.padding_horizontal_mobile | default: 16 }}px;
    background-color: {{ bottom_block.settings.bg_color | default: 'transparent' }};
    margin-top: {{ bottom_block.settings.margin_top_mobile | default: 0 }}px;
    order: 4;
  }
  #shopify-section-{{ section.id }} .vso-footer-07__bottom-bar > * {
    width: 100%;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: {{ bottom_block.settings.gap_desktop | default: 24 }}px;
      padding: {{ bottom_block.settings.padding_vertical_desktop | default: 24 }}px {{ bottom_block.settings.padding_horizontal_desktop | default: 40 }}px;
      margin-top: {{ bottom_block.settings.margin_top_desktop | default: 0 }}px;
      order: unset;
    }
    #shopify-section-{{ section.id }} .vso-footer-07__bottom-bar > * {
      width: auto;
      flex: 1 1 0%;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__copyright {
    margin: 0;
    color: {{ bottom_block.settings.copyright_color | default: section.settings.text_color }};
    text-transform: uppercase;
    text-align: center;
    order: 2;
    letter-spacing: 1px;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__copyright {
      text-align: left;
      order: 1;
    }
  }
  {% if bottom_block.settings.copyright_custom_font %}
    #shopify-section-{{ section.id }} .vso-footer-07__copyright {
      font-size: {{ bottom_block.settings.copyright_size_mobile | default: 11 }}px;
      font-family: {{ bottom_block.settings.copyright_font.family }}, {{ bottom_block.settings.copyright_font.fallback_families }};
      font-style: {{ bottom_block.settings.copyright_font.style }};
      line-height: {{ bottom_block.settings.copyright_line_height }}%;
    }
    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .vso-footer-07__copyright {
        font-size: {{ bottom_block.settings.copyright_size_desktop | default: 12 }}px;
      }
    }
  {% endif %}
  {% if bottom_block.settings.copyright_custom_font and section.settings.enable_advanced_settings %}
    #shopify-section-{{ section.id }} .vso-footer-07__copyright {
      font-weight: {{ bottom_block.settings.copyright_font_weight | default: 400 }};
      letter-spacing: {{ bottom_block.settings.copyright_letter_spacing | default: 1 }}px;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-footer-07__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ bottom_block.settings.payment_gap | default: 8 }}px;
    order: 3;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__payments {
      justify-content: flex-end;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__payment-icon {
    height: {{ bottom_block.settings.payment_icon_height | default: 24 }}px;
    width: auto;
  }
  #shopify-section-{{ section.id }} .vso-footer-07__payment-icon svg {
    height: 100%;
    width: auto;
  }

  #shopify-section-{{ section.id }} .vso-footer-07__social {
    display: flex;
    gap: {{ bottom_block.settings.social_gap | default: 16 }}px;
    flex-wrap: wrap;
    justify-content: center;
    order: 1;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .vso-footer-07__social {
      order: 2;
    }
  }

  #shopify-section-{{ section.id }} .vso-footer-07__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ bottom_block.settings.social_icon_size | default: 24 }}px;
    height: {{ bottom_block.settings.social_icon_size | default: 24 }}px;
    color: {{ bottom_block.settings.social_icon_color | default: section.settings.text_color }};
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .vso-footer-07__social-link:hover {
    opacity: 0.7;
  }
  #shopify-section-{{ section.id }} .vso-footer-07__social-link svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
{%- endstyle -%}

