<div class="vso-footer-07__background vso-node vd-l vso-hidden">
  <div class="vso-footer-07__container">
  {%- assign menu_blocks = section.blocks | where: 'type', 'menu' -%}
  {% if menu_blocks.size > 0 %}
    <div class="vso-footer-07__nav-grid">
      {%- for block in menu_blocks -%}
        <div class="vso-footer-07__menu" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <button type="button" class="vso-footer-07__menu-toggle" aria-expanded="false">
              {% if section.settings.menu_heading_custom_font %}
                <span class="vso-footer-07__menu-heading">{{ block.settings.heading }}</span>
              {% else %}
                {% assign mh_tag = section.settings.menu_heading_as | default: 'h5' %}
                <{{ mh_tag }} class="vso-footer-07__menu-heading">{{ block.settings.heading }}</{{ mh_tag }}>
              {% endif %}
              <span class="vso-footer-07__menu-icon" aria-hidden="true"></span>
            </button>
            {% if section.settings.menu_heading_custom_font %}
              <span class="vso-footer-07__menu-heading vso-footer-07__menu-heading-desktop">{{ block.settings.heading }}</span>
            {% else %}
              {% assign mh_tag = section.settings.menu_heading_as | default: 'h5' %}
              <{{ mh_tag }} class="vso-footer-07__menu-heading vso-footer-07__menu-heading-desktop">{{ block.settings.heading }}</{{ mh_tag }}>
            {% endif %}
          {% endif %}
          {% if block.settings.menu != blank %}
            <ul class="vso-footer-07__menu-list">
              {% for link in block.settings.menu.links %}
                <li><a class="vso-footer-07__menu-link" href="{{ link.url }}" {% if link.target %}target="{{ link.target }}"{% endif %}>{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>
  {% endif %}

  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'logo' -%}
        <div class="vso-footer-07__logo-wrapper" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'vso-footer-07__logo', widths: '400,600,800,1000,1200,1600' }}
          {% endif %}
        </div>

      {%- when 'links' -%}
        {% if block.settings.menu != blank %}
          <div class="vso-footer-07__links-wrapper" {{ block.shopify_attributes }}>
            {% for link in block.settings.menu.links %}
              <a class="vso-footer-07__link" href="{{ link.url }}" {% if link.target %}target="{{ link.target }}"{% endif %}>{{ link.title }}</a>
            {% endfor %}
          </div>
        {% endif %}

      {%- when 'bottom_bar' -%}
        <div class="vso-footer-07__bottom-bar" {{ block.shopify_attributes }}>
          {% if block.settings.copyright_custom_font %}
            <span class="vso-footer-07__copyright">
              &copy; {% if block.settings.show_shop_name %}{% if block.settings.shop_name_text != blank %}{{ block.settings.shop_name_text }}{% else %}{{ shop.name }}{% endif %}{% endif %} {{ 'now' | date: '%Y' }}{% if block.settings.rights_text != blank %} &bull; {{ block.settings.rights_text }}{% endif %}
            </span>
          {% else %}
            {% assign cp_tag = block.settings.copyright_as | default: 'p' %}
            <{{ cp_tag }} class="vso-footer-07__copyright">
              &copy; {% if block.settings.show_shop_name %}{% if block.settings.shop_name_text != blank %}{{ block.settings.shop_name_text }}{% else %}{{ shop.name }}{% endif %}{% endif %} {{ 'now' | date: '%Y' }}{% if block.settings.rights_text != blank %} &bull; {{ block.settings.rights_text }}{% endif %}
            </{{ cp_tag }}>
          {% endif %}

          {% if block.settings.show_social_icons %}
            <div class="vso-footer-07__social">
              {% if block.settings.social_facebook != blank %}
