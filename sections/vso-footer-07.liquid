                </a>
              {% endif %}
              {% if block.settings.social_tiktok != blank %}
                <a href="{{ block.settings.social_tiktok }}" class="vso-footer-07__social-link" aria-label="TikTok" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
                </a>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.show_payment_icons %}
            <div class="vso-footer-07__payments">
              {% for type in shop.enabled_payment_types %}
                <span class="vso-footer-07__payment-icon">{{ type | payment_type_svg_tag }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </div>

    {%- endcase -%}
  {%- endfor -%}
  </div>
</div>

<script>
  (function() {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const toggleButtons = section.querySelectorAll('.vso-footer-07__menu-toggle');

    toggleButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        const menu = this.closest('.vso-footer-07__menu');
        const isOpen = menu.classList.contains('is-open');

        menu.classList.toggle('is-open');

        this.setAttribute('aria-expanded', !isOpen);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "VSO - Footer 07",
  "tag": "section",
  "class": "section vso-node vso-node--v2 vso-footer-07",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Section Settings" },
    { "type": "checkbox", "id": "enable_advanced_settings", "label": "Enable advanced settings", "default": false, "info": "Shows additional settings for spacing, layout, and typography." },
    { "type": "checkbox", "id": "section_full_width", "label": "Full width", "default": false, "visible_if": "{{ section.settings.enable_advanced_settings }}" },
    { "type": "range", "id": "section_max_width", "label": "Content max width", "min": 30, "max": 220, "step": 2, "unit": "rem", "default": 120, "visible_if": "{{ section.settings.enable_advanced_settings }}" },
    { "type": "range", "id": "nav_columns_desktop", "label": "Navigation columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "inner_padding_horizontal", "label": "Desktop side spacing", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ section.settings.enable_advanced_settings }}" },
    { "type": "range", "id": "inner_padding_horizontal_mobile", "label": "Mobile side spacing", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ section.settings.enable_advanced_settings }}" },

    { "type": "header", "content": "Section Background" },
