<section class="listicle-froya-result-progress section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lf-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="lfrp-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="lfrp-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="lfrp-list">
        {% for block in section.blocks %}
          {% if block.type == 'progress_item' %}
            <div class="lfrp-item lfrp-block-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="lfrp-item__media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'lfrp-item__image', alt: block.settings.title }}
                {% endif %}
                {% if block.settings.progress_label != blank %}
                  <span class="lfrp-item__label">{{ block.settings.progress_label }}</span>
                {% endif %}
              </div>
              <div class="lfrp-item__content">
                {% if block.settings.title != blank %}
                  <h3 class="lfrp-item__title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="lfrp-item__text rte">{{ block.settings.text }}</div>
                {% endif %}
                <div class="lfrp-item__bar" aria-hidden="true">
                  <span class="lfrp-item__bar-fill" style="width: {{ block.settings.progress_percent }}%;"></span>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% render 'listicle-froya-section-base', section: section %}

<style>
  .section-{{ section.id }} .lfrp-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 8px;
  }

  .section-{{ section.id }} .lfrp-subheading {
    font-size: {{ section.settings.subheading_font_size_mobile }}px;
    color: {{ section.settings.subheading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .section-{{ section.id }} .lfrp-list {
    display: grid;
    gap: {{ section.settings.item_gap_mobile }}px;
  }

  .section-{{ section.id }} .lfrp-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: center;
    background: {{ section.settings.item_bg_color }};
    border-radius: {{ section.settings.item_border_radius }}px;
    padding: 16px;
  }

  .section-{{ section.id }} .lfrp-item__media {
    position: relative;
  }

  .section-{{ section.id }} .lfrp-item__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ section.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .section-{{ section.id }} .lfrp-item__label {
    position: absolute;
    left: 12px;
    bottom: 12px;
    background: {{ section.settings.label_bg_color }};
    color: {{ section.settings.label_text_color }};
    font-size: {{ section.settings.label_font_size_mobile }}px;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 999px;
  }

  .section-{{ section.id }} .lfrp-item__title {
    font-size: {{ section.settings.item_title_size_mobile }}px;
    font-weight: {{ section.settings.item_title_weight }};
    color: {{ section.settings.item_title_color }};
    margin: 0 0 8px;
  }

  .section-{{ section.id }} .lfrp-item__text {
    font-size: {{ section.settings.item_text_size_mobile }}px;
    color: {{ section.settings.item_text_color }};
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .section-{{ section.id }} .lfrp-item__bar {
    height: {{ section.settings.bar_height }}px;
    background: {{ section.settings.bar_bg_color }};
    border-radius: {{ section.settings.bar_height }}px;
    overflow: hidden;
  }

  .section-{{ section.id }} .lfrp-item__bar-fill {
    display: block;
    height: 100%;
    background: {{ section.settings.bar_fill_color }};
    border-radius: inherit;
    transition: width 0.6s ease;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .lfrp-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfrp-subheading {
      font-size: {{ section.settings.subheading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfrp-list {
      gap: {{ section.settings.item_gap_desktop }}px;
    }

    .section-{{ section.id }} .lfrp-item {
      grid-template-columns: 1fr 1fr;
      padding: 24px;
    }

    .section-{{ section.id }} .lfrp-item__label {
      font-size: {{ section.settings.label_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfrp-item__title {
      font-size: {{ section.settings.item_title_size_desktop }}px;
    }

    .section-{{ section.id }} .lfrp-item__text {
      font-size: {{ section.settings.item_text_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Listicle Froya – Result Progress",
  "tag": "section",
  "class": "section-listicle-froya-result-progress",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real results over time" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "range", "id": "item_gap_mobile", "min": 12, "max": 40, "step": 4, "unit": "px", "label": "Item gap (mobile)", "default": 16 },
    { "type": "range", "id": "item_gap_desktop", "min": 16, "max": 48, "step": 4, "unit": "px", "label": "Item gap (desktop)", "default": 24 },
    { "type": "color", "id": "item_bg_color", "label": "Item background", "default": "#faf8f6" },
    { "type": "range", "id": "item_border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Item radius", "default": 12 },
    { "type": "range", "id": "image_border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Image radius", "default": 8 },
    { "type": "color", "id": "label_bg_color", "label": "Label background", "default": "#cc667c" },
    { "type": "color", "id": "label_text_color", "label": "Label text", "default": "#ffffff" },
    { "type": "range", "id": "label_font_size_mobile", "min": 10, "max": 16, "step": 1, "unit": "px", "label": "Label size (mobile)", "default": 12 },
    { "type": "range", "id": "label_font_size_desktop", "min": 10, "max": 16, "step": 1, "unit": "px", "label": "Label size (desktop)", "default": 13 },
    { "type": "range", "id": "bar_height", "min": 4, "max": 16, "step": 1, "unit": "px", "label": "Progress bar height", "default": 8 },
    { "type": "color", "id": "bar_bg_color", "label": "Bar background", "default": "#e5e7eb" },
    { "type": "color", "id": "bar_fill_color", "label": "Bar fill", "default": "#cc667c" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size_mobile", "min": 20, "max": 48, "step": 2, "unit": "px", "label": "Heading size (mobile)", "default": 28 },
    { "type": "range", "id": "heading_font_size_desktop", "min": 24, "max": 56, "step": 2, "unit": "px", "label": "Heading size (desktop)", "default": 40 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" },
      { "value": "700", "label": "Bold" }
    ], "default": "600" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1f2937" },
    { "type": "range", "id": "subheading_font_size_mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Subheading size (mobile)", "default": 15 },
    { "type": "range", "id": "subheading_font_size_desktop", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Subheading size (desktop)", "default": 16 },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#6b7280" },
    { "type": "range", "id": "item_title_size_mobile", "min": 16, "max": 28, "step": 1, "unit": "px", "label": "Item title size (mobile)", "default": 18 },
    { "type": "range", "id": "item_title_size_desktop", "min": 18, "max": 32, "step": 1, "unit": "px", "label": "Item title size (desktop)", "default": 22 },
    { "type": "select", "id": "item_title_weight", "label": "Item title weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" }
    ], "default": "600" },
    { "type": "color", "id": "item_title_color", "label": "Item title color", "default": "#111827" },
    { "type": "range", "id": "item_text_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Item text size (mobile)", "default": 14 },
    { "type": "range", "id": "item_text_size_desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Item text size (desktop)", "default": 15 },
    { "type": "color", "id": "item_text_color", "label": "Item text color", "default": "#4b5563" },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "checkbox", "id": "gradient_enabled", "label": "Use gradient background", "default": false },
    { "type": "color_background", "id": "gradient_background", "label": "Gradient", "default": "linear-gradient(180deg, rgba(255,255,255,1), rgba(250,248,246,1) 100%)" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "body_color", "label": "Body color", "default": "#374151" },
    { "type": "range", "id": "body_font_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Body size (mobile)", "default": 16 },
    { "type": "range", "id": "body_font_size_desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Body size (desktop)", "default": 16 },
    { "type": "range", "id": "container_max_width", "min": 600, "max": 1400, "step": 10, "unit": "px", "label": "Container max width", "default": 1000 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (mobile)", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (mobile)", "default": 32 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (desktop)", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (desktop)", "default": 48 }
  ],
  "blocks": [
    {
      "type": "progress_item",
      "name": "Progress item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "progress_label", "label": "Progress label", "default": "Week 4" },
        { "type": "range", "id": "progress_percent", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Progress percent", "default": 75 },
        { "type": "text", "id": "title", "label": "Title", "default": "Visible improvement" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe the result at this stage.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Listicle Froya – Result Progress",
      "blocks": [
        { "type": "progress_item" },
        { "type": "progress_item" },
        { "type": "progress_item" }
      ]
    }
  ]
}
{% endschema %}
