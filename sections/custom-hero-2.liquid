{% comment %}
  Custom Hero 2 — full-viewport stacked hero with arrangeable blocks.
  Main settings are independent from Custom Hero.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign d_justify = section.settings.desktop_justify_content | default: 'center'
  assign m_justify = section.settings.mobile_justify_content | default: 'center'
  assign d_align = section.settings.desktop_align_items | default: 'center'
  assign m_align = section.settings.mobile_align_items | default: 'center'
  assign d_text = 'center'
  if d_align == 'flex-start'
    assign d_text = 'left'
  elsif d_align == 'flex-end'
    assign d_text = 'right'
  endif
  assign m_text = 'center'
  if m_align == 'flex-start'
    assign m_text = 'left'
  elsif m_align == 'flex-end'
    assign m_text = 'right'
  endif

  assign d_content_pos = section.settings.desktop_content_position | default: 'center'
  assign m_content_pos = section.settings.mobile_content_position | default: 'center'
  assign d_shell_justify = 'center'
  if d_content_pos == 'left'
    assign d_shell_justify = 'flex-start'
  elsif d_content_pos == 'right'
    assign d_shell_justify = 'flex-end'
  endif
  assign m_shell_justify = 'center'
  if m_content_pos == 'left'
    assign m_shell_justify = 'flex-start'
  elsif m_content_pos == 'right'
    assign m_shell_justify = 'flex-end'
  endif

  assign header_scheme = section.settings.header_color_scheme | default: 'dark'

  case section.settings.desktop_height
    when 'full'
      assign d_height = '100vh'
    when '90'
      assign d_height = '90vh'
    when '80'
      assign d_height = '80vh'
    when '70'
      assign d_height = '70vh'
    when '60'
      assign d_height = '60vh'
    when '50'
      assign d_height = '50vh'
    else
      assign d_height = 'auto'
  endcase

  case section.settings.mobile_height
    when 'full'
      assign m_height = '100svh'
    when '90'
      assign m_height = '90svh'
    when '80'
      assign m_height = '80svh'
    when '70'
      assign m_height = '70svh'
    when '60'
      assign m_height = '60svh'
    when '50'
      assign m_height = '50svh'
    else
      assign m_height = 'auto'
  endcase
-%}

{% capture check_icon %}
  {% render 'icons', icon: 'check-2' %}
{% endcapture %}
{% capture guarantee_icon %}
  {% render 'icons', icon: 'guarantee_icon' %}
{% endcapture %}

{%- style -%}
  #shopify-section-{{ sid }} {
    position: relative;
  }

  .ch2-{{ sid }} {
    position: relative;
    width: 100%;
    min-height: {{ d_height }};
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: {{ section.settings.background_color | default: '#000000' }};
  }

  .ch2-{{ sid }}__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .ch2-{{ sid }}__bg-img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.background_fit | default: 'cover' }};
    object-position: {{ section.settings.background_position | default: 'center center' }};
  }

  .ch2-{{ sid }}__bg-img--desktop { display: block; }
  .ch2-{{ sid }}__bg-img--mobile { display: none; }

  .ch2-{{ sid }}__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ch2-{{ sid }}__shell {
    position: relative;
    z-index: 2;
    width: 100%;
    {% if section.settings.constrain_to_page_width %}
      max-width: var(--page-content-width, var(--page-width, 1440px));
      margin-left: auto;
      margin-right: auto;
    {% else %}
      max-width: none;
    {% endif %}
    min-height: {{ d_height }};
    display: flex;
    flex-direction: row;
    justify-content: {{ d_shell_justify }};
    align-items: stretch;
    box-sizing: border-box;
    padding: {{ section.settings.padding_top | default: 80 }}px {{ section.settings.padding_horizontal | default: 24 }}px {{ section.settings.padding_bottom | default: 40 }}px;
  }

  .ch2-{{ sid }}__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: {{ section.settings.content_max_width | default: 720 }}px;
    min-height: calc({{ d_height }} - {{ section.settings.padding_top | default: 80 }}px - {{ section.settings.padding_bottom | default: 40 }}px);
    display: flex;
    flex-direction: column;
    justify-content: {{ d_justify }};
    align-items: {{ d_align }};
    text-align: {{ d_text }};
    box-sizing: border-box;
    gap: {{ section.settings.blocks_gap | default: 0 }}px;
  }

  .ch2-{{ sid }}__block {
    width: 100%;
    max-width: 100%;
  }

  /* Rating */
  .ch2-{{ sid }} .ch2__rating {
    display: flex;
    align-items: center;
    justify-content: {{ d_align }};
    flex-wrap: wrap;
    gap: 8px;
  }
  .ch2-{{ sid }} .ch2__rating-stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .ch2-{{ sid }} .ch2__rating-stars svg {
    width: var(--ch2-star-size, 16px);
    height: var(--ch2-star-size, 16px);
    fill: currentColor;
  }
  .ch2-{{ sid }} .ch2__rating-text {
    margin: 0;
    line-height: 1.4;
  }
  .ch2-{{ sid }} .ch2__rating-text p { margin: 0; }

  /* Heading */
  .ch2-{{ sid }} .ch2__heading {
    margin: 0;
    width: 100%;
  }
  .ch2-{{ sid }} .ch2__heading-accent {
    display: inline;
  }
  .ch2-{{ sid }} .ch2__heading--accent-below,
  .ch2-{{ sid }} .ch2__heading--accent-above {
    display: flex;
    flex-direction: column;
    align-items: {{ d_align }};
    gap: 4px;
  }
  .ch2-{{ sid }} .ch2__heading--accent-above {
    flex-direction: column-reverse;
  }

  /* Subtitle */
  .ch2-{{ sid }} .ch2__subtitle {
    width: 100%;
  }
  .ch2-{{ sid }} .ch2__subtitle p { margin: 0; }

  /* Button */
  .ch2-{{ sid }} .ch2__button-wrap {
    display: flex;
    justify-content: {{ d_align }};
    width: 100%;
  }
  .ch2-{{ sid }} .ch2__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-sizing: border-box;
  }
  .ch2-{{ sid }} .ch2__button:hover { opacity: 0.92; }
  .ch2-{{ sid }} .ch2__button--full { width: 100%; }

  /* Guarantee */
  .ch2-{{ sid }} .ch2__guarantee {
    display: flex;
    align-items: center;
    justify-content: {{ d_align }};
    gap: 8px;
    flex-wrap: wrap;
  }
  .ch2-{{ sid }} .ch2__guarantee-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ch2-{{ sid }} .ch2__guarantee-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Image block */
  .ch2-{{ sid }} .ch2__image-wrap {
    width: 100%;
    display: flex;
    justify-content: {{ d_align }};
  }
  .ch2-{{ sid }} .ch2__image {
    width: 100%;
    height: auto;
    display: block;
  }
  .ch2-{{ sid }} .ch2__image--desktop { display: block; }
  .ch2-{{ sid }} .ch2__image--mobile { display: none; }

  /* Badge */
  .ch2-{{ sid }} .ch2__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ d_align }};
    gap: 8px;
  }
  .ch2-{{ sid }} .ch2__badge {
    display: inline-block;
  }

  /* Spacer */
  .ch2-{{ sid }} .ch2__spacer {
    width: 100%;
    flex-shrink: 0;
  }

  /* Per-block styles */
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'rating' %}
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
          margin-top: {{ block.settings.margin_top | default: 0 }}px;
          margin-bottom: {{ block.settings.margin_bottom | default: 12 }}px;
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__rating {
          --ch2-star-size: {{ block.settings.star_size_desktop | default: 16 }}px;
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__rating-stars {
          color: {{ block.settings.star_color | default: '#C9A227' }};
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__rating-text {
          color: {{ block.settings.text_color | default: '#FFFFFF' }};
          font-size: {{ block.settings.font_size_desktop | default: 14 }}px;
          font-weight: {{ block.settings.font_weight | default: 400 }};
        }

      {% when 'heading' %}
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
          margin-top: {{ block.settings.margin_top | default: 0 }}px;
          margin-bottom: {{ block.settings.margin_bottom | default: 16 }}px;
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__heading {
          color: {{ block.settings.heading_color | default: '#FFFFFF' }};
          font-size: {{ block.settings.font_size_desktop | default: 42 }}px;
          line-height: {{ block.settings.line_height | default: 1.15 }};
          font-weight: {{ block.settings.font_weight | default: 700 }};
          letter-spacing: {{ block.settings.letter_spacing | default: 0 }}px;
          text-transform: {{ block.settings.text_transform | default: 'none' }};
          {% if block.settings.font_family == 'serif' %}
            font-family: Georgia, 'Times New Roman', serif;
          {% endif %}
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__heading-accent {
          color: {{ block.settings.accent_color | default: '#FFFFFF' }};
          font-size: {{ block.settings.accent_font_size_desktop | default: 42 }}px;
          font-weight: {{ block.settings.accent_font_weight | default: 700 }};
          {% if block.settings.accent_italic %}font-style: italic;{% endif %}
          {% if block.settings.use_accent_gradient and block.settings.accent_gradient != blank %}
            background: {{ block.settings.accent_gradient }};
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
          {% endif %}
        }

      {% when 'subtitle' %}
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
          margin-top: {{ block.settings.margin_top | default: 0 }}px;
          margin-bottom: {{ block.settings.margin_bottom | default: 24 }}px;
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__subtitle {
          color: {{ block.settings.text_color | default: '#FFFFFF' }};
          font-size: {{ block.settings.font_size_desktop | default: 16 }}px;
          line-height: {{ block.settings.line_height | default: 1.5 }};
          font-weight: {{ block.settings.font_weight | default: 400 }};
          max-width: {{ block.settings.max_width | default: 100 }}%;
          {% if d_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
          {% if d_align == 'flex-end' %}margin-left: auto;{% endif %}
        }

      {% when 'button' %}
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
          margin-top: {{ block.settings.margin_top | default: 0 }}px;
          margin-bottom: {{ block.settings.margin_bottom | default: 16 }}px;
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__button {
          color: {{ block.settings.button_text_color | default: '#FFFFFF' }};
          {% if block.settings.use_gradient and block.settings.button_gradient != blank %}
            background: {{ block.settings.button_gradient }};
          {% else %}
            background-color: {{ block.settings.button_bg_color | default: '#C9A227' }};
          {% endif %}
          border: {{ block.settings.border_width | default: 0 }}px solid {{ block.settings.border_color | default: '#C9A227' }};
          border-radius: {{ block.settings.border_radius | default: 4 }}px;
          font-size: {{ block.settings.font_size_desktop | default: 15 }}px;
          font-weight: {{ block.settings.font_weight | default: 700 }};
          text-transform: {{ block.settings.text_transform | default: 'uppercase' }};
          letter-spacing: {{ block.settings.letter_spacing | default: 1 }}px;
          padding: {{ block.settings.padding_vertical | default: 16 }}px {{ block.settings.padding_horizontal | default: 32 }}px;
          {% if block.settings.full_width %}width: 100%;{% endif %}
          max-width: {{ block.settings.max_width_desktop | default: 100 }}%;
        }

      {% when 'guarantee' %}
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
          margin-top: {{ block.settings.margin_top | default: 0 }}px;
          margin-bottom: {{ block.settings.margin_bottom | default: 20 }}px;
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__guarantee {
          color: {{ block.settings.text_color | default: '#FFFFFF' }};
          font-size: {{ block.settings.font_size_desktop | default: 13 }}px;
          font-weight: {{ block.settings.font_weight | default: 400 }};
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__guarantee-icon {
          width: {{ block.settings.icon_size_desktop | default: 18 }}px;
          height: {{ block.settings.icon_size_desktop | default: 18 }}px;
          color: {{ block.settings.icon_color | default: '#C9A227' }};
        }

      {% when 'image' %}
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
          margin-top: {{ block.settings.margin_top | default: 0 }}px;
          margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__image {
          max-width: {{ block.settings.max_width_desktop | default: 100 }}%;
          border-radius: {{ block.settings.border_radius | default: 0 }}px;
          object-fit: {{ block.settings.object_fit | default: 'contain' }};
        }

      {% when 'badge' %}
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
          margin-top: {{ block.settings.margin_top | default: 0 }}px;
          margin-bottom: {{ block.settings.margin_bottom | default: 12 }}px;
        }
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__badge {
          background-color: {{ block.settings.badge_bg | default: '#FFFFFF' }};
          color: {{ block.settings.badge_text_color | default: '#000000' }};
          font-size: {{ block.settings.font_size_desktop | default: 12 }}px;
          font-weight: {{ block.settings.font_weight | default: 600 }};
          padding: {{ block.settings.padding_vertical | default: 6 }}px {{ block.settings.padding_horizontal | default: 12 }}px;
          border-radius: {{ block.settings.border_radius | default: 20 }}px;
          text-transform: {{ block.settings.text_transform | default: 'uppercase' }};
          letter-spacing: 0.5px;
        }

      {% when 'spacer' %}
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__spacer {
          height: {{ block.settings.height_desktop | default: 24 }}px;
        }

      {% when 'custom_html' %}
        .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
          margin-top: {{ block.settings.margin_top | default: 0 }}px;
          margin-bottom: {{ block.settings.margin_bottom | default: 16 }}px;
        }
    {% endcase %}
  {% endfor %}

  @media screen and (max-width: 749px) {
    .ch2-{{ sid }} {
      min-height: {{ m_height }};
    }

    .ch2-{{ sid }}__bg-img--desktop { display: none; }
    .ch2-{{ sid }}__bg-img--mobile { display: block; }

    .ch2-{{ sid }}__shell {
      min-height: {{ m_height }};
      justify-content: {{ m_shell_justify }};
      padding: {{ section.settings.padding_top_mobile | default: 72 }}px {{ section.settings.padding_horizontal_mobile | default: 20 }}px {{ section.settings.padding_bottom_mobile | default: 24 }}px;
    }

    .ch2-{{ sid }}__inner {
      min-height: calc({{ m_height }} - {{ section.settings.padding_top_mobile | default: 72 }}px - {{ section.settings.padding_bottom_mobile | default: 24 }}px);
      justify-content: {{ m_justify }};
      align-items: {{ m_align }};
      text-align: {{ m_text }};
      max-width: {{ section.settings.content_max_width_mobile | default: 100 }}%;
    }

    .ch2-{{ sid }} .ch2__rating,
    .ch2-{{ sid }} .ch2__button-wrap,
    .ch2-{{ sid }} .ch2__guarantee,
    .ch2-{{ sid }} .ch2__image-wrap,
    .ch2-{{ sid }} .ch2__badges {
      justify-content: {{ m_align }};
    }

    .ch2-{{ sid }} .ch2__heading--accent-below,
    .ch2-{{ sid }} .ch2__heading--accent-above {
      align-items: {{ m_align }};
    }

    .ch2-{{ sid }} .ch2__image--desktop { display: none; }
    .ch2-{{ sid }} .ch2__image--mobile { display: block; }

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'rating' %}
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
            margin-top: {{ block.settings.margin_top_mobile | default: 0 }}px;
            margin-bottom: {{ block.settings.margin_bottom_mobile | default: 10 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__rating {
            --ch2-star-size: {{ block.settings.star_size_mobile | default: 14 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__rating-text {
            font-size: {{ block.settings.font_size_mobile | default: 12 }}px;
          }

        {% when 'heading' %}
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
            margin-top: {{ block.settings.margin_top_mobile | default: 0 }}px;
            margin-bottom: {{ block.settings.margin_bottom_mobile | default: 12 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__heading {
            font-size: {{ block.settings.font_size_mobile | default: 32 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__heading-accent {
            font-size: {{ block.settings.accent_font_size_mobile | default: 32 }}px;
          }

        {% when 'subtitle' %}
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
            margin-top: {{ block.settings.margin_top_mobile | default: 0 }}px;
            margin-bottom: {{ block.settings.margin_bottom_mobile | default: 20 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__subtitle {
            font-size: {{ block.settings.font_size_mobile | default: 14 }}px;
            max-width: {{ block.settings.max_width_mobile | default: 100 }}%;
            {% if m_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
            {% if m_align == 'flex-end' %}margin-left: auto; margin-right: 0;{% endif %}
            {% if m_align == 'flex-start' %}margin-left: 0; margin-right: auto;{% endif %}
          }

        {% when 'button' %}
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
            margin-top: {{ block.settings.margin_top_mobile | default: 0 }}px;
            margin-bottom: {{ block.settings.margin_bottom_mobile | default: 14 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__button {
            font-size: {{ block.settings.font_size_mobile | default: 14 }}px;
            padding: {{ block.settings.padding_vertical_mobile | default: 14 }}px {{ block.settings.padding_horizontal_mobile | default: 24 }}px;
            max-width: {{ block.settings.max_width_mobile | default: 100 }}%;
            {% if block.settings.full_width_mobile %}width: 100%;{% endif %}
          }

        {% when 'guarantee' %}
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
            margin-top: {{ block.settings.margin_top_mobile | default: 0 }}px;
            margin-bottom: {{ block.settings.margin_bottom_mobile | default: 16 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__guarantee {
            font-size: {{ block.settings.font_size_mobile | default: 12 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__guarantee-icon {
            width: {{ block.settings.icon_size_mobile | default: 16 }}px;
            height: {{ block.settings.icon_size_mobile | default: 16 }}px;
          }

        {% when 'image' %}
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
            margin-top: {{ block.settings.margin_top_mobile | default: 0 }}px;
            margin-bottom: {{ block.settings.margin_bottom_mobile | default: 0 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__image {
            max-width: {{ block.settings.max_width_mobile | default: 100 }}%;
          }

        {% when 'badge' %}
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
            margin-top: {{ block.settings.margin_top_mobile | default: 0 }}px;
            margin-bottom: {{ block.settings.margin_bottom_mobile | default: 10 }}px;
          }
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__badge {
            font-size: {{ block.settings.font_size_mobile | default: 11 }}px;
          }

        {% when 'spacer' %}
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] .ch2__spacer {
            height: {{ block.settings.height_mobile | default: 16 }}px;
          }

        {% when 'custom_html' %}
          .ch2-{{ sid }} .ch2__block[data-block-id="{{ block.id }}"] {
            margin-top: {{ block.settings.margin_top_mobile | default: 0 }}px;
            margin-bottom: {{ block.settings.margin_bottom_mobile | default: 12 }}px;
          }
      {% endcase %}
    {% endfor %}
  }

  /* Transparent header — chrome only.
     Do NOT touch header-drawer open/close, summary::before underlay,
     .icon-hamburger / .icon-close visibility/opacity, or #menu-drawer. */
  {% if section.settings.transparent_header %}
    #shopify-section-{{ sid }} {
      margin-top: calc(-1 * var(--header-height, 64px));
    }

    html.ch2-th-ready .section-header {
      z-index: 1001;
    }

    /* Pause transparent chrome while the native drawer <details> is open */
    html.ch2-th-ready .section-header:not(:has(#Details-menu-drawer-container[open])) sticky-header.header-wrapper,
    html.ch2-th-ready .section-header:not(:has(#Details-menu-drawer-container[open])) .header-wrapper {
      transition:
        background-color 0.35s ease,
        background 0.35s ease,
        box-shadow 0.35s ease,
        border-color 0.35s ease,
        backdrop-filter 0.35s ease,
        -webkit-backdrop-filter 0.35s ease;
    }

    html.ch2-th-ready .section-header .header__heading-link.media {
      position: relative;
    }

    html.ch2-th-ready .section-header .header__heading-logo--main,
    html.ch2-th-ready .section-header .header__heading-logo--secondary {
      transition: opacity 0.35s ease;
    }

    {% if settings.secondary_logo != blank %}
      html.ch2-th-ready .section-header .header__heading-logo--secondary {
        display: block !important;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        pointer-events: none;
      }
    {% endif %}

    /* Color transitions — cart/account/search + inline nav only (never menu drawer) */
    html.ch2-th-ready .section-header:not(:has(#Details-menu-drawer-container[open])) .header__icons .header__icon:not(.header__icon--menu),
    html.ch2-th-ready .section-header:not(:has(#Details-menu-drawer-container[open])) .header__icons .header__icon:not(.header__icon--menu) svg,
    html.ch2-th-ready .section-header:not(:has(#Details-menu-drawer-container[open])) .header__icons .header__icon:not(.header__icon--menu) .material-icon,
    html.ch2-th-ready .section-header:not(:has(#Details-menu-drawer-container[open])) .header__heading-link,
    html.ch2-th-ready .section-header:not(:has(#Details-menu-drawer-container[open])) .header__inline-menu .header__menu-item {
      transition: color 0.35s ease, fill 0.35s ease;
    }

    html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) sticky-header.header-wrapper,
    html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header-wrapper {
