      box-shadow: none !important;
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
      border-bottom-color: transparent !important;
      border-color: transparent !important;
    }

    {% if header_scheme == 'dark' %}
      {% if settings.secondary_logo != blank %}
        html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__heading-logo--main {
          opacity: 0;
        }
        html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__heading-logo--secondary {
