      {% endif %}
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__icons .header__icon:not(.header__icon--menu),
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__icons .header__icon:not(.header__icon--menu) svg,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__icons .header__icon:not(.header__icon--menu) .material-icon,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__heading,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__heading-link,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__inline-menu .header__menu-item,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__inline-menu .list-menu__item {
        color: #FFFFFF !important;
        fill: #FFFFFF !important;
      }
      /* Hamburger color only when drawer is closed — never opacity/visibility */
      html.ch2-th-overlay .section-header header-drawer > details:not([open]) > summary.header__icon--menu,
      html.ch2-th-overlay .section-header header-drawer > details:not([open]) > summary.header__icon--menu .icon-hamburger,
      html.ch2-th-overlay .section-header header-drawer > details:not([open]) > summary.header__icon--menu .icon-hamburger svg,
      html.ch2-th-overlay .section-header header-drawer > details:not([open]) > summary.header__icon--menu .icon-hamburger .material-icon {
        color: #FFFFFF !important;
        fill: #FFFFFF !important;
      }
    {% else %}
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__heading-logo--main {
        opacity: 1;
      }
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__heading-logo--secondary {
        opacity: 0;
      }
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__icons .header__icon:not(.header__icon--menu),
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__icons .header__icon:not(.header__icon--menu) svg,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__icons .header__icon:not(.header__icon--menu) .material-icon,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__heading,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__heading-link,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__inline-menu .header__menu-item,
      html.ch2-th-overlay .section-header:not(:has(#Details-menu-drawer-container[open])) .header__inline-menu .list-menu__item {
        color: #000000 !important;
        fill: #000000 !important;
      }
      html.ch2-th-overlay .section-header header-drawer > details:not([open]) > summary.header__icon--menu,
      html.ch2-th-overlay .section-header header-drawer > details:not([open]) > summary.header__icon--menu .icon-hamburger,
      html.ch2-th-overlay .section-header header-drawer > details:not([open]) > summary.header__icon--menu .icon-hamburger svg,
      html.ch2-th-overlay .section-header header-drawer > details:not([open]) > summary.header__icon--menu .icon-hamburger .material-icon {
        color: #000000 !important;
        fill: #000000 !important;
      }
    {% endif %}

    /* Drawer panel is off-limits — restore close icon to drawer text token only */
    html.ch2-th-ready .section-header #menu-drawer .menu-drawer__close-btn,
    html.ch2-th-ready .section-header #menu-drawer .menu-drawer__close-btn svg,
    html.ch2-th-ready .section-header #menu-drawer .menu-drawer__close-btn .icon,
    html.ch2-th-ready .section-header #menu-drawer .menu-drawer__close-btn .material-icon,
    html.ch2-th-overlay .section-header #menu-drawer .menu-drawer__close-btn,
    html.ch2-th-overlay .section-header #menu-drawer .menu-drawer__close-btn svg,
    html.ch2-th-overlay .section-header #menu-drawer .menu-drawer__close-btn .icon,
    html.ch2-th-overlay .section-header #menu-drawer .menu-drawer__close-btn .material-icon {
      color: var(--drawer-text) !important;
      fill: var(--drawer-text) !important;
    }
  {% endif %}
{%- endstyle -%}

{%- if section.settings.transparent_header -%}
  <script>
    document.documentElement.classList.add('ch2-th-ready', 'ch2-th-overlay');
    if (document.body) document.body.classList.add('ch2-th-ready', 'ch2-th-overlay');
  </script>
{%- endif -%}

<section
  id="CustomHero2-{{ sid }}"
  class="ch2-{{ sid }} custom-hero-2"
  data-section-id="{{ sid }}"
  {% if section.settings.transparent_header %}data-transparent-header="true"{% endif %}
>
  <div class="ch2-{{ sid }}__bg" aria-hidden="true">
    {%- liquid
      assign bg_class_desktop = 'ch2-' | append: sid | append: '__bg-img ch2-' | append: sid | append: '__bg-img--desktop'
      assign bg_class_mobile = 'ch2-' | append: sid | append: '__bg-img ch2-' | append: sid | append: '__bg-img--mobile'
    -%}
    {%- if section.settings.background_desktop != blank -%}
      {{ section.settings.background_desktop | image_url: width: 2400 | image_tag: class: bg_class_desktop, loading: 'eager', widths: '800,1200,1600,2000,2400', sizes: '100vw', alt: '' }}
    {%- endif -%}
    {%- if section.settings.background_mobile != blank -%}
      {{ section.settings.background_mobile | image_url: width: 1200 | image_tag: class: bg_class_mobile, loading: 'eager', widths: '400,600,800,1000,1200', sizes: '100vw', alt: '' }}
    {%- elsif section.settings.background_desktop != blank -%}
      {{ section.settings.background_desktop | image_url: width: 1200 | image_tag: class: bg_class_mobile, loading: 'eager', widths: '400,600,800,1000,1200', sizes: '100vw', alt: '' }}
    {%- endif -%}
  </div>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="ch2-{{ sid }}__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="ch2-{{ sid }}__shell">
  <div class="ch2-{{ sid }}__inner">
    {%- for block in section.blocks -%}
      <div class="ch2-{{ sid }}__block ch2__block" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'rating' -%}
            <div class="ch2__rating">
              <div class="ch2__rating-stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {% render 'icons', icon: 'custom_hero_rating' %}
                {%- endfor -%}
              </div>
              {%- if block.settings.rating_text != blank -%}
                <div class="ch2__rating-text">{{ block.settings.rating_text }}</div>
              {%- endif -%}
            </div>

          {%- when 'heading' -%}
            {%- assign accent_pos = block.settings.accent_position | default: 'below' -%}
            <{{ block.settings.heading_tag | default: 'h1' }} class="ch2__heading ch2__heading--accent-{{ accent_pos }}">
              {%- if accent_pos == 'inline_first' -%}
                {%- if block.settings.heading_accent != blank -%}
                  <span class="ch2__heading-accent">{{ block.settings.heading_accent }}</span>
                {%- endif -%}
                {% if block.settings.heading != blank %} {{ block.settings.heading }}{% endif %}
              {%- elsif accent_pos == 'inline_last' -%}
                {% if block.settings.heading != blank %}{{ block.settings.heading }} {% endif %}
                {%- if block.settings.heading_accent != blank -%}
                  <span class="ch2__heading-accent">{{ block.settings.heading_accent }}</span>
                {%- endif -%}
              {%- else -%}
                {%- if block.settings.heading != blank -%}
                  <span class="ch2__heading-main">{{ block.settings.heading }}</span>
                {%- endif -%}
                {%- if block.settings.heading_accent != blank -%}
                  <span class="ch2__heading-accent">{{ block.settings.heading_accent }}</span>
                {%- endif -%}
              {%- endif -%}
            </{{ block.settings.heading_tag | default: 'h1' }}>

          {%- when 'subtitle' -%}
            {%- if block.settings.subtitle != blank -%}
              <div class="ch2__subtitle">{{ block.settings.subtitle }}</div>
            {%- endif -%}

          {%- when 'button' -%}
            {%- if block.settings.button_text != blank -%}
              <div class="ch2__button-wrap">
                {%- if block.settings.scroll_to_section != blank -%}
                  <a
                    href="#{{ block.settings.scroll_to_section }}"
                    class="ch2__button{% if block.settings.full_width %} ch2__button--full{% endif %} ch2-scroll-to"
                    data-scroll-target="{{ block.settings.scroll_to_section }}"
                  >
                    {{- block.settings.button_text -}}
                  </a>
                {%- else -%}
                  <a
                    href="{{ block.settings.button_link | default: '#' }}"
                    class="ch2__button{% if block.settings.full_width %} ch2__button--full{% endif %}"
                  >
                    {{- block.settings.button_text -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'guarantee' -%}
            <div class="ch2__guarantee">
              <span class="ch2__guarantee-icon">
                {%- if block.settings.use_custom_svg and block.settings.custom_svg != blank -%}
                  {{ block.settings.custom_svg }}
                {%- elsif block.settings.icon_style == 'check' -%}
                  {{ check_icon }}
                {%- else -%}
                  {{ guarantee_icon }}
                {%- endif -%}
              </span>
              {%- if block.settings.guarantee_text != blank -%}
                <span class="ch2__guarantee-text">{{ block.settings.guarantee_text }}</span>
              {%- endif -%}
            </div>

          {%- when 'image' -%}
            <div class="ch2__image-wrap">
              {%- liquid
                assign img_alt_desktop = block.settings.image_desktop.alt | default: ''
                assign img_alt_mobile = block.settings.image_mobile.alt | default: img_alt_desktop
              -%}
              {%- if block.settings.image_desktop != blank -%}
                {{ block.settings.image_desktop | image_url: width: 1600 | image_tag: class: 'ch2__image ch2__image--desktop', loading: 'lazy', widths: '400,600,800,1200,1600', sizes: '(max-width: 749px) 100vw, 720px', alt: img_alt_desktop }}
              {%- endif -%}
              {%- if block.settings.image_mobile != blank -%}
                {{ block.settings.image_mobile | image_url: width: 1000 | image_tag: class: 'ch2__image ch2__image--mobile', loading: 'lazy', widths: '300,500,700,1000', sizes: '100vw', alt: img_alt_mobile }}
              {%- elsif block.settings.image_desktop != blank -%}
                {{ block.settings.image_desktop | image_url: width: 1000 | image_tag: class: 'ch2__image ch2__image--mobile', loading: 'lazy', widths: '300,500,700,1000', sizes: '100vw', alt: img_alt_desktop }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'ch2__image placeholder' }}
              {%- endif -%}
            </div>

          {%- when 'badge' -%}
            {%- if block.settings.badge_text != blank -%}
              <div class="ch2__badges">
                <span class="ch2__badge">{{ block.settings.badge_text }}</span>
              </div>
            {%- endif -%}

          {%- when 'spacer' -%}
            <div class="ch2__spacer" aria-hidden="true"></div>

          {%- when 'custom_html' -%}
            {%- if block.settings.custom_html != blank -%}
              <div class="ch2__custom-html">{{ block.settings.custom_html }}</div>
            {%- endif -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  </div>
</section>

{%- if section.settings.transparent_header -%}
<script>
  (function() {
    var sectionEl = document.getElementById('CustomHero2-{{ sid }}');
    if (!sectionEl) return;

    var OVERLAY = 'ch2-th-overlay';
    var READY = 'ch2-th-ready';
    /* Switch after a short scroll — do not wait for end of hero */
    var RELEASE_AT = 72;
    var ENABLE_AT = 36;
    var overlayOn = true;
    var ticking = false;

    function setClass(el, name, on) {
      if (!el) return;
      if (on) el.classList.add(name);
      else el.classList.remove(name);
    }

    function setOverlay(on) {
      if (on === overlayOn) return;
      overlayOn = on;
      setClass(document.documentElement, OVERLAY, on);
      setClass(document.body, OVERLAY, on);
    }

    function scrollY() {
      return window.pageYOffset || document.documentElement.scrollTop || 0;
    }

    function shouldOverlay() {
      var y = scrollY();
      if (overlayOn) return y < RELEASE_AT;
      return y < ENABLE_AT;
    }

    function update() {
      setOverlay(shouldOverlay());
      ticking = false;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    setClass(document.documentElement, READY, true);
    setClass(document.body, READY, true);
    setOverlay(scrollY() < ENABLE_AT);
    update();

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    document.addEventListener('shopify:section:load', update);
    document.addEventListener('shopify:section:unload', function() {
      setClass(document.documentElement, OVERLAY, false);
      setClass(document.documentElement, READY, false);
      setClass(document.body, OVERLAY, false);
      setClass(document.body, READY, false);
    });
  })();
</script>
{%- endif -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.ch2-scroll-to').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        var targetId = this.getAttribute('data-scroll-target');
        var target = document.getElementById(targetId);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Custom Hero 2",
  "tag": "section",
  "class": "section-custom-hero-2",
  "settings": [
    {
      "type": "header",
      "content": "Transparent header"
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "Transparent header",
      "default": true,
      "info": "Fades the sticky header over this hero (announcement untouched). Sticky layout is never changed — on scroll, styles ease back to your header settings."
    },
    {
      "type": "select",
      "id": "header_color_scheme",
      "label": "Header color scheme (when transparent)",
      "options": [
        {
          "value": "dark",
          "label": "Dark — secondary logo + white icons"
        },
        {
          "value": "light",
          "label": "Light — primary logo + dark icons"
        }
      ],
      "default": "dark",
      "info": "Uses Logo / Secondary logo from Theme settings. Reverts to primary logo when scrolled."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "background_desktop",
      "label": "Background Desktop"
    },
    {
      "type": "image_picker",
      "id": "background_mobile",
      "label": "Background Mobile",
      "info": "Falls back to desktop background if empty"
    },
    {
      "type": "select",
      "id": "background_fit",
      "label": "Background fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "background_position",
      "label": "Background position",
      "default": "center center",
      "info": "e.g. center center, top center, bottom right"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 0
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "select",
