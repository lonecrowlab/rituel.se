{%- liquid
  assign icon_position = section.settings.icon_position | default: 'left'
  assign icon_position_mobile = section.settings.icon_position_mobile | default: 'top'
  assign bg_image = section.settings.background_image
-%}

<section
  class="ltl-fry-guarantee section-{{ section.id }} lfg-icon-{{ icon_position }} lfg-icon-mobile-{{ icon_position_mobile }}"
  data-section-id="{{ section.id }}"
>
  {% if bg_image != blank %}
    <div class="lfg-bg" aria-hidden="true">
      {{
        bg_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          class: 'lfg-bg__image',
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          alt: ''
      }}
    </div>
  {% endif %}

  <div class="lf-wrap">
    <div class="lfg-box">
      <div class="lfg-row">
        {% for block in section.blocks %}
          {% if block.type == 'icon' %}
            <div class="lfg-icon lfg-block-{{ block.id }}" {{ block.shopify_attributes }}>
              {% if block.settings.icon_image != blank %}
                {{
                  block.settings.icon_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'lfg-icon__image',
                    alt: block.settings.icon_alt | default: ''
                }}
              {% else %}
                {% liquid
                  assign guarantee_icon = block.settings.icon_name
                  if guarantee_icon == blank
                    assign guarantee_icon = 'shield_check'
                  endif
                %}
                <span class="lfg-icon__svg">{% render 'icons', icon: guarantee_icon %}</span>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        <div class="lfg-content">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'text' %}
                {% if block.settings.text != blank %}
                  {%- liquid
                    assign visibility = block.settings.visibility | default: 'all'
                    assign text_style = block.settings.style | default: 'body'
                  -%}
                  <div
                    class="lfg-text lfg-text--{{ text_style }} lfg-block-{{ block.id }} lfg-device-{{ visibility }}"
                    {{ block.shopify_attributes }}
                  >{{ block.settings.text }}</div>
                {% endif %}
              {% when 'link' %}
                {% if block.settings.label != blank %}
                  {%- assign visibility = block.settings.visibility | default: 'all' -%}
                  <a
                    class="lfg-link lfg-block-{{ block.id }} lfg-device-{{ visibility }}"
                    href="{{ block.settings.link | default: '#' }}"
                    {{ block.shopify_attributes }}
                  >{{ block.settings.label }}</a>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'button' %}
          {% if block.settings.label != blank %}
            {%- assign visibility = block.settings.visibility | default: 'all' -%}
            <div class="lfg-btn-wrap lfg-device-{{ visibility }}" {{ block.shopify_attributes }}>
              <a class="lfg-btn lfg-block-{{ block.id }}" href="{{ block.settings.link | default: '#' }}">
                {{- block.settings.label -}}
              </a>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% render 'ltl-fry-section-base', section: section %}

<style>
  {% for block in section.blocks %}
    {% if block.type == 'text' and block.settings.font_source == 'custom' %}
      {% if block.settings.font_regular != blank %}
        {{ block.settings.font_regular | font_face: font_display: 'swap' }}
      {% endif %}
      {% if block.settings.font_bold != blank %}
        {{ block.settings.font_bold | font_face: font_display: 'swap' }}
      {% endif %}
    {% endif %}
  {% endfor %}

  .section-{{ section.id }} {
    position: relative;
    overflow: hidden;
  }

  {% if bg_image != blank %}
    .section-{{ section.id }} .lfg-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .section-{{ section.id }} .lfg-bg__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: {{ section.settings.background_image_fit }};
      object-position: {{ section.settings.background_image_position }};
      opacity: {{ section.settings.background_image_opacity | divided_by: 100.0 }};
    }

    .section-{{ section.id }} .lf-wrap {
      position: relative;
      z-index: 1;
    }
  {% endif %}

  .section-{{ section.id }} .lfg-box {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.content_align }};
    gap: {{ section.settings.content_gap_mobile }}px;
    background: {{ section.settings.box_bg_color }};
    border: {{ section.settings.box_border_width }}px solid {{ section.settings.box_border_color }};
    border-radius: {{ section.settings.box_border_radius }}px;
    padding: {{ section.settings.box_padding_mobile }}px;
  }

  .section-{{ section.id }} .lfg-row {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.row_align_mobile }};
    gap: {{ section.settings.icon_gap_mobile }}px;
    width: 100%;
  }

  .section-{{ section.id }}.lfg-icon-mobile-top .lfg-row {
    flex-direction: column;
  }

  .section-{{ section.id }}.lfg-icon-mobile-bottom .lfg-row {
    flex-direction: column-reverse;
  }

  .section-{{ section.id }} .lfg-content {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.content_align }};
    text-align: {{ section.settings.text_align }};
    gap: {{ section.settings.text_gap_mobile }}px;
    flex: 1;
    min-width: 0;
    max-width: {{ section.settings.text_max_width }}px;
    width: 100%;
  }

  .section-{{ section.id }} .lfg-icon {
    flex-shrink: 0;
    width: {{ section.settings.icon_width_mobile }}px;
    height: {{ section.settings.icon_height_mobile }}px;
    color: {{ section.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-{{ section.id }} .lfg-icon__image,
  .section-{{ section.id }} .lfg-icon__svg,
  .section-{{ section.id }} .lfg-icon svg {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.icon_fit }};
    object-position: {{ section.settings.icon_position_focal }};
  }

  .section-{{ section.id }} .lfg-icon__svg {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-{{ section.id }} .lfg-icon__svg svg {
    width: {{ section.settings.icon_svg_scale }}%;
    height: {{ section.settings.icon_svg_scale }}%;
  }

  .section-{{ section.id }} .lfg-text {
    margin: 0;
    width: 100%;
  }

  .section-{{ section.id }} .lfg-text p {
    margin: 0;
  }

  .section-{{ section.id }} .lfg-text p + p {
    margin-top: 0.4em;
  }

  .section-{{ section.id }} .lfg-link {
    display: inline-flex;
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.link_font_size_mobile }}px;
    font-weight: {{ section.settings.link_font_weight }};
    letter-spacing: {{ section.settings.link_letter_spacing }}px;
    text-transform: {{ section.settings.link_text_transform }};
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .section-{{ section.id }} .lfg-btn-wrap {
    width: 100%;
    display: flex;
    justify-content: {{ section.settings.button_align }};
  }

  .section-{{ section.id }} .lfg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_font_size_mobile }}px;
    font-weight: {{ section.settings.button_font_weight }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    text-transform: {{ section.settings.button_text_transform }};
    text-decoration: none;
  }

  .section-{{ section.id }} .lfg-device-desktop {
    display: none !important;
  }

  .section-{{ section.id }} .lfg-text.lfg-device-mobile,
  .section-{{ section.id }} .lfg-text.lfg-device-all {
    display: block;
  }

  .section-{{ section.id }} a.lfg-device-mobile,
  .section-{{ section.id }} a.lfg-device-all {
    display: inline-flex;
  }

  .section-{{ section.id }} .lfg-btn-wrap.lfg-device-mobile,
  .section-{{ section.id }} .lfg-btn-wrap.lfg-device-all {
    display: flex;
  }

  {% for block in section.blocks %}
    {% if block.type == 'text' %}
      .section-{{ section.id }} .lfg-block-{{ block.id }} {
        font-size: {{ block.settings.font_size_mobile | default: 15 }}px;
        line-height: {{ block.settings.line_height | default: 14 | times: 0.1 }};
        color: {{ block.settings.color | default: '#111111' }};
        text-align: {{ block.settings.text_align | default: section.settings.text_align }};
        letter-spacing: {{ block.settings.letter_spacing | default: 0 | times: 0.01 }}em;
        text-transform: {{ block.settings.text_transform | default: 'none' }};
        margin-top: {{ block.settings.margin_top | default: 0 }}px;
        margin-bottom: {{ block.settings.margin_bottom_mobile | default: 0 }}px;
        font-weight: {{ block.settings.font_weight_regular | default: 400 }};
        {% if block.settings.font_source == 'custom' and block.settings.font_regular != blank %}
          font-family: {{ block.settings.font_regular.family }}, {{ block.settings.font_regular.fallback_families }};
        {% elsif block.settings.font_source == 'heading' %}
          font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        {% else %}
          font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        {% endif %}
        {% if block.settings.max_width > 0 %}
          max-width: {{ block.settings.max_width }}px;
        {% endif %}
      }

      .section-{{ section.id }} .lfg-block-{{ block.id }} strong,
      .section-{{ section.id }} .lfg-block-{{ block.id }} b {
        {% if block.settings.font_source == 'custom' and block.settings.font_bold != blank %}
          font-family: {{ block.settings.font_bold.family }}, {{ block.settings.font_bold.fallback_families }};
        {% endif %}
        font-weight: {{ block.settings.font_weight_bold | default: 700 }};
      }
    {% endif %}

    {% if block.type == 'link' %}
      .section-{{ section.id }} .lfg-block-{{ block.id }} {
        color: {{ block.settings.color | default: section.settings.link_color }};
        font-size: {{ block.settings.font_size_mobile | default: section.settings.link_font_size_mobile }}px;
        font-weight: {{ block.settings.font_weight | default: section.settings.link_font_weight }};
        letter-spacing: {{ block.settings.letter_spacing | default: section.settings.link_letter_spacing }}px;
        text-transform: {{ block.settings.text_transform | default: section.settings.link_text_transform }};
        margin-top: {{ block.settings.margin_top | default: 0 }}px;
        margin-bottom: {{ block.settings.margin_bottom_mobile | default: 0 }}px;
      }
    {% endif %}

    {% if block.type == 'button' %}
      .section-{{ section.id }} .lfg-block-{{ block.id }} {
        {% if block.settings.use_custom_styles %}
          background: {{ block.settings.bg_color }};
          color: {{ block.settings.text_color }};
          border-radius: {{ block.settings.border_radius }}px;
          font-size: {{ block.settings.font_size_mobile }}px;
          font-weight: {{ block.settings.font_weight }};
          letter-spacing: {{ block.settings.letter_spacing }}px;
          text-transform: {{ block.settings.text_transform }};
          padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
        {% endif %}
      }
    {% endif %}
  {% endfor %}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .lfg-box {
      padding: {{ section.settings.box_padding_desktop }}px;
      gap: {{ section.settings.content_gap_desktop }}px;
    }

    .section-{{ section.id }} .lfg-row {
      align-items: {{ section.settings.row_align_desktop }};
      gap: {{ section.settings.icon_gap_desktop }}px;
    }

    .section-{{ section.id }}.lfg-icon-left .lfg-row {
      flex-direction: row;
    }

    .section-{{ section.id }}.lfg-icon-right .lfg-row {
      flex-direction: row-reverse;
    }

    .section-{{ section.id }}.lfg-icon-top .lfg-row {
      flex-direction: column;
    }

    .section-{{ section.id }}.lfg-icon-bottom .lfg-row {
      flex-direction: column-reverse;
    }

    .section-{{ section.id }} .lfg-content {
      gap: {{ section.settings.text_gap_desktop }}px;
    }

    .section-{{ section.id }} .lfg-icon {
      width: {{ section.settings.icon_width_desktop }}px;
      height: {{ section.settings.icon_height_desktop }}px;
    }

    .section-{{ section.id }} .lfg-link {
      font-size: {{ section.settings.link_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfg-btn {
      font-size: {{ section.settings.button_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfg-device-mobile {
      display: none !important;
    }

    .section-{{ section.id }} .lfg-text.lfg-device-desktop,
    .section-{{ section.id }} .lfg-text.lfg-device-all {
      display: block;
    }

    .section-{{ section.id }} a.lfg-device-desktop,
    .section-{{ section.id }} a.lfg-device-all {
      display: inline-flex;
    }

    .section-{{ section.id }} .lfg-btn-wrap.lfg-device-desktop,
    .section-{{ section.id }} .lfg-btn-wrap.lfg-device-all {
      display: flex;
    }

    {% for block in section.blocks %}
      {% if block.type == 'text' %}
        .section-{{ section.id }} .lfg-block-{{ block.id }} {
          font-size: {{ block.settings.font_size_desktop | default: 16 }}px;
          margin-bottom: {{ block.settings.margin_bottom_desktop | default: 0 }}px;
        }
      {% endif %}

      {% if block.type == 'link' %}
        .section-{{ section.id }} .lfg-block-{{ block.id }} {
          font-size: {{ block.settings.font_size_desktop | default: section.settings.link_font_size_desktop }}px;
          margin-bottom: {{ block.settings.margin_bottom_desktop | default: 0 }}px;
        }
      {% endif %}

      {% if block.type == 'button' %}
        .section-{{ section.id }} .lfg-block-{{ block.id }} {
          {% if block.settings.use_custom_styles %}
            font-size: {{ block.settings.font_size_desktop }}px;
          {% endif %}
        }
      {% endif %}
    {% endfor %}
  }
</style>

{% schema %}
{
  "name": "ltl-fry-guarantee",
  "tag": "section",
  "class": "section-ltl-fry-guarantee",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon / image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "icon_position_mobile",
      "label": "Icon / image position (mobile)",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "End" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "row_align_mobile",
      "label": "Icon & text align (mobile)",
      "options": [
        { "value": "flex-start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "stretch", "label": "Stretch" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "row_align_desktop",
      "label": "Icon & text align (desktop)",
      "options": [
        { "value": "flex-start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "stretch", "label": "Stretch" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "icon_gap_mobile", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Icon gap (mobile)", "default": 20 },
    { "type": "range", "id": "icon_gap_desktop", "min": 12, "max": 64, "step": 2, "unit": "px", "label": "Icon gap (desktop)", "default": 28 },
    { "type": "range", "id": "text_gap_mobile", "min": 4, "max": 32, "step": 2, "unit": "px", "label": "Text gap (mobile)", "default": 12 },
    { "type": "range", "id": "text_gap_desktop", "min": 4, "max": 40, "step": 2, "unit": "px", "label": "Text gap (desktop)", "default": 14 },
    { "type": "range", "id": "content_gap_mobile", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Content gap (mobile)", "default": 24 },
    { "type": "range", "id": "content_gap_desktop", "min": 8, "max": 64, "step": 2, "unit": "px", "label": "Content gap (desktop)", "default": 28 },
    { "type": "range", "id": "text_max_width", "min": 280, "max": 900, "step": 20, "unit": "px", "label": "Text max width", "default": 560 },

    {
      "type": "header",
      "content": "Icon / image"
    },
    { "type": "range", "id": "icon_width_mobile", "min": 48, "max": 220, "step": 4, "unit": "px", "label": "Width (mobile)", "default": 120 },
    { "type": "range", "id": "icon_height_mobile", "min": 48, "max": 220, "step": 4, "unit": "px", "label": "Height (mobile)", "default": 120 },
    { "type": "range", "id": "icon_width_desktop", "min": 60, "max": 280, "step": 4, "unit": "px", "label": "Width (desktop)", "default": 160 },
    { "type": "range", "id": "icon_height_desktop", "min": 60, "max": 280, "step": 4, "unit": "px", "label": "Height (desktop)", "default": 160 },
    {
      "type": "select",
      "id": "icon_fit",
      "label": "Object fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" },
        { "value": "fill", "label": "Fill" },
        { "value": "none", "label": "None" },
        { "value": "scale-down", "label": "Scale down" }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "icon_position_focal",
      "label": "Object position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "icon_svg_scale", "min": 40, "max": 100, "step": 5, "unit": "%", "label": "Theme icon scale", "default": 100 },
    { "type": "color", "id": "icon_color", "label": "Theme icon color", "default": "#cc667c" },

    {
      "type": "header",
      "content": "Background image"
    },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    {
      "type": "select",
      "id": "background_image_fit",
      "label": "Background fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "Background position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "background_image_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Background opacity", "default": 100 },

    {
      "type": "header",
      "content": "Box"
    },
    { "type": "color", "id": "box_bg_color", "label": "Box background", "default": "#ffffff00" },
    { "type": "range", "id": "box_border_width", "min": 0, "max": 4, "step": 1, "unit": "px", "label": "Box border width", "default": 0 },
    { "type": "color", "id": "box_border_color", "label": "Box border color", "default": "#e5e7eb" },
    { "type": "range", "id": "box_border_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Box radius", "default": 0 },
    { "type": "range", "id": "box_padding_mobile", "min": 0, "max": 64, "step": 4, "unit": "px", "label": "Box padding (mobile)", "default": 16 },
    { "type": "range", "id": "box_padding_desktop", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Box padding (desktop)", "default": 24 },

    {
      "type": "header",
      "content": "Link"
    },
    { "type": "color", "id": "link_color", "label": "Link color", "default": "#111111" },
    { "type": "range", "id": "link_font_size_mobile", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Link size (mobile)", "default": 13 },
    { "type": "range", "id": "link_font_size_desktop", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Link size (desktop)", "default": 14 },
    {
      "type": "select",
      "id": "link_font_weight",
      "label": "Link weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    { "type": "range", "id": "link_letter_spacing", "min": 0, "max": 4, "step": 0.5, "unit": "px", "label": "Link letter spacing", "default": 1 },
    {
      "type": "select",
      "id": "link_text_transform",
      "label": "Link transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },

    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "select",
      "id": "button_align",
      "label": "Button alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
