<section class="listiclev2-incl section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width lv2i-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="lv2i-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="lv2i-grid">
        {% for block in section.blocks %}
          {% if block.type == 'item' %}
            <div class="lv2i-card" {{ block.shopify_attributes }}>
              {% assign product = block.settings.product %}
              {% if product != blank %}
                <a class="lv2i-card__media" href="{{ product.url }}">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'lv2i-card__img', alt: product.title }}
                  {% endif %}
                </a>
                <h3 class="lv2i-card__title">
                  <a href="{{ product.url }}">{{ block.settings.title | default: product.title }}</a>
                </h3>
              {% elsif block.settings.image != blank %}
                <div class="lv2i-card__media">
                  {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'lv2i-card__img', alt: block.settings.title }}
                </div>
                {% if block.settings.title != blank %}
                  <h3 class="lv2i-card__title">{{ block.settings.title }}</h3>
                {% endif %}
              {% endif %}

              {% if block.settings.stats != blank %}
                <div class="lv2i-card__stats rte">{{ block.settings.stats }}</div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a class="lv2i-card__btn" href="{{ block.settings.button_url | default: product.url | default: '#' }}">{{ block.settings.button_label }}</a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .section-{{ section.id }} .lv2i-wrap {
    max-width: {{ section.settings.container_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .section-{{ section.id }} .lv2i-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 24px;
    font-weight: 600;
  }

  .section-{{ section.id }} .lv2i-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.card_gap_mobile }}px;
  }

  .section-{{ section.id }} .lv2i-card {
    text-align: center;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: 20px 16px;
    background: {{ section.settings.card_bg_color }};
  }

  .section-{{ section.id }} .lv2i-card__media {
    display: block;
    margin-bottom: 12px;
    text-decoration: none;
  }

  .section-{{ section.id }} .lv2i-card__img {
    width: 100%;
    max-width: {{ section.settings.image_max_width }}px;
    height: auto;
    margin: 0 auto;
    display: block;
  }

  .section-{{ section.id }} .lv2i-card__title {
    font-size: {{ section.settings.title_font_size_mobile }}px;
    margin: 0 0 12px;
    font-weight: 600;
  }

  .section-{{ section.id }} .lv2i-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .section-{{ section.id }} .lv2i-card__stats {
    font-size: {{ section.settings.stats_font_size_mobile }}px;
    line-height: 1.55;
    margin-bottom: 14px;
    color: {{ section.settings.stats_color }};
    text-align: left;
  }

  .section-{{ section.id }} .lv2i-card__btn {
    display: inline-block;
    font-size: {{ section.settings.button_font_size_mobile }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: {{ section.settings.button_text_color }};
    background: {{ section.settings.button_bg_color }};
    padding: 10px 20px;
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .section-{{ section.id }} .lv2i-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2i-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: {{ section.settings.card_gap_desktop }}px;
    }

    .section-{{ section.id }} .lv2i-card__title {
      font-size: {{ section.settings.title_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2i-card__stats {
      font-size: {{ section.settings.stats_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2i-card__btn {
      font-size: {{ section.settings.button_font_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Listiclev2 Incl",
  "tag": "section",
  "class": "section-listiclev2-incl",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Included:"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card gap (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_gap_desktop",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Card gap (desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Image max width",
      "default": 220
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading (desktop)",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card title (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card title (desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "stats_font_size_mobile",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Stats (mobile)",
      "default": 13
    },
    {
      "type": "range",
      "id": "stats_font_size_desktop",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Stats (desktop)",
      "default": 14
    },
    {
      "type": "color",
      "id": "stats_color",
      "label": "Stats color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Button (mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_font_size_desktop",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Button (desktop)",
      "default": 13
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Container max width",
      "default": 750,
      "info": "Content container width. Section background stays full width."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "richtext",
          "id": "stats",
          "label": "Stats / description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "LEARN MORE"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Listiclev2 Incl",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
