{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}

<section
  id="Lft-{{ section.id }}"
  class="ltl-fry-timeline section-{{ section.id }}{% if section.settings.highlight_all %} lft-highlight-all{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="lf-wrap">
    <div class="lft-layout{% unless has_image %} lft-layout--no-media{% endunless %}">
      {% if has_image %}
        <div class="lft-media">
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 750px) 42vw, 100vw',
              class: 'lft-media__image',
              alt: section.settings.heading
          }}
        </div>
      {% endif %}

      <div class="lft-content">
        {% if section.settings.heading != blank %}
          <h2 class="lft-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="lft-subheading">{{ section.settings.subheading }}</p>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="lft-timeline">
            {% for block in section.blocks %}
              {% if block.type == 'timeline_step' %}
                <div
                  class="lft-step lft-block-{{ block.id }}{% if section.settings.highlight_all %} is-active{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div class="lft-step__header">
                    <span class="lft-step__dot" aria-hidden="true"></span>
                    {% if block.settings.title != blank %}
                      <h3 class="lft-step__title">{{ block.settings.title }}</h3>
                    {% endif %}
                  </div>

                  <div class="lft-step__body">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          class: 'lft-step__image',
                          alt: block.settings.title
                      }}
                    {% endif %}
                    {% if block.settings.label != blank %}
                      <p class="lft-step__label">{{ block.settings.label }}</p>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div class="lft-step__text rte">{{ block.settings.text }}</div>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% render 'ltl-fry-section-base', section: section %}

<style>
  .section-{{ section.id }} .lft-layout {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  {% if section.settings.section_width == 'full' %}
    .section-{{ section.id }} .lft-content {
      padding-left: {{ section.settings.side_padding }}px;
      padding-right: {{ section.settings.side_padding }}px;
    }

    .section-{{ section.id }} .lft-media__image {
      border-radius: 0;
    }
  {% endif %}

  .section-{{ section.id }} .lft-media__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  .section-{{ section.id }} .lft-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 8px;
    line-height: 1.25;
  }

  .section-{{ section.id }} .lft-subheading {
    font-size: {{ section.settings.subheading_font_size_mobile }}px;
    color: {{ section.settings.subheading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .section-{{ section.id }} .lft-timeline {
    --lft-dot-size: {{ section.settings.dot_size }}px;
    --lft-dot-gap: {{ section.settings.line_offset }}px;
    --lft-dot-line-gap: {{ section.settings.dot_line_gap }}px;
    position: relative;
  }

  .section-{{ section.id }} .lft-timeline::before {
    content: "";
    position: absolute;
    left: calc(var(--lft-dot-size) / 2);
    top: calc(var(--lft-dot-size) / 2);
    bottom: calc(var(--lft-dot-size) / 2);
    width: {{ section.settings.line_width }}px;
    background: {{ section.settings.line_color }};
    border-radius: {{ section.settings.line_width }}px;
    transform: translateX(-50%);
    z-index: 0;
  }

  .section-{{ section.id }}.lft-highlight-all .lft-timeline::before {
    background: {{ section.settings.marker_bg_color }};
  }

  .section-{{ section.id }} .lft-step {
    position: relative;
    z-index: 1;
    padding-bottom: {{ section.settings.step_spacing_mobile }}px;
  }

  .section-{{ section.id }} .lft-step:last-child {
    padding-bottom: 0;
  }

  .section-{{ section.id }} .lft-step__header {
    display: flex;
    align-items: center;
    gap: var(--lft-dot-gap);
    min-height: var(--lft-dot-size);
  }

  .section-{{ section.id }} .lft-step__dot {
    flex: 0 0 var(--lft-dot-size);
    width: var(--lft-dot-size);
    height: var(--lft-dot-size);
    border-radius: 50%;
    background: {{ section.settings.marker_inactive_color }};
    {% if section.settings.dot_line_gap > 0 %}
      box-shadow: 0 0 0 var(--lft-dot-line-gap) {{ section.settings.bg_color }};
    {% else %}
      box-shadow: none;
    {% endif %}
  }

  .section-{{ section.id }} .lft-step.is-active .lft-step__dot,
  .section-{{ section.id }}.lft-highlight-all .lft-step__dot {
    background: {{ section.settings.marker_bg_color }};
  }

  .section-{{ section.id }} .lft-step__title {
    flex: 1 1 auto;
    font-size: {{ section.settings.step_title_size_mobile }}px;
    font-weight: {{ section.settings.step_title_weight }};
    font-style: {{ section.settings.step_title_style }};
    color: {{ section.settings.step_title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .section-{{ section.id }} .lft-step__body {
    padding-left: calc(var(--lft-dot-size) + var(--lft-dot-gap));
    margin-top: 6px;
  }

  .section-{{ section.id }} .lft-step__label {
    font-size: {{ section.settings.marker_font_size_mobile }}px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.marker_text_color }};
    margin: 0 0 6px;
    line-height: 1.4;
  }

  .section-{{ section.id }} .lft-step__image {
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_border_radius }}px;
    margin-bottom: 12px;
    display: block;
  }

  .section-{{ section.id }} .lft-step__text {
    font-size: {{ section.settings.step_text_size_mobile }}px;
    color: {{ section.settings.step_text_color }};
    line-height: 1.5;
  }

  .section-{{ section.id }} .lft-step__text p {
    margin: 0 0 0.75em;
  }

  .section-{{ section.id }} .lft-step__text p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .lft-layout {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: {{ section.settings.column_gap }}px;
      align-items: start;
    }

    .section-{{ section.id }} .lft-layout--no-media {
      grid-template-columns: minmax(0, 1fr);
      max-width: 720px;
      margin-left: auto;
      margin-right: auto;
    }

    {% if section.settings.section_width == 'full' %}
      .section-{{ section.id }} .lft-media {
        padding-left: 0;
        padding-right: 0;
      }

      .section-{{ section.id }} .lft-content {
        padding-left: {{ section.settings.side_padding }}px;
        padding-right: {{ section.settings.side_padding }}px;
      }
    {% endif %}

    .section-{{ section.id }} .lft-media {
      position: sticky;
      top: {{ section.settings.sticky_top }}px;
    }

    .section-{{ section.id }} .lft-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lft-subheading {
      font-size: {{ section.settings.subheading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lft-step {
      padding-bottom: {{ section.settings.step_spacing_desktop }}px;
    }

    .section-{{ section.id }} .lft-step__label {
      font-size: {{ section.settings.marker_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lft-step__title {
      font-size: {{ section.settings.step_title_size_desktop }}px;
    }

    .section-{{ section.id }} .lft-step__text {
      font-size: {{ section.settings.step_text_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "ltl-fry-timeline",
  "tag": "section",
  "class": "section-ltl-fry-timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Effortless, effective skincare. Because great skin shouldn't be complicated." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "image_border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Image radius", "default": 0 },
    { "type": "range", "id": "column_gap", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Column gap", "default": 48 },
    { "type": "range", "id": "sticky_top", "min": 20, "max": 160, "step": 4, "unit": "px", "label": "Sticky image offset", "default": 96 },
    { "type": "header", "content": "Timeline" },
    { "type": "checkbox", "id": "highlight_all", "label": "Highlight all", "default": true, "info": "Highlights every timeline marker and the connecting line by default" },
    { "type": "range", "id": "dot_size", "min": 10, "max": 24, "step": 2, "unit": "px", "label": "Dot size", "default": 14 },
    { "type": "range", "id": "line_offset", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Gap between dot and text", "default": 20 },
    { "type": "range", "id": "dot_line_gap", "min": 0, "max": 12, "step": 1, "unit": "px", "label": "Gap between line and dot", "default": 0, "info": "0 makes the line connect through the dots with no ring gap." },
    { "type": "range", "id": "line_width", "min": 1, "max": 8, "step": 1, "unit": "px", "label": "Line width", "default": 2 },
    { "type": "color", "id": "line_color", "label": "Line color", "default": "#e5e7eb" },
    { "type": "color", "id": "marker_bg_color", "label": "Active marker color", "default": "#b89aa6" },
    { "type": "color", "id": "marker_inactive_color", "label": "Inactive marker color", "default": "#e5e7eb" },
    { "type": "color", "id": "marker_text_color", "label": "Label color", "default": "#6b7280" },
    { "type": "range", "id": "marker_font_size_mobile", "min": 10, "max": 16, "step": 1, "unit": "px", "label": "Label size (mobile)", "default": 12 },
    { "type": "range", "id": "marker_font_size_desktop", "min": 10, "max": 16, "step": 1, "unit": "px", "label": "Label size (desktop)", "default": 13 },
    { "type": "range", "id": "step_spacing_mobile", "min": 16, "max": 64, "step": 4, "unit": "px", "label": "Step spacing (mobile)", "default": 28 },
    { "type": "range", "id": "step_spacing_desktop", "min": 20, "max": 80, "step": 4, "unit": "px", "label": "Step spacing (desktop)", "default": 36 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size_mobile", "min": 20, "max": 48, "step": 2, "unit": "px", "label": "Heading size (mobile)", "default": 28 },
    { "type": "range", "id": "heading_font_size_desktop", "min": 24, "max": 56, "step": 2, "unit": "px", "label": "Heading size (desktop)", "default": 36 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" },
      { "value": "700", "label": "Bold" }
    ], "default": "600" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1f2937" },
    { "type": "range", "id": "subheading_font_size_mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Subheading size (mobile)", "default": 15 },
    { "type": "range", "id": "subheading_font_size_desktop", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Subheading size (desktop)", "default": 16 },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#6b7280" },
    { "type": "range", "id": "step_title_size_mobile", "min": 16, "max": 28, "step": 1, "unit": "px", "label": "Step title size (mobile)", "default": 20 },
    { "type": "range", "id": "step_title_size_desktop", "min": 18, "max": 32, "step": 1, "unit": "px", "label": "Step title size (desktop)", "default": 24 },
    { "type": "select", "id": "step_title_weight", "label": "Step title weight", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" }
    ], "default": "500" },
    { "type": "select", "id": "step_title_style", "label": "Step title style", "options": [
      { "value": "normal", "label": "Normal" },
      { "value": "italic", "label": "Italic" }
    ], "default": "italic" },
    { "type": "color", "id": "step_title_color", "label": "Step title color", "default": "#111827" },
    { "type": "range", "id": "step_text_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Step text size (mobile)", "default": 14 },
    { "type": "range", "id": "step_text_size_desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Step text size (desktop)", "default": 15 },
    { "type": "color", "id": "step_text_color", "label": "Step text color", "default": "#4b5563" },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "checkbox", "id": "gradient_enabled", "label": "Use gradient background", "default": false },
    { "type": "color_background", "id": "gradient_background", "label": "Gradient", "default": "linear-gradient(180deg, rgba(255,255,255,1), rgba(250,248,246,1) 100%)" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "body_color", "label": "Body color", "default": "#374151" },
    { "type": "range", "id": "body_font_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Body size (mobile)", "default": 16 },
    { "type": "range", "id": "body_font_size_desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Body size (desktop)", "default": 16 },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [
      { "value": "page", "label": "Section width" },
      { "value": "full", "label": "Full width" }
    ], "default": "page" },
    { "type": "range", "id": "container_max_width", "min": 600, "max": 1400, "step": 10, "unit": "px", "label": "Container max width", "default": 1100, "info": "Applies when Section width is selected." },
    { "type": "range", "id": "side_padding", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Content side padding", "default": 24, "info": "Used when Full width is selected. Image stays edge-to-edge on desktop." },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (mobile)", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (mobile)", "default": 32 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (desktop)", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (desktop)", "default": 48 }
  ],
  "blocks": [
    {
      "type": "timeline_step",
      "name": "Timeline step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Daily routine – Morning & night" },
        { "type": "text", "id": "label", "label": "Label", "default": "BALMS", "info": "Optional. Shown under the title. Leave blank if not needed — alignment stays consistent." },
        { "type": "image_picker", "id": "image", "label": "Step image" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe what happens at this stage.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ltl-fry-timeline",
      "blocks": [
        {
          "type": "timeline_step",
          "settings": {
            "title": "Daily routine – Morning & night",
            "label": "BALMS",
            "text": "<p>Apply a pea-sized amount to face and neck morning and night. Massage until absorbed.</p>"
          }
        },
        {
          "type": "timeline_step",
          "settings": {
            "title": "Exfoliate",
            "label": "SCRUB",
            "text": "<p>Use 1–2 times a week in the shower for smoother, brighter skin.</p>"
          }
        },
        {
          "type": "timeline_step",
          "settings": {
            "title": "Targeted care when you need it",
            "label": "BALM FOR DRY, ITCHY SKIN",
            "text": "<p>Apply where skin needs extra comfort.</p>"
          }
        },
        {
          "type": "timeline_step",
          "settings": {
            "title": "Keep it simple. No extra products needed.",
            "label": "",
            "text": "<p>A focused routine is enough. Great skin shouldn't be complicated.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
