<script>
  (function() {
    // Shopify often relocates section scripts, so never rely on currentScript.closest().
    var section = document.querySelector('.tiktok-video-slider.section-{{ section.id }}');
    if (!section) return;

    function initSlider(viewport) {
      if (!viewport || viewport.dataset.initialized === 'true') return;
      viewport.dataset.initialized = 'true';
      var track = viewport.querySelector('[data-slider-track]');
      if (!track) return;

      var isDragging = false;
      var startPos = 0;
      var currentTranslate = 0;
      var prevTranslate = 0;
      var animationID = 0;
      var currentIndex = 0;

      viewport.addEventListener('mousedown', dragStart);
      viewport.addEventListener('mouseup', dragEnd);
      viewport.addEventListener('mouseleave', dragEnd);
      viewport.addEventListener('mousemove', drag);
      viewport.addEventListener('touchstart', dragStart, { passive: true });
      viewport.addEventListener('touchend', dragEnd);
      viewport.addEventListener('touchmove', drag, { passive: true });
      viewport.addEventListener('contextmenu', function(e) {
        if (isDragging) e.preventDefault();
      });

      function getPositionX(event) {
        return event.type.indexOf('mouse') !== -1 ? event.pageX : event.touches[0].clientX;
      }

      function dragStart(event) {
        isDragging = true;
        startPos = getPositionX(event);
        animationID = requestAnimationFrame(animation);
        viewport.style.cursor = 'grabbing';
        track.style.transition = 'none';
      }

      function drag(event) {
        if (!isDragging) return;
        currentTranslate = prevTranslate + getPositionX(event) - startPos;
      }

      function dragEnd() {
        isDragging = false;
        cancelAnimationFrame(animationID);
        viewport.style.cursor = 'grab';
        track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        var movedBy = currentTranslate - prevTranslate;
        if (movedBy < -50) currentIndex = Math.min(currentIndex + 1, track.children.length - 1);
        if (movedBy > 50) currentIndex = Math.max(currentIndex - 1, 0);
        var slideWidth = track.children[0].offsetWidth;
        var gap = parseInt(getComputedStyle(track).gap, 10) || 0;
        currentTranslate = -currentIndex * (slideWidth + gap);
        prevTranslate = currentTranslate;
        track.style.transform = 'translateX(' + currentTranslate + 'px)';
      }

      function animation() {
        track.style.transform = 'translateX(' + currentTranslate + 'px)';
        if (isDragging) requestAnimationFrame(animation);
      }

      viewport.style.cursor = 'grab';
    }

    function init() {
      if (section.dataset.tvsInit === 'true') return;
      section.dataset.tvsInit = 'true';

      var viewport = section.querySelector('[data-slider-viewport]');
      initSlider(viewport);

      var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      var saveData = !!(connection && (connection.saveData || connection.effectiveType === '2g' || connection.effectiveType === 'slow-2g'));
      var useLowRes = saveData || window.matchMedia('(max-width: 749px)').matches;
      var videos = section.querySelectorAll('[data-video]');

      section.querySelectorAll('.tvs-video-poster').forEach(function(img) {
        var wrapper = img.closest('.tvs-video-wrapper');
        function ready() {
          if (wrapper) wrapper.classList.add('tvs-poster-ready');
        }
        function fail() {
          if (wrapper) wrapper.classList.add('tvs-poster-failed');
          img.remove();
        }
        if (img.complete) {
          if (img.naturalWidth === 0) fail();
          else ready();
        }
        img.addEventListener('load', ready);
        img.addEventListener('error', fail);
      });

      function hideLoader(wrapper) {
        var loader = wrapper && wrapper.querySelector('.tvs-video-loader');
        if (!loader) return;
        clearTimeout(Number(loader.dataset.delayTimer || 0));
        loader.classList.remove('tvs-loader-visible');
        loader.classList.add('tvs-hide');
      }

      function showLoader(wrapper) {
        var loader = wrapper && wrapper.querySelector('.tvs-video-loader');
        if (!loader) return;
        loader.classList.remove('tvs-hide');
        clearTimeout(Number(loader.dataset.delayTimer || 0));
        loader.dataset.delayTimer = String(setTimeout(function() {
          if (!loader.classList.contains('tvs-hide')) loader.classList.add('tvs-loader-visible');
        }, 300));
      }

      function markUnavailable(video) {
        video.dataset.failed = 'true';
        video.dataset.loading = '';
        video.classList.remove('tvs-loaded');
        var wrapper = video.closest('.tvs-video-wrapper');
        if (!wrapper) return;
        wrapper.classList.add('tvs-unavailable');
        wrapper.classList.remove('tvs-ready');
        hideLoader(wrapper);
      }

      function loadVideo(video) {
        if (!video || video.dataset.loaded === 'true' || video.dataset.loading === 'true') return;

        var src = useLowRes && video.getAttribute('data-src-lq')
          ? video.getAttribute('data-src-lq')
          : video.getAttribute('data-src');
        if (!src) {
          markUnavailable(video);
          return;
        }

        video.dataset.loading = 'true';
        var wrapper = video.closest('.tvs-video-wrapper');
        showLoader(wrapper);

        video.muted = true;
        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.preload = 'auto';
        video.src = src;

        var settled = false;
        function finish() {
          if (settled) return;
          settled = true;
          clearTimeout(timer);
        }

        function onReady() {
          if (video.dataset.loaded === 'true') {
            finish();
            return;
          }
          video.dataset.loaded = 'true';
          video.dataset.loading = '';
          video.classList.add('tvs-loaded');
          if (wrapper) {
            wrapper.classList.add('tvs-ready');
            wrapper.classList.remove('tvs-unavailable');
            hideLoader(wrapper);
          }
          if (video.dataset.autoplay === 'true') {
            var playAttempt = video.play();
            if (playAttempt && playAttempt.catch) playAttempt.catch(function() {});
          }
          finish();
        }

        function onFail() {
          if (video.dataset.loaded === 'true') {
            finish();
            return;
          }
          markUnavailable(video);
          finish();
        }

        video.addEventListener('loadeddata', onReady, { once: true });
        video.addEventListener('canplay', onReady, { once: true });
        video.addEventListener('error', onFail, { once: true });
        var timer = setTimeout(onFail, 15000);
        video.load();
        if (video.readyState >= 2) onReady();
      }

      if ('IntersectionObserver' in window) {
        var slideObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            var video = entry.target.querySelector('[data-video]');
            if (!video) return;
            if (entry.isIntersecting) {
              loadVideo(video);
              if (video.dataset.loaded === 'true' && video.dataset.autoplay === 'true' && video.paused) {
                video.muted = true;
                var playAttempt = video.play();
                if (playAttempt && playAttempt.catch) playAttempt.catch(function() {});
              }
            } else if (video.dataset.loaded === 'true' && !video.paused) {
              video.pause();
            }
          });
        }, { root: null, rootMargin: saveData ? '120px 0px' : '280px 0px', threshold: 0.1 });

        section.querySelectorAll('[data-slider-slide]').forEach(function(slide) {
          slideObserver.observe(slide);
        });
      } else {
        videos.forEach(loadVideo);
      }

      section.querySelectorAll('.tvs-video-wrapper').forEach(function(wrapper) {
        var video = wrapper.querySelector('[data-video]');
        var playPauseBtn = wrapper.querySelector('[data-play-pause]');
        if (!video || !playPauseBtn || playPauseBtn.disabled) return;

        var hideTimeout;
        function showButton() {
          playPauseBtn.classList.remove('tvs-hidden');
          clearTimeout(hideTimeout);
          hideTimeout = setTimeout(function() {
            playPauseBtn.classList.add('tvs-hidden');
          }, 2000);
        }

        function togglePlayPause() {
          if (video.dataset.loaded !== 'true') {
            loadVideo(video);
            showButton();
            return;
          }
          if (video.paused) {
            video.muted = true;
            var playAttempt = video.play();
            if (playAttempt && playAttempt.catch) playAttempt.catch(function() {});
            playPauseBtn.classList.add('tvs-playing');
          } else {
            video.pause();
            playPauseBtn.classList.remove('tvs-playing');
          }
          showButton();
        }

        playPauseBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          togglePlayPause();
        });
        video.addEventListener('click', togglePlayPause);
        wrapper.addEventListener('mouseenter', showButton);
        wrapper.addEventListener('mousemove', showButton);
        wrapper.addEventListener('touchstart', showButton, { passive: true });
        video.addEventListener('play', function() { playPauseBtn.classList.add('tvs-playing'); });
        video.addEventListener('pause', function() { playPauseBtn.classList.remove('tvs-playing'); });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (!event.target || !event.target.querySelector) return;
      if (event.target.querySelector('.section-{{ section.id }}') || event.target.classList.contains('section-{{ section.id }}')) {
        section = document.querySelector('.tiktok-video-slider.section-{{ section.id }}');
        if (section) {
          section.dataset.tvsInit = '';
          init();
        }
      }
    });
  })();
</script>

