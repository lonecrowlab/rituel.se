{% comment %}Updated by Elevate: 2026-01-02T23:26:23.923Z{% endcomment %}
{% comment %}
  Video Slider Section
  Follows established section patterns with heading scaffold and functional slider
  Supports video uploads with customizable aspect ratios and responsive sizing
{% endcomment %}

<section class="tiktok-video-slider section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="container page-width">
    <div class="tvs-content-wrapper">

      {% comment %} Heading {% endcomment %}
      {% if section.settings.heading_before != blank or section.settings.highlighted_text != blank or section.settings.heading_after != blank %}
        <div class="tvs-header-wrapper tvs-align-{{ section.settings.heading_text_align }}">
          {% case section.settings.highlight_position %}
            {% when 'above' %}
              {% if section.settings.highlighted_text != blank %}
                <span class="tvs-highlighted-text tvs-highlighted-separate">{{ section.settings.highlighted_text }}</span>
              {% endif %}
              <{{ section.settings.heading_tag }} class="tvs-heading">
                {{ section.settings.heading_before }}
                {{ section.settings.heading_after }}
              </{{ section.settings.heading_tag }}>
            {% when 'below' %}
              <{{ section.settings.heading_tag }} class="tvs-heading">
                {{ section.settings.heading_before }}
                {{ section.settings.heading_after }}
              </{{ section.settings.heading_tag }}>
              {% if section.settings.highlighted_text != blank %}
                <span class="tvs-highlighted-text tvs-highlighted-separate">{{ section.settings.highlighted_text }}</span>
              {% endif %}
            {% when 'inline_first' %}
              <{{ section.settings.heading_tag }} class="tvs-heading">
                {% if section.settings.highlighted_text != blank %}
                  <span class="tvs-highlighted-text">{{ section.settings.highlighted_text }}</span>
                {% endif %}
                {% if section.settings.heading_before != blank %}{{ " " }}{{ section.settings.heading_before }}{% endif %}
                {% if section.settings.heading_after != blank %}{{ " " }}{{ section.settings.heading_after }}{% endif %}
              </{{ section.settings.heading_tag }}>
            {% when 'inline_second' %}
              <{{ section.settings.heading_tag }} class="tvs-heading">
                {% if section.settings.heading_before != blank %}{{ section.settings.heading_before }}{{ " " }}{% endif %}
                {% if section.settings.highlighted_text != blank %}
                  <span class="tvs-highlighted-text">{{ section.settings.highlighted_text }}</span>
                {% endif %}
                {% if section.settings.heading_after != blank %}{{ " " }}{{ section.settings.heading_after }}{% endif %}
              </{{ section.settings.heading_tag }}>
          {% endcase %}
        </div>
      {% endif %}

      {% comment %} Intro Text {% endcomment %}
      {% if section.settings.intro_text != blank %}
        <div class="tvs-intro-text tvs-align-{{ section.settings.heading_text_align }} rte">
          {{ section.settings.intro_text }}
        </div>
      {% endif %}

      {% comment %} Video Slider {% endcomment %}
      {% if section.blocks.size > 0 %}
        {% capture poster_sizes %}(min-width: 1024px) {{ section.settings.slide_width_desktop }}vw, (min-width: 750px) {{ section.settings.slide_width_tablet }}vw, {{ section.settings.slide_width_mobile }}vw{% endcapture %}
        <div class="tvs-slider" data-slider-container>
          <div class="tvs-slider-viewport" data-slider-viewport>
            <div class="tvs-slider-track" data-slider-track>
              {% assign tvs_video_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'video' %}
                  {% assign tvs_video_index = tvs_video_index | plus: 1 %}
                  {% liquid
                    assign tvs_src = ''
                    assign tvs_type = 'video/mp4'
                    assign tvs_score = 1000000
                    assign tvs_src_lq = ''
                    assign tvs_type_lq = 'video/mp4'
                    assign tvs_score_lq = 1000000
                    assign tvs_fallback_src = ''
                    assign tvs_fallback_type = 'video/mp4'
                    assign tvs_poster = block.settings.poster
                    assign tvs_alt = ''
                    assign tvs_target = 540
                    assign tvs_target_lq = 360

                    if tvs_poster == blank and block.settings.video != blank
                      assign tvs_poster = block.settings.video.preview_image
                    endif

                    if block.settings.video != blank and block.settings.video.alt != blank
                      assign tvs_alt = block.settings.video.alt
                    endif

                    if block.settings.video != blank
                      for source in block.settings.video.sources
                        if source.format == 'mp4'
                          if tvs_fallback_src == blank
                            assign tvs_fallback_src = source.url
                            if source.mime_type != blank
                              assign tvs_fallback_type = source.mime_type
                            endif
                          endif
                          if source.width > 0 and source.height > 0
                            assign short_side = source.height
                            if source.width < source.height
                              assign short_side = source.width
                            endif

                            if short_side <= tvs_target
                              assign score = tvs_target | minus: short_side
                            else
                              assign score = 2000 | plus: short_side
                            endif
                            if score < tvs_score
                              assign tvs_score = score
                              assign tvs_src = source.url
                              if source.mime_type != blank
                                assign tvs_type = source.mime_type
                              endif
                            endif

                            if short_side <= tvs_target_lq
                              assign score_lq = tvs_target_lq | minus: short_side
                            else
                              assign score_lq = 2000 | plus: short_side
                            endif
                            if score_lq < tvs_score_lq
                              assign tvs_score_lq = score_lq
                              assign tvs_src_lq = source.url
                              if source.mime_type != blank
                                assign tvs_type_lq = source.mime_type
                              endif
                            endif
                          endif
                        endif
                      endfor
                      if tvs_src == blank
                        assign tvs_src = tvs_fallback_src
                        assign tvs_type = tvs_fallback_type
                      endif
                      if tvs_src_lq == blank
                        assign tvs_src_lq = tvs_src
                        assign tvs_type_lq = tvs_type
                      endif
                    endif
                  %}
                  <div class="tvs-slide" data-slider-slide {{ block.shopify_attributes }}>
                    <div class="tvs-video-card tvs-aspect-{{ section.settings.video_aspect_ratio }}">
                      <div class="tvs-video-wrapper{% if tvs_poster != blank %} tvs-has-poster{% endif %}{% if block.settings.video != blank and tvs_src == blank %} tvs-unavailable{% endif %}" data-video-card>
                        <div class="tvs-video-skeleton" aria-hidden="true"></div>
                        {% if block.settings.video != blank %}
                          {% if tvs_poster != blank %}
                            {{ tvs_poster | image_url: width: 720 | image_tag:
                              class: 'tvs-video-poster',
                              loading: 'lazy',
                              fetchpriority: 'low',
                              decoding: 'async',
                              widths: '180,240,360,540,720',
                              sizes: poster_sizes,
                              alt: tvs_alt
                            }}
                          {% endif %}
                          <div class="tvs-video-fallback" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                              <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                              <path d="M10 9.5v5l4.5-2.5L10 9.5Z" fill="currentColor"/>
                            </svg>
                            <span class="tvs-video-fallback-label">Video unavailable</span>
                          </div>
                          {% if tvs_src != blank %}
                            <video
                              class="tvs-video-element"
                              playsinline
                              {% if section.settings.video_loop %}loop{% endif %}
                              {% if section.settings.video_muted %}muted{% endif %}
                              {% if section.settings.video_controls %}controls{% endif %}
                              preload="none"
                              data-video
                              data-index="{{ tvs_video_index }}"
                              data-autoplay="{{ section.settings.video_autoplay }}"
                              data-src="{{ tvs_src }}"
                              data-type="{{ tvs_type }}"
                              data-src-lq="{{ tvs_src_lq }}"
                              data-type-lq="{{ tvs_type_lq }}"
                            ></video>
                            <div class="tvs-video-loader" aria-hidden="true">
                              <div class="tvs-loader-spinner"></div>
                            </div>
                          {% endif %}
                          {% if section.settings.show_play_pause_button %}
                            <button type="button" class="tvs-play-pause-btn tvs-btn-{{ section.settings.play_pause_position }}" data-play-pause {% if tvs_src == blank %}disabled{% endif %} aria-label="Play or pause video">
                              <svg class="tvs-play-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M8 5V19L19 12L8 5Z" fill="currentColor"/>
                              </svg>
                              <svg class="tvs-pause-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M6 4H10V20H6V4ZM14 4H18V20H14V4Z" fill="currentColor"/>
                              </svg>
                            </button>
                          {% endif %}
                        {% else %}
                          <div class="tvs-video-placeholder">
                            <p>Upload a video</p>
                          </div>
                          {% if section.settings.show_play_pause_button %}
                            <button type="button" class="tvs-play-pause-btn tvs-btn-{{ section.settings.play_pause_position }}" data-play-pause disabled aria-label="Play or pause video">
                              <svg class="tvs-play-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M8 5V19L19 12L8 5Z" fill="currentColor"/>
                              </svg>
                              <svg class="tvs-pause-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M6 4H10V20H6V4ZM14 4H18V20H14V4Z" fill="currentColor"/>
                              </svg>
                            </button>
                          {% endif %}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}

      {% comment %} Custom HTML Blocks {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'custom_html' %}
          <div class="tvs-custom-html-block" {{ block.shopify_attributes }}>
            {{ block.settings.html_content }}
          </div>
        {% endif %}
      {% endfor %}

    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    {% if section.settings.use_theme_colors %}
      background: {{ settings.section_background }};
      {% if settings.section_gradient_enabled %}
        background: {{ settings.section_gradient }};
      {% endif %}
    {% else %}
      background: {{ section.settings.section_background }};
      {% if section.settings.section_gradient_enabled %}
        background: {{ section.settings.section_gradient }};
      {% endif %}
    {% endif %}
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
  }

  .section-{{ section.id }} .page-width {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .tvs-content-wrapper {
    width: 100%;
  }

  {% comment %} Heading Styles {% endcomment %}
  .section-{{ section.id }} .tvs-header-wrapper {
    margin-bottom: {{ section.settings.header_spacing }}px;
  }

  .section-{{ section.id }} .tvs-align-left {
    text-align: left;
  }

  .section-{{ section.id }} .tvs-align-center {
    text-align: center;
  }

  .section-{{ section.id }} .tvs-align-right {
    text-align: right;
  }

  .section-{{ section.id }} .tvs-heading {
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    letter-spacing: {{ settings.heading_letter_spacing }};
    text-transform: {{ settings.heading_text_transform }};
    {% if settings.enable_global_typography %}
      font-size: {{ settings.heading_font_size_desktop }}px;
      font-weight: {{ settings.heading_font_weight }};
    {% else %}
      font-size: {{ section.settings.heading_font_size_desktop }}px;
      font-weight: {{ section.settings.heading_font_weight }};
    {% endif %}
    {% if section.settings.use_theme_colors %}
      color: {{ settings.heading_color }};
    {% else %}
      color: {{ section.settings.heading_color }};
    {% endif %}
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    line-height: 1.2;
  }

  .section-{{ section.id }} .tvs-highlighted-text {
    font-family: {{ settings.highlighted_text_font.family }}, {{ settings.highlighted_text_font.fallback_families }};
    text-transform: {{ settings.highlighted_text_transform }};
    display: inline-block; /* Always inline-block to prevent gradient from spreading across full container width */
    {% if section.settings.use_theme_colors %}
      {% if settings.highlighted_text_gradient_enabled %}
        background: {{ settings.highlighted_text_gradient }};
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      {% else %}
        color: {{ settings.highlighted_text_solid_color }};
      {% endif %}
    {% else %}
      {% if section.settings.highlighted_gradient_enabled %}
        background: {{ section.settings.highlighted_gradient }};
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      {% else %}
        color: {{ section.settings.highlighted_color }};
      {% endif %}
    {% endif %}
    {% if settings.enable_global_typography %}
      font-size: {{ settings.highlighted_text_font_size_desktop }}px;
      font-weight: {{ settings.highlighted_text_font_weight }};
      letter-spacing: {{ settings.highlighted_text_letter_spacing | divided_by: 1000.0 }}em;
      font-style: {{ settings.highlighted_text_font_style }};
    {% else %}
      font-size: {{ section.settings.highlighted_font_size_desktop }}px;
      font-weight: {{ section.settings.highlighted_font_weight }};
      letter-spacing: {{ settings.highlighted_text_letter_spacing | divided_by: 1000.0 }}em;
      font-style: {{ settings.highlighted_text_font_style }};
    {% endif %}
  }

  .section-{{ section.id }} .tvs-highlighted-separate {
    display: inline-block;
    margin-bottom: {{ section.settings.highlighted_spacing }}px;
  }

  .section-{{ section.id }} .tvs-intro-text {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: {{ section.settings.intro_font_size }}px;
    line-height: 1.6;
    {% if section.settings.use_theme_colors %}
      color: {{ settings.body_color }};
    {% else %}
      color: {{ section.settings.intro_text_color }};
    {% endif %}
    margin-bottom: {{ section.settings.intro_text_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .tvs-heading {
      {% if settings.enable_global_typography %}
        font-size: {{ settings.heading_font_size_mobile }}px;
      {% else %}
        font-size: {{ section.settings.heading_font_size_mobile }}px;
      {% endif %}
    }

    .section-{{ section.id }} .tvs-highlighted-text {
      {% if settings.enable_global_typography %}
        font-size: {{ settings.highlighted_text_font_size_mobile }}px;
      {% else %}
        font-size: {{ section.settings.highlighted_font_size_mobile }}px;
      {% endif %}
    }
  }

  {% comment %} Slider Styles {% endcomment %}
  .section-{{ section.id }} .tvs-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .section-{{ section.id }} .tvs-slider-viewport {
    overflow-x: auto;
    overflow-y: visible;
    width: 100%;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 1rem;
  }

  .section-{{ section.id }} .tvs-slider-viewport::-webkit-scrollbar {
    height: 6px;
  }

  .section-{{ section.id }} .tvs-slider-viewport::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.08);
    border-radius: 999px;
  }

  .section-{{ section.id }} .tvs-slider-viewport::-webkit-scrollbar-thumb {
    background: rgba(15, 23, 42, 0.3);
    border-radius: 999px;
  }

  .section-{{ section.id }} .tvs-slider-viewport:active {
    cursor: grabbing;
  }

  .section-{{ section.id }} .tvs-slider-track {
    display: flex;
    gap: {{ section.settings.slide_gap }}px;
    min-width: 100%;
    width: max-content;
  }

  .section-{{ section.id }} .tvs-slide {
    flex: 0 0 {{ section.settings.slide_width_desktop }}%;
    min-width: {{ section.settings.slide_width_desktop }}%;
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) and (max-width: 1023px) {
    .section-{{ section.id }} .tvs-slide {
      flex: 0 0 {{ section.settings.slide_width_tablet }}%;
      min-width: {{ section.settings.slide_width_tablet }}%;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .tvs-slide {
      flex: 0 0 {{ section.settings.slide_width_mobile }}%;
      min-width: {{ section.settings.slide_width_mobile }}%;
    }
  }

  {% comment %} Video Card Styles {% endcomment %}
  .section-{{ section.id }} .tvs-video-card {
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    overflow: hidden;
    height: 100%;
  }

  .section-{{ section.id }} .tvs-video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .section-{{ section.id }} .tvs-aspect-square {
    aspect-ratio: 1 / 1;
  }

  .section-{{ section.id }} .tvs-aspect-portrait {
    aspect-ratio: 3 / 4;
  }

  .section-{{ section.id }} .tvs-aspect-landscape {
    aspect-ratio: 16 / 9;
  }

  .section-{{ section.id }} .tvs-aspect-vertical {
    aspect-ratio: 9 / 16;
  }

  .section-{{ section.id }} .tvs-video-wrapper {
    background: {{ section.settings.card_background }};
  }

  .section-{{ section.id }} .tvs-video-skeleton {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(110deg, rgba(15, 23, 42, 0.04) 25%, rgba(15, 23, 42, 0.09) 37%, rgba(15, 23, 42, 0.04) 63%);
    background-size: 200% 100%;
    animation: tvs-shimmer 1.2s ease-in-out infinite;
  }

  .section-{{ section.id }} .tvs-video-wrapper.tvs-poster-ready .tvs-video-skeleton,
  .section-{{ section.id }} .tvs-video-wrapper.tvs-unavailable .tvs-video-skeleton,
  .section-{{ section.id }} .tvs-video-wrapper.tvs-ready .tvs-video-skeleton {
    animation: none;
    opacity: 0;
    pointer-events: none;
  }

  .section-{{ section.id }} .tvs-video-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: opacity 0.25s ease;
  }

  .section-{{ section.id }} .tvs-video-fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: none;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.06);
    color: rgba(15, 23, 42, 0.45);
    text-align: center;
    padding: 12px;
  }

  .section-{{ section.id }} .tvs-video-fallback svg {
    width: 36px;
    height: 36px;
  }

  .section-{{ section.id }} .tvs-video-fallback-label {
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .section-{{ section.id }} .tvs-unavailable:not(.tvs-has-poster) .tvs-video-fallback,
  .section-{{ section.id }} .tvs-unavailable.tvs-poster-failed .tvs-video-fallback {
    display: flex;
  }

  .section-{{ section.id }} .tvs-unavailable.tvs-has-poster:not(.tvs-poster-failed) .tvs-video-poster {
    opacity: 1;
  }

  .section-{{ section.id }} .tvs-video-element {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .section-{{ section.id }} .tvs-video-element.tvs-loaded {
    opacity: 1;
  }

  .section-{{ section.id }} .tvs-video-loader {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 10px;
    background: transparent;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 3;
  }

  .section-{{ section.id }} .tvs-video-loader.tvs-loader-visible {
    opacity: 1;
  }

  .section-{{ section.id }} .tvs-video-wrapper:not(.tvs-has-poster) .tvs-video-loader {
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .section-{{ section.id }} .tvs-video-loader.tvs-hide,
  .section-{{ section.id }} .tvs-unavailable .tvs-video-loader {
    opacity: 0;
    pointer-events: none;
  }

  .section-{{ section.id }} .tvs-loader-spinner {
    width: 22px;
    height: 22px;
    border: 2px solid rgba(255,255,255,0.55);
    border-top-color: rgba(15, 23, 42, 0.7);
    border-radius: 50%;
    background: rgba(255,255,255,0.78);
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.12);
    animation: tvs-spin 0.7s linear infinite;
  }

  @keyframes tvs-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes tvs-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .section-{{ section.id }} .tvs-play-pause-btn {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.play_pause_width }}px;
    height: {{ section.settings.play_pause_height }}px;
    {% if section.settings.enable_play_pause_bg %}
      background: {{ section.settings.play_pause_bg_color }};
      {% if section.settings.enable_play_pause_blur %}
        backdrop-filter: blur({{ section.settings.play_pause_blur_amount }}px);
        -webkit-backdrop-filter: blur({{ section.settings.play_pause_blur_amount }}px);
      {% endif %}
    {% else %}
      background: transparent;
    {% endif %}
    border: {{ section.settings.play_pause_border_width }}px solid {{ section.settings.play_pause_border_color }};
    border-radius: {{ section.settings.play_pause_border_radius }}px;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.2s ease;
    padding: 0;
    color: {{ section.settings.play_pause_icon_color }};
  }

  .section-{{ section.id }} .tvs-play-pause-btn:hover {
    transform: scale(1.05);
  }

  .section-{{ section.id }} .tvs-play-pause-btn.tvs-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .section-{{ section.id }} .tvs-btn-top-left {
    top: 7px;
    left: 7px;
  }

  .section-{{ section.id }} .tvs-btn-top-right {
    top: 7px;
    right: 7px;
  }

  .section-{{ section.id }} .tvs-btn-bottom-left {
    bottom: 7px;
    left: 7px;
  }

  .section-{{ section.id }} .tvs-btn-bottom-right {
    bottom: 7px;
    right: 7px;
  }

  .section-{{ section.id }} .tvs-btn-center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .section-{{ section.id }} .tvs-btn-center:hover {
    transform: translate(-50%, -50%) scale(1.05);
  }

