<section class="ltl-fry-ingredients section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lf-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="lfi2-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="lfi2-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="lfi2-grid">
        {% for block in section.blocks %}
          {% if block.type == 'ingredient' %}
            <div class="lfi2-item lfi2-item--level-{{ block.settings.level }} lfi2-block-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="lfi2-item__header">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'lfi2-item__image', alt: block.settings.name }}
                {% endif %}
                <div class="lfi2-item__meta">
                  {% if block.settings.level_label != blank %}
                    <span class="lfi2-item__level">{{ block.settings.level_label }}</span>
                  {% endif %}
                  {% if block.settings.name != blank %}
                    <h3 class="lfi2-item__name">{{ block.settings.name }}</h3>
                  {% endif %}
                  {% if block.settings.percent != blank %}
                    <span class="lfi2-item__percent">{{ block.settings.percent }}</span>
                  {% endif %}
                </div>
              </div>
              {% if block.settings.description != blank %}
                <div class="lfi2-item__desc rte">{{ block.settings.description }}</div>
              {% endif %}
              <div class="lfi2-item__bar" aria-hidden="true">
                <span class="lfi2-item__bar-fill lfi2-item__bar-fill--{{ block.settings.level }}"></span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% render 'ltl-fry-section-base', section: section %}

<style>
  .section-{{ section.id }} .lfi2-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 8px;
  }

  .section-{{ section.id }} .lfi2-subheading {
    font-size: {{ section.settings.subheading_font_size_mobile }}px;
    color: {{ section.settings.subheading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .section-{{ section.id }} .lfi2-grid {
    display: grid;
    gap: {{ section.settings.item_gap_mobile }}px;
  }

  .section-{{ section.id }} .lfi2-item {
    background: {{ section.settings.item_bg_color }};
    border-radius: {{ section.settings.item_border_radius }}px;
    padding: 16px;
    border: 1px solid {{ section.settings.item_border_color }};
  }

  .section-{{ section.id }} .lfi2-item__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .section-{{ section.id }} .lfi2-item__image {
    width: {{ section.settings.ingredient_image_size_mobile }}px;
    height: {{ section.settings.ingredient_image_size_mobile }}px;
    object-fit: cover;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .section-{{ section.id }} .lfi2-item__level {
    display: inline-block;
    font-size: {{ section.settings.level_font_size_mobile }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }

  .section-{{ section.id }} .lfi2-item--level-high .lfi2-item__level { color: {{ section.settings.level_high_color }}; }
  .section-{{ section.id }} .lfi2-item--level-medium .lfi2-item__level { color: {{ section.settings.level_medium_color }}; }
  .section-{{ section.id }} .lfi2-item--level-low .lfi2-item__level { color: {{ section.settings.level_low_color }}; }

  .section-{{ section.id }} .lfi2-item__name {
    font-size: {{ section.settings.name_font_size_mobile }}px;
    font-weight: {{ section.settings.name_font_weight }};
    color: {{ section.settings.name_color }};
    margin: 0;
  }

  .section-{{ section.id }} .lfi2-item__percent {
    font-size: {{ section.settings.percent_font_size_mobile }}px;
    color: {{ section.settings.percent_color }};
    margin-left: auto;
    font-weight: 600;
  }

  .section-{{ section.id }} .lfi2-item__desc {
    font-size: {{ section.settings.desc_font_size_mobile }}px;
    color: {{ section.settings.desc_color }};
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .section-{{ section.id }} .lfi2-item__bar {
    height: 6px;
    background: {{ section.settings.bar_bg_color }};
    border-radius: 6px;
    overflow: hidden;
  }

  .section-{{ section.id }} .lfi2-item__bar-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
  }

  .section-{{ section.id }} .lfi2-item__bar-fill--high { width: 100%; background: {{ section.settings.level_high_color }}; }
  .section-{{ section.id }} .lfi2-item__bar-fill--medium { width: 66%; background: {{ section.settings.level_medium_color }}; }
  .section-{{ section.id }} .lfi2-item__bar-fill--low { width: 33%; background: {{ section.settings.level_low_color }}; }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .lfi2-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfi2-subheading {
      font-size: {{ section.settings.subheading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfi2-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: {{ section.settings.item_gap_desktop }}px;
    }

    .section-{{ section.id }} .lfi2-item__image {
      width: {{ section.settings.ingredient_image_size_desktop }}px;
      height: {{ section.settings.ingredient_image_size_desktop }}px;
    }

    .section-{{ section.id }} .lfi2-item__level {
      font-size: {{ section.settings.level_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfi2-item__name {
      font-size: {{ section.settings.name_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfi2-item__percent {
      font-size: {{ section.settings.percent_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfi2-item__desc {
      font-size: {{ section.settings.desc_font_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "ltl-fry-ingredients",
  "tag": "section",
  "class": "section-ltl-fry-ingredients",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Key ingredients" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 3, "step": 1, "label": "Columns (desktop)", "default": 2 },
    { "type": "range", "id": "item_gap_mobile", "min": 12, "max": 32, "step": 4, "unit": "px", "label": "Item gap (mobile)", "default": 16 },
    { "type": "range", "id": "item_gap_desktop", "min": 16, "max": 40, "step": 4, "unit": "px", "label": "Item gap (desktop)", "default": 24 },
    { "type": "color", "id": "item_bg_color", "label": "Item background", "default": "#ffffff" },
    { "type": "color", "id": "item_border_color", "label": "Item border color", "default": "#e5e7eb" },
    { "type": "range", "id": "item_border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Item radius", "default": 12 },
    { "type": "range", "id": "ingredient_image_size_mobile", "min": 32, "max": 72, "step": 4, "unit": "px", "label": "Image size (mobile)", "default": 48 },
    { "type": "range", "id": "ingredient_image_size_desktop", "min": 40, "max": 80, "step": 4, "unit": "px", "label": "Image size (desktop)", "default": 56 },
    { "type": "color", "id": "level_high_color", "label": "High level color", "default": "#cc667c" },
    { "type": "color", "id": "level_medium_color", "label": "Medium level color", "default": "#d4a574" },
    { "type": "color", "id": "level_low_color", "label": "Low level color", "default": "#9ca3af" },
    { "type": "color", "id": "bar_bg_color", "label": "Bar background", "default": "#e5e7eb" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size_mobile", "min": 20, "max": 48, "step": 2, "unit": "px", "label": "Heading size (mobile)", "default": 28 },
    { "type": "range", "id": "heading_font_size_desktop", "min": 24, "max": 56, "step": 2, "unit": "px", "label": "Heading size (desktop)", "default": 40 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" },
      { "value": "700", "label": "Bold" }
    ], "default": "600" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1f2937" },
    { "type": "range", "id": "subheading_font_size_mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Subheading size (mobile)", "default": 15 },
    { "type": "range", "id": "subheading_font_size_desktop", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Subheading size (desktop)", "default": 16 },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#6b7280" },
    { "type": "range", "id": "level_font_size_mobile", "min": 10, "max": 14, "step": 1, "unit": "px", "label": "Level label size (mobile)", "default": 11 },
    { "type": "range", "id": "level_font_size_desktop", "min": 10, "max": 14, "step": 1, "unit": "px", "label": "Level label size (desktop)", "default": 12 },
    { "type": "range", "id": "name_font_size_mobile", "min": 14, "max": 24, "step": 1, "unit": "px", "label": "Name size (mobile)", "default": 16 },
    { "type": "range", "id": "name_font_size_desktop", "min": 16, "max": 28, "step": 1, "unit": "px", "label": "Name size (desktop)", "default": 18 },
    { "type": "select", "id": "name_font_weight", "label": "Name weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" }
    ], "default": "600" },
    { "type": "color", "id": "name_color", "label": "Name color", "default": "#111827" },
    { "type": "range", "id": "percent_font_size_mobile", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Percent size (mobile)", "default": 14 },
    { "type": "range", "id": "percent_font_size_desktop", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Percent size (desktop)", "default": 15 },
    { "type": "color", "id": "percent_color", "label": "Percent color", "default": "#6b7280" },
    { "type": "range", "id": "desc_font_size_mobile", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Description size (mobile)", "default": 14 },
    { "type": "range", "id": "desc_font_size_desktop", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Description size (desktop)", "default": 15 },
    { "type": "color", "id": "desc_color", "label": "Description color", "default": "#4b5563" },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf8f6" },
    { "type": "checkbox", "id": "gradient_enabled", "label": "Use gradient background", "default": false },
    { "type": "color_background", "id": "gradient_background", "label": "Gradient", "default": "linear-gradient(180deg, rgba(250,248,246,1), rgba(255,255,255,1) 100%)" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "body_color", "label": "Body color", "default": "#374151" },
    { "type": "range", "id": "body_font_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Body size (mobile)", "default": 16 },
    { "type": "range", "id": "body_font_size_desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Body size (desktop)", "default": 16 },
    { "type": "range", "id": "container_max_width", "min": 600, "max": 1200, "step": 10, "unit": "px", "label": "Container max width", "default": 1000 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (mobile)", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (mobile)", "default": 32 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (desktop)", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (desktop)", "default": 48 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "select", "id": "level", "label": "Level", "options": [
          { "value": "high", "label": "High" },
          { "value": "medium", "label": "Medium" },
          { "value": "low", "label": "Low" }
        ], "default": "high" },
        { "type": "text", "id": "level_label", "label": "Level label", "default": "Hero ingredient" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "PDRN" },
        { "type": "text", "id": "percent", "label": "Percentage", "default": "5%" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Describe this ingredient and its benefits.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ltl-fry-ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "level": "high" } },
        { "type": "ingredient", "settings": { "level": "medium" } },
        { "type": "ingredient", "settings": { "level": "low" } }
      ]
    }
  ]
}
{% endschema %}
