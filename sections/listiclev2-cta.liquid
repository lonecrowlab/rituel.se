{% liquid
  assign layout_style = section.settings.layout_style | default: 'style_1'
  assign product = section.settings.product
  assign cta_image = section.settings.image
  if cta_image == blank and product != blank and product.featured_image
    assign cta_image = product.featured_image
  endif

  assign button_url = section.settings.button_url
  if button_url == blank and product != blank
    assign button_url = product.url
  endif

  assign wrap_max_width = section.settings.container_max_width | plus: 0
  assign has_media = false
  if cta_image != blank or product != blank
    assign has_media = true
  endif
%}

<section
  class="listiclev2-cta section-{{ section.id }} lv2a--{{ layout_style }}{% if has_media %} lv2a--has-media{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.section_id != blank %}id="{{ section.settings.section_id }}"{% endif %}
>
  <div class="page-width lv2a-wrap">
    <div class="lv2a-grid">
      <div class="lv2a-media">
        {% if layout_style == 'style_1' and section.settings.heading != blank %}
          <div class="lv2a-heading lv2a-heading--media">{{ section.settings.heading }}</div>
        {% endif %}

        {% if cta_image != blank %}
          <div class="lv2a-media__image-wrap">
            {% if product != blank %}
              <a href="{{ product.url }}" class="lv2a-media__link">
                {% assign media_alt = cta_image.alt | default: product.title %}
                {{ cta_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'lv2a-media__image', alt: media_alt }}
              </a>
            {% else %}
              {{ cta_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'lv2a-media__image', alt: cta_image.alt }}
            {% endif %}
          </div>
        {% endif %}

        {% if layout_style == 'style_1' %}
          {% if section.settings.title != blank or section.settings.badge != blank %}
            <div class="lv2a-title-row lv2a-title-row--media">
              {% if section.settings.title != blank %}
                <h2 class="lv2a-title">{{ section.settings.title }}</h2>
              {% endif %}
              {% if section.settings.badge != blank %}
                <span class="lv2a-badge">{{ section.settings.badge }}</span>
              {% endif %}
            </div>
          {% endif %}
        {% endif %}
      </div>

      <div class="lv2a-content">
        {% if layout_style == 'style_2' %}
          {% if section.settings.title != blank or section.settings.badge != blank %}
            <div class="lv2a-title-row">
              {% if section.settings.title != blank %}
                <h2 class="lv2a-title">{{ section.settings.title }}</h2>
              {% endif %}
              {% if section.settings.badge != blank %}
                <span class="lv2a-badge">{{ section.settings.badge }}</span>
              {% endif %}
            </div>
          {% endif %}
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="lv2a-blocks">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'icon_text' %}
                  {% if block.settings.text != blank %}
                    {% liquid
                      assign icon_layout = block.settings.layout | default: 'horizontal'
                      assign icon_row_tag = 'div'
                      if block.settings.link != blank
                        assign icon_row_tag = 'a'
                      endif
                    %}
                    <{{ icon_row_tag }}
                      class="lv2a-block lv2a-block--icon-text lv2a-icon-row lv2a-icon-row--{{ icon_layout }} lv2a-block-{{ block.id }}"
                      {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <div class="lv2a-icon-row__icon">
                        {% if block.settings.icon_image != blank %}
                          {{ block.settings.icon_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'lv2a-icon-row__img', alt: '' }}
                        {% elsif block.settings.icon_name != blank %}
                          <span class="lv2a-icon-row__svg">
                            {% render 'icons', icon: block.settings.icon_name %}
                          </span>
                        {% endif %}
                      </div>
                      <div class="lv2a-icon-row__text rte">{{ block.settings.text }}</div>
                    </{{ icon_row_tag }}>
                  {% endif %}
                {% when 'text' %}
                  {% if block.settings.text != blank %}
                    <div class="lv2a-block lv2a-block--text lv2a-block-{{ block.id }}" {{ block.shopify_attributes }}>
                      <div class="lv2a-text">{{ block.settings.text }}</div>
                    </div>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="lv2a-btn"
            href="{{ button_url | default: '#' }}"
            {% if section.settings.button_open_new_tab %}target="_blank" rel="noopener"{% endif %}
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {% if section.settings.guarantee_text != blank or section.settings.customers_text != blank %}
          <div class="lv2a-guarantee">
            {% if section.settings.guarantee_text != blank %}
              <span class="lv2a-guarantee__item">
                <span class="lv2a-guarantee__icon" aria-hidden="true">
                  {% render 'icons', icon: 'shield_check' %}
                </span>
                <span class="lv2a-guarantee__text">{{ section.settings.guarantee_text }}</span>
              </span>
            {% endif %}
            {% if section.settings.guarantee_text != blank and section.settings.customers_text != blank %}
              <span class="lv2a-guarantee__sep" aria-hidden="true">|</span>
            {% endif %}
            {% if section.settings.customers_text != blank %}
              <span class="lv2a-guarantee__item">
                <span class="lv2a-guarantee__icon" aria-hidden="true">
                  {% render 'icons', icon: 'customers' %}
                </span>
                <span class="lv2a-guarantee__text">{{ section.settings.customers_text }}</span>
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .section-{{ section.id }} .lv2a-wrap {
    {% if wrap_max_width == 0 %}
      max-width: none;
    {% else %}
      max-width: {{ wrap_max_width }}px;
    {% endif %}
    margin-left: auto;
    margin-right: auto;
    width: 100%;
  }

  .section-{{ section.id }} .lv2a-grid {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.column_gap_mobile }}px;
  }

  .section-{{ section.id }} .lv2a-media,
  .section-{{ section.id }} .lv2a-content {
    width: 100%;
    min-width: 0;
  }

  .section-{{ section.id }} .lv2a-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    color: {{ section.settings.heading_color }};
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: 1.3;
    margin: 0 0 12px;
    text-align: {{ section.settings.heading_align_mobile }};
  }

  .section-{{ section.id }} .lv2a-media__image-wrap {
    width: 100%;
  }

  .section-{{ section.id }} .lv2a-media__link {
    display: block;
    text-decoration: none;
  }

  .section-{{ section.id }} .lv2a-media__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  .section-{{ section.id }} .lv2a-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    margin: 0 0 16px;
  }

  .section-{{ section.id }} .lv2a-title-row--media {
    margin-top: 14px;
    margin-bottom: 0;
  }

  .section-{{ section.id }} .lv2a-title {
    font-size: {{ section.settings.title_font_size_mobile }}px;
    color: {{ section.settings.title_color }};
    font-weight: {{ section.settings.title_font_weight }};
    line-height: 1.25;
    margin: 0;
  }

  .section-{{ section.id }} .lv2a-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.badge_font_size_mobile }}px;
    font-weight: {{ section.settings.badge_font_weight }};
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: {{ section.settings.badge_text_color }};
    background: {{ section.settings.badge_bg_color }};
    padding: {{ section.settings.badge_padding_vertical }}px {{ section.settings.badge_padding_horizontal }}px;
    border-radius: {{ section.settings.badge_border_radius }}px;
    line-height: 1;
  }

  .section-{{ section.id }} .lv2a-blocks {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.blocks_gap_mobile }}px;
    margin-bottom: 20px;
  }

  .section-{{ section.id }} .lv2a-block--text .lv2a-text {
    font-size: {{ section.settings.text_font_size_mobile }}px;
    color: {{ section.settings.text_color }};
    line-height: 1.55;
  }

  .section-{{ section.id }} .lv2a-block--text .lv2a-text p {
    margin: 0 0 0.75em;
  }

  .section-{{ section.id }} .lv2a-block--text .lv2a-text p:last-child {
    margin-bottom: 0;
  }
.icon-with-text__item h4{
  text-align:left;
}
  .section-{{ section.id }} .lv2a-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    font-size: {{ section.settings.button_font_size_mobile }}px;
    font-weight: {{ section.settings.button_font_weight }};
    color: {{ section.settings.button_text_color }};
    background: {{ section.settings.button_bg_color }};
    padding: {{ section.settings.button_padding_vertical_mobile }}px {{ section.settings.button_padding_horizontal_mobile }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    text-decoration: none;
    text-align: center;
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin-bottom: 14px;
    transition: opacity 0.2s ease;
  }

  .section-{{ section.id }} .lv2a-btn:hover {
    opacity: 0.9;
  }

  .section-{{ section.id }} .lv2a-guarantee {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {{ section.settings.guarantee_align_mobile }};
    gap: 6px 10px;
    font-size: {{ section.settings.guarantee_font_size_mobile }}px;
    color: {{ section.settings.guarantee_color }};
    line-height: 1.4;
  }

  .section-{{ section.id }} .lv2a-guarantee__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .section-{{ section.id }} .lv2a-guarantee__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: {{ section.settings.guarantee_icon_color }};
    width: {{ section.settings.guarantee_icon_size }}px;
    height: {{ section.settings.guarantee_icon_size }}px;
  }

  .section-{{ section.id }} .lv2a-guarantee__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .section-{{ section.id }} .lv2a-guarantee__sep {
    opacity: 0.5;
  }

  .section-{{ section.id }} .lv2a-icon-row {
    display: flex;
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
  }

  .section-{{ section.id }} .lv2a-icon-row--horizontal {
    flex-direction: row;
    align-items: flex-start;
  }

  .section-{{ section.id }} .lv2a-icon-row--vertical {
    flex-direction: column;
    align-items: flex-start;
  }

  .section-{{ section.id }} .lv2a-icon-row__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-{{ section.id }} .lv2a-icon-row__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .section-{{ section.id }} .lv2a-icon-row__svg svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .section-{{ section.id }} .lv2a-icon-row__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .section-{{ section.id }} .lv2a-icon-row__text {
    flex: 1;
    line-height: 1.5;
    text-align: left;
  }

  .section-{{ section.id }} .lv2a-icon-row__text p {
    margin: 0;
  }

  {% for block in section.blocks %}
    {% if block.type == 'icon_text' %}
      .section-{{ section.id }} .lv2a-block-{{ block.id }} {
        gap: {{ block.settings.gap }}px;
        padding-top: {{ block.settings.padding_vertical }}px;
        padding-bottom: {{ block.settings.padding_vertical }}px;
        padding-left: {{ block.settings.padding_horizontal }}px;
        padding-right: {{ block.settings.padding_horizontal }}px;
        margin-bottom: {{ block.settings.margin_bottom }}px;
      }
      .section-{{ section.id }} .lv2a-block-{{ block.id }} .lv2a-icon-row__icon {
        width: {{ block.settings.icon_size_mobile }}px;
        height: {{ block.settings.icon_size_mobile }}px;
        background: {{ block.settings.icon_bg_color }};
        border-radius: {{ block.settings.icon_radius }}px;
        color: {{ block.settings.icon_color }};
        padding: {{ block.settings.icon_padding }}px;
      }
      .section-{{ section.id }} .lv2a-block-{{ block.id }} .lv2a-icon-row__text {
        font-size: {{ block.settings.text_font_size_mobile }}px;
        color: {{ block.settings.text_color }};
      }
    {% endif %}
    {% if block.type == 'text' %}
      .section-{{ section.id }} .lv2a-block-{{ block.id }} .lv2a-text {
        {% if block.settings.font_size_mobile != blank %}
          font-size: {{ block.settings.font_size_mobile }}px;
        {% endif %}
        {% if block.settings.color != blank %}
          color: {{ block.settings.color }};
        {% endif %}
      }
    {% endif %}
  {% endfor %}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .section-{{ section.id }}.lv2a--has-media .lv2a-grid {
      display: grid;
      grid-template-columns: {{ section.settings.media_width }}fr {{ 100 | minus: section.settings.media_width }}fr;
      gap: {{ section.settings.column_gap_desktop }}px;
      align-items: {{ section.settings.vertical_align }};
    }

    .section-{{ section.id }} .lv2a-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
      text-align: {{ section.settings.heading_align_desktop }};
    }

    .section-{{ section.id }} .lv2a-title {
      font-size: {{ section.settings.title_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2a-badge {
      font-size: {{ section.settings.badge_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2a-blocks {
      gap: {{ section.settings.blocks_gap_desktop }}px;
    }

    .section-{{ section.id }} .lv2a-block--text .lv2a-text {
      font-size: {{ section.settings.text_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lv2a-btn {
      font-size: {{ section.settings.button_font_size_desktop }}px;
      padding: {{ section.settings.button_padding_vertical_desktop }}px {{ section.settings.button_padding_horizontal_desktop }}px;
    }

    .section-{{ section.id }} .lv2a-guarantee {
      justify-content: {{ section.settings.guarantee_align_desktop }};
      font-size: {{ section.settings.guarantee_font_size_desktop }}px;
    }

    {% for block in section.blocks %}
      {% if block.type == 'icon_text' %}
        .section-{{ section.id }} .lv2a-block-{{ block.id }} .lv2a-icon-row__icon {
          width: {{ block.settings.icon_size_desktop }}px;
          height: {{ block.settings.icon_size_desktop }}px;
        }
        .section-{{ section.id }} .lv2a-block-{{ block.id }} .lv2a-icon-row__text {
          font-size: {{ block.settings.text_font_size_desktop }}px;
        }
      {% endif %}
      {% if block.type == 'text' %}
        .section-{{ section.id }} .lv2a-block-{{ block.id }} .lv2a-text {
          {% if block.settings.font_size_desktop != blank %}
            font-size: {{ block.settings.font_size_desktop }}px;
          {% endif %}
        }
      {% endif %}
    {% endfor %}
  }
</style>

{% schema %}
{
  "name": "Listiclev2 CTA",
  "tag": "section",
  "class": "section-listiclev2-cta",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section anchor ID"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Style",
      "options": [
        { "value": "style_1", "label": "Style 1" },
        { "value": "style_2", "label": "Style 2" }
      ],
      "default": "style_1",
      "info": "Style 1: heading + title/badge under image on left. Style 2: title/badge on the right with content."
    },
    {
      "type": "header",
      "content": "Product / Image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Shows on the left. Used for image fallback and button link if no URL is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional override. If empty, product image is used."
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Get Started With Labareau's Signature Anti-Aging Set:</p>",
      "info": "Shown above the image in Style 1."
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "The Collection"
    },
    {
      "type": "inline_richtext",
      "id": "badge",
      "label": "Badge",
      "default": "BESTSELLER"
    },
    {
      "type": "inline_richtext",
      "id": "button_label",
      "label": "Button text",
      "default": "GET \"THE COLLECTION\" NOW →"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "info": "Falls back to product URL when empty."
    },
    {
      "type": "checkbox",
      "id": "button_open_new_tab",
      "label": "Open button in new tab",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "guarantee_text",
      "label": "Button guarantee",
      "default": "Recommended by Doctors"
    },
    {
      "type": "inline_richtext",
      "id": "customers_text",
      "label": "Customers text",
      "default": "250,000+ Happy Customers"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Left column width (desktop)",
      "default": 45
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical align (desktop)",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Column gap (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Column gap (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "blocks_gap_mobile",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Blocks gap (mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "blocks_gap_desktop",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Blocks gap (desktop)",
      "default": 14
    },
    {
      "type": "number",
      "id": "container_max_width",
      "label": "Container max width (px)",
      "default": 1000,
      "info": "Set to 0 for full width. Section background stays full width."
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading (desktop)",
      "default": 26
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Heading align (mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_align_desktop",
      "label": "Heading align (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Title typography"
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Title (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Title (desktop)",
      "default": 28
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
