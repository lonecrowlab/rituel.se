<section class="listiclev2-text section-{{ section.id }}" data-section-id="{{ section.id }}" {% if section.settings.section_id != blank %}id="{{ section.settings.section_id }}"{% endif %}>
  <div class="page-width lv2x-wrap">
    {% if section.settings.content != blank %}
      <div class="lv2x-content rte">{{ section.settings.content }}</div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .section-{{ section.id }} .lv2x-wrap {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    width: 100%;
    text-align: {{ section.settings.text_align }};
  }

  .section-{{ section.id }} .lv2x-content {
    font-size: {{ section.settings.font_size_mobile }}px;
    color: {{ section.settings.text_color }};
    line-height: {{ section.settings.line_height }};
    font-weight: {{ section.settings.font_weight }};
  }

  .section-{{ section.id }} .lv2x-content p {
    margin: 0 0 1em;
  }

  .section-{{ section.id }} .lv2x-content p:last-child {
    margin-bottom: 0;
  }

  .section-{{ section.id }} .lv2x-content ol,
  .section-{{ section.id }} .lv2x-content ul {
    margin: 0 0 1em;
    padding-left: 1.25em;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .section-{{ section.id }} .lv2x-content {
      font-size: {{ section.settings.font_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Listiclev2 Text",
  "tag": "section",
  "class": "section-listiclev2-text",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section anchor ID",
      "info": "Optional anchor for in-page navigation"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your listicle text here. Use bold, underline, and lists as needed.</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font size (desktop)",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 1.2,
      "max": 2,
      "step": 0.1,
      "label": "Line height",
      "default": 1.6
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Container max width",
      "default": 750,
      "info": "Content container width. Section background stays full width."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Listiclev2 Text"
    }
  ]
}
{% endschema %}
