      }
      .vso-warning__title {
        font-size: 18px;
      }
      .vso-warning__subtitle {
        max-width: none;
      }
      .vso-warning__image {
        flex: none;
        max-width: 100%;
      }
    }
  </style>
{%- endif -%}


  <div class="vso-hero-06__container vso-node vd-l vso-hidden">
      <div class="vso-hero-06__inner">
        {%- for block in section.blocks -%}
          {%- if block.type == 'media' -%}
            <div class="vso-hero-06__media">
              <div class="vso-hero-06__media-container" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                <div class="vso-hero-06__media-wrapper">
                  {% if block.settings.video != blank %}
                    {{ block.settings.video | video_tag: 
                      controls: block.settings.controls, 
                      autoplay: true, 
                      loop: true, 
                      muted: true, 
                      playsinline: block.settings.playsinline, 
                      loading: 'lazy',
                      preload: block.settings.preload | default: 'metadata',
                      class: 'vso-hero-06__video' 
                    }}
                  {% elsif block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'vso-hero-06__image' }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}

                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
  
        <div class="vso-hero-06__text">
          {%- for block in section.blocks -%}
            {%- unless block.type == 'media' -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  {%- liquid
                    assign title_parts = block.settings.heading | split: '_'
                    assign processed_title = ''
                    assign is_highlighted = false
                    for part in title_parts
                      if is_highlighted
                        capture highlighted_part
                          echo '<span class="highlight-text">' | append: part | append: '</span>'
                        endcapture
                        assign processed_title = processed_title | append: highlighted_part
                        assign is_highlighted = false
                      else
                        assign processed_title = processed_title | append: part
                        assign is_highlighted = true
                      endif
                    endfor
                  -%}
                  <div class="vso-hero-06__heading-flex" data-block-id="{{ block.id }}">
                    {%- if block.settings.custom_font -%}
                      <h2 class="vso-hero-06__title">
                        {{ processed_title }}
                      </h2>
                    {%- else -%}
                      {%- assign heading_tag = block.settings.heading_as | default: 'h2' -%}
                      <{{ heading_tag }} class="vso-hero-06__title">
                        {{ processed_title }}
                      </{{ heading_tag }}>
                    {%- endif -%}
                  </div>
                {%- when 'paragraph' -%}
                  <div class="vso-hero-06__paragraph-flex" data-block-id="{{ block.id }}">
                    {%- if block.settings.custom_font -%}
                      <p class="vso-hero-06__paragraph">
                        {{ block.settings.text }}
                      </p>
                    {%- else -%}
                      {%- assign paragraph_tag = block.settings.paragraph_as | default: 'p' -%}
                      <{{ paragraph_tag }} class="vso-hero-06__paragraph">
                        {{ block.settings.text }}
                      </{{ paragraph_tag }}>
                    {%- endif -%}
                  </div>
                {%- when 'button' -%}
                  <div class="vso-hero-06__button-wrapper-flex" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                    {% assign btn_url = block.settings.url %}
                    {% if btn_url != blank %}
                      <a href="{{ btn_url }}" class="vso-hero-06__button">
                        {{ block.settings.label }}
                      </a>
                    {% else %}
                      <button class="vso-hero-06__button" type="button">
                        {{ block.settings.label }}
                      </button>
                    {% endif %}
                  </div>

                {%- when 'feature' -%}
                  <div class="vso-hero-06__feature" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                    {% if block.settings.icon != blank %}
                      <img class="vso-hero-06__feature-icon" src="{{ block.settings.icon | image_url: width: 64 }}" alt="{{ block.settings.icon.alt | escape }}" loading="lazy" width="{{ section.settings.feature_icon_size_desktop }}" height="{{ section.settings.feature_icon_size_desktop }}">
                    {% else %}
                      <svg class="vso-hero-06__feature-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="{{ section.settings.feature_icon_size_desktop }}" height="{{ section.settings.feature_icon_size_desktop }}">
                        <circle cx="12" cy="12" r="10" fill="{{ section.settings.feature_svg_background_color | default: '#000000' }}"/>
                        <path d="M8 12.5l3 3 5-6" fill="none" stroke="{{ section.settings.feature_svg_check_color | default: '#ffffff' }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                    {%- if section.settings.feature_custom_font -%}
                      <p class="vso-hero-06__feature-text">{{ block.settings.text }}</p>
                    {%- else -%}
                      {%- assign feature_tag = section.settings.feature_as | default: 'p' -%}
                      <{{ feature_tag }} class="vso-hero-06__feature-text">{{ block.settings.text }}</{{ feature_tag }}>
                    {%- endif -%}
                  </div>
                {%- when 'testimonial' -%}
                  <div class="vso-hero-06__testimonial" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                    <div class="vso-hero-06__testimonial-stars vso-hero-06__testimonial-stars--legacy">
                      {% for i in (1..5) %}
                        {% case block.settings.star_icon %}
                          {% when 'star1' %}
                            <span class="star star-filled">
                              <svg viewBox="-2.4 -2.4 28.80 28.80" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="1em" height="1em"><g id="SVGRepo_bgCarrier" stroke-width="0" transform="translate(1.2,1.2), scale(0.9)"><rect x="-2.4" y="-2.4" width="28.80" height="28.80" rx="0" fill="{{ block.settings.star_bg_color }}" strokewidth="0"></rect></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <rect x="0" fill="none" width="24" height="24"></rect> <g> <path d="M12 2l2.582 6.953L22 9.257l-5.822 4.602L18.18 21 12 16.89 5.82 21l2.002-7.14L2 9.256l7.418-.304"></path> </g> </g></svg>
                            </span>
                          {% when 'star2' %}
