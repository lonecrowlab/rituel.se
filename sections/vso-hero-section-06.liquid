{% endcomment %}

{%- liquid
  assign text_max_width_desktop_value = section.settings.text_max_width_desktop
  assign bg_full_width_desktop = false

  if text_max_width_desktop_value <= 100
    assign text_max_width_desktop_value = text_max_width_desktop_value | times: 16
  endif

  if section.settings.bg_full_width == true
    assign bg_full_width_desktop = true
  endif
-%}

{%- style -%}
  .vd-l { display: none !important; }
    #shopify-section-{{ section.id }} {
      --section-border-radius: {{ section.settings.section_border_radius_mobile }}px;
      --section-horizontal-padding: var(--page-margin, 16px);
      --blocks-gap: {{ section.settings.blocks_gap }}px;
      --feature-gap: {{ section.settings.feature_gap }}px;
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
      border-radius: var(--section-border-radius);
      overflow: hidden;
      padding: 0;
    }

    {% if section.settings.enable_advanced_settings %}
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: {{ section.settings.padding_horizontal_mobile }}px;
      }
    {% endif %}

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        background-color: {{ section.settings.section_bg_color }};
      }
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-border-radius: {% if bg_full_width_desktop %}0px{% else %}{{ section.settings.section_border_radius }}px{% endif %};
        --section-horizontal-padding: 0px;
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
        border-radius: var(--section-border-radius);
        {% if bg_full_width_desktop %}
          background-color: {{ section.settings.section_bg_color }};
        {% else %}
          background: transparent;
        {% endif %}
      }
    }

    {% if section.settings.enable_advanced_settings == false and bg_full_width_desktop == false %}
      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} {
          --section-horizontal-padding: 40px;
        }
      }
    {% endif %}

    {% if section.settings.enable_advanced_settings == false and bg_full_width_desktop %}
      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} {
          --section-container-max-width: var(--page-content-width, var(--page-width, 1440px));
          --section-outer-gutter: max(0px, calc((100vw - var(--section-container-max-width)) / 2));
          --section-horizontal-padding: max(0px, calc(var(--page-margin, 40px) - var(--section-outer-gutter)));
        }
      }
    {% endif %}

    {% if section.settings.enable_advanced_settings %}
      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} {
          --section-horizontal-padding: {{ section.settings.padding_horizontal }}px;
        }
      }
    {% endif %}
  
    #shopify-section-{{ section.id }} > .vso-hero-06__container {
      margin-left: auto;
      margin-right: auto;
      width: 100%;
      max-width: var(--page-content-width, var(--page-width, 1440px));
      {% if section.settings.enable_advanced_settings %}
        {% if bg_full_width_desktop and section.settings.section_full_width == true %}
          max-width: 100%;
        {% else %}
          max-width: {{ section.settings.section_max_width }}rem;
        {% endif %}
      {% endif %}
      border-radius: var(--section-border-radius);
      overflow: hidden;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: var(--section-horizontal-padding);
      padding-right: var(--section-horizontal-padding);
    }

    {% if bg_full_width_desktop == false %}
      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} > .vso-hero-06__container {
          width: calc(100% - (2 * var(--page-margin, 40px)));
        }
      }
    {% endif %}

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} > .vso-hero-06__container {
        background: transparent;
      }
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} > .vso-hero-06__container {
        {% if bg_full_width_desktop %}
          background: transparent;
        {% else %}
          background-color: {{ section.settings.section_bg_color }};
        {% endif %}
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  
    #shopify-section-{{ section.id }} .vso-hero-06__inner {
      display: flex;
      flex-direction: column;
      gap: var(--blocks-gap);
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-06__inner {
        --desktop-text-media-gap: {% if section.settings.enable_advanced_settings %}0px{% else %}40px{% endif %};
        flex-direction: {% if section.settings.reverse_layout_desktop %}row-reverse{% else %}row{% endif %}; 
        align-items: center;
        gap: var(--desktop-text-media-gap);
      }
      #shopify-section-{{ section.id }} .vso-hero-06__media,
      #shopify-section-{{ section.id }} .vso-hero-06__text {
        flex: 0 0 calc((100% - var(--desktop-text-media-gap)) / 2);
        max-width: calc((100% - var(--desktop-text-media-gap)) / 2);
      }
  
      #shopify-section-{{ section.id }} .vso-hero-06__text > * {
        max-width: {{ text_max_width_desktop_value }}px;
        margin-left: auto;
        margin-right: auto;
      }
    }
  
    #shopify-section-{{ section.id }} .vso-hero-06__text {
      display: flex;
      flex-direction: column;
      gap: var(--blocks-gap);
      {% if section.settings.enable_advanced_settings %}
        padding-left: {{ section.settings.text_max_width_horizontal_padding_mobile }}px;
        padding-right: {{ section.settings.text_max_width_horizontal_padding_mobile }}px;
      {% else %}
        padding-left: 0;
        padding-right: 0;
      {% endif %}
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-06__text {
        {% if section.settings.enable_advanced_settings %}
          padding-left: {{ section.settings.text_max_width_horizontal_padding }}px;
          padding-right: {{ section.settings.text_max_width_horizontal_padding }}px;
        {% else %}
          padding-left: 0;
          padding-right: 0;
        {% endif %}
      }
    }
  
    #shopify-section-{{ section.id }} .vso-hero-06__feature {
      display: flex;
      align-items: center;
    }
  
    #shopify-section-{{ section.id }} .vso-hero-06__media-container {
      position: relative;
      width: 100%;
      overflow: hidden;
    }
    
    #shopify-section-{{ section.id }} .vso-hero-06__media-wrapper video,
    #shopify-section-{{ section.id }} .vso-hero-06__media-wrapper .vso-hero-06__video,
    #shopify-section-{{ section.id }} .vso-hero-06__media-wrapper .vso-hero-06__image,
    #shopify-section-{{ section.id }} .vso-hero-06__media-wrapper picture,
    #shopify-section-{{ section.id }} .vso-hero-06__media-wrapper img {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      display: block !important;
      max-width: none !important;
      max-height: none !important;
      min-width: 100% !important;
      min-height: 100% !important;
    }

    #shopify-section-{{ section.id }} .vso-hero-06__media-wrapper picture img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    #shopify-section-{{ section.id }} .vso-hero-06__media-wrapper .placeholder-svg {
      width: 100%;
      height: 100%;
      display: block;
      background-color: #f3f3f3;
    }
    
    #shopify-section-{{ section.id }} .vso-hero-06__media-wrapper .placeholder-svg svg {
      width: 100%;
      height: 100%;
      fill: #9ca3af;
    }

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        {%- assign justify_mobile_heading = 'flex-start' -%}
        {%- if section.settings.feature_text_alignment_mobile == 'center' -%}
          {%- assign justify_mobile_heading = 'center' -%}
        {%- elsif section.settings.feature_text_alignment_mobile == 'right' -%}
          {%- assign justify_mobile_heading = 'flex-end' -%}
        {%- endif -%}
        {%- assign justify_desktop_heading = 'flex-start' -%}
        {%- if section.settings.feature_text_alignment_desktop == 'center' -%}
          {%- assign justify_desktop_heading = 'center' -%}
        {%- elsif section.settings.feature_text_alignment_desktop == 'right' -%}
          {%- assign justify_desktop_heading = 'flex-end' -%}
        {%- endif -%}
        #shopify-section-{{ section.id }} .vso-hero-06__heading-flex[data-block-id="{{ block.id }}"] {
          justify-content: {{ justify_mobile_heading }};
          margin-top: {{ block.settings.margin_top_mobile }}px;
          margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
        }
        #shopify-section-{{ section.id }} .vso-hero-06__heading-flex[data-block-id="{{ block.id }}"] .vso-hero-06__title {
          margin-top: 0;
          margin-bottom: 0;
          --highlight-color: {{ block.settings.highlight_color }};
        }
        {% if block.settings.custom_font %}
          #shopify-section-{{ section.id }} .vso-hero-06__heading-flex[data-block-id="{{ block.id }}"] .vso-hero-06__title {
            color: {{ block.settings.text_color }};
            font-size: {{ block.settings.font_size_mobile }}px;
            font-weight: {{ block.settings.font_weight }};
            line-height: {{ block.settings.line_height }};
            font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
            font-style: {{ block.settings.font.style }};
          }
        {% endif %}
        @media screen and (min-width: 750px) {
          #shopify-section-{{ section.id }} .vso-hero-06__heading-flex[data-block-id="{{ block.id }}"] {
            justify-content: {{ justify_desktop_heading }};
            margin-top: {{ block.settings.margin_top }}px;
            margin-bottom: {{ block.settings.margin_bottom }}px;
          }
          #shopify-section-{{ section.id }} .vso-hero-06__heading-flex[data-block-id="{{ block.id }}"] .vso-hero-06__title {
            margin-top: 0;
          }
          {% if block.settings.custom_font %}
            #shopify-section-{{ section.id }} .vso-hero-06__heading-flex[data-block-id="{{ block.id }}"] .vso-hero-06__title {
              font-size: {{ block.settings.font_size_desktop }}px;
            }
          {% endif %}
        }

      {%- when 'paragraph' -%}
        {%- assign justify_mobile_para = 'flex-start' -%}
        {%- if section.settings.feature_text_alignment_mobile == 'center' -%}
          {%- assign justify_mobile_para = 'center' -%}
        {%- elsif section.settings.feature_text_alignment_mobile == 'right' -%}
          {%- assign justify_mobile_para = 'flex-end' -%}
        {%- endif -%}
        {%- assign justify_desktop_para = 'flex-start' -%}
        {%- if section.settings.feature_text_alignment_desktop == 'center' -%}
          {%- assign justify_desktop_para = 'center' -%}
        {%- elsif section.settings.feature_text_alignment_desktop == 'right' -%}
          {%- assign justify_desktop_para = 'flex-end' -%}
        {%- endif -%}
        #shopify-section-{{ section.id }} .vso-hero-06__paragraph-flex[data-block-id="{{ block.id }}"] {
          justify-content: {{ justify_mobile_para }};
          margin-top: {{ block.settings.margin_top_mobile }}px;
          margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
        }
        #shopify-section-{{ section.id }} .vso-hero-06__paragraph-flex[data-block-id="{{ block.id }}"] .vso-hero-06__paragraph {
          {% if block.settings.custom_font %}
            color: {{ block.settings.text_color }};
            font-size: {{ block.settings.font_size_mobile }}px;
            font-weight: {{ block.settings.font_weight }};
            font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
            font-style: {{ block.settings.font.style }};
          {% endif %}
        }
        @media screen and (min-width: 750px) {
          #shopify-section-{{ section.id }} .vso-hero-06__paragraph-flex[data-block-id="{{ block.id }}"] {
            justify-content: {{ justify_desktop_para }};
            margin-top: {{ block.settings.margin_top }}px;
            margin-bottom: {{ block.settings.margin_bottom }}px;
          }
          {% if block.settings.custom_font %}
            #shopify-section-{{ section.id }} .vso-hero-06__paragraph-flex[data-block-id="{{ block.id }}"] .vso-hero-06__paragraph {
              font-size: {{ block.settings.font_size_desktop }}px;
              font-weight: {{ block.settings.font_weight }};
            }
          {% endif %}
        }

      {%- when 'button' -%}
        {%- assign justify_mobile_btn = 'flex-start' -%}
        {%- if section.settings.feature_text_alignment_mobile == 'center' -%}
          {%- assign justify_mobile_btn = 'center' -%}
        {%- elsif section.settings.feature_text_alignment_mobile == 'right' -%}
          {%- assign justify_mobile_btn = 'flex-end' -%}
        {%- endif -%}
        {%- assign justify_desktop_btn = 'flex-start' -%}
        {%- if section.settings.feature_text_alignment_desktop == 'center' -%}
          {%- assign justify_desktop_btn = 'center' -%}
        {%- elsif section.settings.feature_text_alignment_desktop == 'right' -%}
          {%- assign justify_desktop_btn = 'flex-end' -%}
        {%- endif -%}
        #shopify-section-{{ section.id }} .vso-hero-06__button-wrapper-flex[data-block-id="{{ block.id }}"] {
          justify-content: {{ justify_mobile_btn }};
          margin-top: {{ block.settings.margin_top_mobile }}px;
          margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
        }
        #shopify-section-{{ section.id }} .vso-hero-06__button-wrapper-flex[data-block-id="{{ block.id }}"] .vso-hero-06__button {
          font-size: {{ block.settings.font_size_mobile }}px;
          padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding_mobile }}px;
          border-radius: {{ block.settings.border_radius }}px;
          background: {{ block.settings.bg_color }};
          color: {{ block.settings.text_color }};
          border: none;
          cursor: pointer;
          text-decoration: none;
          display: inline-block;
          transition: all 0.2s ease;
          {% if block.settings.custom_font %}font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }}; font-style: {{ block.settings.font.style }};{% endif %}
        }
        #shopify-section-{{ section.id }} .vso-hero-06__button-wrapper-flex[data-block-id="{{ block.id }}"] .vso-hero-06__button:hover {
          background: {{ block.settings.hover_bg_color }};
          color: {{ block.settings.hover_text_color }};
        }
        @media screen and (min-width: 750px) {
          #shopify-section-{{ section.id }} .vso-hero-06__button-wrapper-flex[data-block-id="{{ block.id }}"] {
            justify-content: {{ justify_desktop_btn }};
            margin-top: {{ block.settings.margin_top }}px;
            margin-bottom: {{ block.settings.margin_bottom }}px;
          }
          #shopify-section-{{ section.id }} .vso-hero-06__button-wrapper-flex[data-block-id="{{ block.id }}"] .vso-hero-06__button {
            font-size: {{ block.settings.font_size_desktop }}px;
            padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
          }
        }

      {%- when 'feature' -%}
        {%- assign justify_mobile = 'flex-start' -%}
        {%- if section.settings.feature_text_alignment_mobile == 'center' -%}
          {%- assign justify_mobile = 'center' -%}
        {%- elsif section.settings.feature_text_alignment_mobile == 'right' -%}
          {%- assign justify_mobile = 'flex-end' -%}
        {%- endif -%}
        {%- assign justify_desktop = 'flex-start' -%}
        {%- if section.settings.feature_text_alignment_desktop == 'center' -%}
          {%- assign justify_desktop = 'center' -%}
        {%- elsif section.settings.feature_text_alignment_desktop == 'right' -%}
          {%- assign justify_desktop = 'flex-end' -%}
        {%- endif -%}
        #shopify-section-{{ section.id }} .vso-hero-06__feature[data-block-id="{{ block.id }}"] {
          width: 100%;
          --icon-size-mobile: {{ section.settings.feature_icon_size_mobile }}px;
          --icon-size-desktop: {{ section.settings.feature_icon_size_desktop }}px;
          --icon-text-gap: {{ section.settings.feature_icon_text_gap }}px;
          margin-top: {{ block.settings.margin_top_mobile }}px;
          margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
          display: flex;
          align-items: center;
          justify-content: {{ justify_mobile }};
          gap: var(--icon-text-gap);
        }
        #shopify-section-{{ section.id }} .vso-hero-06__feature[data-block-id="{{ block.id }}"] .vso-hero-06__feature-icon {
          width: var(--icon-size-mobile);
          height: auto;
          display: block;
          vertical-align: middle;
        }
        #shopify-section-{{ section.id }} .vso-hero-06__feature[data-block-id="{{ block.id }}"] .vso-hero-06__feature-icon svg {
          width: var(--icon-size-mobile);
          height: var(--icon-size-mobile);
          display: block;
          vertical-align: middle;
        }
        #shopify-section-{{ section.id }} .vso-hero-06__feature[data-block-id="{{ block.id }}"] .vso-hero-06__feature-text {
          margin: 0;
        }
        {% if section.settings.feature_custom_font %}
          #shopify-section-{{ section.id }} .vso-hero-06__feature[data-block-id="{{ block.id }}"] .vso-hero-06__feature-text {
            font-size: {{ section.settings.feature_font_size_mobile }}px;
            color: {{ section.settings.feature_text_color }};
            font-weight: {{ section.settings.feature_font_weight }};
            font-family: {{ section.settings.feature_font.family }}, {{ section.settings.feature_font.fallback_families }};
            font-style: {{ section.settings.feature_font.style }};
          }
        {% endif %}
        @media screen and (min-width: 750px) {
          #shopify-section-{{ section.id }} .vso-hero-06__feature[data-block-id="{{ block.id }}"] {
            width: 100%;
            margin-top: {{ block.settings.margin_top }}px;
            margin-bottom: {{ block.settings.margin_bottom }}px;
            justify-content: {{ justify_desktop }};
          }
          #shopify-section-{{ section.id }} .vso-hero-06__feature[data-block-id="{{ block.id }}"] .vso-hero-06__feature-icon {
            width: var(--icon-size-desktop);
          }
          #shopify-section-{{ section.id }} .vso-hero-06__feature[data-block-id="{{ block.id }}"] .vso-hero-06__feature-icon svg {
            width: var(--icon-size-desktop);
            height: var(--icon-size-desktop);
          }
          {% if section.settings.feature_custom_font %}
            #shopify-section-{{ section.id }} .vso-hero-06__feature[data-block-id="{{ block.id }}"] .vso-hero-06__feature-text {
              font-size: {{ section.settings.feature_font_size_desktop }}px;
              font-weight: {{ section.settings.feature_font_weight }};
            }
          {% endif %}
        }

      {%- when 'testimonial' -%}
        {%- assign align_items_mobile = 'center' -%}
        {%- assign text_align_mobile = block.settings.testimonial_alignment_mobile -%}
        {%- if block.settings.testimonial_alignment_mobile == 'left' -%}
          {%- assign align_items_mobile = 'flex-start' -%}
        {%- elsif block.settings.testimonial_alignment_mobile == 'right' -%}
          {%- assign align_items_mobile = 'flex-end' -%}
        {%- endif -%}
        {%- assign align_items_desktop = 'center' -%}
        {%- assign text_align_desktop = block.settings.testimonial_alignment_desktop -%}
        {%- if block.settings.testimonial_alignment_desktop == 'left' -%}
          {%- assign align_items_desktop = 'flex-start' -%}
        {%- elsif block.settings.testimonial_alignment_desktop == 'right' -%}
          {%- assign align_items_desktop = 'flex-end' -%}
        {%- endif -%}
        #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] {
          padding: 20px;
          width: 100%;
          display: flex;
          flex-direction: column;
          align-items: {{ align_items_mobile }};
          text-align: {{ text_align_mobile }};
          border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
          border-radius: {{ block.settings.border_radius }}px;
          background-color: {{ block.settings.block_bg_color }};
          margin-top: {{ block.settings.margin_top_mobile }}px;
          margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
        }
        #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-title {
          margin-top: 0;
          margin-bottom: {{ block.settings.title_margin_bottom }}px;
        }
        {% if block.settings.custom_title_font %}
          #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-title {
            font-size: {{ block.settings.title_font_size_mobile }}px;
            font-weight: 600;
            color: {{ block.settings.title_color }};
            font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
            font-style: {{ block.settings.title_font.style }};
          }
        {% endif %}
        #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-stars {
          display: flex;
          flex-direction: row;
          gap: {{ block.settings.star_gap }}px;
          font-size: {{ block.settings.star_size_mobile }}px;
          margin: 0 0 {{ block.settings.stars_margin_bottom }}px 0;
          color: {{ block.settings.star_color }};
        }
        #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-content {
          margin-top: 0;
          margin-bottom: {{ block.settings.text_margin_bottom }}px;
        }
        {% if block.settings.custom_content_font %}
          #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-content {
            font-size: {{ block.settings.content_font_size_mobile }}px;
            line-height: 1.5;
            color: {{ block.settings.content_color }};
            font-family: {{ block.settings.content_font.family }}, {{ block.settings.content_font.fallback_families }};
            font-style: {{ block.settings.content_font.style }};
          }
        {% endif %}
        #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-author {
          margin: 0;
        }
        {% if block.settings.custom_author_font %}
          #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-author {
            font-size: {{ block.settings.author_font_size_mobile }}px;
            font-weight: 500;
            color: {{ block.settings.author_color }};
            font-family: {{ block.settings.author_font.family }}, {{ block.settings.author_font.fallback_families }};
            font-style: {{ block.settings.author_font.style }};
          }
        {% endif %}
        @media screen and (min-width: 750px) {
          #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] {
            align-items: {{ align_items_desktop }};
            text-align: {{ text_align_desktop }};
            margin-top: {{ block.settings.margin_top }}px;
            margin-bottom: {{ block.settings.margin_bottom }}px;
          }
          {% if block.settings.custom_title_font %}
            #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-title {
              font-size: {{ block.settings.title_font_size_desktop }}px;
            }
          {% endif %}
          #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-stars {
            font-size: {{ block.settings.star_size_desktop }}px;
          }
          {% if block.settings.custom_content_font %}
            #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-content {
              font-size: {{ block.settings.content_font_size_desktop }}px;
            }
          {% endif %}
          {% if block.settings.custom_author_font %}
            #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .vso-hero-06__testimonial-author {
              font-size: {{ block.settings.author_font_size_desktop }}px;
            }
          {% endif %}
        }

      {%- when 'media' -%}
        {%- liquid
          assign media_height_mobile_value = block.settings.media_height_mobile
          assign media_height_desktop_value = block.settings.media_height_desktop

          if media_height_mobile_value <= 60
            assign media_height_mobile_value = media_height_mobile_value | times: 16
          endif

          if media_height_desktop_value <= 75
            assign media_height_desktop_value = media_height_desktop_value | times: 16
          endif
        -%}
        #shopify-section-{{ section.id }} .vso-hero-06__media-container[data-block-id="{{ block.id }}"] {
          border-radius: {{ block.settings.media_border_radius }}px;
          margin-top: {{ block.settings.margin_top_mobile }}px;
          margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
        }
        #shopify-section-{{ section.id }} .vso-hero-06__media-container[data-block-id="{{ block.id }}"] .vso-hero-06__media-wrapper {
          position: relative;
          width: 100%;
          height: {{ media_height_mobile_value }}px;
          overflow: hidden;
          background: #f0f0f0;
        }
        @media screen and (min-width: 750px) {
          #shopify-section-{{ section.id }} .vso-hero-06__media-container[data-block-id="{{ block.id }}"] .vso-hero-06__media-wrapper {
            height: {{ media_height_desktop_value }}px;
          }
          #shopify-section-{{ section.id }} .vso-hero-06__media-container[data-block-id="{{ block.id }}"] {
            margin-top: {{ block.settings.margin_top }}px;
            margin-bottom: {{ block.settings.margin_bottom }}px;
          }
        }

    {%- endcase -%}
  {%- endfor -%}

  /* Heading block flex container styles */
  #shopify-section-{{ section.id }} .vso-hero-06__heading-flex {
    width: 100%;
    display: flex;
  }

  /* Paragraph block flex container styles */
  #shopify-section-{{ section.id }} .vso-hero-06__paragraph-flex {
    width: 100%;
    display: flex;
  }

  /* Button wrapper flex container styles */
  #shopify-section-{{ section.id }} .vso-hero-06__button-wrapper-flex {
    width: 100%;
    display: flex;
  }

  /* Testimonial legacy stars hidden */
  #shopify-section-{{ section.id }} .vso-hero-06__testimonial-stars--legacy {
    display: none !important;
  }

  /* Highlight color for heading spans */
  #shopify-section-{{ section.id }} .vso-hero-06__title .highlight-text {
    color: var(--highlight-color);
  }

  /* Testimonial star styles */
  {%- for block in section.blocks -%}
    {%- if block.type == 'testimonial' -%}
      #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .star-half {
        background: linear-gradient(to right, {{ block.settings.star_bg_color }} 50%, {{ block.settings.star_empty_color }} 50%);
        color: {{ block.settings.star_color }};
      }
      #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .star-empty-text {
        color: {{ block.settings.star_empty_color }};
      }
      #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .gradient-stop-filled {
        stop-color: {{ block.settings.star_bg_color }};
        stop-opacity: 1;
      }
      #shopify-section-{{ section.id }} .vso-hero-06__testimonial[data-block-id="{{ block.id }}"] .gradient-stop-empty {
        stop-color: {{ block.settings.star_empty_color }};
        stop-opacity: 1;
      }
    {%- endif -%}
  {%- endfor -%}

  .vso-node { display: none; }
  .vso-node--v2 { display: block; }
  {%- endstyle -%}
  
{%- if request.design_mode -%}
