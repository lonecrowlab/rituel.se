                        <{{ title_tag }} class="vso-hero-06__testimonial-title">
                          {{ block.settings.testimonial_title }}
                        </{{ title_tag }}>
                      {%- endif -%}
                    {% endif %}
                    {% if block.settings.testimonial != blank %}
