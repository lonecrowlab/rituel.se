{%- style -%}
  .section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    {% if section.settings.border_bottom_width > 0 %}
      border-bottom: {{ section.settings.border_bottom_width }}px solid {{ section.settings.border_bottom_color }};
    {% endif %}
  }

  .section-{{ section.id }} .subscribe-section__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: {{ section.settings.text_align }};
  }

  .section-{{ section.id }} .subscribe-section__heading {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: {{ section.settings.heading_font_size_desktop }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .subscribe-section__text {
    max-width: {{ section.settings.text_max_width }}px;
    margin: 0 auto {{ section.settings.text_margin_bottom }}px;
    font-size: {{ section.settings.text_font_size_desktop }}px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .subscribe-section__text p {
    margin: 0;
  }

  .section-{{ section.id }} .subscribe-section__form {
    max-width: {{ section.settings.form_max_width }}px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .subscribe-section__fields {
    display: flex;
    align-items: stretch;
    gap: {{ section.settings.form_gap }}px;
  }

  .section-{{ section.id }} .subscribe-section__input {
    flex: 1;
    min-width: 0;
    height: {{ section.settings.field_height }}px;
    padding: 0 14px;
    font-size: {{ section.settings.input_font_size }}px;
    color: {{ section.settings.input_text_color }};
    background-color: {{ section.settings.input_background_color }};
    border: {{ section.settings.input_border_width }}px solid {{ section.settings.input_border_color }};
    border-radius: {{ section.settings.input_border_radius }}px;
    box-shadow: none;
    outline: none;
  }

  .section-{{ section.id }} .subscribe-section__input::placeholder {
    color: {{ section.settings.input_text_color }};
    opacity: 0.6;
  }

  .section-{{ section.id }} .subscribe-section__input:focus-visible {
    border-color: {{ section.settings.button_background_color }};
    box-shadow: 0 0 0 2px {{ section.settings.button_background_color | color_modify: 'alpha', 0.25 }};
  }

  .section-{{ section.id }} .subscribe-section__button {
    flex-shrink: 0;
    height: {{ section.settings.field_height }}px;
    padding: 0 {{ section.settings.button_padding_horizontal }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    letter-spacing: 0.04em;
    text-transform: {% if section.settings.button_uppercase %}uppercase{% else %}none{% endif %};
    white-space: nowrap;
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_background_color }};
    border: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .section-{{ section.id }} .subscribe-section__button:hover {
    background-color: {{ section.settings.button_hover_color }};
  }

  .section-{{ section.id }} .subscribe-section__button:focus-visible {
    outline: 2px solid {{ section.settings.button_background_color }};
    outline-offset: 2px;
  }

  .section-{{ section.id }} .subscribe-section__message {
    margin: 12px 0 0;
    font-size: 14px;
  }

  .section-{{ section.id }} .subscribe-section__message--success {
    color: #2e7d32;
  }

  .section-{{ section.id }} .subscribe-section__message--error {
    color: #c62828;
  }

  .section-{{ section.id }} .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .section-{{ section.id }} .subscribe-section__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    .section-{{ section.id }} .subscribe-section__text {
      font-size: {{ section.settings.text_font_size_mobile }}px;
    }

    {% if section.settings.stack_on_mobile %}
      .section-{{ section.id }} .subscribe-section__fields {
        flex-direction: column;
      }
    {% endif %}
  }
{%- endstyle -%}

<section class="subscribe-section section-{{ section.id }}">
  <div class="subscribe-section__inner">
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="subscribe-section__heading">
        {{- section.settings.heading | escape -}}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="subscribe-section__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- assign form_id = 'SubscribeForm-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'subscribe-section__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <div class="subscribe-section__fields">
        <label class="visually-hidden" for="SubscribeEmail-{{ section.id }}">
          {{- section.settings.input_placeholder | escape -}}
        </label>
        <input
          id="SubscribeEmail-{{ section.id }}"
          class="subscribe-section__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.input_placeholder | escape }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="SubscribeError-{{ section.id }}"
          {% endif %}
        >
        <button type="submit" class="subscribe-section__button" name="commit">
          {{- section.settings.button_text | escape -}}
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <p class="subscribe-section__message subscribe-section__message--success" role="status">
          {{- section.settings.success_message | escape -}}
        </p>
      {%- elsif form.errors -%}
        <p
          id="SubscribeError-{{ section.id }}"
          class="subscribe-section__message subscribe-section__message--error"
          role="alert"
        >
          {{- section.settings.error_message | escape -}}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Subscribe section",
  "tag": "div",
  "class": "subscribe-section-wrapper",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tips & exklusiva erbjudanden" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Registrera dig för att få exklusiv tillgång till våra bästa erbjudanden och guider för att förbättra din hud på naturlig väg.</p>"
    },
    { "type": "text", "id": "input_placeholder", "label": "Email placeholder", "default": "Ange din e-postadress" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Prenumerera" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Tack för att du prenumererar!" },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "Ange en giltig e-postadress." },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "Text alignment",
      "default": "center"
    },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "min": 400, "max": 1200, "step": 20, "unit": "px", "label": "Content max width", "default": 700 },
    { "type": "range", "id": "text_max_width", "min": 200, "max": 900, "step": 10, "unit": "px", "label": "Text max width", "default": 480 },
    { "type": "range", "id": "form_max_width", "min": 250, "max": 800, "step": 10, "unit": "px", "label": "Form max width", "default": 400 },
    { "type": "range", "id": "form_gap", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Gap between input and button", "default": 6 },
    { "type": "checkbox", "id": "stack_on_mobile", "label": "Stack input and button on mobile", "default": false },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#faf6f0" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a1a1a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a1a1a" },

    { "type": "header", "content": "Heading style" },
    { "type": "range", "id": "heading_font_size_desktop", "min": 16, "max": 64, "step": 1, "unit": "px", "label": "Font size (desktop)", "default": 30 },
    { "type": "range", "id": "heading_font_size_mobile", "min": 16, "max": 48, "step": 1, "unit": "px", "label": "Font size (mobile)", "default": 24 },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    { "type": "range", "id": "heading_margin_bottom", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "Space below heading", "default": 12 },

    { "type": "header", "content": "Text style" },
    { "type": "range", "id": "text_font_size_desktop", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Font size (desktop)", "default": 14 },
    { "type": "range", "id": "text_font_size_mobile", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Font size (mobile)", "default": 13 },
    { "type": "range", "id": "text_margin_bottom", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "Space below text", "default": 12 },

    { "type": "header", "content": "Input" },
    { "type": "range", "id": "field_height", "min": 32, "max": 64, "step": 1, "unit": "px", "label": "Input and button height", "default": 42 },
    { "type": "range", "id": "input_font_size", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Font size", "default": 14 },
    { "type": "color", "id": "input_background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "input_text_color", "label": "Text", "default": "#1a1a1a" },
    { "type": "color", "id": "input_border_color", "label": "Border", "default": "#8c8c8c" },
    { "type": "range", "id": "input_border_width", "min": 0, "max": 4, "step": 1, "unit": "px", "label": "Border width", "default": 1 },
    { "type": "range", "id": "input_border_radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Border radius", "default": 2 },

    { "type": "header", "content": "Button" },
    { "type": "color", "id": "button_background_color", "label": "Background", "default": "#ba6a7f" },
    { "type": "color", "id": "button_hover_color", "label": "Hover background", "default": "#a35669" },
    { "type": "color", "id": "button_text_color", "label": "Text", "default": "#ffffff" },
    { "type": "range", "id": "button_font_size", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Font size", "default": 14 },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    { "type": "checkbox", "id": "button_uppercase", "label": "Uppercase text", "default": true },
    { "type": "range", "id": "button_padding_horizontal", "min": 8, "max": 48, "step": 1, "unit": "px", "label": "Horizontal padding", "default": 16 },
    { "type": "range", "id": "button_border_radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Border radius", "default": 2 },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding (desktop)", "default": 20 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding (desktop)", "default": 24 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding (mobile)", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding (mobile)", "default": 32 },

    { "type": "header", "content": "Bottom border" },
    { "type": "range", "id": "border_bottom_width", "min": 0, "max": 10, "step": 1, "unit": "px", "label": "Width", "default": 0 },
    { "type": "color", "id": "border_bottom_color", "label": "Color", "default": "#a08c96" }
  ],
  "presets": [
    { "name": "Subscribe section", "category": "Forms" }
  ]
}
{% endschema %}
