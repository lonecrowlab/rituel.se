    { "type": "range", "id": "column_gap", "min": 24, "max": 80, "step": 4, "unit": "px", "label": "Column gap", "default": 48 },
    { "type": "range", "id": "sticky_top", "min": 20, "max": 160, "step": 4, "unit": "px", "label": "Sticky image offset", "default": 96 },
    { "type": "header", "content": "Timeline" },
    { "type": "range", "id": "scroll_trigger", "min": 30, "max": 70, "step": 5, "unit": "%", "label": "Highlight position", "default": 50, "info": "Viewport height where the active step is highlighted" },
    { "type": "range", "id": "line_width", "min": 1, "max": 6, "step": 1, "unit": "px", "label": "Line width", "default": 2 },
