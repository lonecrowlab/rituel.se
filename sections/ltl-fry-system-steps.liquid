{% liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign use_splide_mobile = false
  if section.settings.mobile_slider and step_blocks.size > 1
    assign use_splide_mobile = true
  endif
%}

<section class="ltl-fry-system-steps section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lf-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="lfss-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="lfss-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if step_blocks.size > 0 %}
      <div class="lfss-steps lfss-steps--desktop">
        {% for block in step_blocks %}
          <div class="lfss-step lfss-block-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="lfss-step__number">{{ forloop.index }}</div>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'lfss-step__image', alt: block.settings.title }}
            {% endif %}
            <div class="lfss-step__content">
              {% if block.settings.title != blank %}
                <h3 class="lfss-step__title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="lfss-step__text rte">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {% if use_splide_mobile %}
        <div class="lfss-steps lfss-steps--mobile">
          <splide-component
            data-type="slide"
            data-autoplay="false"
            data-slides-desktop="1"
            data-slides-mobile="1"
            data-gap-desktop="16"
            data-gap-mobile="16"
            data-arrows="true"
            data-pagination="true"
            data-drag="true"
          >
            <div class="splide lfss-splide">
              <div class="splide__track">
                <ul class="splide__list">
                  {% for block in step_blocks %}
                    <li class="splide__slide">
                      <div class="lfss-step lfss-block-{{ block.id }}">
                        <div class="lfss-step__number">{{ forloop.index }}</div>
                        {% if block.settings.image != blank %}
                          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'lfss-step__image', alt: block.settings.title }}
                        {% endif %}
                        <div class="lfss-step__content">
                          {% if block.settings.title != blank %}
                            <h3 class="lfss-step__title">{{ block.settings.title }}</h3>
                          {% endif %}
                          {% if block.settings.text != blank %}
                            <div class="lfss-step__text rte">{{ block.settings.text }}</div>
                          {% endif %}
                        </div>
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          </splide-component>
        </div>
      {% else %}
        <div class="lfss-steps lfss-steps--mobile lfss-steps--stack">
          {% for block in step_blocks %}
            <div class="lfss-step lfss-block-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="lfss-step__number">{{ forloop.index }}</div>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'lfss-step__image', alt: block.settings.title }}
              {% endif %}
              <div class="lfss-step__content">
                {% if block.settings.title != blank %}
                  <h3 class="lfss-step__title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="lfss-step__text rte">{{ block.settings.text }}</div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% render 'ltl-fry-section-base', section: section %}

<style>
  .section-{{ section.id }} .lfss-heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 8px;
  }

  .section-{{ section.id }} .lfss-subheading {
    font-size: {{ section.settings.subheading_font_size_mobile }}px;
    color: {{ section.settings.subheading_color }};
    text-align: {{ section.settings.text_align }};
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .section-{{ section.id }} .lfss-step {
    background: {{ section.settings.step_bg_color }};
    border-radius: {{ section.settings.step_border_radius }}px;
    padding: 20px;
    text-align: {{ section.settings.text_align }};
  }

  .section-{{ section.id }} .lfss-step__number {
    width: {{ section.settings.number_size }}px;
    height: {{ section.settings.number_size }}px;
    border-radius: 50%;
    background: {{ section.settings.number_bg_color }};
    color: {{ section.settings.number_text_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.number_font_size_mobile }}px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .section-{{ section.id }} .lfss-step__image {
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_border_radius }}px;
    margin-bottom: 12px;
    display: block;
  }

  .section-{{ section.id }} .lfss-step__title {
    font-size: {{ section.settings.step_title_size_mobile }}px;
    font-weight: {{ section.settings.step_title_weight }};
    color: {{ section.settings.step_title_color }};
    margin: 0 0 8px;
  }

  .section-{{ section.id }} .lfss-step__text {
    font-size: {{ section.settings.step_text_size_mobile }}px;
    color: {{ section.settings.step_text_color }};
    line-height: 1.5;
  }

  .section-{{ section.id }} .lfss-steps--desktop {
    display: none;
  }

  .section-{{ section.id }} .lfss-steps--mobile {
    display: block;
  }

  .section-{{ section.id }} .lfss-steps--stack {
    display: grid;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .lfss-heading {
      font-size: {{ section.settings.heading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfss-subheading {
      font-size: {{ section.settings.subheading_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfss-steps--desktop {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: {{ section.settings.gap_desktop }}px;
    }

    .section-{{ section.id }} .lfss-steps--mobile {
      display: none;
    }

    .section-{{ section.id }} .lfss-step__number {
      font-size: {{ section.settings.number_font_size_desktop }}px;
    }

    .section-{{ section.id }} .lfss-step__title {
      font-size: {{ section.settings.step_title_size_desktop }}px;
    }

    .section-{{ section.id }} .lfss-step__text {
      font-size: {{ section.settings.step_text_size_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "ltl-fry-system-steps",
  "tag": "section",
  "class": "section-ltl-fry-system-steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How the system works" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 3 },
    { "type": "range", "id": "gap_desktop", "min": 8, "max": 48, "step": 4, "unit": "px", "label": "Gap (desktop)", "default": 24 },
    { "type": "checkbox", "id": "mobile_slider", "label": "Mobile slider (Splide)", "default": true },
    { "type": "header", "content": "Step style" },
    { "type": "color", "id": "step_bg_color", "label": "Step background", "default": "#faf8f6" },
    { "type": "range", "id": "step_border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Step radius", "default": 12 },
    { "type": "range", "id": "image_border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Image radius", "default": 8 },
    { "type": "range", "id": "number_size", "min": 28, "max": 56, "step": 2, "unit": "px", "label": "Number circle size", "default": 36 },
    { "type": "color", "id": "number_bg_color", "label": "Number background", "default": "#cc667c" },
    { "type": "color", "id": "number_text_color", "label": "Number text", "default": "#ffffff" },
    { "type": "range", "id": "number_font_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Number size (mobile)", "default": 14 },
    { "type": "range", "id": "number_font_size_desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Number size (desktop)", "default": 15 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_font_size_mobile", "min": 20, "max": 48, "step": 2, "unit": "px", "label": "Heading size (mobile)", "default": 28 },
    { "type": "range", "id": "heading_font_size_desktop", "min": 24, "max": 56, "step": 2, "unit": "px", "label": "Heading size (desktop)", "default": 40 },
    { "type": "select", "id": "heading_font_weight", "label": "Heading weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" },
      { "value": "700", "label": "Bold" }
    ], "default": "600" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1f2937" },
    { "type": "range", "id": "subheading_font_size_mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Subheading size (mobile)", "default": 15 },
    { "type": "range", "id": "subheading_font_size_desktop", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Subheading size (desktop)", "default": 16 },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#6b7280" },
    { "type": "range", "id": "step_title_size_mobile", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Step title size (mobile)", "default": 18 },
    { "type": "range", "id": "step_title_size_desktop", "min": 16, "max": 32, "step": 1, "unit": "px", "label": "Step title size (desktop)", "default": 20 },
    { "type": "select", "id": "step_title_weight", "label": "Step title weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" }
    ], "default": "600" },
    { "type": "color", "id": "step_title_color", "label": "Step title color", "default": "#111827" },
    { "type": "range", "id": "step_text_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Step text size (mobile)", "default": 14 },
    { "type": "range", "id": "step_text_size_desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Step text size (desktop)", "default": 15 },
    { "type": "color", "id": "step_text_color", "label": "Step text color", "default": "#4b5563" },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "checkbox", "id": "gradient_enabled", "label": "Use gradient background", "default": false },
    { "type": "color_background", "id": "gradient_background", "label": "Gradient", "default": "linear-gradient(180deg, rgba(255,255,255,1), rgba(250,248,246,1) 100%)" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "body_color", "label": "Body color", "default": "#374151" },
    { "type": "range", "id": "body_font_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Body size (mobile)", "default": 16 },
    { "type": "range", "id": "body_font_size_desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Body size (desktop)", "default": 16 },
    { "type": "range", "id": "container_max_width", "min": 600, "max": 1400, "step": 10, "unit": "px", "label": "Container max width", "default": 1100 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (mobile)", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (mobile)", "default": 32 },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (desktop)", "default": 48 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (desktop)", "default": 48 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this step.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ltl-fry-system-steps",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
