    { "type": "range", "id": "step_spacing_mobile", "min": 12, "max": 40, "step": 2, "unit": "px", "label": "Step spacing (mobile)", "default": 16 },
    { "type": "range", "id": "step_spacing_desktop", "min": 12, "max": 48, "step": 2, "unit": "px", "label": "Step spacing (desktop)", "default": 16 },
    { "type": "header", "content": "Step style" },
    { "type": "color", "id": "step_bg_color", "label": "Step background", "default": "#faf8f6" },
    { "type": "range", "id": "step_border_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Step radius", "default": 16 },
    { "type": "range", "id": "number_size", "min": 24, "max": 48, "step": 2, "unit": "px", "label": "Number circle size", "default": 28 },
    { "type": "color", "id": "number_bg_color", "label": "Number background", "default": "#ffffff" },
    { "type": "color", "id": "number_text_color", "label": "Number text", "default": "#c4b5bc" },
    { "type": "color", "id": "number_border_color", "label": "Number border", "default": "#e8e0e4" },
    { "type": "color", "id": "number_active_bg_color", "label": "Active number background", "default": "#c4b5bc" },
    { "type": "color", "id": "number_active_text_color", "label": "Active number text", "default": "#ffffff" },
    { "type": "range", "id": "number_font_size_mobile", "min": 11, "max": 18, "step": 1, "unit": "px", "label": "Number size (mobile)", "default": 12 },
    { "type": "range", "id": "number_font_size_desktop", "min": 11, "max": 18, "step": 1, "unit": "px", "label": "Number size (desktop)", "default": 13 },
    { "type": "range", "id": "icon_size", "min": 28, "max": 56, "step": 2, "unit": "px", "label": "Step icon size", "default": 36 },
    { "type": "color", "id": "icon_bg_color", "label": "Step icon background", "default": "#d7c6cc" },
    { "type": "header", "content": "Step typography" },
    { "type": "range", "id": "step_title_size_mobile", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Step title size (mobile)", "default": 18 },
    { "type": "range", "id": "step_title_size_desktop", "min": 16, "max": 32, "step": 1, "unit": "px", "label": "Step title size (desktop)", "default": 20 },
    { "type": "select", "id": "step_title_weight", "label": "Step title weight", "options": [
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semibold" },
      { "value": "700", "label": "Bold" }
    ], "default": "600" },
    { "type": "color", "id": "step_title_color", "label": "Step title color", "default": "#111827" },
