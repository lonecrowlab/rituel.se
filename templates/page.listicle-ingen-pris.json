px;\n    font-weight: 500;\n    color: #1a1a1a;\n    margin: 0 0 36px 0;\n    line-height: 1.25;\n  }\n\n  .testimonials__cards {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .testimonial-card {\n    background: #ffffff;\n    border-radius: 12px;\n    padding: 24px 22px;\n    text-align: left;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);\n  }\n\n  .testimonial-card__stars {\n    color: #d9879a;\n    font-size: 14px;\n    letter-spacing: 0.05em;\n    margin-bottom: 14px;\n    line-height: 1;\n  }\n\n  .testimonial-card__quote {\n    color: #1a1a1a;\n    font-size: 14px;\n    font-style: italic;\n    line-height: 1.55;\n    margin: 0 0 18px 0;\n  }\n\n  .testimonial-card__name {\n    color: #1a1a1a;\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.1em;\n    margin: 0;\n  }\n\n  @media (max-width: 480px) {\n    .testimonials {\n      padding: 48px 16px;\n    }\n    .testimonials__heading {\n      font-size: 24px;\n    }\n    .testimonial-card {\n      padding: 20px 18px;\n    }\n  }\n</style>",
