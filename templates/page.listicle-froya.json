        "timeline_step_zCTYhC": {
          "type": "timeline_step",
          "settings": {
            "title": "Keep it simple.No extra products needed.",
            "label": "",
            "text": "<p>Skip the extra cleansers and face washes, your skin doesn’t need them. Overwashing strips natural oils, leading to dryness and breakouts.</p><p>Let your skin breathe, and let Frøya do the work.</p>"
          }
