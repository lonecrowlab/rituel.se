          "type": "timeline_step",
          "settings": {
            "title": "Targeted care when you need it",
            "label": "",
            "text": "<h5>Balm for Dry, Itchy Skin</h5><p>Apply 2-3 times daily to clean, dry skin. Use a thin layer and reapply frequently throughout the day for best results.</p>"
          }
        },
