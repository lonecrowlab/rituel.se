        "heading_HVMj89": {
          "type": "heading",
          "settings": {
            "heading": "<p>Hej! Jag heter Line</p>",
            "heading_accent": "",
            "highlight_position": "inline_last",
            "use_theme_colors": false,
            "font_size_desktop": 48,
            "font_size_mobile": 32,
            "line_height": 1.2,
