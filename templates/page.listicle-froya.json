      "settings": {
        "product": "pdrn-collagen-volume-balm",
        "image_column_width": 50,
        "gallery_aspect_ratio": "4 / 5",
        "gallery_image_fit": "cover",
        "gallery_radius": 0,
        "gallery_bg_color": "#f3eee9",
        "show_save_badge": true,
        "save_badge_text": "SPARA 40%",
        "save_badge_bg_color": "#cc667c",
        "save_badge_text_color": "#ffffff",
        "save_badge_font_size": 14,
        "show_quote_overlay": true,
        "quote_name": "Kari Thompson",
        "quote_text": "",
        "ingredients_button_text": "Visa ingredienser",
        "ingredients_button_bg": "#cc667c",
        "ingredients_button_color": "#ffffff",
        "ingredients_button_font_size_mobile": 18,
        "ingredients_button_font_size_desktop": 18,
        "ingredients_button_radius": 4,
        "ingredients_modal_content": "<div class=\"product-ingredients\">\n<div class=\"section-title\"><p>10 nyckelingredienser, blandade för att samverka</p></div>\n<ul class=\"product-ingredients__list\" role=\"list\">\n<li class=\"product-ingredients__item\" role=\"listitem\">\n<div class=\"product-ingredients__media\"><img src=\"https://cdn.shopify.com/s/files/1/0743/5252/5487/files/s1.svg?v=1790317955\" alt=\"\" width=\"240\" height=\"240\" loading=\"lazy\" class=\"product-ingredients__icon\"></div>\n<div class=\"product-ingredients__body\">\n<span class=\"product-ingredients__tag\">MJUKARE, SLÄTARE HUD</span><h3 class=\"product-ingredients__title\">Granatäpple, arktisk nypon &amp; arnika</h3>\n<div class=\"product-ingredients__text\">Arnika, granatäpple och nypon samverkar för att mjuka upp utseendet av fina linjer och ge en slätare hudstruktur.</div>\n</div>\n</li>\n<li class=\"product-ingredients__item\" role=\"listitem\">\n<div class=\"product-ingredients__media\"><img src=\"https://cdn.shopify.com/s/files/1/0743/5252/5487/files/sunflower.png?v=1790317955\" alt=\"\" width=\"240\" height=\"240\" loading=\"lazy\" class=\"product-ingredients__icon\"></div>\n<div class=\"product-ingredients__body\">\n<span class=\"product-ingredients__tag\">FASTARE HUD</span><h3 class=\"product-ingredients__title\">Naturligt vitamin E</h3>\n<div class=\"product-ingredients__text\">Vitamin E från solrosor är en naturlig antioxidant som hjälper huden att se fastare och mer spänstig ut.</div>\n</div>\n</li>\n<li class=\"product-ingredients__item\" role=\"listitem\">\n<div class=\"product-ingredients__media\"><img src=\"https://cdn.shopify.com/s/files/1/0743/5252/5487/files/beeswax.svg?v=1790317955\" alt=\"\" width=\"240\" height=\"240\" loading=\"lazy\" class=\"product-ingredients__icon\"></div>\n<div class=\"product-ingredients__body\">\n<span class=\"product-ingredients__tag\">STÄRKER HUDBARRIÄREN</span><h3 class=\"product-ingredients__title\">Bivax &amp; tistel</h3>\n<div class=\"product-ingredients__text\">Låser in fukt och hjälper till att skydda och stärka hudbarriären.</div>\n</div>\n</li>\n<li class=\"product-ingredients__item\" role=\"listitem\">\n<div class=\"product-ingredients__media\"><img src=\"https://cdn.shopify.com/s/files/1/0743/5252/5487/files/calendula.svg?v=1790317955\" alt=\"\" width=\"240\" height=\"240\" loading=\"lazy\" class=\"product-ingredients__icon\"></div>\n<div class=\"product-ingredients__body\">\n<span class=\"product-ingredients__tag\">LUGNAR OCH LINDRAR</span><h3 class=\"product-ingredients__title\">Calendula &amp; ringblomma</h3>\n<div class=\"product-ingredients__text\">Kraftfull och snabbverkande lindring för huden.</div>\n</div>\n</li>\n<li class=\"product-ingredients__item\" role=\"listitem\">\n<div class=\"product-ingredients__media\"><img src=\"https://cdn.shopify.com/s/files/1/0743/5252/5487/files/arnica.svg?v=1790317955\" alt=\"\" width=\"240\" height=\"240\" loading=\"lazy\" class=\"product-ingredients__icon\"></div>\n<div class=\"product-ingredients__body\">\n<span class=\"product-ingredients__tag\">LJUSAR UPP MÖRKA RINGAR</span><h3 class=\"product-ingredients__title\">Arktisk arnika &amp; skvalan</h3>\n<div class=\"product-ingredients__text\">Hjälper till att ge fyllighet och fukt åt den känsliga huden under ögonen.</div>\n</div>\n</li>\n<li class=\"product-ingredients__item\" role=\"listitem\">\n<div class=\"product-ingredients__media\"><img src=\"https://cdn.shopify.com/s/files/1/0743/5252/5487/files/sea_buckthorn_smaller.svg?v=1790317955\" alt=\"\" width=\"240\" height=\"240\" loading=\"lazy\" class=\"product-ingredients__icon\"></div>\n<div class=\"product-ingredients__body\">\n<span class=\"product-ingredients__tag\">NATURLIG LYSTER</span><h3 class=\"product-ingredients__title\">Havtorn</h3>\n<div class=\"product-ingredients__text\">En exceptionellt rik naturlig källa till vitamin C (17 gånger mer än apelsiner).</div>\n</div>\n</li>\n</ul>\n</div>",
