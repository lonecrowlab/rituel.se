        "social_proof_accordion_RT_H05": {
          "type": "social_proof_accordion",
          "settings": {
            "question": "Tryggt att beställa 😍",
            "open_default": false,
            "display_mode": "poster",
            "poster_image": "shopify://shop_images/accordion--before.webp",
            "review_1_before_image": "shopify://shop_images/Emma--1.webp",
            "review_1_before_day": "Dag 1",
            "review_1_after_image": "shopify://shop_images/Emma--2.webp",
            "review_1_after_day": "Dag 21",
            "review_1_stars": 5,
            "review_1_title": "Synliga resultat på mogen hud",
            "review_1_review": "Jag var skeptisk efter att ha provat allt. Men efter 3 veckor frågade min syster vad jag gjort, hon trodde jag hade injicerat. Det här är det första som faktiskt fungerar för mogen hud.",
            "review_1_name": "Emma. N, 56",
            "review_2_before_image": "shopify://shop_images/anna-1.webp",
            "review_2_before_day": "Dag 1",
            "review_2_after_image": "shopify://shop_images/anna-2.webp",
            "review_2_after_day": "Dag 42",
            "review_2_stars": 5,
            "review_2_title": "Mjukare textur & slätare panna",
            "review_2_review": "Det första jag märkte var inte det jag väntade mig, det var hudens textur. Den känns mjukare, mer levande. Som om huden tar upp näring igen istället för att bara torka ut. Sen, efter 6 veckor, började även pannan se slätare ut.",
            "review_2_name": "Anna. B, 49",
            "review_3_before_image": "shopify://shop_images/maja-1.webp",
            "review_3_before_day": "Dag 1",
            "review_3_after_image": "shopify://shop_images/maja-2.webp",
            "review_3_after_day": "Dag 30",
            "review_3_stars": 5,
            "review_3_title": "Mindre synliga fina linjer",
            "review_3_review": "Jag har testat ungefär allt och är ganska trött på produkter som lovar runt. Den här är första gången på länge jag faktiskt ser skillnad, även på de fina linjerna.",
            "review_3_name": "Maja. L, 44",
            "review_4_before_image": "shopify://shop_images/sofia--1.webp",
            "review_4_before_day": "Dag 1",
            "review_4_after_image": "shopify://shop_images/sofia--2.webp",
            "review_4_after_day": "Dag 21",
            "review_4_stars": 5,
            "review_4_title": "Synlig skillnad under ögonen",
            "review_4_review": "Har provat alla krämer som finns på marknaden. Trodde inte längre på underverk. Men efter 3 veckor med PDRN-balmen är skillnaden så tydlig att jag inte längre behöver foundation under ögonen.",
            "review_4_name": "Sofia. H, 52",
            "review_5_before_image": "shopify://shop_images/eva--1.webp",
            "review_5_before_day": "Dag 1",
            "review_5_after_image": "shopify://shop_images/eva--2.webp",
            "review_5_after_day": "Dag 60",
            "review_5_stars": 5,
            "review_5_title": "Huden känns verkligt annorlunda",
            "review_5_review": "Jag hade gett upp hoppet, apotekshyllan, dyra behandlingar, inget höll vad det lovade. Så skepsisen var på topp. Men två månader in kan jag inte förneka det längre: huden känns annorlunda.",
            "review_5_name": "Eva. B, 68",
            "question_bg_color": "#ffffff",
            "question_bg_color_hover": "#f5f5f5",
