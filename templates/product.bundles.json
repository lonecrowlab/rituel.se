        "custom_liquid_KtjAiH": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .pdrn-glow-bundle {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    background: #ffffff;\n    border: 1px solid #4a4a4a;\n    border-radius: 14px;\n    padding: 12px 16px;\n    max-width: 100%;\n    font-family: inherit;\n    box-sizing: border-box;\n  }\n  \n  .pdrn-glow-bundle__image {\n    flex-shrink: 0;\n    width: 58px;\n    height: 58px;\n    border-radius: 12px;\n    overflow: hidden;\n    background: #fce4ec;\n  }\n  \n  .pdrn-glow-bundle__image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  \n  .pdrn-glow-bundle__content {\n    flex: 1;\n    min-width: 0;\n  }\n  \n  .pdrn-glow-bundle__title {\n    font-size: 15px;\n    font-weight: 600;\n    color: #1a1a1a;\n    margin: 0;\n    line-height: 1.3;\n  }\n  \n  .pdrn-glow-bundle__right {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 6px;\n    flex-shrink: 0;\n  }\n  \n  .pdrn-glow-bundle__price {\n    font-size: 13px;\n    color: #999;\n    text-decoration: line-through;\n    line-height: 1;\n  }\n  \n  .pdrn-glow-bundle__badge {\n    background: #4caf50;\n    color: #ffffff;\n    font-size: 12px;\n    font-weight: 600;\n    padding: 6px 12px;\n    border-radius: 999px;\n    white-space: nowrap;\n    line-height: 1;\n  }\n  \n  @media (max-width: 480px) {\n    .pdrn-glow-bundle {\n      padding: 10px 12px;\n      gap: 10px;\n    }\n    .pdrn-glow-bundle__image {\n      width: 50px;\n      height: 50px;\n    }\n    .pdrn-glow-bundle__title {\n      font-size: 14px;\n    }\n  }\n</style>\n<div class=\"pdrn-glow-bundle\">\n  <div class=\"pdrn-glow-bundle__image\">\n    <img \n      src=\"https://cdn.shopify.com/s/files/1/0663/9458/7239/files/From-7_f86853eb-bbe5-4290-ad1b-8ee632d3a934.png?v=1778699677\" \n      alt=\"The PDRN Glow Guide\"\n      loading=\"lazy\"\n    />\n  </div>\n  <div class=\"pdrn-glow-bundle__content\">\n    <p class=\"pdrn-glow-bundle__title\">PDRN Glow Guide</p>\n  </div>\n  <div class=\"pdrn-glow-bundle__right\">\n    <span class=\"pdrn-glow-bundle__price\">149 kr</span>\n    <span class=\"pdrn-glow-bundle__badge\">Ingår gratis</span>\n  </div>\n</div>"
          }
