    "custom_liquid_FrQCtD": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<section class=\"testimonials\">\n  <div class=\"testimonials__inner\">\n    <p class=\"testimonials__eyebrow\">VAD VÅRA KUNDER SÄGER</p>\n    <h2 class=\"testimonials__heading\">Riktiga resultat från riktiga kvinnor</h2>\n\n    <div class=\"testimonials__cards\">\n      <article class=\"testimonial-card\">\n        <div class=\"testimonial-card__stars\">★ ★ ★ ★ ★</div>\n        <p class=\"testimonial-card__quote\">\"Klimakteriet förändrade min hud på ett sätt jag inte var beredd på. Sedan jag hittade PDRN Collagen Volume Balm vet jag inte hur jag klarade mig utan den.\"</p>\n        <p class=\"testimonial-card__name\">LINNEA S., 47</p>\n      </article>\n\n      <article class=\"testimonial-card\">\n        <div class=\"testimonial-card__stars\">★ ★ ★ ★ ★</div>\n        <p class=\"testimonial-card__quote\">\"Jag var skeptisk. Jag har testat allt. Men efter en vecka märkte jag en verklig skillnad. Huden är fastare och lystret är tillbaka.\"</p>\n        <p class=\"testimonial-card__name\">EMMA K., 43</p>\n      </article>\n\n      <article class=\"testimonial-card\">\n        <div class=\"testimonial-card__stars\">★ ★ ★ ★ ★</div>\n        <p class=\"testimonial-card__quote\">\"Jag hade planerat att boka botox. Så glad att jag testade detta först. Rynkorna har minskat och huden känns fylligare, helt naturligt.\"</p>\n        <p class=\"testimonial-card__name\">MAJA L., 51</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<style>\n  .testimonials {\n    background: #FDF8F5;\n    padding: 64px 16px;\n    font-family: inherit;\n  }\n\n  .testimonials__inner {\n    max-width: 520px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .testimonials__eyebrow {\n    color: #d9879a;\n    font-size: 13px;\n    font-weight: 500;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    margin: 0 0 14px 0;\n  }\n\n  .testimonials__heading {\n    font-family: 'Playfair Display', 'DM Serif Display', Georgia, serif;\n    font-size: 32px;\n    font-weight: 500;\n    color: #1a1a1a;\n    margin: 0 0 36px 0;\n    line-height: 1.25;\n  }\n\n  .testimonials__cards {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .testimonial-card {\n    background: #ffffff;\n    border-radius: 12px;\n    padding: 24px 22px;\n    text-align: left;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);\n  }\n\n  .testimonial-card__stars {\n    color: #d9879a;\n    font-size: 14px;\n    letter-spacing: 0.05em;\n    margin-bottom: 14px;\n    line-height: 1;\n  }\n\n  .testimonial-card__quote {\n    color: #1a1a1a;\n    font-size: 16px;\n    font-style: italic;\n    line-height: 1.55;\n    margin: 0 0 18px 0;\n  }\n\n  .testimonial-card__name {\n    color: #1a1a1a;\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.1em;\n    margin: 0;\n  }\n\n  @media (max-width: 480px) {\n    .testimonials {\n      padding: 48px 16px;\n    }\n    .testimonials__heading {\n      font-size: 24px;\n    }\n    .testimonial-card {\n      padding: 20px 18px;\n    }\n  }\n</style>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "testimonial_reviews_slider_pnpai7": {
      "type": "testimonial-reviews-slider",
      "blocks": {
        "review_cKKwUk": {
          "type": "review",
          "settings": {
            "title": "Jag har testat behandlingar på klinik",
            "description": "Jag har testat behandlingar på klinik tidigare och ville hitta något enklare att använda hemma. Serumet är lätt att applicera och huden känns mjuk efteråt. Har fortsatt använda det i min rutin.",
            "star_rating": 5,
            "name": "Karin B., 42 år · 2 sep 2026",
            "show_verified": false
          }
        },
        "review_Lfrrdy": {
          "type": "review",
          "settings": {
            "title": "Min syster frågade faktiskt",
            "description": "Efter några veckor frågade min syster om jag hade bytt hudvård. Hon tyckte att jag såg extra fräsch ut! Det gjorde mig verkligen glad.",
            "star_rating": 5,
            "name": "Eva-Lena Å., 55 år · 19 juli 2026",
            "show_verified": false
          }
        },
        "review_fNN3AG": {
          "type": "review",
          "settings": {
            "title": "Skeptisk i början",
            "description": "Jag har testat många serum genom åren och var ganska skeptisk. Men efter ungefär tre veckor kändes huden mjukare och mer återfuktad. Jag fortsätter gärna använda det!",
            "star_rating": 5,
            "name": "Emma N., 56 år · 5 aug 2026",
            "show_verified": false
          }
        }
      },
