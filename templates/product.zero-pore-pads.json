          }
        },
        "faq_item_WWkNjm": {
          "type": "faq_item",
          "settings": {
            "question": "Hjälper padsen mot orenheter?",
            "answer": "<p>BHA (salicylsyra) arbetar ner i porerna och hjälper till att avlägsna överflödigt talg och döda hudceller, faktorer som kan bidra till orenheter. Många användare upplever en klarare och jämnare hy över tid.</p>",
            "custom_html": "",
            "open_by_default": false,
            "badge_text": "",
            "badge_override_section": false,
            "badge_bg_color": "#000000",
            "badge_text_color": "#ffffff",
