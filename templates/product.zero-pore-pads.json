            "badge_padding_horizontal": 12,
            "badge_margin_bottom": 8,
            "icon_material": "",
            "icon_material_filled": false,
            "icon_svg": ""
          }
        },
        "faq_item_KLr6f4": {
          "type": "faq_item",
          "settings": {
            "question": "Hur ofta ska jag använda den?",
            "answer": "<p>För bästa resultat: 1 gång dagligen, helst på kvällen efter rengöring. Känslig hy kan börja varannan dag och öka gradvis när hyn vant sig.</p>",
            "custom_html": "",
            "open_by_default": false,
            "badge_text": "",
            "badge_override_section": false,
            "badge_bg_color": "#000000",
            "badge_text_color": "#ffffff",
