            "badge_padding_horizontal": 12,
            "badge_margin_bottom": 8,
            "icon_material": "",
            "icon_material_filled": false,
            "icon_svg": ""
          }
        },
        "faq_item_mhhBGd": {
          "type": "faq_item",
          "settings": {
            "question": "Är produkten testad på djur?",
            "answer": "<p>Nej. Pore Refining Pads är inte testade på djur, i enlighet med EU:s förbud mot djurtester för kosmetika.</p>",
            "custom_html": "",
            "open_by_default": false,
            "badge_text": "",
            "badge_override_section": false,
            "badge_bg_color": "#000000",
            "badge_text_color": "#ffffff",
