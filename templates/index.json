      "type": "faq-accordion-4",
      "blocks": {
        "faq_item_xGXEjX": {
          "type": "faq_item",
          "settings": {
            "question": "Vad det är",
            "answer": "<p>PDRN är en renad DNA-molekyl utvunnen ur lax. Ingrediensen som transformerat koreansk hudvård, och som fram tills nu mest funnits bakom klinikdörrar. Nu i en balm, hemma hos dig.</p>",
            "custom_html": "",
            "open_by_default": false,
            "badge_text": "",
            "badge_override_section": false,
            "badge_bg_color": "#000000",
            "badge_text_color": "#ffffff",
            "badge_font_size": 12,
