        "faq_item_rfTVkw": {
          "type": "faq_item",
          "settings": {
            "question": "Är det dermatologiskt testad?",
            "answer": "<p>Ja. Testad för säkerhet och hudkompatibilitet.<br/>Formulan bygger på 5% Volufiline från Sederma (Frankrike), en patenterad ingrediens, och Salmon PDRN, som länge använts inom koreansk hudvård. Formulerad enligt EU:s kosmetikaregler, formulerad i Sydkorea.</p>",
            "custom_html": "",
            "open_by_default": false,
