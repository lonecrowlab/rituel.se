        "faq_item_KWjY9M": {
          "type": "faq_item",
          "disabled": true,
          "settings": {
            "question": "Hur länge räcker en stick?",
            "answer": "<p>4–5 veckor vid daglig användning, morgon och kväll. Bara på morgonen: upp till 10 veckor. Vill du ha hela kuren utan att beställa om? Ta 3-pack.</p>",
