        "custom_liquid": "<style>\n.ecl-footer-content {\n    display: grid;\n    gap: 40px;\n    margin-bottom: 40px;\n    grid-template-columns: 1fr;\n    text-align: center;\n    justify-content: center;\n}\n.ecl-footer-column ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    display: flex;\n    gap: 10px;\n}\n.ecl-footer-content{\n    grid-template-columns: 1fr;\n}\n.ecl-footer-brand {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n\n}\n.ecl-footer-main {\n  padding: 20px;\n}\n.ecl-footer-brand img{\nmax-width:120px;\n}\n.ecl-footer-content h3 {\n    display: none;\n}\n    .ecl-footer-column--desktop-3 {\n        grid-column: span 3;\n        display: flex;\n        width: 100%;\n        justify-content: center;\n    }\n.ecl-footer-bottom,.newsletter-section{\ndisplay:none;\n}\n.ecl-footer-column li {\n    margin-bottom: 12px;\n    display: inline;\n    margin: 5px;\n}\n.ecl-footer-content{\ndisplay:block!important;\n}\n.ecl-footer-column ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\ndisplay:block;\n}\n.ecl-footer-brand img {\n    max-width: 120px;\n    margin-left: auto;\n    margin-right: auto;\n}\n.ecl-footer-main {\n    padding: 20px 20px 20px!important;\n}\n.ecl-footer-column li {\n    margin: 0px!important;\n}\n.ecl-footer-column ul {\ndisplay:inline-flex;\nflex-direction:row;\n    flex-wrap: wrap;\n    gap: 5px;\n}\n    .ecl-footer-column--mobile-1 {\n        grid-column: unset;\n        display: inline-block;\n        margin-top: 20px;\n    }\n</style>",
