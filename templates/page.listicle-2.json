            "block_border_left": 0,
            "custom_css": ""
          }
        },
        "text_factors": {
          "type": "text",
          "settings": {
            "content": "<p>Aging is driven by complex biochemical processes that impact the skin at a cellular level. The primary factors of skin aging include:</p><ol><li><strong>Collagen Degradation:</strong> Collagen diminishes by about 1% each year, leading to sagging and wrinkle formation.</li><li><strong>Moisture Loss:</strong> Hyaluronic acid decreases with age, compromising moisture retention.</li><li><strong>Oxidative Stress:</strong> UV rays and pollutants generate free radicals that damage skin cells.</li></ol><p><span style=\"text-decoration:underline\"><strong>RITÚEL's Advanced Technology</strong></span> employs cutting-edge scientific advancements to address these root causes of aging.</p>",
            "block_padding_top": 0,
            "block_padding_bottom": 0,
            "block_padding_left": 0,
            "block_padding_right": 0,
            "block_border_color": "#000000",
            "block_border_style": "solid",
            "block_border_top": 0,
            "block_border_right": 0,
            "block_border_bottom": 0,
            "block_border_left": 0,
            "custom_css": ""
          }
        },
        "image_g8zxpa": {
