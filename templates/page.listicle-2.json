    "lv2_content_factors": {
      "type": "listiclev2-content",
      "blocks": {
        "heading_hy3fm7": {
          "type": "heading",
          "settings": {
            "title": "The Main Factors Behind Skin Aging",
            "heading_style": "bar",
            "block_padding_top": 0,
            "block_padding_bottom": 0,
            "block_padding_left": 0,
            "block_padding_right": 0,
            "block_border_color": "#000000",
