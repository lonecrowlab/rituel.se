            "block_border_left": 0,
            "custom_css": ""
          }
        },
        "text_K3ijVF": {
          "type": "text",
          "settings": {
            "content": "<p>As we age, the fibroblast cells in our skin produce less collagen, reducing the skin’s structural support. Collagen acts like scaffolding, providing firmness and elasticity. When collagen degrades, the skin begins to sag and wrinkles form due to reduced structural integrity.</p>",
            "block_padding_top": 0,
            "block_padding_bottom": 0,
            "block_padding_left": 0,
            "block_padding_right": 0,
            "block_border_color": "#000000",
            "block_border_style": "solid",
