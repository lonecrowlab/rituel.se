    })
      .then((response) => {
        return response.json();
      })
      .then((data) => {
        if (data.selling_plan_allocation) {
        } else if (sellingPlanId) {
        }
      })
      .catch((error) => {
      });
  };

  // Auto-select variant on page load if none selected
  window.autoSelectVariant = function () {
    if (window.PriceManager) {
      return window.PriceManager.ensureVariant();
    }
    return null;
  };

  /* ── Frequency auto-sort (shortest → longest) ──────────────────
     Parses interval from the plan name (works with any subscription app)
     Supports: day(s), week(s), month(s), year(s) in multiple languages
     e.g. "Deliver every 2 weeks", "Every 30 days", "Monthly", "2 Wochen"
  ────────────────────────────────────────────────────────────────── */
  (function sortFrequencyDropdowns() {
    var UNIT_TO_DAYS = {
      day: 1, days: 1, daily: 1, jour: 1, jours: 1, tag: 1, tage: 1, dia: 1, dias: 1, giorno: 1, giorni: 1,
      week: 7, weeks: 7, weekly: 7, semaine: 7, semaines: 7, woche: 7, wochen: 7, semana: 7, semanas: 7, settimana: 7, settimane: 7,
      month: 30, months: 30, monthly: 30, mois: 30, monat: 30, monate: 30, mes: 30, meses: 30, mese: 30, mesi: 30,
      year: 365, years: 365, yearly: 365, an: 365, ans: 365, jahr: 365, jahre: 365, anno: 365, anni: 365, año: 365, años: 365
    };

    function parseDays(name) {
      if (!name) return 9999;
      var lower = name.toLowerCase().trim();

      // Try "number + unit" pattern: "every 2 weeks", "2 Wochen", "30 days"
      var match = lower.match(/(\d+)\s*(day|days|daily|week|weeks|weekly|month|months|monthly|year|years|yearly|jour|jours|semaine|semaines|woche|wochen|tag|tage|mois|monat|monate|dia|dias|semana|semanas|giorno|giorni|settimana|settimane|mese|mesi|an|ans|jahr|jahre|anno|anni|año|años)/i);
      if (match) {
        var num = parseInt(match[1], 10);
        var unit = match[2].toLowerCase();
        return num * (UNIT_TO_DAYS[unit] || 30);
      }

      // Try "unit" only with no number (implies 1): "weekly", "monthly", "daily"
      var words = lower.split(/[\s,\-\/]+/);
      for (var i = 0; i < words.length; i++) {
        var w = words[i];
        if (UNIT_TO_DAYS[w]) {
          var prev = i > 0 ? parseInt(words[i - 1], 10) : NaN;
          var count = isNaN(prev) ? 1 : prev;
          return count * UNIT_TO_DAYS[w];
        }
      }

      return 9999;
    }

    document.querySelectorAll('.frequency-select').forEach(function(select) {
      var options = Array.from(select.options);
      if (options.length < 2) return;

      var selectedVal = select.value;

      // Always sort shortest duration first
      options.sort(function(a, b) {
        var daysA = parseDays(a.getAttribute('data-plan-name') || a.textContent);
        var daysB = parseDays(b.getAttribute('data-plan-name') || b.textContent);
        return daysA - daysB;
      });

      options.forEach(function(opt) { select.appendChild(opt); });
      select.value = selectedVal;
    });
  })();

