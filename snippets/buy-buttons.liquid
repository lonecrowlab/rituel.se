<script>
// Preserve original button label when variants change
document.addEventListener('DOMContentLoaded', function() {
  const buttonLabel = document.querySelector('#ProductSubmitButton-{{ section_id }} .main-atc__label__text');
  if (buttonLabel) {
    const originalLabel = buttonLabel.getAttribute('data-original-label');
    const soldoutLabel = buttonLabel.getAttribute('data-soldout-label');

    // Listen for variant change events
    document.addEventListener('variant-change', function(event) {
      if (event.detail && event.detail.variant) {
        const variant = event.detail.variant;
        if (variant.available) {
          buttonLabel.textContent = originalLabel;
        } else {
          buttonLabel.textContent = soldoutLabel;
        }
      }
    });

    // Also listen for button updates from Shopify's system
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.type === 'characterData' || mutation.type === 'childList') {
          const currentText = buttonLabel.textContent.trim();
          const addToCartTranslations = ['Add to cart', 'Add to Cart', 'ADD TO CART'];
          // If button text was changed to a generic "Add to cart" but we have a custom label
          if (addToCartTranslations.includes(currentText) && originalLabel && originalLabel !== currentText) {
            buttonLabel.textContent = originalLabel;
          }
        }
      });
    });

    observer.observe(buttonLabel, { characterData: true, childList: true, subtree: true });
  }
});

// Enhanced cart handling for all products (with or without QB/variants)
(function() {
  let isSubmitting = false;
  const CART_TYPE = '{{ settings.cart_type | default: "drawer" }}';

  // Intercept all form submissions
  document.addEventListener('submit', function(e) {
    const form = e.target;

    // Check if this is a product form
    if (!form.classList.contains('product-form') && !form.querySelector('[name="add"]')) {
      return;
    }

    // Check if coordinator is already handling this
    if (window.ProductCoordinator && window.ProductCoordinator.state.isProcessing) {
      return;
    }

    // Check if another handler already processed this
    if (e.defaultPrevented) {
      return;
    }

    // Check if QB is handling this
    const qbWrapper = document.querySelector('.qb-wrapper');
    if (qbWrapper && qbWrapper.dataset.formId === form.id) {
      return;
    }

    // Always prevent default for product forms we're handling
    // Bail out BEFORE preventDefault if the submit control can't be used
    const submitButton = form.querySelector('[type="submit"]');
    if (!submitButton || submitButton.disabled) {
      return;
    }

    e.preventDefault();
    e.stopPropagation();

    // Prevent double submission
    if (isSubmitting) {
      return;
    }

    // Handle regular add to cart
    isSubmitting = true;

    // Check if skip cart is enabled — redirect directly to checkout
    const skipCart = submitButton.hasAttribute('data-skip-cart') ||
                    form.querySelector('input[name="id"][data-skip-cart]');

    // Add loading to button
    submitButton.classList.add('loading');
    submitButton.disabled = true;

    // Prepare form data
    const formData = new FormData(form);

    // Ensure QB quantity is applied (QB init may run before form exists)
    const activeQB = document.querySelector('.qb-wrapper .qb-option.qb-active');
    if (activeQB) {
      formData.set('quantity', parseInt(activeQB.dataset.qty) || 1);
    }

    // Submit to cart
    fetch('/cart/add.js', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to add to cart');
      }
      return response.json();
    })
    .then(data => {
      // Skip cart → go straight to checkout
      if (skipCart) {
        window.location.href = '/checkout';
        return;
      }

      // Cart type "page" → redirect to cart page
      if (CART_TYPE === 'page') {
        window.location.href = '{{ routes.cart_url }}';
        return;
      }

      // Cart type "drawer" → open cart drawer
      // Add any checkpoint gifts BEFORE fetching sections so they appear instantly
      var giftPromise = window.__addCheckpointGifts ? window.__addCheckpointGifts() : Promise.resolve();
      return giftPromise.then(function() {
        return fetch(window.CartDrawerSections.getSectionsUrl());
      })
        .then(res => res.json())
        .then(sections => {
          // Update cart content BEFORE opening drawer
          if (sections && window.CartDrawerSections.pickDrawerHtml(sections)) {
            const cartDrawer = document.querySelector('cart-drawer');
            if (cartDrawer) {
              // Add loading state to prevent empty cart flash
              cartDrawer.classList.add('is-loading');
              cartDrawer.classList.remove('is-empty');

              const parser = new DOMParser();
              const newDoc = parser.parseFromString(window.CartDrawerSections.pickDrawerHtml(sections), 'text/html');

              // Update content immediately before opening
              const cartItems = cartDrawer.querySelector('.cart-items, [id*="cart-items"], .drawer__inner');
              const newCartItems = newDoc.querySelector('.cart-items, [id*="cart-items"], .drawer__inner');

              if (cartItems && newCartItems) {
                cartItems.innerHTML = newCartItems.innerHTML;
              } else {
                const drawerContent = cartDrawer.querySelector('.drawer__content, .cart-drawer__content');
                const newDrawerContent = newDoc.querySelector('.drawer__content, .cart-drawer__content');

                if (drawerContent && newDrawerContent) {
                  drawerContent.innerHTML = newDrawerContent.innerHTML;
                }
              }

              // Remove loading state
              cartDrawer.classList.remove('is-loading', 'is-empty');
              cartDrawer.classList.add('is-loaded');

              // Now open the drawer with updated content
              setTimeout(() => {
                cartDrawer.classList.add('animate', 'active');
                cartDrawer.setAttribute('open', '');
                document.body.classList.add('overflow-hidden');

                if (typeof cartDrawer.open === 'function') {
                  cartDrawer.open();
                } else {
                  const cartIcon = document.querySelector('.header__icon--cart');
                  if (cartIcon) {
                    cartIcon.click();
                  }
                }
              }, 50);

              // Show empty messages again if needed (after a delay)
              setTimeout(() => {
                const emptyMessages = cartDrawer.querySelectorAll('.cart__empty-text, .cart-drawer__empty, .cart__empty');
                emptyMessages.forEach(msg => {
                  msg.style.display = '';
                });
              }, 500);
            }
          }

          // Update cart bubble
          if (sections && sections['cart-icon-bubble']) {
            const parser = new DOMParser();
            const doc = parser.parseFromString(sections['cart-icon-bubble'], 'text/html');
            const newBubble = doc.querySelector('.cart-count-bubble');
            const cartIconBubble = document.querySelector('#cart-icon-bubble');

            if (cartIconBubble && newBubble) {
              const existingBubble = cartIconBubble.querySelector('.cart-count-bubble');
              if (existingBubble) {
                existingBubble.innerHTML = newBubble.innerHTML;
              } else {
                cartIconBubble.appendChild(newBubble.cloneNode(true));
              }
            }
          }

          // Notify other components (checkpoints bar, etc.) that the cart changed
          document.dispatchEvent(new CustomEvent('cart:updated'));
        });
    })
    .catch(error => {
      alert('Failed to add to cart. Please try again.');
    })
    .finally(() => {
      // Reset button state
      submitButton.classList.remove('loading');
      submitButton.disabled = false;

      setTimeout(() => {
        isSubmitting = false;
      }, 300);
    });
  }, true);
})();

// =================================================================
// PRICE MANAGER — Single source of truth for ALL price updates
// Handles: main price, ATC button, subscription widget plan prices
// Listens to: variant changes, QB state, subscription state
// =================================================================
(function() {
  'use strict';

  // ---- State ----
  let currentState = {
    variantId: null,
    variantPrice: 0,
    variantComparePrice: 0,
    qbQuantity: 1,
    qbDiscount: 0,
    subscriptionActive: false,
    subscriptionDiscount: 0,
    sellingPlanId: '',
    bundleActive: false,
    bundlePrice: 0,
    bundleComparePrice: 0
  };

  // ---- Data ----
  function getVariantData() {
    try {
      const el = document.querySelector('.subscription-widget__variants-json');
      if (el) return JSON.parse(el.textContent);
      const scripts = document.querySelectorAll('script[type="application/json"]');
      for (const s of scripts) {
        try {
          const d = JSON.parse(s.textContent);
          if (Array.isArray(d) && d.length > 0 && d[0].id) return d;
        } catch(e) { continue; }
      }
    } catch(e) {}
    return [];
  }

  const variantData = getVariantData();
  const sellingPlansData = JSON.parse(
    document.querySelector('.subscription-widget__plans-json')?.textContent || '[]'
  );

  // ---- Helpers ----
  const shopMoneyFormat = {{ shop.money_format | json }};

  function formatMoney(cents) {
    // Round to nearest whole currency unit (401 kr, not 400,68 kr)
    const roundedCents = Math.round(Number(cents) / 100) * 100;
    const noDecimalsFormat = shopMoneyFormat
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, '{{amount_no_decimals_with_comma_separator}}')
      .replace(/\{\{\s*amount\s*\}\}/g, '{{amount_no_decimals}}');

    let formatted;
    if (typeof Shopify !== 'undefined' && typeof Shopify.formatMoney === 'function') {
      formatted = Shopify.formatMoney(roundedCents, noDecimalsFormat || shopMoneyFormat);
    } else {
      formatted = new Intl.NumberFormat('{{ shop.locale }}', {
        style: 'currency',
        currency: '{{ shop.currency }}',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0
      }).format(roundedCents / 100);
    }
    return formatted;
  }

  function getDiscountedPrice(basePrice, sellingPlanId) {
    const plan = sellingPlansData.find(p => p.id == sellingPlanId);
    if (!plan) return basePrice;
    if (plan.value_type === 'percentage') return Math.round(basePrice * (100 - plan.value) / 100);
    if (plan.value_type === 'fixed_amount') return Math.max(0, basePrice - plan.value);
    if (plan.value_type === 'price') return plan.value;
    return basePrice;
  }

  function ensureVariant() {
    const form = document.querySelector('form[action*="/cart/add"]');
    const variantInput = form?.querySelector('input[name="id"]');
    if (!variantInput?.value) {
      const best = variantData.find(v => v.available) || variantData[0];
      if (best && variantInput) {
        variantInput.value = best.id;
        variantInput.dispatchEvent(new Event('change', { bubbles: true }));
        return best.id;
      }
    }
    return variantInput?.value;
  }

  // ---- Price Calculation ----
  function calculatePrice() {
    // Bundle mode: use bundle prices directly
    if (currentState.bundleActive && currentState.bundlePrice > 0) {
      const qty = currentState.qbQuantity;
      const totalPrice = currentState.bundlePrice * qty;
      const totalComparePrice = currentState.bundleComparePrice > 0 ? currentState.bundleComparePrice * qty : 0;

      // Subscription discount on top of bundle price
      let finalPrice = totalPrice;
      if (currentState.subscriptionActive && currentState.sellingPlanId) {
        finalPrice = getDiscountedPrice(totalPrice, currentState.sellingPlanId);
      } else if (currentState.subscriptionActive && currentState.subscriptionDiscount > 0) {
        finalPrice = Math.round(totalPrice * (100 - currentState.subscriptionDiscount) / 100);
      }

      return {
        finalPrice,
        totalPrice,
        totalComparePrice,
        comparePrice: totalComparePrice > finalPrice ? totalComparePrice : (totalPrice > finalPrice ? totalPrice : 0),
      };
    }

    const variant = variantData.find(v => v.id == currentState.variantId);
    if (!variant) return null;

    let perUnitPrice = variant.price;
    let perUnitComparePrice = variant.compare_at_price || 0;

    // Apply QB discount
    if (currentState.qbDiscount > 0) {
      const qbMultiplier = (100 - currentState.qbDiscount) / 100;
      perUnitPrice = Math.round(perUnitPrice * qbMultiplier);
      // Keep compare_at_price at original value to show full savings
      // If no compare_at_price, use original undiscounted price as compare
      if (perUnitComparePrice === 0) {
        perUnitComparePrice = variant.price;
      }
    }

    // Totals with quantity
    const totalPrice = perUnitPrice * currentState.qbQuantity;
    const totalComparePrice = perUnitComparePrice > 0 ? perUnitComparePrice * currentState.qbQuantity : 0;

    // Subscription discount
    let finalPrice = totalPrice;
    if (currentState.subscriptionActive && currentState.sellingPlanId) {
      finalPrice = getDiscountedPrice(totalPrice, currentState.sellingPlanId);
    } else if (currentState.subscriptionActive && currentState.subscriptionDiscount > 0) {
      finalPrice = Math.round(totalPrice * (100 - currentState.subscriptionDiscount) / 100);
    }

    return {
      finalPrice,
      totalPrice,
      totalComparePrice,
      comparePrice: totalComparePrice > finalPrice ? totalComparePrice : (totalPrice > finalPrice ? totalPrice : 0),
    };
  }

  // ---- DOM Updates ----
  function updateAllPrices() {
    const prices = calculatePrice();
    if (!prices) return;

    const formattedFinal = formatMoney(prices.finalPrice);
    const formattedCompare = prices.comparePrice > 0 ? formatMoney(prices.comparePrice) : null;
    const formattedOneTime = formatMoney(prices.totalPrice);

    // 1. Main product price display
    ['.price-item--sale.main-price', '.price-item--regular.main-price'].forEach(sel => {
      document.querySelectorAll(sel).forEach(el => {
        if (!el.closest('.price__compare-price') && !el.classList.contains('main-comapre-price')) {
          el.textContent = currentState.subscriptionActive ? formattedFinal : formattedOneTime;
        }
      });
    });

    // 2. Compare prices
    if (formattedCompare && prices.comparePrice > prices.finalPrice) {
      document.querySelectorAll('.price__compare-price .price-item').forEach(el => {
        el.textContent = formattedCompare;
        el.style.display = '';
        if (el.closest('.price__compare-price')) el.closest('.price__compare-price').style.display = '';
      });
    } else {
      document.querySelectorAll('.price__compare-price').forEach(el => { el.style.display = 'none'; });
    }

    // 3. ATC button price
    const mainAtcPrice = document.getElementById('main-atc-price-{{ section.id }}');
    if (mainAtcPrice) mainAtcPrice.textContent = currentState.subscriptionActive ? formattedFinal : formattedOneTime;

    const stickyAtcPrice = document.getElementById('sticky-atc-price-{{ section.id }}');
    if (stickyAtcPrice) stickyAtcPrice.textContent = currentState.subscriptionActive ? formattedFinal : formattedOneTime;

    // 4. ATC compare price
    document.querySelectorAll('.main-atc-compare-price').forEach(el => {
      if (formattedCompare && prices.comparePrice > prices.finalPrice) {
        el.textContent = formattedCompare;
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    });

    // 5. Subscription widget plan prices — always show subscription-discounted price
    const subPlan = document.querySelector('[data-plan="subscription"]');
    if (subPlan) {
      const subCurrent = subPlan.querySelector('.current-price');
      const subOriginal = subPlan.querySelector('.original-price');
      // Calculate subscription price independently of current selection
      const subSellingPlanId = subPlan.getAttribute('data-selling-plan');
      const subDiscountedPrice = subSellingPlanId ? getDiscountedPrice(prices.totalPrice, subSellingPlanId) : prices.totalPrice;
      const formattedSubPrice = formatMoney(subDiscountedPrice);
      if (subCurrent) subCurrent.textContent = formattedSubPrice;
      if (subOriginal) {
        subOriginal.textContent = formattedOneTime;
        subOriginal.style.display = subDiscountedPrice < prices.totalPrice ? '' : 'none';
      }
    }

    // 6. One-time plan prices
    const onetimePlan = document.querySelector('[data-plan="onetime-single"]');
    if (onetimePlan) {
      const otCurrent = onetimePlan.querySelector('.current-price');
      const otOriginal = onetimePlan.querySelector('.original-price');
      if (otCurrent) otCurrent.textContent = formattedOneTime;
      if (otOriginal) {
        if (prices.totalComparePrice > prices.totalPrice) {
          otOriginal.textContent = formatMoney(prices.totalComparePrice);
          otOriginal.style.display = '';
        } else {
          otOriginal.style.display = 'none';
        }
      }
    }
  }

  // ---- Initialization ----
  function initVariant() {
    const variantId = ensureVariant();
    if (variantId) {
      currentState.variantId = variantId;
      const variant = variantData.find(v => v.id == variantId);
      if (variant) {
        currentState.variantPrice = variant.price;
        currentState.variantComparePrice = variant.compare_at_price || 0;
      }
    }
  }

  function initSubscription() {
    const selectedPlan = document.querySelector('.plan-option.selected') ||
                         document.querySelector('.plan-option input[type="radio"]:checked')?.closest('.plan-option');
    if (selectedPlan) {
      const planType = selectedPlan.getAttribute('data-plan');
      if (planType?.includes('subscription')) {
        const planId = selectedPlan.getAttribute('data-selling-plan') || '';
        currentState.subscriptionActive = true;
        currentState.sellingPlanId = planId;
        const plan = sellingPlansData.find(p => p.id == planId);
        currentState.subscriptionDiscount = (plan?.value_type === 'percentage') ? plan.value : 0;
      }
    }
  }

  function initQB() {
    const qbActive = document.querySelector('.qb-wrapper .qb-option.qb-active');
    if (qbActive) {
      const quantity = parseInt(qbActive.dataset.qty) || 1;
      const optionNum = parseInt(qbActive.dataset.option) || 1;

      {%- assign qb2_discount = 10 -%}
      {%- assign qb3_discount = 15 -%}
      {%- assign qb4_discount = 20 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'qb_row_no_variant' -%}
          {%- assign qb2_discount = block.settings.qb2_discount | default: 10 -%}
          {%- assign qb3_discount = block.settings.qb3_discount | default: 15 -%}
          {%- assign qb4_discount = block.settings.qb4_discount | default: 20 -%}
        {%- endif -%}
      {%- endfor -%}

      let discount = 0;
      switch(optionNum) {
        case 1: discount = 0; break;
        case 2: discount = {{ qb2_discount }}; break;
        case 3: discount = {{ qb3_discount }}; break;
        case 4: discount = {{ qb4_discount }}; break;
      }

      currentState.qbQuantity = quantity;
      currentState.qbDiscount = discount;
    }
  }

  // ---- Event Listeners ----
  document.addEventListener('qb:state-changed', function(e) {
    if (e.detail.quantity) currentState.qbQuantity = e.detail.quantity;
    if (e.detail.qbDiscount !== undefined) currentState.qbDiscount = e.detail.qbDiscount;
    // QB selection clears bundle mode
    currentState.bundleActive = false;
    currentState.bundlePrice = 0;
    currentState.bundleComparePrice = 0;
    updateAllPrices();
  });

  document.addEventListener('bundle:state-changed', function(e) {
    if (e.detail.active !== undefined) currentState.bundleActive = e.detail.active;
    if (e.detail.finalPrice !== undefined) currentState.bundlePrice = e.detail.finalPrice;
    if (e.detail.comparePrice !== undefined) currentState.bundleComparePrice = e.detail.comparePrice;
    if (e.detail.quantity !== undefined) currentState.qbQuantity = e.detail.quantity;
    // Reset QB discount — bundle has its own pricing
    currentState.qbDiscount = 0;
    updateAllPrices();
  });

  document.addEventListener('subscription:state-changed', function(e) {
    if (e.detail.subscriptionActive !== undefined) currentState.subscriptionActive = e.detail.subscriptionActive;
    if (e.detail.subscriptionDiscount !== undefined) currentState.subscriptionDiscount = e.detail.subscriptionDiscount;
    if (e.detail.sellingPlanId !== undefined) currentState.sellingPlanId = e.detail.sellingPlanId;
    updateAllPrices();
  });

  // Variant change via custom events (works immediately)
  function handleVariantEvent(e) {
    const variantId = e.detail?.variant?.id || e.detail?.variantId || e.detail?.id;
    if (variantId && variantId != currentState.variantId) {
      currentState.variantId = variantId;
      const variant = variantData.find(v => v.id == variantId);
      if (variant) {
        currentState.variantPrice = variant.price;
        currentState.variantComparePrice = variant.compare_at_price || 0;
      }
      updateAllPrices();
    }
  }
  document.addEventListener('variant-change', handleVariantEvent);
  document.addEventListener('variant:change', handleVariantEvent);

  // Variant change via MutationObserver (deferred until form exists)
  function setupVariantObserver() {
    const form = document.querySelector('form[action*="/cart/add"]');
    const variantInput = form?.querySelector('input[name="id"]');
    if (variantInput) {
      const observer = new MutationObserver(() => {
        const newVariantId = variantInput.value;
        if (newVariantId && newVariantId != currentState.variantId) {
          currentState.variantId = newVariantId;
          const variant = variantData.find(v => v.id == newVariantId);
          if (variant) {
            currentState.variantPrice = variant.price;
            currentState.variantComparePrice = variant.compare_at_price || 0;
          }
          updateAllPrices();
        }
      });
      observer.observe(variantInput, { attributes: true, attributeFilter: ['value'] });
      // Also listen for programmatic value changes
      variantInput.addEventListener('change', () => {
        const newVariantId = variantInput.value;
        if (newVariantId && newVariantId != currentState.variantId) {
          currentState.variantId = newVariantId;
          const variant = variantData.find(v => v.id == newVariantId);
          if (variant) {
            currentState.variantPrice = variant.price;
            currentState.variantComparePrice = variant.compare_at_price || 0;
          }
          updateAllPrices();
        }
      });
      return true;
    }
    return false;
  }

  // ---- Init (deferred until form is in DOM) ----
  function deferredInit() {
    if (!setupVariantObserver()) {
      // Form not in DOM yet — retry on next frame
      requestAnimationFrame(deferredInit);
      return;
    }
    initVariant();
    initSubscription();
    initQB();
    updateAllPrices();

    // Watch price container for innerHTML replacements from theme's renderProductInfo
    // (async section re-render overwrites PriceManager prices with raw server HTML)
    var priceContainer = document.getElementById('price-{{ section.id }}');
    if (priceContainer) {
      var priceObserver = new MutationObserver(function() {
        // Only re-apply if QB or subscription is active (otherwise server prices are correct)
        if (currentState.qbDiscount > 0 || currentState.subscriptionActive || currentState.bundleActive) {
          // Defer to ensure renderProductInfo has finished all its DOM updates
          requestAnimationFrame(function() { updateAllPrices(); });
        }
      });
      priceObserver.observe(priceContainer, { childList: true, subtree: true });
    }
  }
  requestAnimationFrame(deferredInit);

  // ---- Public API ----
  window.PriceManager = {
    ensureVariant: ensureVariant,
    getState: () => ({...currentState}),
    formatMoney: formatMoney,
    refresh: updateAllPrices
  };

})();
</script>
<div
  {{ block.shopify_attributes }}
  style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;"
>
  {%- if product != blank -%}
    <product-form
      id="ProductForm-{{ section.id }}"
      class="product-form main-product-form"
      data-section="{{ section.id }}"
      data-options="{{ product.options | join: ',' }}"
      data-main="{{ main_product }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <svg
          aria-hidden="true"
          focusable="false"
          class="icon icon-error"
          viewBox="0 0 13 13"
        >
          <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
          <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
          <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
          <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
        </svg>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <div class="hidden product-form__variants" id="product-form-{{ section.id }}__variants" data-values=""></div>
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          class="product-variant-id"
          {% if block.settings.skip_cart %}
            data-skip-cart="true"
          {% endif %}
        >
        <input
          type="hidden"
          name="quantity"
          value="1"
          min="1"
          class="product-form__quantity-input"
        >
        <div class="product-form__buttons{% if block.settings.uppercase_text %} product-form__buttons--uppercase{% endif %}">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
          -%}
          <div class='product-form__quantity-and-btn product-form__quantity-and-btn--{{ quantity_atc_append }} product-form__quantity-and-btn--{{ quantity_atc_append_heights }}'>
            {% if quantity_selector_html != blank and quantity_atc_append != 'none' %}
              {{ quantity_selector_html }}
            {% endif %}
            <button
              id="ProductSubmitButton-{{ section_id }}"
              type="submit"
              name="add"
              class="atc-button product-form__submit button button--full-width button--margin-x{% if main_product %} main-product-atc{% else %} featured-product-atc-{{ section.id }}{% endif %}"
              {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                disabled
                data-unavailable="true"
              {% endif %}
              {% if block.settings.skip_cart %}
                data-skip-cart="true"
              {% endif %}
              data-required-fields="0"
              data-valid-fields="0"
            >
              <span class="main-atc__error" style="display:none;"></span>
              {% if block.settings.button_icon_position == 'before' %}
                {% if block.settings.button_custom_icon != blank %}
                  <span class="atc-button__icon-svg">
                    {{ block.settings.button_custom_icon }}
                  </span>
                {% elsif block.settings.button_icon != blank %}
                  {% render 'material-icon', icon: block.settings.button_icon, filled: block.settings.button_icon_filled %}
                {% endif %}
              {% endif %}
              <span class="main-atc__label button__label">
                <span class="main-atc__label__text" data-original-label="{%- if block.settings.button_label != blank -%}{{ block.settings.button_label }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}" data-soldout-label="{{ 'products.product.sold_out' | t }}">
                  {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- else -%}
                    {%- if block.settings.button_label != blank -%}
                      {{ block.settings.button_label }}
                    {%- else -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- endif -%}
                  {%- endif -%}
                </span>
                {% if block.settings.display_price %}
                  {% if block.settings.button_price_separator != blank %}
                    <span class="main-atc__separator{%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%} hidden{% endif %}" style="margin: 0 {{ block.settings.button_price_separator_gap | default: 8 }}px;">{{ block.settings.button_price_separator }}</span>
                  {% endif %}
                  <span class="main-atc-price-wrapper{%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%} hidden{% endif %}">
                    {% if block.settings.show_compare_price_in_button and product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
                      {% assign rounded_compare_price = product.selected_or_first_available_variant.compare_at_price | plus: 50 | divided_by: 100 | times: 100 %}
                      <span class="main-atc-compare-price">{{ rounded_compare_price | money_without_trailing_zeros }}</span>
                    {% endif %}
                    {% assign rounded_atc_price = product.selected_or_first_available_variant.price | plus: 50 | divided_by: 100 | times: 100 %}
                    <span id="main-atc-price-{{ section.id }}" class='main-atc-price'>{{ rounded_atc_price | money_without_trailing_zeros }}</span>
                  </span>
                {% endif %}
              </span>
              {% if block.settings.button_icon_position == 'after' %}
                {% if block.settings.button_custom_icon != blank %}
                  <span class="atc-button__icon-svg">
                    {{ block.settings.button_custom_icon }}
                  </span>
                {% elsif block.settings.button_icon != blank %}
                  {% render 'material-icon', icon: block.settings.button_icon, filled: block.settings.button_icon_filled %}
                {% endif %}
              {% endif %}
              <div class="loading-overlay__spinner hidden">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  class="spinner"
                  viewBox="0 0 66 66"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </button>
          </div>
          {%- if block.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities no-js-hidden quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          {% render 'icon-unavailable' %}
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>
