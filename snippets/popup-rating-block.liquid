{% comment %}
  Popup Rating block — dropdown review summary under the trigger element.
  Reads live rating data from the Trustoo widget (.tt-head-left).
{% endcomment %}

{%- liquid
  assign popup_id = 'PopupRating-' | append: block.id
  assign accent_color = block.settings.accent_color | default: '#cc667c'
  assign bar_bg = block.settings.bar_background_color | default: '#e6e6e6'

  assign total_reviews_text = block.settings.total_reviews_text | default: 'Based on [reviews.count] reviews'
  if block.settings.show_total_reviews == false
    assign total_reviews_text = blank
  endif
-%}

<div
  class="popup-rating-block"
  id="{{ popup_id }}"
  data-popup-rating
  data-attachment-type="{{ block.settings.attachment_type | default: 'custom_rating_block' }}"
  data-trigger-selector="{{ block.settings.trigger_selector | escape }}"
  data-show-total-reviews="{{ block.settings.show_total_reviews }}"
  data-total-reviews-template="{{ total_reviews_text | escape }}"
  data-view-all-text="{{ block.settings.view_all_text | default: 'View all' | escape }}"
  data-view-all-link="{{ block.settings.view_all_link | default: '#vstar-reviews' | escape }}"
  data-accent-color="{{ accent_color }}"
  data-bar-bg="{{ bar_bg }}"
  data-chevron-color="{{ block.settings.chevron_color | default: '#343F20' | escape }}"
  data-fallback-rating="{{ product.metafields.custom.review_stars_ave.value | default: product.metafields.custom.review_stars_ave | escape }}"
  data-fallback-count="{{ product.metafields.custom.review_count.value | default: product.metafields.custom.review_count | escape }}"
  style="--popup-rating-accent: {{ accent_color }}; --popup-rating-bar-bg: {{ bar_bg }};"
  {{ block.shopify_attributes }}
></div>

<div class="popup-rating-dropdown" id="{{ popup_id }}-dropdown" hidden aria-hidden="true">
  <div class="popup-rating-dropdown__panel" role="dialog" aria-modal="false" aria-labelledby="{{ popup_id }}-title">
    <span class="popup-rating-dropdown__caret" aria-hidden="true"></span>

    <button type="button" class="popup-rating-dropdown__close" data-popup-rating-close aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="popup-rating-dropdown__summary">
      <div class="popup-rating-dropdown__score-row">
        <div class="popup-rating-dropdown__score-group">
          <p class="popup-rating-dropdown__score" data-popup-rating-score>—</p>
          <div class="popup-rating-dropdown__stars" data-popup-rating-stars aria-hidden="true"></div>
        </div>
        <p class="popup-rating-dropdown__total" data-popup-rating-total{% unless block.settings.show_total_reviews %} hidden{% endunless %}></p>
      </div>

      <div class="popup-rating-dropdown__breakdown" data-popup-rating-breakdown></div>
    </div>

    <div class="popup-rating-dropdown__divider"></div>

    <div class="popup-rating-dropdown__reviews">
      <div class="popup-rating-dropdown__reviews-header">
        <span></span>
        <a class="popup-rating-dropdown__view-all" href="{{ block.settings.view_all_link | default: '#vstar-reviews' }}" data-popup-rating-view-all>
          {{ block.settings.view_all_text | default: 'View all' }}
          <svg width="6" height="10" viewBox="0 0 6 10" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="popup-rating-dropdown__slider swiper" data-popup-rating-slider>
        <div class="swiper-wrapper">
          {%- liquid
            assign review_slides = 'review_1|review_2|review_3' | split: '|'
          -%}
          {%- for review_key in review_slides -%}
            {%- case review_key -%}
              {%- when 'review_1' -%}
                {%- assign slide_image = block.settings.review_1_image -%}
                {%- assign slide_name = block.settings.review_1_name -%}
                {%- assign slide_description = block.settings.review_1_description -%}
              {%- when 'review_2' -%}
                {%- assign slide_image = block.settings.review_2_image -%}
                {%- assign slide_name = block.settings.review_2_name -%}
                {%- assign slide_description = block.settings.review_2_description -%}
              {%- when 'review_3' -%}
                {%- assign slide_image = block.settings.review_3_image -%}
                {%- assign slide_name = block.settings.review_3_name -%}
                {%- assign slide_description = block.settings.review_3_description -%}
            {%- endcase -%}

            {%- if slide_image != blank or slide_name != blank or slide_description != blank -%}
              {%- assign slide_alt = slide_name -%}
              {%- if slide_alt == blank and slide_description != blank -%}
                {%- assign slide_alt = slide_description | strip_html | truncate: 80 -%}
              {%- endif -%}

              <div class="swiper-slide popup-rating-dropdown__slide">
                <div class="popup-rating-dropdown__slide-inner">
                  {%- if slide_image != blank -%}
                    {%- liquid
                      assign slide_height = 72
                      if slide_image.aspect_ratio != blank and slide_image.aspect_ratio > 0
                        assign slide_height = 72 | divided_by: slide_image.aspect_ratio | round
                      endif
                    -%}
                    <div class="popup-rating-dropdown__slide-media">
                      <img
                        src="{{ slide_image | image_url: width: 220 }}"
                        srcset="{{ slide_image | image_url: width: 110 }} 110w, {{ slide_image | image_url: width: 220 }} 220w"
                        width="72"
                        height="{{ slide_height }}"
                        loading="lazy"
                        class="popup-rating-dropdown__slide-image"
                        alt="{{ slide_alt | escape }}"
                      >
                    </div>
                  {%- endif -%}
                  <div class="popup-rating-dropdown__slide-content">
                    {%- if slide_name != blank -%}
                      <p class="popup-rating-dropdown__slide-name">{{ slide_name }}</p>
                    {%- endif -%}
                    {%- if slide_description != blank -%}
                      <div class="popup-rating-dropdown__slide-text rte">{{ slide_description }}</div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="popup-rating-dropdown__nav">
        <div class="popup-rating-dropdown__nav-center">
          <div class="popup-rating-dropdown__pagination swiper-pagination"></div>
          <div class="popup-rating-dropdown__arrows">
            <button type="button" class="popup-rating-dropdown__arrow popup-rating-dropdown__arrow--prev swiper-button-prev" aria-label="Previous review"></button>
            <button type="button" class="popup-rating-dropdown__arrow popup-rating-dropdown__arrow--next swiper-button-next" aria-label="Next review"></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" media="print" onload="this.media='all'">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script src="{{ 'popup-rating.js' | asset_url }}" defer></script>

<style>
  .popup-rating-block {
    display: none;
  }

  .popup-rating-wrapper {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .popup-rating-wrapper .rating-stars > a {
    text-decoration: none;
    color: inherit;
  }

  .popup-rating-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 6px;
    flex-shrink: 0;
    line-height: 0;
    transition: transform 0.2s ease;
  }

  .popup-rating-chevron svg {
    display: block;
  }

  .popup-rating-wrapper.is-open .popup-rating-chevron {
    transform: rotate(180deg);
  }

  .popup-rating-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    width: min(420px, calc(100vw - 32px));
    pointer-events: none;
  }

  .popup-rating-dropdown:not([hidden]) {
    pointer-events: auto;
  }

  .popup-rating-dropdown[hidden] {
    display: none !important;
  }

  .popup-rating-dropdown__panel {
    position: relative;
    width: 100%;
    max-height: min(70vh, 620px);
    overflow: auto;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.14);
    border: 1px solid #ececec;
    padding: 20px 18px 16px;
  }

  .popup-rating-dropdown__caret {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 14px;
    height: 14px;
    background: #fff;
    border-top: 1px solid #ececec;
    border-left: 1px solid #ececec;
    z-index: 1;
  }

  .popup-rating-dropdown__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 28px;
    height: 28px;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    background: #fff;
    cursor: pointer;
    z-index: 2;
  }

  .popup-rating-dropdown__score-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding-right: 36px;
    margin-bottom: 14px;
  }

  .popup-rating-dropdown__score-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .popup-rating-dropdown__score {
    margin: 0;
    font-size: 28px;
    line-height: 1;
    font-weight: 700;
    color: #111;
  }

  .popup-rating-dropdown__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .popup-rating-dropdown__star {
    position: relative;
    width: 18px;
    height: 18px;
    display: inline-block;
    flex-shrink: 0;
  }

  .popup-rating-dropdown__star svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .popup-rating-dropdown__star--half {
    position: relative;
  }

  .popup-rating-dropdown__star-empty {
    display: block;
  }

  .popup-rating-dropdown__star-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    overflow: hidden;
  }

  .popup-rating-dropdown__total {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.4;
    color: #444;
    text-align: right;
    max-width: 46%;
  }

  .popup-rating-dropdown__total strong {
    font-weight: 700;
  }

  .popup-rating-dropdown__breakdown {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .popup-rating-dropdown__bar-row {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #333;
  }

  .popup-rating-dropdown__bar-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .popup-rating-dropdown__bar-track {
    height: 8px;
    border-radius: 999px;
    background: var(--popup-rating-bar-bg, #e6e6e6);
    overflow: hidden;
  }

  .popup-rating-dropdown__bar-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--popup-rating-accent, #cc667c);
  }

  .popup-rating-dropdown__bar-count {
    min-width: 32px;
    text-align: right;
    color: #666;
    font-size: 11px;
  }

  .popup-rating-dropdown__divider {
    height: 1px;
    background: #ececec;
    margin: 16px 0 12px;
  }

  .popup-rating-dropdown__reviews-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .popup-rating-dropdown__view-all {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: #333;
    text-decoration: none;
  }

  .popup-rating-dropdown__view-all:hover {
    text-decoration: underline;
  }

  .popup-rating-dropdown__slide-inner {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .popup-rating-dropdown__slide-media {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    border-radius: 8px;
    overflow: hidden;
    background: #f3f3f3;
  }

  .popup-rating-dropdown__slide-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .popup-rating-dropdown__slide-content {
    flex: 1;
    min-width: 0;
  }

  .popup-rating-dropdown__slide-name {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    color: #111;
  }

  .popup-rating-dropdown__slide-text {
    font-size: 13px;
    line-height: 1.5;
    color: #333;
  }

  .popup-rating-dropdown__slide-text p {
    margin: 0;
  }

  .popup-rating-dropdown__nav {
    display: flex;
    justify-content: center;
    margin-top: 14px;
  }

  .popup-rating-dropdown__nav-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .popup-rating-dropdown__pagination {
    position: static !important;
    width: auto !important;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .popup-rating-dropdown__pagination .swiper-pagination-bullet {
    width: 7px;
    height: 7px;
    margin: 0 !important;
    background: #d9d9d9;
    opacity: 1;
  }

  .popup-rating-dropdown__pagination .swiper-pagination-bullet-active {
    background: #111;
  }

  .popup-rating-dropdown__arrows {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    position: absolute;
    width: 100%;
    bottom: 0px;
    padding: 15px;
}

  .popup-rating-dropdown__arrow {
    position: static !important;
    width: 32px;
    height: 32px;
    margin: 0 !important;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fff;
    color: #333;
    cursor: pointer;
  }

  .popup-rating-dropdown__arrow::after {
    font-size: 12px !important;
    font-weight: 700;
  }

  .popup-rating-dropdown__arrow.swiper-button-disabled {
    opacity: 0.35;
    cursor: default;
  }

  .popup-rating-trigger--clickable,
  .popup-rating-trigger--clickable * {
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .popup-rating-dropdown {
      left: 0;
      transform: none;
      width: min(420px, calc(100vw - 24px));
    }

    .popup-rating-dropdown__score {
      font-size: 24px;
    }
  }
</style>
