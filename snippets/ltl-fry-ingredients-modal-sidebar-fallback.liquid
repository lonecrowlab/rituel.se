{%- assign lines = data | strip | newline_to_br | split: '<br />' -%}
<div>
  <div>
    {%- for line in lines -%}
      {%- assign entry = line | strip -%}
      {%- assign kind = entry | slice: 0 -%}
      {%- assign label = entry | remove_first: kind | remove_first: ':' -%}
      {%- if kind == 'h' -%}
        <h3 class="product-content__info-content-text-faq-title">{{ label }}</h3>
      {%- else -%}
        {%- case kind -%}
          {%- when 'a' -%}{%- assign dot = '#4A90E2' -%}
          {%- when 'o' -%}{%- assign dot = '#5A9512' -%}
          {%- else -%}{%- assign dot = '#B8E77F' -%}
        {%- endcase -%}
        <div>
          <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7.47363" cy="7.33203" r="6.5" fill="{{ dot }}"></circle>
          </svg>
          <span>{{ label }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
