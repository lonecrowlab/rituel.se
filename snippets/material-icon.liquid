{% comment %}
  Renders a Material icon as inline SVG when available (ATF-safe), otherwise lazy font fallback.
  Accepts: icon, filled, custom_color, color, class
{% endcomment %}
{%- liquid
  assign icon_name = icon | strip | downcase | replace: ' ', '_'
  assign icon_class = 'material-icon-svg'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
  if custom_color != blank
    assign icon_class = icon_class | append: ' material-icon--custom-color color-icon-' | append: custom_color
  endif

  assign icon_color = color
  if icon_color == blank and custom_color != blank
    assign icon_color = custom_color
  endif

  assign icon_style = ''
  if icon_color != blank
    assign icon_style = 'color: ' | append: icon_color | append: ';'
  endif
-%}

{%- case icon_name -%}
  {%- when 'person' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></span>
  {%- when 'local_shipping' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg></span>
  {%- when 'storefront' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M21.9 8.89l-1.05-4.37c-.22-.9-1-1.52-1.91-1.52H4.05c-.9 0-1.69.63-1.9 1.52L1.1 8.89c-.24 1.02-.02 2.06.62 2.88.08.11.17.21.27.31v8.8c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-8.8c.1-.1.19-.2.27-.31.64-.82.86-1.86.62-2.88zM5.05 6h13.9l.83 3.47H4.22L5.05 6zM7 20v-6h2v6H7zm4 0v-6h2v6h-2zm4 0v-6h2v6h-2z"/></svg></span>
  {%- when 'shopping_cart' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0 0 20 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg></span>
  {%- when 'check_circle' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></span>
  {%- when 'content_copy' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg></span>
  {%- when 'verified' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m23 12-2.44-2.79.34-3.69-3.61-.82-1.89-3.2L12 2.96 8.6 1.5 6.71 4.69 3.1 5.5l.34 3.7L1 12l2.44 2.79-.34 3.7 3.61.82L8.6 22.5 12 21.04l3.4 1.46 1.89-3.19 3.61-.82-.34-3.69L23 12zm-12.91 4.72-3.8-3.81 1.48-1.48 2.32 2.33 5.85-5.87 1.48 1.48-7.33 7.35z"/></svg></span>
  {%- when 'star' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></span>
  {%- when 'lock' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg></span>
  {%- when 'favorite' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></span>
  {%- when 'arrow_right_alt' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M16.01 11H4v2h12.01v3L20 12l-3.99-4v3z"/></svg></span>
  {%- when 'check_circle_outline', 'check' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></span>
  {%- when 'cancel', 'close' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/></svg></span>
  {%- when 'info' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg></span>
  {%- when 'eco' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6.05 8.05a7.007 7.007 0 0 0 0 9.9 7.007 7.007 0 0 0 9.9 0 7.007 7.007 0 0 0 0-9.9 7.007 7.007 0 0 0-9.9 0zm1.41 8.49a5.006 5.006 0 0 1 0-7.08 5.006 5.006 0 0 1 7.08 0 5.006 5.006 0 0 1 0 7.08 5.006 5.006 0 0 1-7.08 0zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg></span>
  {%- when 'recycling' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M5.77 7.15 7.2 4.78l1.03-1.71c.39-.65 1.33-.65 1.72 0l1.48 2.46-3.25 2.1a.996.996 0 0 1-1.41-.48zM21.29 9.26l-2.14-.65a.996.996 0 0 0-1.26.73l-.03.16-2.15 6.67a1 1 0 0 0 .99 1.26h.18c.45-.01.84-.32.95-.76l.74-2.67 3.63 1.11c.41.13.84-.04 1.05-.41l1.14-2.01a1 1 0 0 0-.28-1.26zM5.64 16.36l-2.14-.65a.996.996 0 0 0-1.26.73l-.03.16-2.15 6.67a1 1 0 0 0 .99 1.26h.18c.45-.01.84-.32.95-.76l.74-2.67 3.63 1.11c.41.13.84-.04 1.05-.41l1.14-2.01a1 1 0 0 0-.28-1.26zM13 19h-2v-2h2v2zm0-6h-2v-2h2v2z"/></svg></span>
  {%- when 'flag' -%}
    <span class="{{ icon_class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M14.4 6 14 4H5v17h2v-7h5.6l.4 2h7V6h-5.6z"/></svg></span>
  {%- else -%}
    <span class="material-icon material-symbols-outlined{% if filled %} filled{% endif %}{% if custom_color != blank %} material-icon--custom-color color-icon-{{ custom_color }}{% endif %}{{ class }}"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-hidden="true">
      {{ icon_name }}
    </span>
{%- endcase -%}
