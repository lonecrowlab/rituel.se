<script>
(function() {
  'use strict';
  const wrapper = document.querySelector('.cart-checkpoints--product');
  if (!wrapper) return;

  const configEl = wrapper.parentElement.querySelector('.checkpoints-config') ||
                   document.querySelector('.checkpoints-config');
  if (!configEl) return;

  let cfg;
  try { cfg = JSON.parse(configEl.textContent); } catch(e) { return; }

  let cartSubtotal = cfg.cartSubtotal || 0;
  let cartQuantity = cfg.cartQuantity || 0;
  const isQuantity = cfg.goalType === 'quantity';
  const moneyFormat = cfg.moneyFormat;
  const progressMsg = cfg.progressMessage;
  const successMsg = cfg.successMessage;
  const goals = cfg.goals || [];
  const variants = cfg.variants || [];

  if (goals.length === 0) return;

  const highestGoal = goals[goals.length - 1].amount;
  const goalMultiplier = isQuantity ? 1 : 100;

  let currentVariantPrice = cfg.variantPrice || 0;
  let currentQuantity = 1;
  let currentQbDiscount = 0;

  function formatAmountVariants(cents) {
    var n = Math.max(0, Number(cents) || 0) / 100;
    var fixed2 = n.toFixed(2);
    var parts = fixed2.split('.');
    var intPart = parts[0];
    var decPart = parts[1];
    var spacedInt = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    var dottedInt = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, '.');

    return {
      amount: intPart + '.' + decPart,
      amount_with_comma_separator: dottedInt + ',' + decPart,
      amount_with_space_separator: spacedInt + ',' + decPart,
      amount_no_decimals: String(Math.round(n)),
      amount_no_decimals_with_comma_separator: dottedInt,
      amount_no_decimals_with_space_separator: spacedInt
    };
  }

  function formatPlainAmount(cents) {
    return formatAmountVariants(cents).amount_with_space_separator;
  }

  function applyProgressMessage(template, amountHtml, rawRemaining, nextGoalText, isQuantity) {
    if (!template) return '';

    var msg = template;
    var variants = isQuantity
      ? {
          amount: String(Math.max(0, Math.round(rawRemaining))),
          amount_with_comma_separator: String(Math.max(0, Math.round(rawRemaining))),
          amount_with_space_separator: String(Math.max(0, Math.round(rawRemaining))),
          amount_no_decimals: String(Math.max(0, Math.round(rawRemaining))),
          amount_no_decimals_with_comma_separator: String(Math.max(0, Math.round(rawRemaining))),
          amount_no_decimals_with_space_separator: String(Math.max(0, Math.round(rawRemaining)))
        }
      : formatAmountVariants(Math.max(0, rawRemaining));

    msg = msg.replace(/\[amount\]/g, amountHtml);
    msg = msg.replace(/\[next_goal\]/g, nextGoalText || '');
    msg = msg.replace(/\[next_goal_lowercase\]/g, (nextGoalText || '').toLowerCase());

    Object.keys(variants).forEach(function (key) {
      msg = msg.replace(new RegExp('\\{\\{\\s*' + key + '\\s*\\}\\}', 'g'), variants[key]);
    });

    return msg;
  }

  function updateCheckpointsBar() {
    var productValue;
    if (isQuantity) {
      productValue = currentQuantity;
    } else {
      var discountMultiplier = (100 - currentQbDiscount) / 100;
      productValue = Math.round(currentVariantPrice * discountMultiplier) * currentQuantity;
    }

    var total = isQuantity ? cartQuantity + productValue : cartSubtotal + productValue;
    var highestGoalValue = highestGoal * goalMultiplier;
    var progress = (total / highestGoalValue) * 100;
    var allReached = progress >= 100;
    if (allReached) progress = 100;

    // Update progress bar width
    var bar = wrapper.querySelector('.cart-progress__bar__progress');
    if (bar) bar.style.width = progress + '%';

    // Find next unreached goal
    var nextGoalText = null;
    var nextGoalValue = 0;
    for (var g = 0; g < goals.length; g++) {
      var goalValue = goals[g].amount * goalMultiplier;
      if (total < goalValue && !nextGoalText) {
        nextGoalText = goals[g].text;
        nextGoalValue = goalValue;
      }
    }

    // Update progress text
    var textEl = wrapper.querySelector('.cart-progress__text');
    if (!textEl) return;

    if (allReached) {
      textEl.innerHTML = successMsg;
    } else if (nextGoalText) {
      var remaining = nextGoalValue - total;
      var amountHtml;
      if (isQuantity) {
        amountHtml = Math.max(0, Math.round(remaining)).toString();
      } else {
        amountHtml = '<span>' + formatPlainAmount(Math.max(0, remaining)) + '</span>';
      }
      textEl.innerHTML = applyProgressMessage(
        progressMsg,
        amountHtml,
        remaining,
        nextGoalText,
        isQuantity
      );
    }
  }

  // QB option changes
  document.addEventListener('qb:state-changed', function(e) {
    if (e.detail.quantity) currentQuantity = e.detail.quantity;
    if (e.detail.qbDiscount !== undefined) currentQbDiscount = e.detail.qbDiscount;
    updateCheckpointsBar();
  });

  // Bundle changes (multi-variant QB)
  document.addEventListener('bundle:state-changed', function(e) {
    if (e.detail.quantity !== undefined) currentQuantity = e.detail.quantity;
    if (e.detail.finalPrice !== undefined) currentVariantPrice = e.detail.finalPrice;
    currentQbDiscount = 0; // bundle already has pricing baked in
    updateCheckpointsBar();
  });

  // Subscription changes
  document.addEventListener('subscription:state-changed', function() {
    updateCheckpointsBar();
  });

  // Variant changes
  function handleVariant(e) {
    var variantId = e.detail && e.detail.variant ? e.detail.variant.id :
                    (e.detail ? (e.detail.variantId || e.detail.id) : null);
    if (variantId) {
      for (var i = 0; i < variants.length; i++) {
        if (variants[i].id == variantId) {
          currentVariantPrice = variants[i].price;
          break;
        }
      }
      updateCheckpointsBar();
    }
  }
  document.addEventListener('variant-change', handleVariant);
  document.addEventListener('variant:change', handleVariant);

  // Also watch the hidden variant input for programmatic changes
  function setupVariantObserver() {
    var form = document.querySelector('form[action*="/cart/add"]');
    if (!form) return;
    var input = form.querySelector('input[name="id"]');
    if (!input) return;

    function onInputChange() {
      var vid = input.value;
      for (var i = 0; i < variants.length; i++) {
        if (variants[i].id == vid) {
          currentVariantPrice = variants[i].price;
          updateCheckpointsBar();
          break;
        }
      }
    }

    var obs = new MutationObserver(onInputChange);
    obs.observe(input, { attributes: true, attributeFilter: ['value'] });
    input.addEventListener('change', onInputChange);
  }

  // Deferred init: wait for form to be in DOM
  function init() {
    setupVariantObserver();

    // Read initial QB state if present
    var qbActive = document.querySelector('.qb-wrapper .qb-option.qb-active');
    if (qbActive) {
      currentQuantity = parseInt(qbActive.dataset.qty) || 1;
    }

    // Read initial quantity from form
    var qtyInput = document.querySelector('.product-form__quantity-input, input[name="quantity"]');
    if (qtyInput && !qbActive) {
      currentQuantity = parseInt(qtyInput.value) || 1;
    }

    updateCheckpointsBar();
  }

  /* ── Gift auto-add/remove (only if cart drawer checkpoints bar is NOT active) ── */
  var gifts = cfg.gifts || [];
  var cartDrawerActive = document.querySelector('.checkpoints-gifts-config');
  var shouldManageGifts = gifts.length > 0 && !cartDrawerActive;

  var giftHandleSet = {};
  for (var gi = 0; gi < gifts.length; gi++) {
    giftHandleSet[gifts[gi].handle] = true;
  }

  /* --- SessionStorage dismissal tracking (shared key with cart drawer) --- */
  var DISMISSED_KEY = 'checkpoints_dismissed_gifts';

  function getDismissed() {
    try {
      return JSON.parse(sessionStorage.getItem(DISMISSED_KEY)) || {};
    } catch(e) { return {}; }
  }
  function setDismissed(obj) {
    try { sessionStorage.setItem(DISMISSED_KEY, JSON.stringify(obj)); } catch(e) {}
  }
  function dismissGift(handle) {
    var d = getDismissed(); d[handle] = true; setDismissed(d);
  }
  function undismissGift(handle) {
    var d = getDismissed(); delete d[handle]; setDismissed(d);
  }
  function isDismissed(handle) {
    return !!getDismissed()[handle];
  }

  var prevGiftHandlesInCart = {};
  var giftProcessing = false;

  /**
   * Core gift logic — returns a Promise that resolves when add/remove ops finish.
   * Does NOT re-render the cart drawer (caller decides).
   */
  function manageGifts(cart) {
    var cartValue = 0;
    if (isQuantity) {
      for (var q = 0; q < cart.items.length; q++) {
        if (!giftHandleSet[cart.items[q].handle]) {
          cartValue += cart.items[q].quantity;
        }
      }
    } else {
      cartValue = cart.items_subtotal_price;
    }

    var currentGiftHandlesInCart = {};
    var toAdd = [];
    var toRemove = [];

    for (var i = 0; i < gifts.length; i++) {
      var gift = gifts[i];
      var threshold = gift.goalAmount * goalMultiplier;
      var goalMet = cartValue >= threshold;

      var inCart = false;
      for (var j = 0; j < cart.items.length; j++) {
        if (cart.items[j].handle === gift.handle) {
          inCart = true;
          break;
        }
      }

      if (inCart) {
        currentGiftHandlesInCart[gift.handle] = true;
      }

      if (!goalMet) {
        undismissGift(gift.handle);
        for (var k = 0; k < cart.items.length; k++) {
          if (cart.items[k].handle === gift.handle) {
            toRemove.push(cart.items[k].key);
          }
        }
      } else if (goalMet && !inCart) {
        if (prevGiftHandlesInCart[gift.handle]) {
          dismissGift(gift.handle);
        }
        if (!isDismissed(gift.handle)) {
          toAdd.push(gift.variantId);
        }
      }
    }

    prevGiftHandlesInCart = currentGiftHandlesInCart;

    if (toAdd.length === 0 && toRemove.length === 0) {
      return Promise.resolve();
    }

    var ops = [];

    if (toAdd.length > 0) {
      var addItems = toAdd.map(function(vid) { return { id: vid, quantity: 1 }; });
      ops.push(
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: addItems })
        })
      );
    }

    for (var r = 0; r < toRemove.length; r++) {
      ops.push(
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: toRemove[r], quantity: 0 })
        })
      );
    }

    return Promise.all(ops);
  }

  /**
   * Global hook — buy-buttons calls this BEFORE opening the cart drawer
   * so gifts are already in the cart when the drawer renders.
   * Returns a Promise that resolves when done.
   */
  if (shouldManageGifts) {
    window.__addCheckpointGifts = function() {
      if (giftProcessing) return Promise.resolve();
      giftProcessing = true;
      return fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          cartSubtotal = cart.items_subtotal_price;
          cartQuantity = cart.items.reduce(function(s, item) { return s + item.quantity; }, 0);
          updateCheckpointsBar();
          return manageGifts(cart);
        })
        .then(function() { giftProcessing = false; })
        .catch(function() { giftProcessing = false; });
    };
  }

  /**
   * Event-based fallback — for non-buy-button cart changes (e.g. cart page,
   * quantity edits in cart drawer). Re-renders cart drawer after gift changes.
   */
  function checkAndManageGiftsWithRerender(cart) {
    if (giftProcessing) return;
    giftProcessing = true;
    manageGifts(cart)
      .then(function() {
        return fetch(window.CartDrawerSections.getSectionsUrl());
      })
      .then(function(r) { return r.json(); })
      .then(function(sections) {
        if (sections && window.CartDrawerSections.pickDrawerHtml(sections)) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(window.CartDrawerSections.pickDrawerHtml(sections), 'text/html');
          var newItems = doc.querySelector('cart-drawer-items') || doc.querySelector('.cart-items, [id*="cart-items"], .drawer__inner');
          var curItems = document.querySelector('cart-drawer-items') || document.querySelector('.cart-items, [id*="cart-items"], .drawer__inner');
          if (newItems && curItems) curItems.innerHTML = newItems.innerHTML;
        }
        if (sections && sections['cart-icon-bubble']) {
          var bParser = new DOMParser();
          var bDoc = bParser.parseFromString(sections['cart-icon-bubble'], 'text/html');
          var newBubble = bDoc.querySelector('.cart-count-bubble');
          var curBubble = document.querySelector('#cart-icon-bubble');
          if (curBubble && newBubble) {
            var existing = curBubble.querySelector('.cart-count-bubble');
            if (existing) existing.innerHTML = newBubble.innerHTML;
            else curBubble.appendChild(newBubble.cloneNode(true));
          }
        }
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        giftProcessing = false;
      })
      .catch(function() { giftProcessing = false; });
  }

  /* ── Live cart sync: update progress bar + gift check after cart changes ── */
  var cartSyncTimer = null;
  var CART_SYNC_DEBOUNCE = 1500;

  function onCartChanged() {
    clearTimeout(cartSyncTimer);
    cartSyncTimer = setTimeout(function() {
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          cartSubtotal = cart.items_subtotal_price;
          cartQuantity = cart.items.reduce(function(s, item) { return s + item.quantity; }, 0);
          updateCheckpointsBar();

          if (shouldManageGifts) {
            checkAndManageGiftsWithRerender(cart);
          }
        })
        .catch(function() {});
    }, CART_SYNC_DEBOUNCE);
  }

  document.addEventListener('cart:updated', onCartChanged);
  document.addEventListener('cart-update', onCartChanged);
  document.addEventListener('cartQuantityUpdated', onCartChanged);

  /* ── Initial gift check on page load (cart may already meet threshold) ── */
  function initialGiftCheck() {
    if (!shouldManageGifts) return;
    setTimeout(function() {
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          cartSubtotal = cart.items_subtotal_price;
          cartQuantity = cart.items.reduce(function(s, item) { return s + item.quantity; }, 0);
          updateCheckpointsBar();
          checkAndManageGiftsWithRerender(cart);
        })
        .catch(function() {});
    }, 1500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      init();
      initialGiftCheck();
    });
  } else {
    requestAnimationFrame(function() {
      init();
      initialGiftCheck();
    });
  }
})();
</script>
{% endif %}
