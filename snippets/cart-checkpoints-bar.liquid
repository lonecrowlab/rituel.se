    <script>
    (function() {
      'use strict';
      if (window.Shopify && window.Shopify.designMode) return;

      var configEl = document.querySelector('.checkpoints-gifts-config');
      if (!configEl) return;

      var cfg;
      try { cfg = JSON.parse(configEl.textContent); } catch(e) { return; }

      var gifts = cfg.gifts || [];
      if (gifts.length === 0) return;

      var goalType = cfg.goalType;
      var isQuantity = goalType === 'quantity';
      var isProcessing = false;
      var debounceTimer = null;
      var DEBOUNCE_MS = 1500;

      /* Build a set of gift handles for quick lookup */
      var giftHandleSet = {};
      for (var g = 0; g < gifts.length; g++) {
        giftHandleSet[gifts[g].handle] = true;
      }

      /* --- Manual-removal tracking via sessionStorage --- */
      var DISMISSED_KEY = 'checkpoints_dismissed_gifts';

      function getDismissed() {
        try {
          return JSON.parse(sessionStorage.getItem(DISMISSED_KEY)) || {};
        } catch(e) { return {}; }
      }
      function setDismissed(obj) {
        try { sessionStorage.setItem(DISMISSED_KEY, JSON.stringify(obj)); } catch(e) {}
      }
      function dismissGift(handle) {
        var d = getDismissed(); d[handle] = true; setDismissed(d);
      }
      function undismissGift(handle) {
        var d = getDismissed(); delete d[handle]; setDismissed(d);
      }
      function isDismissed(handle) {
        return !!getDismissed()[handle];
      }

      /* Track previous cart state so we can detect manual removals */
      var prevGiftHandlesInCart = {};

      /* Debounced wrapper — waits for cart activity to settle before acting */
      function scheduleCheck() {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(checkAndManageGifts, DEBOUNCE_MS);
      }

      function checkAndManageGifts() {
        if (isProcessing) return;
        isProcessing = true;

        fetch('/cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            /* Exclude gift items from cart value so gifts don't count toward thresholds */
            var cartValue = 0;
            if (isQuantity) {
              for (var q = 0; q < cart.items.length; q++) {
                if (!giftHandleSet[cart.items[q].handle]) {
                  cartValue += cart.items[q].quantity;
                }
              }
            } else {
              cartValue = cart.items_subtotal_price;
            }
            var goalMultiplier = isQuantity ? 1 : 100;

            var currentGiftHandlesInCart = {};
            var toAdd = [];
            var toRemove = [];

            for (var i = 0; i < gifts.length; i++) {
              var gift = gifts[i];
              var threshold = gift.goalAmount * goalMultiplier;
              var goalMet = cartValue >= threshold;

              /* Check if ANY variant of this product is in cart (match by handle) */
              var inCart = false;
              for (var j = 0; j < cart.items.length; j++) {
                if (cart.items[j].handle === gift.handle) {
                  inCart = true;
                  break;
                }
              }

              if (inCart) {
                currentGiftHandlesInCart[gift.handle] = true;
              }

              if (!goalMet) {
                /* Goal no longer met — remove ALL matching items AND clear dismissed flag */
                undismissGift(gift.handle);
                for (var k = 0; k < cart.items.length; k++) {
                  if (cart.items[k].handle === gift.handle) {
                    toRemove.push(cart.items[k].key);
                  }
                }
              } else if (goalMet && !inCart) {
                /* Goal met, gift not in cart */
                if (prevGiftHandlesInCart[gift.handle]) {
                  /* Was previously in cart but now gone = customer removed it */
                  dismissGift(gift.handle);
                }
                if (!isDismissed(gift.handle)) {
                  toAdd.push(gift.variantId);
                }
              }
              /* goalMet && inCart — gift is where it should be, leave it alone */
            }

            prevGiftHandlesInCart = currentGiftHandlesInCart;

            if (toAdd.length === 0 && toRemove.length === 0) {
              isProcessing = false;
              return;
            }

            var ops = [];

            if (toAdd.length > 0) {
              var addItems = toAdd.map(function(vid) { return { id: vid, quantity: 1 }; });
              ops.push(
                fetch('/cart/add.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ items: addItems })
                })
              );
            }

            for (var r = 0; r < toRemove.length; r++) {
              ops.push(
                fetch('/cart/change.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ id: toRemove[r], quantity: 0 })
                })
              );
            }

            Promise.all(ops)
              .then(function() {
                return fetch(((window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/') + '?section_id=' + encodeURIComponent(window.CartDrawerSections.getDrawerSectionId()));
              })
              .then(function(r) { return r.text(); })
              .then(function(html) {
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');
                var newCartItems = doc.querySelector('cart-drawer-items');
                var currentCartItems = document.querySelector('cart-drawer-items');
                if (newCartItems && currentCartItems) {
                  currentCartItems.innerHTML = newCartItems.innerHTML;
                }
                document.dispatchEvent(new CustomEvent('cart:refresh'));
                isProcessing = false;
              })
              .catch(function() {
                isProcessing = false;
              });
          })
          .catch(function() {
            isProcessing = false;
          });
      }

      /* Use debounced version for cart events so variant swapper can finish */
      document.addEventListener('cart:updated', scheduleCheck);
      document.addEventListener('cart-update', scheduleCheck);
      document.addEventListener('cartQuantityUpdated', scheduleCheck);

      /* Initial check on page load */
      setTimeout(checkAndManageGifts, 1500);
    })();
    </script>
