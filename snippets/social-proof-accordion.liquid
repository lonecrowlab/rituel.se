<script>
(function() {
  class SpaSlider {
    constructor(wrapper) {
      this.wrapper = wrapper;
      this.control = wrapper.querySelector('[data-spa-handle]');
      this.afterImage = wrapper.querySelector('.spa-dialog__image--after');
      this.isDragging = false;
      this.touchStartX = 0;
      this.touchStartY = 0;
      this.isHorizontalSwipe = false;
      this.init();
    }

    init() {
      if (!this.control || !this.afterImage) return;
      this.wrapper.addEventListener('mousedown', this.startDrag.bind(this));
      document.addEventListener('mousemove', this.onDrag.bind(this));
      document.addEventListener('mouseup', this.stopDrag.bind(this));
      this.wrapper.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
      this.wrapper.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: false });
      this.wrapper.addEventListener('touchend', this.handleTouchEnd.bind(this));
      this.wrapper.addEventListener('click', this.handleClick.bind(this));
    }

    handleClick(e) {
      if (e.type === 'click' && e.detail === 0) return;
      const rect = this.wrapper.getBoundingClientRect();
      const percentage = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
      this.updateSlider(percentage);
    }

    handleTouchStart(e) {
      this.touchStartX = e.touches[0].clientX;
      this.touchStartY = e.touches[0].clientY;
      this.isHorizontalSwipe = false;
    }

    handleTouchMove(e) {
      const touchX = e.touches[0].clientX;
      const touchY = e.touches[0].clientY;
      const deltaX = Math.abs(touchX - this.touchStartX);
      const deltaY = Math.abs(touchY - this.touchStartY);
      if (!this.isHorizontalSwipe && deltaX < 10 && deltaY < 10) return;
      if (!this.isHorizontalSwipe) this.isHorizontalSwipe = deltaX > deltaY;
      if (this.isHorizontalSwipe) {
        e.preventDefault();
        this.isDragging = true;
        const rect = this.wrapper.getBoundingClientRect();
        const percentage = Math.max(0, Math.min(100, ((touchX - rect.left) / rect.width) * 100));
        this.updateSlider(percentage);
      }
    }

    handleTouchEnd() {
      this.isDragging = false;
      this.isHorizontalSwipe = false;
    }

    startDrag(e) {
      this.isDragging = true;
      const rect = this.wrapper.getBoundingClientRect();
      const percentage = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
      this.updateSlider(percentage);
    }

    stopDrag() {
      this.isDragging = false;
    }

    onDrag(e) {
      if (!this.isDragging) return;
      e.preventDefault();
      const rect = this.wrapper.getBoundingClientRect();
      const percentage = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
      this.updateSlider(percentage);
    }

    updateSlider(percentage) {
      this.control.style.left = percentage + '%';
      this.afterImage.style.clipPath = 'inset(0 0 0 ' + percentage + '%)';
    }

    reset() {
      this.updateSlider(50);
    }
  }

  function spaCartRoot() {
    if (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) {
      return window.Shopify.routes.root;
    }
    return '/';
  }

  function spaCartAddUrl() {
    var root = spaCartRoot();
    if (root.charAt(root.length - 1) !== '/') root += '/';
    return root + 'cart/add.js';
  }

  function spaRefreshCartAndOpenDrawer() {
    var sectionsApi = window.CartDrawerSections;
    if (!sectionsApi || typeof sectionsApi.getSectionsUrl !== 'function') {
      var fallbackTrigger = document.querySelector('#cart-icon-bubble');
      if (fallbackTrigger) fallbackTrigger.click();
      return Promise.resolve();
    }

    return fetch(sectionsApi.getSectionsUrl())
      .then(function(res) { return res.json(); })
      .then(function(sections) {
        var html = sectionsApi.pickDrawerHtml(sections);
        var cartDrawer = document.querySelector('cart-drawer');
        if (html && cartDrawer) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var rendered = doc.querySelector('cart-drawer');
          if (rendered) {
            cartDrawer.innerHTML = rendered.innerHTML;
            cartDrawer.className = rendered.className;
            if (rendered.getAttribute('data-section-id')) {
              cartDrawer.setAttribute('data-section-id', rendered.getAttribute('data-section-id'));
            }
          }
        }

        if (sections['cart-icon-bubble']) {
          var bubbleDoc = new DOMParser().parseFromString(sections['cart-icon-bubble'], 'text/html');
          var newBubble = bubbleDoc.querySelector('.cart-count-bubble');
          var cartIconBubble = document.querySelector('#cart-icon-bubble');
          var existingBubble = cartIconBubble ? cartIconBubble.querySelector('.cart-count-bubble') : null;
          if (cartIconBubble) {
            if (newBubble && existingBubble) {
              existingBubble.innerHTML = newBubble.innerHTML;
            } else if (newBubble && !existingBubble) {
              cartIconBubble.appendChild(newBubble.cloneNode(true));
            } else if (!newBubble && existingBubble) {
              existingBubble.remove();
            }
          }
        }

        if (cartDrawer) {
          cartDrawer.classList.remove('is-empty', 'is-loading');
          cartDrawer.classList.add('is-loaded');
          if (typeof cartDrawer.open === 'function') {
            cartDrawer.open();
          } else {
            var trigger = document.querySelector('#cart-icon-bubble, .header__icon--cart');
            if (trigger) trigger.click();
          }
        }
      });
  }

  function initSpaProductsAtc() {
    if (document.body.dataset.spaAtc === 'true') return;
    document.body.dataset.spaAtc = 'true';

    document.addEventListener('click', function(e) {
      var button = e.target.closest('[data-spa-atc]');
      if (!button || button.disabled) return;

      e.preventDefault();
      e.stopPropagation();

      var variantId = parseInt(button.getAttribute('data-variant-id'), 10);
      if (!variantId) return;

      var textEl = button.querySelector('.spa-dialog__product-atc-text');
      var originalText = button.getAttribute('data-add-label') || (textEl ? textEl.textContent : '');
      var addedText = button.getAttribute('data-added-label') || 'Tillagd';

      button.classList.add('loading');
      button.disabled = true;

      fetch(spaCartAddUrl(), {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          'X-Upsell-Add': 'true'
        },
        body: JSON.stringify({
          items: [{ id: variantId, quantity: 1 }]
        })
      })
        .then(function(response) {
          if (!response.ok) {
            return response.json().then(function(err) {
              throw new Error((err && err.description) || 'HTTP ' + response.status);
            });
          }
          return response.json();
        })
        .then(function() {
          return spaRefreshCartAndOpenDrawer();
        })
        .then(function() {
          button.classList.remove('loading');
          button.disabled = false;
          if (textEl) textEl.textContent = addedText;
          setTimeout(function() {
            if (textEl) textEl.textContent = originalText;
          }, 2000);
        })
        .catch(function(error) {
          button.classList.remove('loading');
          button.disabled = false;
          if (textEl) textEl.textContent = originalText;
          alert('Kunde inte lägga till: ' + (error && error.message ? error.message : 'okänt fel'));
        });
    });
  }

  function initSocialProofAccordion(blockId) {
    const accordion = document.querySelector('[data-spa="' + blockId + '"]');
    if (!accordion || accordion.dataset.initialized === 'true') return;
    accordion.dataset.initialized = 'true';

    const trigger = accordion.querySelector('[data-accordion-trigger]');
    const content = accordion.querySelector('[data-accordion-content]');
    const inner = accordion.querySelector('.spa__answer-inner');

    function setOpen(open) {
      if (!trigger || !content) return;
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        content.style.maxHeight = content.scrollHeight + 'px';
      } else {
        content.style.maxHeight = content.scrollHeight + 'px';
        requestAnimationFrame(function() {
          content.style.maxHeight = '0';
        });
      }
    }

    if (trigger && content) {
      trigger.addEventListener('click', function() {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        setOpen(!isOpen);
      });

      if (trigger.getAttribute('aria-expanded') === 'true') {
        content.style.maxHeight = content.scrollHeight + 'px';
      } else {
        content.style.maxHeight = '0';
      }

      if (inner && typeof ResizeObserver !== 'undefined') {
        const observer = new ResizeObserver(function() {
          if (trigger.getAttribute('aria-expanded') === 'true') {
            content.style.maxHeight = content.scrollHeight + 'px';
          }
        });
        observer.observe(inner);
      }
    }

    const dialog = document.getElementById('SpaDialog-' + blockId);
    const mode = accordion.dataset.spaMode || 'poster';

    function initNativeScrollDrag(scroller) {
      if (!scroller || scroller.dataset.scrollDrag === 'true') return;
      scroller.dataset.scrollDrag = 'true';

      let isDown = false;
      let startX = 0;
      let startScrollLeft = 0;
      let moved = false;

      scroller.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        if (e.target.closest('[data-spa-slider], [data-spa-atc], button, a, select')) return;
        if (scroller.hasAttribute('data-spa-products') === false && e.target.closest('[data-spa-products]')) return;
        isDown = true;
        moved = false;
        startX = e.pageX;
        startScrollLeft = scroller.scrollLeft;
        scroller.classList.add('is-dragging');
      });

      document.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        e.preventDefault();
        const walk = e.pageX - startX;
        if (Math.abs(walk) > 3) moved = true;
        scroller.scrollLeft = startScrollLeft - walk;
      });

      document.addEventListener('mouseup', function() {
        if (!isDown) return;
        isDown = false;
        scroller.classList.remove('is-dragging');
      });

      scroller.addEventListener('click', function(e) {
        if (!moved) return;
        if (e.target.closest('[data-spa-slider], [data-spa-atc]')) return;
        e.preventDefault();
        e.stopPropagation();
        moved = false;
      }, true);

      scroller.addEventListener('dragstart', function(e) {
        e.preventDefault();
      });
    }

    accordion.querySelectorAll('[data-spa-slider]').forEach(function(slider) {
      new SpaSlider(slider);
    });
    accordion.querySelectorAll('[data-spa-viewport]').forEach(initNativeScrollDrag);
    initSpaProductsAtc();

    if (!dialog) return;

    dialog.querySelectorAll('[data-spa-slider]').forEach(function(slider) {
      new SpaSlider(slider);
    });
    dialog.querySelectorAll('[data-spa-viewport]').forEach(initNativeScrollDrag);

    const viewport = dialog.querySelector('[data-spa-viewport]:not([data-spa-products])');
    const openBtn = accordion.querySelector('[data-spa-open]');
    const closeBtn = dialog.querySelector('[data-spa-close]');

    function openDialog() {
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      if (viewport) viewport.scrollLeft = 0;
    }

    function closeDialog() {
      if (typeof dialog.close === 'function' && dialog.open) {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
    }

    if (openBtn && mode === 'poster') {
      openBtn.addEventListener('click', openDialog);
    }
    if (closeBtn) closeBtn.addEventListener('click', closeDialog);

    dialog.addEventListener('click', function(e) {
      if (e.target === dialog) closeDialog();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      initSocialProofAccordion('{{ spa_id }}');
    });
  } else {
    initSocialProofAccordion('{{ spa_id }}');
  }
})();
</script>
{%- endif -%}
