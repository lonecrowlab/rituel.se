{%- comment -%}
  STOCK PROGRESS BAR — truthful, driven by real inventory.

  Setup:
  1. Create a product metafield:
       Namespace & key:  custom.batch_size
       Type:             Integer
       Value:            the starting quantity of this batch, e.g. 1500
  2. Make sure inventory tracking is ON for the product's variants.
  3. Include where you want it:
       {% render 'stock-bar', product: product %}

  It hides itself when batch_size is missing, when inventory is not tracked,
  or when fewer than `min_percent` are sold, so it only appears when it is
  actually saying something.
{%- endcomment -%}

{%- liquid
  assign min_percent = 55
  assign batch = product.metafields.custom.batch_size.value | plus: 0

  assign left = 0
  assign tracked = false
  for v in product.variants
    if v.inventory_management != blank
      assign tracked = true
      if v.inventory_quantity > 0
        assign left = left | plus: v.inventory_quantity
      endif
    endif
  endfor

  assign show = false
  assign percent = 0
  if batch > 0 and tracked
    assign sold = batch | minus: left
    if sold > 0
      assign percent = sold | times: 100 | divided_by: batch
      if percent > 99
        assign percent = 99
      endif
      if percent >= min_percent
        assign show = true
      endif
    endif
  endif
-%}

{%- if show -%}
<div class="rt-stock" role="group" aria-label="Lagerstatus">
  <p class="rt-stock__title">Snart slut i lager</p>
  <p class="rt-stock__sub">Begränsat antal kvar av den här satsen.</p>

  <div class="rt-stock__track" role="progressbar"
       aria-valuenow="{{ percent }}" aria-valuemin="0" aria-valuemax="100"
       aria-label="{{ percent }} procent sålt">
    <span class="rt-stock__fill" style="width: {{ percent }}%;"></span>
  </div>

  <p class="rt-stock__label">{{ percent }} % sålt</p>
</div>

<style>
  .rt-stock {
    --rt-fill: #A8426F;
    --rt-track: #F1E7EB;
    --rt-ink: #1A1614;
    --rt-muted: #6B625B;
    margin: 20px 0;
    font-family: inherit;
  }

  .rt-stock__title {
    margin: 0 0 2px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--rt-ink);
  }

  .rt-stock__sub {
    margin: 0 0 10px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--rt-muted);
  }

  .rt-stock__track {
    position: relative;
    height: 8px;
    border-radius: 99px;
    background: var(--rt-track);
    overflow: hidden;
  }

  .rt-stock__fill {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: var(--rt-fill);
    transform-origin: left center;
    animation: rt-stock-grow 900ms cubic-bezier(.2,.7,.3,1) both;
  }

  @keyframes rt-stock-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rt-stock__fill { animation: none; }
  }

  .rt-stock__label {
    margin: 8px 0 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--rt-fill);
  }
</style>
{%- endif -%}