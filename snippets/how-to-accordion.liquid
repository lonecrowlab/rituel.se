{% doc %}
  How To Accordion Block
  Accordion styled like product-info-accordion with how-to steps content.

  @param {object} block - The section block with how-to accordion settings
{% enddoc %}

{% comment %}
  How To Accordion Block
  Accordion styled like product-info-accordion with how-to steps content
{% endcomment %}

{% liquid
  assign has_steps = false
  for i in (1..5)
    assign title_key = 'step_' | append: i | append: '_title'
    assign desc_key = 'step_' | append: i | append: '_description'
    assign image_key = 'step_' | append: i | append: '_image'
    if block.settings[title_key] != blank or block.settings[desc_key] != blank or block.settings[image_key] != blank
      assign has_steps = true
      break
    endif
  endfor
%}

{% if block.settings.heading != blank or has_steps %}

<div
  class="how-to-accordion how-to-accordion-{{ block.id }}"
  data-how-to-accordion="{{ block.id }}"
  {{ block.shopify_attributes }}
  style="
    --margin-top: {{ block.settings.margin_top }}px;
    --margin-bottom: {{ block.settings.margin_bottom }}px;
    --padding-top: {{ block.settings.padding_top }}px;
    --padding-bottom: {{ block.settings.padding_bottom }}px;
    --padding-left: {{ block.settings.padding_left }}px;
    --padding-right: {{ block.settings.padding_right }}px;
    --margin-top-mobile: {{ block.settings.margin_top_mobile }}px;
    --margin-bottom-mobile: {{ block.settings.margin_bottom_mobile }}px;
    --padding-top-mobile: {{ block.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;
    --padding-left-mobile: {{ block.settings.padding_left_mobile }}px;
    --padding-right-mobile: {{ block.settings.padding_right_mobile }}px;
  "
>
  <div class="how-to-accordion-items">
    <div class="how-to-accordion-item" data-accordion-item>
      <button
        class="how-to-accordion-question"
        type="button"
        aria-expanded="{% if block.settings.open_default %}true{% else %}false{% endif %}"
        data-accordion-trigger
      >
        <span class="how-to-accordion-question-text">{{ block.settings.heading }}</span>
        <span class="how-to-accordion-icon">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>

      <div class="how-to-accordion-answer" data-accordion-content>
        <div class="how-to-accordion-answer-inner">
          <div class="how-to-steps">
            {% for i in (1..5) %}
              {% assign title_key = 'step_' | append: i | append: '_title' %}
              {% assign desc_key = 'step_' | append: i | append: '_description' %}
              {% assign image_key = 'step_' | append: i | append: '_image' %}

              {% assign step_title = block.settings[title_key] %}
              {% assign step_desc = block.settings[desc_key] %}
              {% assign step_image = block.settings[image_key] %}

              {% if step_title != blank or step_desc != blank or step_image != blank %}
                <div class="how-to-step">
                  {% if step_image != blank %}
                    <div class="how-to-step__icon">
                      <img
                        src="{{ step_image | image_url: width: 200 }}"
                        alt="{{ step_image.alt | default: step_title | escape }}"
                        loading="lazy"
                        width="{{ block.settings.icon_size }}"
                        height="{{ block.settings.icon_size }}"
                      >
                    </div>
                  {% endif %}
                  <div class="how-to-step__content">
                    {% if step_title != blank %}
                      <span class="how-to-step__title">{{ step_title }}</span>
                    {% endif %}
                    {% if step_desc != blank %}
                      <span class="how-to-step__description">{{ step_desc }}</span>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .how-to-accordion-{{ block.id }} {
    width: 100%;
    margin-top: var(--margin-top, 10px);
    margin-bottom: var(--margin-bottom, 10px);
    padding-top: var(--padding-top, 0px);
    padding-bottom: var(--padding-bottom, 0px);
    padding-left: var(--padding-left, 0px);
    padding-right: var(--padding-right, 0px);
    box-sizing: border-box;
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-items {
    width: 100%;
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-item {
    {% if block.settings.border_width > 0 %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    background: {{ block.settings.question_bg_color }};
    color: {{ block.settings.question_text_color }};
    border: none;
    text-align: left;
    padding: {{ block.settings.question_padding_vertical_desktop }}px {{ block.settings.question_padding_horizontal_desktop }}px;
    font-size: {{ block.settings.question_font_size }}px;
    font-weight: {{ block.settings.question_font_weight }};
    transition: all 0.3s ease;
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-question:hover {
    background: {{ block.settings.question_bg_color_hover }};
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-question[aria-expanded="true"] {
    background: {{ block.settings.question_bg_color_active }};
    color: {{ block.settings.question_text_color_active }};
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-question-text {
    flex: 1;
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-icon {
    flex-shrink: 0;
    margin-left: 1rem;
    transition: transform 0.3s ease;
    display: flex;
    align-items: center;
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-question[aria-expanded="true"] .how-to-accordion-icon {
    transform: rotate(180deg);
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-answer {
    overflow: hidden;
    transition: max-height 0.3s ease-in-out;
  }

  .how-to-accordion-{{ block.id }} .how-to-accordion-answer-inner {
    padding: {{ block.settings.answer_padding_vertical_desktop }}px {{ block.settings.answer_padding_horizontal_desktop }}px;
    background-color: {{ block.settings.answer_bg_color }};
  }

  .how-to-accordion-{{ block.id }} .how-to-steps {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.step_gap }}px;
  }

  .how-to-accordion-{{ block.id }} .how-to-step {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .how-to-accordion-{{ block.id }} .how-to-step__icon {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .how-to-accordion-{{ block.id }} .how-to-step__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .how-to-accordion-{{ block.id }} .how-to-step__content {
    flex: 1;
    min-width: 0;
    line-height: {{ block.settings.step_line_height }};
  }

  .how-to-accordion-{{ block.id }} .how-to-step__title {
    display: inline;
    font-size: {{ block.settings.step_title_font_size }}px;
    font-weight: {{ block.settings.step_title_font_weight }};
    color: {{ block.settings.step_title_color }};
    text-transform: {{ block.settings.step_title_text_transform }};
    margin-right: 0.25em;
  }

  .how-to-accordion-{{ block.id }} .how-to-step__description {
    display: inline;
    font-size: {{ block.settings.step_description_font_size }}px;
    font-weight: {{ block.settings.step_description_font_weight }};
    color: {{ block.settings.step_description_color }};
  }

  @media screen and (max-width: 749px) {
    .how-to-accordion-{{ block.id }} {
      margin-top: var(--margin-top-mobile, 10px);
      margin-bottom: var(--margin-bottom-mobile, 10px);
      padding-top: var(--padding-top-mobile, 0px);
      padding-bottom: var(--padding-bottom-mobile, 0px);
      padding-left: var(--padding-left-mobile, 0px);
      padding-right: var(--padding-right-mobile, 0px);
    }

    .how-to-accordion-{{ block.id }} .how-to-accordion-question {
      font-size: {{ block.settings.question_font_size_mobile }}px;
      padding: {{ block.settings.question_padding_vertical_mobile }}px {{ block.settings.question_padding_horizontal_mobile }}px;
    }

    .how-to-accordion-{{ block.id }} .how-to-accordion-answer-inner {
      padding: {{ block.settings.answer_padding_vertical_mobile }}px {{ block.settings.answer_padding_horizontal_mobile }}px;
    }

    .how-to-accordion-{{ block.id }} .how-to-steps {
      gap: {{ block.settings.step_gap_mobile }}px;
    }

    .how-to-accordion-{{ block.id }} .how-to-step {
      gap: {{ block.settings.icon_text_gap_mobile }}px;
    }

    .how-to-accordion-{{ block.id }} .how-to-step__icon {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .how-to-accordion-{{ block.id }} .how-to-step__title {
      font-size: {{ block.settings.step_title_font_size_mobile }}px;
    }

    .how-to-accordion-{{ block.id }} .how-to-step__description {
      font-size: {{ block.settings.step_description_font_size_mobile }}px;
    }
  }
</style>

<script>
(function() {
  function initHowToAccordion(accordionId) {
    const accordion = document.querySelector(`[data-how-to-accordion="${accordionId}"]`);
    if (!accordion || accordion.dataset.initialized) return;

    accordion.dataset.initialized = 'true';
    const items = accordion.querySelectorAll('[data-accordion-item]');

    items.forEach(item => {
      const trigger = item.querySelector('[data-accordion-trigger]');
      const content = item.querySelector('[data-accordion-content]');

      if (trigger && content) {
        trigger.addEventListener('click', () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';

          if (isOpen) {
            trigger.setAttribute('aria-expanded', 'false');
            content.style.maxHeight = content.scrollHeight + 'px';
            requestAnimationFrame(() => {
              content.style.maxHeight = '0';
            });
          } else {
            trigger.setAttribute('aria-expanded', 'true');
            content.style.maxHeight = content.scrollHeight + 'px';
          }
        });

        if (trigger.getAttribute('aria-expanded') === 'true') {
          content.style.maxHeight = content.scrollHeight + 'px';
        } else {
          content.style.maxHeight = '0';
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initHowToAccordion('{{ block.id }}');
    });
  } else {
    initHowToAccordion('{{ block.id }}');
  }
})();
</script>

{% endif %}
