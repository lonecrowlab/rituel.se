{% comment %}
  Renders product card rating from metafields or Trustoo widget fallback.

  Accepts:
  - product: {Object} Product Liquid object (required)
  - section: {Object} Section settings (optional)
  - use_custom_rating: {Boolean} Override for using custom metafield ratings
  - show_rating_count: {Boolean} Override for showing review count text
  - rating_count_text: {String} Override for count text template with [rating.count] and [rating.ave]
  - wrapper_class: {String} Additional CSS class for the wrapper
{% endcomment %}

{%- liquid
  assign use_custom = use_custom_rating
  if use_custom == nil
    if section.settings.use_custom_product_rating != nil
      assign use_custom = section.settings.use_custom_product_rating
    else
      assign use_custom = settings.use_custom_product_rating
    endif
  endif
  if use_custom == nil
    assign use_custom = true
  endif

  assign show_count = show_rating_count
  if show_count == nil
    if section.settings.show_product_rating_count != nil
      assign show_count = section.settings.show_product_rating_count
    else
      assign show_count = settings.show_product_rating_count
    endif
  endif

  assign count_text_template = rating_count_text
  if count_text_template == blank
    if section.settings.product_rating_count_text != blank
      assign count_text_template = section.settings.product_rating_count_text
    elsif settings.product_rating_count_text != blank
      assign count_text_template = settings.product_rating_count_text
    else
      assign count_text_template = '[rating.count] reviews!'
    endif
  endif

  assign review_stars = product.metafields.custom.review_stars_ave.value
  assign review_count = product.metafields.custom.review_count.value
  assign formatted_review_count = blank
  if review_count != blank
    capture formatted_review_count
      render 'format-review-count', count: review_count
    endcapture
    assign formatted_review_count = formatted_review_count | strip
    if formatted_review_count == blank
      assign formatted_review_count = review_count
    endif
  endif

  assign star_size = section.settings.rating_stars_size | default: 14
  assign star_color = section.settings.rating_star_color | default: '#ffd300'
  assign bg_star_color = section.settings.rating_bg_star_color | default: '#e0e0e0'
  assign bg_stars_style = section.settings.rating_bg_stars_style | default: 'outlined'

  assign wrapper_classes = 'product-card-rating'
  if wrapper_class != blank
    assign wrapper_classes = wrapper_classes | append: ' ' | append: wrapper_class
  endif
-%}

{%- if use_custom and review_stars != blank -%}
  {%- liquid
    assign current_rating = review_stars | times: 1.0
    assign rating_percent = current_rating | times: 20.0
  -%}
  <div class="{{ wrapper_classes }} product-card-rating--custom">
    <div class="product-card-rating__stars fc-rating-stars">
      <div class="fc-rating-stars__container">
        <div class="fc-rating-stars__container--underlay{% if settings.star_style == 'trustpilot' %} rating-stars--trustpilot{% endif %}">
          {% if settings.star_style == 'trustpilot' %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><path d="M0 0h96v96H0z" fill="{{ settings.trustpilot_star_empty_color }}"/><path d="M48 64.7L62.6 61l6.1 18.8zm33.6-24.3H55.9L48 16.2l-7.9 24.2H14.4l20.8 15-7.9 24.2 20.8-15 12.8-9.2z" fill="{{ settings.star_symbol_color }}"/></svg>
            {% endfor %}
          {% elsif bg_stars_style == 'outlined' %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
                <path fill="{{ bg_star_color }}" d="M287.9 0c9.2 0 17.6 5.2 21.6 13.5l68.6 141.3 153.2 22.6c9 1.3 16.5 7.6 19.3 16.3s.5 18.1-5.9 24.5L433.6 328.4l26.2 155.6c1.5 9-2.2 18.1-9.6 23.5s-17.3 6-25.3 1.7l-137-73.2L151 509.1c-8.1 4.3-17.9 3.7-25.3-1.7s-11.2-14.5-9.7-23.5l26.2-155.6L31.1 218.2c-6.5-6.4-8.7-15.9-5.9-24.5s10.3-14.9 19.3-16.3l153.2-22.6L266.3 13.5C270.4 5.2 278.7 0 287.9 0zm0 79L235.4 187.2c-3.5 7.1-10.2 12.1-18.1 13.3L99 217.9 184.9 303c5.5 5.5 8.1 13.3 6.8 21L171.4 443.7l105.2-56.2c7.1-3.8 15.6-3.8 22.6 0l105.2 56.2L384.2 324.1c-1.3-7.7 1.2-15.5 6.8-21l85.9-85.1L358.6 200.5c-7.8-1.2-14.6-6.1-18.1-13.3L287.9 79z"/>
              </svg>
            {% endfor %}
          {% else %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
                <path fill="{{ bg_star_color }}" d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/>
              </svg>
            {% endfor %}
          {% endif %}
        </div>
        <div class="fc-rating-stars__container--overlay{% if settings.star_style == 'trustpilot' %} rating-stars--trustpilot{% endif %}" style="width: {{ rating_percent }}%;">
          {% if settings.star_style == 'trustpilot' %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><path d="M0 0h96v96H0z" fill="{{ settings.trustpilot_star_color }}"/><path d="M48 64.7L62.6 61l6.1 18.8zm33.6-24.3H55.9L48 16.2l-7.9 24.2H14.4l20.8 15-7.9 24.2 20.8-15 12.8-9.2z" fill="{{ settings.star_symbol_color }}"/></svg>
            {% endfor %}
          {% else %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
                <path fill="{{ star_color }}" d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/>
              </svg>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
    {%- if show_count and review_count != blank or show_count and review_stars != blank -%}
      {%- capture rating_count_display -%}
        {%- render 'replace-rating-text', template: count_text_template, product: product -%}
      {%- endcapture -%}
      <span class="product-card-rating__count">{{ rating_count_display | strip }}</span>
    {%- endif -%}
  </div>
{%- elsif use_custom == false and section.settings.show_rating_stars and section.settings.product_ratings != blank -%}
  {%- liquid
    assign ratings_string = section.settings.product_ratings | strip
    assign ratings_array = ratings_string | split: ','
    assign current_rating = ratings_array[product_index] | times: 1.0
    assign rating_percent = current_rating | times: 20.0
  -%}
  <div class="{{ wrapper_classes }} product-card-rating--manual">
    <div class="product-card-rating__stars fc-rating-stars">
      <div class="fc-rating-stars__container">
        <div class="fc-rating-stars__container--underlay{% if settings.star_style == 'trustpilot' %} rating-stars--trustpilot{% endif %}">
          {% if settings.star_style == 'trustpilot' %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><path d="M0 0h96v96H0z" fill="{{ settings.trustpilot_star_empty_color }}"/><path d="M48 64.7L62.6 61l6.1 18.8zm33.6-24.3H55.9L48 16.2l-7.9 24.2H14.4l20.8 15-7.9 24.2 20.8-15 12.8-9.2z" fill="{{ settings.star_symbol_color }}"/></svg>
            {% endfor %}
          {% elsif bg_stars_style == 'outlined' %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
                <path fill="{{ bg_star_color }}" d="M287.9 0c9.2 0 17.6 5.2 21.6 13.5l68.6 141.3 153.2 22.6c9 1.3 16.5 7.6 19.3 16.3s.5 18.1-5.9 24.5L433.6 328.4l26.2 155.6c1.5 9-2.2 18.1-9.6 23.5s-17.3 6-25.3 1.7l-137-73.2L151 509.1c-8.1 4.3-17.9 3.7-25.3-1.7s-11.2-14.5-9.7-23.5l26.2-155.6L31.1 218.2c-6.5-6.4-8.7-15.9-5.9-24.5s10.3-14.9 19.3-16.3l153.2-22.6L266.3 13.5C270.4 5.2 278.7 0 287.9 0zm0 79L235.4 187.2c-3.5 7.1-10.2 12.1-18.1 13.3L99 217.9 184.9 303c5.5 5.5 8.1 13.3 6.8 21L171.4 443.7l105.2-56.2c7.1-3.8 15.6-3.8 22.6 0l105.2 56.2L384.2 324.1c-1.3-7.7 1.2-15.5 6.8-21l85.9-85.1L358.6 200.5c-7.8-1.2-14.6-6.1-18.1-13.3L287.9 79z"/>
              </svg>
            {% endfor %}
          {% else %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
                <path fill="{{ bg_star_color }}" d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/>
              </svg>
            {% endfor %}
          {% endif %}
        </div>
        <div class="fc-rating-stars__container--overlay{% if settings.star_style == 'trustpilot' %} rating-stars--trustpilot{% endif %}" style="width: {{ rating_percent }}%;">
          {% if settings.star_style == 'trustpilot' %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><path d="M0 0h96v96H0z" fill="{{ settings.trustpilot_star_color }}"/><path d="M48 64.7L62.6 61l6.1 18.8zm33.6-24.3H55.9L48 16.2l-7.9 24.2H14.4l20.8 15-7.9 24.2 20.8-15 12.8-9.2z" fill="{{ settings.star_symbol_color }}"/></svg>
            {% endfor %}
          {% else %}
            {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
                <path fill="{{ star_color }}" d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/>
              </svg>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="custom-vstar-rating-widget {{ wrapper_classes }} fc-trustoo-rating" data-product-id="{{ product.id }}"></div>
{%- endif -%}
